<header class="header">
  <a href="/inicio" class="header-logo"><span class="logo-moneda">Hilton</span></a>

  <nav class="nav-pill desktop-only">
    <% const _d = usuario?.departamento; const _r = usuario?.rol; %>
    <% if (_d === 'cocina' || _d === 'ayb' || _r === 'admin') { %>
      <a href="/eventos" class="nav-item <%= (typeof path !== 'undefined' && path === 'eventos') ? 'activo' : '' %>">
        <i class="ti ti-calendar-event" aria-hidden="true"></i><span class="nav-label">Eventos</span>
      </a>
      <a href="/personal" class="nav-item <%= (typeof path !== 'undefined' && path === 'personal') ? 'activo' : '' %>">
        <i class="ti ti-users" aria-hidden="true"></i><span class="nav-label">Miembro de equipo</span>
      </a>
      <a href="/horarios" class="nav-item <%= (typeof path !== 'undefined' && path === 'horarios') ? 'activo' : '' %>">
        <i class="ti ti-clock" aria-hidden="true"></i><span class="nav-label">Horarios</span>
      </a>
      <a href="/recetas" class="nav-item <%= (typeof path !== 'undefined' && path === 'recetas') ? 'activo' : '' %>">
        <i class="ti ti-chef-hat" aria-hidden="true"></i><span class="nav-label">Recetas</span>
      </a>
      <a href="/costos" class="nav-item <%= (typeof path !== 'undefined' && path === 'costos') ? 'activo' : '' %>">
        <i class="ti ti-coin" aria-hidden="true"></i><span class="nav-label">Costos</span>
      </a>
    <% } %>
    <% if (usuario?.rol === 'admin') { %>
      <a href="/configuracion" class="nav-item <%= (typeof path !== 'undefined' && path === 'configuracion') ? 'activo' : '' %>">
        <i class="ti ti-settings" aria-hidden="true"></i><span class="nav-label">Configuración</span>
      </a>
    <% } %>
    <a href="/logout" class="nav-item nav-item-salir">
      <i class="ti ti-logout" aria-hidden="true"></i><span class="nav-label">Salir</span>
    </a>
  </nav>

  <div class="header-user">
    <span class="user-name desktop-only"><i class="ti ti-user-circle"></i> <%= usuario?.nombre %></span>
    <a href="/logout" class="btn-logout mobile-only-flex"><i class="ti ti-logout"></i></a>
  </div>
</header>

<style>
/* ── Barra de navegación tipo "pill", navy sobre fondo claro, resaltado verde ── */
.nav-pill{
  display:flex; align-items:center; gap:5px;
  background:var(--blanco);
  border:1px solid var(--gris-borde);
  border-radius:999px;
  padding:5px;
  box-shadow:var(--sombra);
  max-width:100%;
  overflow-x:auto;
  scrollbar-width:none;
}
.nav-pill::-webkit-scrollbar{ display:none; }
.nav-item{
  display:flex; align-items:center; gap:0.65rem;
  width:40px; height:40px;
  padding:0 0 0 11px;
  overflow:hidden;
  border-radius:999px;
  color:var(--navy);
  text-decoration:none;
  flex-shrink:0;
  transition:
    width .45s cubic-bezier(.22,1,.36,1),
    background .3s ease,
    box-shadow .3s ease,
    color .3s ease;
}
.nav-item i{ font-size:16px; flex-shrink:0; }
.nav-item:hover,
.nav-item.activo{
  width:auto;
  min-width:148px;
  padding-right:16px;
  background:var(--azul);
  box-shadow:0 0 16px rgba(6,147,126,0.5);
  color:#fff;
}
.nav-item-salir:hover{
  background:rgba(220,38,38,0.85);
  box-shadow:0 0 16px rgba(220,38,38,0.4);
}
.nav-label{
  opacity:0; max-width:0; white-space:nowrap;
  transform:translateX(-8px);
  font-size:0.74rem; font-weight:500; letter-spacing:0.02em;
  transition:
    opacity .25s ease,
    max-width .45s ease,
    transform .35s ease;
}
.nav-item:hover .nav-label,
.nav-item.activo .nav-label{
  opacity:1; max-width:170px; transform:translateX(0);
}

.mobile-only-flex{ display:none; }
@media (max-width:768px){
  .mobile-only-flex{ display:flex; }
}
</style>
