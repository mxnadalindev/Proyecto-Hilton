<header class="header">
  <a href="/inicio" class="header-logo"><span class="logo-moneda">Hilton</span></a>

  <nav class="nav-pill desktop-only">
    <% const _d = usuario?.departamento; const _r = usuario?.rol; %>
    <% if (_d === 'cocina' || (_r === 'admin' && _d !== 'ayb' && _d !== 'compras' && _d !== 'finanzas')) { %>
      <a href="/eventos" class="nav-item <%= (typeof path !== 'undefined' && path === 'eventos') ? 'activo' : '' %>" title="Eventos">
        <i class="ti ti-calendar-event" aria-hidden="true"></i><span class="nav-label">Eventos</span>
      </a>
      <a href="/personal" class="nav-item <%= (typeof path !== 'undefined' && path === 'personal') ? 'activo' : '' %>" title="Miembro de equipo">
        <i class="ti ti-users" aria-hidden="true"></i><span class="nav-label">Miembro de equipo</span>
      </a>
      <a href="/horarios" class="nav-item <%= (typeof path !== 'undefined' && path === 'horarios') ? 'activo' : '' %>" title="Horarios">
        <i class="ti ti-clock" aria-hidden="true"></i><span class="nav-label">Horarios</span>
      </a>
      <a href="/recetas" class="nav-item <%= (typeof path !== 'undefined' && path === 'recetas') ? 'activo' : '' %>" title="Recetas">
        <i class="ti ti-chef-hat" aria-hidden="true"></i><span class="nav-label">Recetas</span>
      </a>
      <a href="/costos" class="nav-item <%= (typeof path !== 'undefined' && path === 'costos') ? 'activo' : '' %>" title="Costos">
        <i class="ti ti-coin" aria-hidden="true"></i><span class="nav-label">Costos</span>
      </a>
    <% } %>
    <% if (_d === 'ayb') { %>
      <a href="/personal" class="nav-item <%= (typeof path !== 'undefined' && path === 'personal') ? 'activo' : '' %>" title="Miembro de equipo">
        <i class="ti ti-users" aria-hidden="true"></i><span class="nav-label">Miembro de equipo</span>
      </a>
      <a href="/horarios" class="nav-item <%= (typeof path !== 'undefined' && path === 'horarios') ? 'activo' : '' %>" title="Horarios">
        <i class="ti ti-clock" aria-hidden="true"></i><span class="nav-label">Horarios</span>
      </a>
    <% } %>
    <% if (usuario?.rol === 'admin') { %>
      <a href="/configuracion" class="nav-item <%= (typeof path !== 'undefined' && path === 'configuracion') ? 'activo' : '' %>" title="Configuración">
        <i class="ti ti-settings" aria-hidden="true"></i><span class="nav-label">Configuración</span>
      </a>
    <% } %>
    <a href="/logout" class="nav-item nav-item-salir">
      <i class="ti ti-logout" aria-hidden="true"></i><span class="nav-label">Salir</span>
    </a>
  </nav>

  <div class="header-user">
    <span class="user-name desktop-only"><i class="ti ti-user-circle"></i> <%= usuario?.nombre %></span>
    <a href="/logout" class="btn-logout mobile-only-flex"><i class="ti ti-logout"></i></a>
  </div>
</header>

<style>
/* ── Barra de navegación tipo "pill", navy sobre fondo claro, resaltado verde ── */
.nav-pill{
  display:flex; align-items:center; gap:5px;
  background:var(--blanco);
  border:1px solid var(--gris-borde);
  border-radius:999px;
  padding:5px;
  box-shadow:var(--sombra);
  max-width:100%;
  overflow-x:auto;
  scrollbar-width:none;
}
.nav-pill::-webkit-scrollbar{ display:none; }
.nav-item{
  display:flex; align-items:center; justify-content:center;
  width:40px; height:40px;
  border-radius:999px;
  color:var(--navy);
  text-decoration:none;
  flex-shrink:0;
  transition: background .2s ease, color .2s ease;
}
.nav-item i{ font-size:17px; }
.nav-item:hover,
.nav-item.activo{
  background:var(--azul);
  color:#fff;
}
.nav-item-salir:hover{
  background:var(--rojo);
}
.nav-label{ display:none; }

.mobile-only-flex{ display:none; }
@media (max-width:768px){
  .mobile-only-flex{ display:flex; }
}

/* ── Asistente: burbuja flotante ── */
.asistente-burbuja{
  position:fixed; bottom:24px; right:24px; z-index:2000;
  width:56px; height:56px; border-radius:50%;
  background:var(--azul); color:#fff; border:none; cursor:pointer;
  display:flex; align-items:center; justify-content:center; font-size:24px;
  box-shadow:0 8px 24px rgba(6,147,126,0.4);
  transition:transform 0.2s ease, background 0.2s ease;
}
.asistente-burbuja:hover{ transform:scale(1.08); background:var(--azul-hover); }

.asistente-panel{
  position:fixed; bottom:92px; right:24px; z-index:2000;
  width:340px; max-width:calc(100vw - 32px); height:460px; max-height:calc(100vh - 140px);
  background:var(--blanco); border-radius:16px; border:1px solid var(--gris-borde);
  box-shadow:0 20px 60px rgba(0,0,0,0.25);
  display:none; flex-direction:column; overflow:hidden;
}
.asistente-panel.abierto{ display:flex; }
.asistente-header{
  background:var(--azul); color:#fff; padding:14px 16px;
  display:flex; align-items:center; justify-content:space-between; flex-shrink:0;
}
.asistente-header-titulo{ font-size:0.85rem; font-weight:600; display:flex; align-items:center; gap:8px; }
.asistente-cerrar{ background:none; border:none; color:#fff; cursor:pointer; font-size:18px; opacity:0.85; }
.asistente-cerrar:hover{ opacity:1; }
.asistente-mensajes{ flex:1; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; }
.asistente-msg{ max-width:85%; padding:8px 12px; border-radius:12px; font-size:0.8rem; line-height:1.5; white-space:pre-wrap; }
.asistente-msg.usuario{ align-self:flex-end; background:var(--azul); color:#fff; border-bottom-right-radius:3px; }
.asistente-msg.bot{ align-self:flex-start; background:var(--gris-fondo); color:var(--negro); border-bottom-left-radius:3px; }
.asistente-confirmar{ display:flex; gap:6px; align-self:flex-start; margin-top:-4px; }
.asistente-confirmar button{ font-size:0.72rem; font-weight:600; padding:5px 12px; border-radius:8px; border:1px solid var(--gris-borde); background:var(--blanco); cursor:pointer; }
.asistente-confirmar button.si{ background:var(--azul); color:#fff; border-color:var(--azul); }
.asistente-input-row{ display:flex; gap:8px; padding:12px; border-top:1px solid var(--gris-borde); flex-shrink:0; }
.asistente-input-row input{ flex:1; border:1px solid var(--gris-borde); border-radius:20px; padding:9px 14px; font-family:var(--font-sans); font-size:0.8rem; outline:none; background:var(--gris-fondo); }
.asistente-input-row input:focus{ border-color:var(--azul); background:var(--blanco); }
.asistente-input-row button{ width:36px; height:36px; border-radius:50%; background:var(--azul); border:none; color:#fff; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
</style>

<button class="asistente-burbuja" onclick="toggleAsistente()" title="Asistente">
  <i class="ti ti-message-chatbot" aria-hidden="true"></i>
</button>

<div class="asistente-panel" id="asistentePanel">
  <div class="asistente-header">
    <span class="asistente-header-titulo"><i class="ti ti-sparkles"></i> Asistente Hilton</span>
    <button class="asistente-cerrar" onclick="toggleAsistente()"><i class="ti ti-x"></i></button>
  </div>
  <div class="asistente-mensajes" id="asistenteMensajes">
    <div class="asistente-msg bot">Hola 👋 Puedo consultar insumos sin precio, quién trabaja tal día, actualizar precios o asignar/quitar RECOFF. ¿En qué te ayudo?</div>
  </div>
  <div class="asistente-input-row">
    <input type="text" id="asistenteInput" placeholder="Escribí tu consulta..." onkeydown="if(event.key==='Enter')enviarMensajeAsistente()">
    <button onclick="enviarMensajeAsistente()"><i class="ti ti-send"></i></button>
  </div>
</div>

<script>
function toggleAsistente() {
  document.getElementById('asistentePanel').classList.toggle('abierto');
}

function agregarMensajeAsistente(texto, tipo) {
  const cont = document.getElementById('asistenteMensajes');
  const div = document.createElement('div');
  div.className = 'asistente-msg ' + tipo;
  div.textContent = texto;
  cont.appendChild(div);
  cont.scrollTop = cont.scrollHeight;
  return div;
}

function agregarBotonesConfirmacion() {
  const cont = document.getElementById('asistenteMensajes');
  const div = document.createElement('div');
  div.className = 'asistente-confirmar';
  div.innerHTML = `
    <button class="si" onclick="responderConfirmacion('sí')">Sí, confirmar</button>
    <button onclick="responderConfirmacion('no')">No, cancelar</button>
  `;
  cont.appendChild(div);
  cont.scrollTop = cont.scrollHeight;
  return div;
}

function responderConfirmacion(texto) {
  const botones = document.querySelector('.asistente-confirmar');
  if (botones) botones.remove();
  enviarMensajeAsistente(texto);
}

async function enviarMensajeAsistente(textoForzado) {
  const input = document.getElementById('asistenteInput');
  const mensaje = textoForzado || input.value.trim();
  if (!mensaje) return;

  agregarMensajeAsistente(mensaje, 'usuario');
  input.value = '';

  const pensando = agregarMensajeAsistente('Pensando...', 'bot');

  try {
    const resp = await fetch('/asistente/mensaje', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mensaje }),
    });
    const data = await resp.json();
    pensando.remove();
    if (data.ok) {
      agregarMensajeAsistente(data.texto, 'bot');
      if (data.requiereConfirmacion) agregarBotonesConfirmacion();
    } else {
      agregarMensajeAsistente(data.error || 'Ocurrió un error.', 'bot');
    }
  } catch (e) {
    pensando.remove();
    agregarMensajeAsistente('No pude conectarme. Probá de nuevo.', 'bot');
  }
}
</script>
