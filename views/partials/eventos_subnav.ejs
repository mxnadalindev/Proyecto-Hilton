<!-- Solapas de navegación dentro de Eventos: Eventos / Menús / Costos.
     Se incluye con { seccionEventos: 'lista' | 'menus' | 'costos' } para
     marcar cuál está activa. El CSS (.eventos-subnav / .eventos-subnav-item)
     vive en style.css, compartido por las 3 pantallas que la usan. -->
<div class="eventos-subnav">
  <a href="/eventos" class="eventos-subnav-item <%= seccionEventos === 'lista' ? 'activa' : '' %>">Eventos</a>
  <a href="/eventos/menus" class="eventos-subnav-item <%= seccionEventos === 'menus' ? 'activa' : '' %>">Menús</a>
  <a href="/eventos/bocaditos-costos" class="eventos-subnav-item <%= seccionEventos === 'costos' ? 'activa' : '' %>">Costos</a>
</div>
