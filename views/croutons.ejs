<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Croutons — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'croutons' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Alimentos y Bebidas</p>
        <h1 class="seccion-titulo">Croutons</h1>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/inicio" class="btn-secondary"><i class="ti ti-home"></i> Menú principal</a>
        <button id="btn-avisos" onclick="toggleAvisos()" class="btn-secondary">
          <i class="ti ti-bell" id="icon-avisos"></i> <span id="texto-avisos">Activar avisos</span>
        </button>

        <!-- Más opciones: Consumidos + Excel -->
        <div class="desplegable-croutons">
          <button onclick="toggleDesplegable('menu-mas-opciones')" class="btn-secondary">
            <i class="ti ti-dots-vertical"></i> Más opciones
          </button>
          <div id="menu-mas-opciones" class="desplegable-croutons-panel" style="display:none;">
            <button type="button" onclick="cerrarDesplegables();showModal('modal-catalogo')" class="desplegable-croutons-item">
              <i class="ti ti-list-details"></i> Catálogo
            </button>
            <button type="button" onclick="cerrarDesplegables();abrirConsumidos()" class="desplegable-croutons-item">
              <i class="ti ti-archive"></i> Consumidos<% if (totalConsumidos > 0) { %> (<%= totalConsumidos %>)<% } %>
            </button>
            <a href="/croutons/excel" class="desplegable-croutons-item">
              <i class="ti ti-file-spreadsheet" style="color:#16a34a;"></i> Excel
            </a>
          </div>
        </div>

        <!-- Nuevo lote: a mano/escanear, o por foto -->
        <div class="desplegable-croutons">
          <button onclick="toggleDesplegable('menu-nuevo-lote')" class="btn-primary">
            <i class="ti ti-plus"></i> Nuevo lote <i class="ti ti-chevron-down" style="font-size:13px;"></i>
          </button>
          <div id="menu-nuevo-lote" class="desplegable-croutons-panel" style="display:none;">
            <button type="button" onclick="cerrarDesplegables();abrirNuevoLote()" class="desplegable-croutons-item">
              <i class="ti ti-pencil"></i> A mano / escanear código
            </button>
            <button type="button" onclick="cerrarDesplegables();showModal('modal-carga-foto')" class="desplegable-croutons-item">
              <i class="ti ti-camera"></i> Por foto del remito
            </button>
          </div>
        </div>
      </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) {
      const msgTexto = decodeURIComponent(msg);
      const esError  = /error/i.test(msgTexto);
    %>
    <div id="toast-mensaje" style="position:fixed;top:20px;right:20px;z-index:2000;background:<%= esError ? '#fef2f2' : '#f0fdf4' %>;border:1px solid <%= esError ? '#fecaca' : '#bbf7d0' %>;border-radius:10px;padding:14px 18px;font-size:0.83rem;color:<%= esError ? '#dc2626' : '#16a34a' %>;display:flex;align-items:center;gap:10px;box-shadow:0 8px 24px rgba(0,0,0,0.15);max-width:360px;transition:opacity .4s, transform .4s;">
      <i class="ti <%= esError ? 'ti-alert-circle' : 'ti-check' %>" style="font-size:18px;flex-shrink:0;"></i>
      <span><%= msgTexto %></span>
      <button type="button" onclick="cerrarToast()" style="background:none;border:none;cursor:pointer;color:inherit;opacity:0.6;font-size:14px;margin-left:4px;flex-shrink:0;"><i class="ti ti-x"></i></button>
    </div>
    <script>
      (function() {
        const toast = document.getElementById('toast-mensaje');
        if (!toast) return;
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-10px)';
          setTimeout(() => toast.remove(), 400);
        }, 4000);
      })();
      function cerrarToast() {
        const toast = document.getElementById('toast-mensaje');
        if (toast) toast.remove();
      }
    </script>
    <% } %>

    <!-- Resumen: tarjetas clickeables que filtran el listado de abajo -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:14px;">
      <a href="/croutons" style="text-decoration:none;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:12px;padding:16px;text-align:center;display:block;">
        <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= totalProductos %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Producto<%= totalProductos !== 1 ? 's' : '' %></p>
      </a>
      <a href="/croutons?tipo=vencidos" style="text-decoration:none;background:#fef2f2;border:<%= tipoFiltro==='vencidos' ? '2px' : '1px' %> solid #<%= tipoFiltro==='vencidos' ? 'dc2626' : 'fecaca' %>;border-radius:12px;padding:16px;text-align:center;display:block;">
        <p style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= vencidos.length %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Vencido<%= vencidos.length !== 1 ? 's' : '' %></p>
      </a>
      <a href="/croutons?tipo=porvencer" style="text-decoration:none;background:#fef3c7;border:<%= tipoFiltro==='porvencer' ? '2px' : '1px' %> solid #<%= tipoFiltro==='porvencer' ? 'ef9f27' : 'fde68a' %>;border-radius:12px;padding:16px;text-align:center;display:block;">
        <p style="font-size:1.8rem;font-weight:700;color:#92400e;margin:0;"><%= porVencer.length %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#92400e;margin:4px 0 0;">Vencen en <%= diasAlerta %> días o menos</p>
      </a>
      <a href="/croutons?tipo=stockbajo" style="text-decoration:none;background:var(--azul-claro);border:<%= tipoFiltro==='stockbajo' ? '2px' : '1px' %> solid <%= tipoFiltro==='stockbajo' ? 'var(--azul)' : 'var(--azul-borde)' %>;border-radius:12px;padding:16px;text-align:center;display:block;">
        <p style="font-size:1.8rem;font-weight:700;color:var(--azul);margin:0;"><%= productosStockBajo.length %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--azul);margin:4px 0 0;">Stock bajo — reponer</p>
      </a>
    </div>

    <% if (tipoFiltro) {
      const colorChip = tipoFiltro==='vencidos' ? '#dc2626' : (tipoFiltro==='porvencer' ? '#ef9f27' : 'var(--azul)');
      const textoChip = tipoFiltro==='vencidos' ? 'Vencidos' : (tipoFiltro==='porvencer' ? `Vencen en ${diasAlerta} días o menos` : 'Stock bajo — reponer');
    %>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
      <span style="font-size:0.75rem;color:var(--gris-texto);">Mostrando:</span>
      <a href="/croutons" style="text-decoration:none;background:<%= colorChip %>;color:#fff;font-size:0.72rem;font-weight:600;padding:4px 10px;border-radius:20px;display:inline-flex;align-items:center;gap:6px;">
        <%= textoChip %> <i class="ti ti-x" style="font-size:12px;"></i>
      </a>
    </div>
    <% } %>

    <!-- Buscador: pegado al listado que filtra, no a las tarjetas — en el
         celular, con el teclado abierto, así el resultado queda a la vista
         en vez de quedar tapado más abajo de las tarjetas. -->
    <div style="position:relative;margin-bottom:16px;max-width:360px;">
      <i class="ti ti-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
      <input type="text" id="buscador-productos" oninput="filtrarProductos()" placeholder="Buscar producto..."
             style="width:100%;padding:9px 12px 9px 34px;border:1px solid var(--gris-borde);border-radius:9px;font-family:var(--font-sans);font-size:0.83rem;outline:none;background:var(--blanco);color:var(--negro);">
    </div>

    <div class="panel-productos">
      <% if (productos.length === 0) { %>
        <div style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:32px;text-align:center;color:var(--gris-texto);">
          <i class="ti ti-package-off" style="font-size:32px;display:block;margin-bottom:10px;"></i>
          <% if (tipoFiltro) { %>
            No hay productos en este filtro.
          <% } else { %>
            Todavía no hay ningún lote cargado. Usá "Cargar lote a mano", escaneá un código de barras, o subí una foto del remito.
          <% } %>
        </div>
      <% } else { %>
      <div id="lista-productos" style="display:flex;flex-direction:column;gap:10px;">
        <% categorias.forEach((cat, ci) => { %>
        <div class="acordeon-categoria">
          <button type="button" class="acordeon-alerta-header" onclick="toggleAcordeon('acordeon-cat-<%= ci %>')" style="background:var(--blanco);border:1px solid var(--gris-borde);color:var(--negro);">
            <i class="ti ti-category" style="font-size:17px;color:var(--gris-texto);"></i>
            <span style="flex:1;text-align:left;"><%= cat.categoria %></span>
            <span class="acordeon-alerta-badge" style="background:var(--gris-texto);"><%= cat.productos.length %></span>
            <i class="ti ti-chevron-down acordeon-alerta-chevron"></i>
          </button>
          <div id="acordeon-cat-<%= ci %>" class="acordeon-alerta-body">
            <% cat.productos.forEach(p => {
              const i = productos.indexOf(p);
              const dias = p.diasParaVencerMinimo;
              let estadoTexto, estadoColor, estadoFondo, estadoBorde;
              if (dias < 0) {
                estadoTexto = `Vencido hace ${Math.abs(dias)} día${Math.abs(dias) !== 1 ? 's' : ''}`;
                estadoColor = '#dc2626'; estadoFondo = '#fef2f2'; estadoBorde = '#fecaca';
              } else if (dias <= diasAlerta) {
                estadoTexto = dias === 0 ? 'Vence hoy' : `Vence en ${dias} día${dias !== 1 ? 's' : ''}`;
                estadoColor = '#92400e'; estadoFondo = '#fef3c7'; estadoBorde = '#fde68a';
              } else {
                estadoTexto = `Vence en ${dias} días`;
                estadoColor = '#16a34a'; estadoFondo = '#f0fdf4'; estadoBorde = '#bbf7d0';
              }
            %>
            <div class="fila-producto" data-nombre="<%= p.producto.toLowerCase() %>" onclick="showModal('modal-producto-<%= i %>')"
                 style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:border-color .15s;">
              <div>
                <p style="font-weight:600;color:var(--negro);margin:0 0 3px;font-size:0.88rem;"><%= p.producto %></p>
                <p style="font-size:0.75rem;color:var(--gris-texto);margin:0;">
                  <%= p.totalLotes %> lote<%= p.totalLotes !== 1 ? 's' : '' %><% if (p.pesoTotalKg > 0) { %> · <%= p.pesoTotalKg.toFixed(2) %> kg total<% } %>
                </p>
              </div>
              <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;">
                <% if (p.stockBajo) { %>
                <span style="font-size:0.68rem;font-weight:700;color:var(--azul);background:var(--azul-claro);border:1px solid var(--azul-borde);padding:3px 9px;border-radius:20px;white-space:nowrap;display:inline-flex;align-items:center;gap:4px;">
                  <i class="ti ti-shopping-cart" style="font-size:12px;"></i> Stock bajo
                </span>
                <% } %>
                <span style="font-size:0.68rem;font-weight:700;color:<%= estadoColor %>;background:<%= estadoFondo %>;border:1px solid <%= estadoBorde %>;padding:3px 9px;border-radius:20px;white-space:nowrap;"><%= estadoTexto %></span>
                <i class="ti ti-chevron-right" style="color:var(--gris-texto);"></i>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
      <p id="mensaje-sin-resultados" style="display:none;text-align:center;color:var(--gris-texto);font-size:0.82rem;padding:20px;">Ningún producto coincide con la búsqueda.</p>
      <% } %>
      </div>
    </div>

  </main>

  <%- include('partials/mobile-nav', { path: 'croutons' }) %>
</div>

<!-- Modal: detalle de lotes por producto (uno por cada producto del listado) -->
<% productos.forEach((p, i) => {
  // Si TODOS los lotes de este producto están vencidos, no tiene sentido
  // mostrar edición de stock mínimo/categoría (son config para la próxima
  // reposición) ni el lápiz de editar un lote muerto — solo importa
  // resolverlo (consumir/eliminar). Si tiene al menos un lote vigente o
  // por vencer, se ve todo normal.
  const productoVencido = !p.lotes.some(l => l.dias_para_vencer >= 0);
%>
<div id="modal-producto-<%= i %>" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:28px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,0.2);max-height:88vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;">
      <h2 style="font-family:var(--font-serif);font-size:1.3rem;font-weight:400;"><%= p.producto %></h2>
      <button onclick="hideModal('modal-producto-<%= i %>')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <p style="font-size:0.75rem;color:var(--gris-texto);margin:0 0 16px;">
      Total: <%= p.totalLotes %> lote<%= p.totalLotes !== 1 ? 's' : '' %><% if (p.pesoTotalKg > 0) { %> · <%= p.pesoTotalKg.toFixed(2) %> kg<% } %>
    </p>

    <% if (!productoVencido) { %>
    <!-- Stock mínimo para alerta de reposición — se guarda solo, sin recargar -->
    <div style="background:var(--azul-claro);border:1px solid var(--azul-borde);border-radius:10px;padding:12px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <i class="ti ti-shopping-cart" style="color:var(--azul);font-size:16px;flex-shrink:0;"></i>
      <label style="font-size:0.76rem;color:var(--azul);font-weight:600;white-space:nowrap;">Stock mínimo:</label>
      <div style="display:flex;align-items:center;gap:4px;">
        <button type="button" onclick="ajustarStockMinimo('<%= p.producto.replace(/'/g, "\\'") %>', <%= i %>, -1)"
                style="width:28px;height:28px;border:1px solid var(--azul-borde);border-radius:7px;background:var(--blanco);color:var(--azul);font-size:1rem;font-weight:700;cursor:pointer;line-height:1;">−</button>
        <input type="number" min="0" step="1" placeholder="Sin definir"
               value="<%= p.stockMinimo !== null ? p.stockMinimo : '' %>"
               id="input-stock-minimo-<%= i %>"
               oninput="const est=document.getElementById('estado-guardado-minimo-<%= i %>'); if(est) est.textContent=''; clearTimeout(timersStockMinimo[<%= i %>]); const v=this.value; timersStockMinimo[<%= i %>]=setTimeout(()=>guardarStockMinimo('<%= p.producto.replace(/'/g, "\\'") %>', v, <%= i %>), 700);"
               style="width:56px;text-align:center;border:1px solid var(--azul-borde);border-radius:7px;padding:6px 4px;font-size:0.82rem;outline:none;background:var(--blanco);color:var(--negro);">
        <button type="button" onclick="ajustarStockMinimo('<%= p.producto.replace(/'/g, "\\'") %>', <%= i %>, 1)"
                style="width:28px;height:28px;border:1px solid var(--azul-borde);border-radius:7px;background:var(--blanco);color:var(--azul);font-size:1rem;font-weight:700;cursor:pointer;line-height:1;">+</button>
      </div>
      <span style="font-size:0.72rem;color:var(--azul);">(hoy: <%= p.stockActual %> <%= p.lotes[0] ? p.lotes[0].unidad : '' %>)</span>
      <span id="estado-guardado-minimo-<%= i %>" style="font-size:0.72rem;color:var(--azul);"></span>
    </div>

    <!-- Categoría del producto — con qué barra se agrupa en el listado -->
    <div style="background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:10px;padding:12px 14px;margin-bottom:16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <i class="ti ti-category" style="color:var(--gris-texto);font-size:16px;flex-shrink:0;"></i>
      <label style="font-size:0.76rem;color:var(--gris-texto);font-weight:600;white-space:nowrap;">Categoría:</label>
      <select id="input-categoria-<%= i %>"
              onchange="if (this.value === '__nueva__') { this.style.display='none'; document.getElementById('input-categoria-nueva-<%= i %>').style.display='inline-block'; document.getElementById('input-categoria-nueva-<%= i %>').focus(); } else { guardarCategoria('<%= p.producto.replace(/'/g, "\\'") %>', this.value, <%= i %>) }"
              style="width:150px;border:1px solid var(--gris-borde);border-radius:7px;padding:6px 9px;font-size:0.82rem;outline:none;background:var(--blanco);color:var(--negro);">
        <option value="" <%= (p.categoria === 'General' || !p.categoria) ? 'selected' : '' %>>General</option>
        <% categoriasDisponibles.forEach(cat => { if (cat !== 'General') { %>
        <option value="<%= cat %>" <%= p.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% } }) %>
        <option value="__nueva__">+ Nueva categoría...</option>
      </select>
      <input type="text" placeholder="Nombre de la categoría" id="input-categoria-nueva-<%= i %>" style="display:none;width:140px;border:1px solid var(--gris-borde);border-radius:7px;padding:6px 9px;font-size:0.82rem;outline:none;background:var(--blanco);color:var(--negro);"
             onchange="guardarCategoria('<%= p.producto.replace(/'/g, "\\'") %>', this.value, <%= i %>)">
      <span id="estado-guardado-categoria-<%= i %>" style="font-size:0.72rem;color:var(--gris-texto);"></span>
    </div>
    <% } %>

    <p style="font-size:0.66rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gris-texto);margin:0 0 8px;font-weight:600;">Lotes cargados</p>

    <% const idPrimerNoVencido = (p.lotes.find(l => l.dias_para_vencer >= 0) || {}).id; %>
    <% p.lotes.forEach(l => {
      const dias = l.dias_para_vencer;
      let colorLote;
      if (dias < 0) colorLote = '#dc2626';
      else if (dias <= diasAlerta) colorLote = '#92400e';
      else colorLote = '#16a34a';
      const textoLote = dias < 0 ? `Vencido hace ${Math.abs(dias)} día${Math.abs(dias) !== 1 ? 's' : ''}` : (dias === 0 ? 'Vence hoy' : `Vence en ${dias} día${dias !== 1 ? 's' : ''}`);
      const esUsarPrimero = p.lotes.length > 1 && l.id === idPrimerNoVencido;
    %>
    <div style="background:var(--gris-fondo);border-radius:10px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px;<% if (esUsarPrimero) { %>border:1.5px solid var(--azul);<% } %>">
      <div style="min-width:0;">
        <p style="font-size:0.8rem;font-weight:600;color:<%= colorLote %>;margin:0 0 2px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
          <%= textoLote %> (<%= new Date(l.fecha_vencimiento).toLocaleDateString('es-AR') %>)
          <% if (esUsarPrimero) { %>
          <span style="font-size:0.62rem;font-weight:700;letter-spacing:0.03em;text-transform:uppercase;color:var(--azul);background:var(--azul-claro);border:1px solid var(--azul-borde);padding:2px 8px;border-radius:20px;display:inline-flex;align-items:center;gap:3px;">
            <i class="ti ti-arrow-big-up-line" style="font-size:11px;"></i> Usar primero
          </span>
          <% } %>
        </p>
        <p style="font-size:0.74rem;color:var(--gris-texto);margin:0;">
          <%= l.cantidad %> <%= l.unidad %><% if (l.peso) { %> · <%= parseFloat(l.peso) %> <%= l.unidad_peso || 'kg' %><% } %> · ingresó <%= new Date(l.fecha_ingreso).toLocaleDateString('es-AR') %>
          <% if (l.proveedor) { %><br><%= l.proveedor %><% } %>
        </p>
      </div>
      <div style="display:flex;gap:6px;flex-shrink:0;">
        <% if (!productoVencido) { %>
        <button type="button" class="btn-icono" title="Editar" onclick='abrirEditarLote(<%- JSON.stringify({
          id: l.id, producto: l.producto, cantidad: l.cantidad, unidad: l.unidad,
          peso: l.peso, unidad_peso: l.unidad_peso,
          fecha_ingreso: l.fecha_ingreso ? new Date(l.fecha_ingreso).toISOString().split("T")[0] : "",
          fecha_vencimiento: l.fecha_vencimiento ? new Date(l.fecha_vencimiento).toISOString().split("T")[0] : "",
          proveedor: l.proveedor, lote_proveedor: l.lote_proveedor, notas: l.notas,
          categoria: p.categoria && p.categoria !== 'General' ? p.categoria : ''
        }) %>)'><i class="ti ti-pencil"></i></button>
        <% } %>
        <button type="button" class="btn-icono" title="Marcar como consumido" onclick='abrirConsumirLote(<%= l.id %>, <%- JSON.stringify(l.producto) %>)'><i class="ti ti-check"></i></button>
        <form method="POST" action="/croutons/lote/<%= l.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar este lote? Esta acción no se puede deshacer.');">
          <button type="submit" class="btn-icono" title="Eliminar" style="color:#dc2626;"><i class="ti ti-trash"></i></button>
        </form>
      </div>
    </div>
    <% }) %>

    <button type="button" onclick="hideModal('modal-producto-<%= i %>')" class="btn-secondary" style="width:100%;justify-content:center;margin-top:8px;">Cerrar</button>
  </div>
</div>
<% }) %>

<!-- Modal: Motivo de consumo (aparece antes de marcar un lote como consumido) -->
<div id="modal-motivo-consumo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1100;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:28px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <h2 style="font-family:var(--font-serif);font-size:1.2rem;font-weight:400;margin:0 0 4px;">Marcar como consumido</h2>
    <p id="texto-motivo-consumo" style="font-size:0.8rem;color:var(--gris-texto);margin:0 0 16px;"></p>
    <form id="form-motivo-consumo" method="POST" action="">
      <label style="font-size:0.78rem;font-weight:600;color:var(--gris-texto);display:block;margin-bottom:6px;">Motivo</label>
      <select name="motivo" required style="width:100%;border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;background:var(--blanco);color:var(--negro);margin-bottom:18px;">
        <option value="" disabled selected>Elegí un motivo</option>
        <option value="Vencido">Vencido</option>
        <option value="Rotura/daño">Rotura / daño</option>
        <option value="Uso normal">Uso normal (consumido en servicio)</option>
        <option value="Otro">Otro</option>
      </select>
      <div style="display:flex;gap:8px;">
        <button type="button" onclick="hideModal('modal-motivo-consumo')" class="btn-secondary" style="flex:1;justify-content:center;">Cancelar</button>
        <button type="submit" class="btn-primary" style="flex:1;justify-content:center;">Confirmar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Consumidos (papelera con restaurar) -->
<div id="modal-consumidos" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:28px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,0.2);max-height:88vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
      <h2 style="font-family:var(--font-serif);font-size:1.3rem;font-weight:400;">Consumidos</h2>
      <button onclick="hideModal('modal-consumidos')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <p style="font-size:0.75rem;color:var(--gris-texto);margin:0 0 16px;">Se borran solos a los 15 días de marcarse como consumidos.</p>
    <div id="lista-consumidos">
      <p style="text-align:center;color:var(--gris-texto);font-size:0.82rem;padding:16px;">Cargando...</p>
    </div>
    <button type="button" onclick="hideModal('modal-consumidos')" class="btn-secondary" style="width:100%;justify-content:center;margin-top:8px;">Cerrar</button>
  </div>
</div>

<!-- Modal: Catálogo — nombre, categoría y stock mínimo de cada producto,
     exista o no un lote activo cargado ahora mismo. -->
<div id="modal-catalogo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:28px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,0.2);max-height:88vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
      <h2 style="font-family:var(--font-serif);font-size:1.3rem;font-weight:400;">Catálogo</h2>
      <button onclick="hideModal('modal-catalogo')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <p style="font-size:0.75rem;color:var(--gris-texto);margin:0 0 16px;">Categoría y stock mínimo de cada producto, tenga o no lotes cargados ahora mismo.</p>

    <!-- Alta rápida de un producto nuevo, sin necesidad de cargarle un lote -->
    <form onsubmit="return agregarProductoCatalogo(event)" style="display:flex;gap:6px;margin-bottom:16px;">
      <input type="text" id="input-nuevo-producto-catalogo" placeholder="Nombre del producto..." required
             style="flex:1;border:1px solid var(--gris-borde);border-radius:8px;padding:8px 10px;font-size:0.8rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
      <button type="submit" class="btn-secondary" style="padding:8px 12px;font-size:0.78rem;"><i class="ti ti-plus"></i></button>
    </form>

    <% if (catalogo.length === 0) { %>
    <p style="text-align:center;color:var(--gris-texto);font-size:0.8rem;padding:16px;">Todavía no hay productos en el catálogo.</p>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <% catalogo.forEach((c, ci) => { %>
      <div style="background:var(--gris-fondo);border-radius:9px;padding:10px 12px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:8px;">
          <p style="font-size:0.8rem;font-weight:600;color:var(--negro);margin:0;"><%= c.nombre %></p>
          <button type="button" class="btn-icono" title="Eliminar del catálogo" onclick="eliminarProductoCatalogo(<%= c.id %>, '<%= c.nombre.replace(/'/g, "\\'") %>')" style="color:#dc2626;flex-shrink:0;width:28px;height:28px;">
            <i class="ti ti-trash" style="font-size:14px;"></i>
          </button>
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:6px;">
          <input type="text" placeholder="Categoría" value="<%= c.categoria && c.categoria !== 'General' ? c.categoria : '' %>"
                 id="cat-input-categoria-<%= ci %>"
                 onchange="guardarCategoria('<%= c.nombre.replace(/'/g, "\\'") %>', this.value, 'cat-<%= ci %>')"
                 style="flex:1;min-width:90px;border:1px solid var(--gris-borde);border-radius:7px;padding:5px 8px;font-size:0.76rem;outline:none;background:var(--blanco);color:var(--negro);">
          <input type="number" min="0" step="1" placeholder="Mínimo" value="<%= c.stock_minimo !== null ? c.stock_minimo : '' %>"
                 id="cat-input-stock-minimo-cat-<%= ci %>"
                 onchange="guardarStockMinimo('<%= c.nombre.replace(/'/g, "\\'") %>', this.value, 'cat-<%= ci %>')"
                 style="width:70px;border:1px solid var(--gris-borde);border-radius:7px;padding:5px 8px;font-size:0.76rem;outline:none;background:var(--blanco);color:var(--negro);">
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
          <select id="cat-input-unidad-cat-<%= ci %>"
                  onchange="guardarUnidad('<%= c.nombre.replace(/'/g, "\\'") %>', this.value, 'cat-<%= ci %>')"
                  style="flex:1;min-width:90px;border:1px solid var(--gris-borde);border-radius:7px;padding:5px 8px;font-size:0.76rem;outline:none;background:var(--blanco);color:var(--negro);">
            <option value="unidad" <%= (c.unidad_default || 'unidad') === 'unidad' ? 'selected' : '' %>>unidad suelta</option>
            <option value="paquete" <%= c.unidad_default === 'paquete' ? 'selected' : '' %>>paquete</option>
            <option value="caja" <%= c.unidad_default === 'caja' ? 'selected' : '' %>>caja</option>
            <option value="bolsa" <%= c.unidad_default === 'bolsa' ? 'selected' : '' %>>bolsa</option>
          </select>
          <input type="text" placeholder="Código de barras" value="<%= c.codigo_barras || '' %>"
                 id="cat-input-codigo-cat-<%= ci %>"
                 onchange="guardarCodigoBarras('<%= c.nombre.replace(/'/g, "\\'") %>', this.value, 'cat-<%= ci %>')"
                 style="flex:1;min-width:110px;border:1px solid var(--gris-borde);border-radius:7px;padding:5px 8px;font-size:0.76rem;outline:none;background:var(--blanco);color:var(--negro);">
        </div>
        <span id="estado-guardado-categoria-cat-<%= ci %>" style="font-size:0.68rem;color:var(--gris-texto);"></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <button type="button" onclick="hideModal('modal-catalogo')" class="btn-secondary" style="width:100%;justify-content:center;margin-top:16px;">Cerrar</button>
  </div>
</div>

<!-- Modal: Cargar por foto (remito o catálogo del proveedor) -->
<div id="modal-carga-foto" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Cargar por foto</h2>
      <button onclick="hideModal('modal-carga-foto')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>

    <div class="tarjeta-unificada" style="margin-bottom:0;box-shadow:none;border:none;padding:0;">
      <div class="tarjeta-unificada-icono"><i class="ti ti-truck-delivery"></i></div>
      <p class="tarjeta-unificada-titulo">
        Carga de mercadería
        <% if (geminiConfigurado) { %>
          <span class="badge-activo"><i class="ti ti-circle-filled" style="font-size:7px;"></i> Activo</span>
        <% } else { %>
          <span class="badge-inactivo">Foto no configurada</span>
        <% } %>
      </p>
      <p class="tarjeta-unificada-desc">Elegí una foto del remito/etiqueta o el catálogo del proveedor — el sistema detecta solo cuál es y lee la fecha de vencimiento de cada producto.</p>

      <div class="tarjeta-unificada-opciones">
        <form id="form-carga-croutons" method="POST" enctype="multipart/form-data"
              class="opcion-precio opcion-precio-sola" onsubmit="return prepararEnvioCroutons()">
          <input type="text" id="input-proveedor-csv" name="proveedor_csv" placeholder="Proveedor (si es catálogo, opcional)" class="precio-card-input-categoria" style="display:none;">
          <label class="input-archivo" id="label-archivo-croutons">
            <i class="ti ti-paperclip"></i>
            <span id="nombre-archivo-croutons">Elegir archivo</span>
            <input type="file" id="input-croutons" required onchange="detectarTipoArchivoCroutons(this)">
          </label>
          <button type="submit" id="btn-carga-croutons" class="btn-primary">
            <i class="ti ti-upload" id="icon-carga-croutons"></i>
            <span id="texto-carga-croutons">Subir</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Cargar / Editar lote (mismo formulario, cambia de modo con JS) -->
<div id="modal-lote" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);max-height:92vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;" id="titulo-modal-lote">Cargar lote</h2>
      <button onclick="hideModal('modal-lote')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>

    <!-- Escáner de código de barras (solo tiene sentido al cargar uno nuevo) -->
    <div id="bloque-escaner" style="margin-bottom:18px;">
      <button type="button" id="btn-abrir-escaner" onclick="abrirEscaner()" class="btn-secondary" style="width:100%;justify-content:center;">
        <i class="ti ti-barcode"></i> Escanear código de barras
      </button>
      <div id="escaner-visor" style="display:none;margin-top:10px;border-radius:10px;overflow:hidden;border:1px solid var(--gris-borde);"></div>
      <div id="escaner-estado" style="display:none;margin-top:8px;font-size:0.78rem;padding:8px 12px;border-radius:8px;"></div>
      <button type="button" id="btn-cerrar-escaner" onclick="cerrarEscaner()" style="display:none;margin-top:8px;width:100%;background:none;border:1px solid var(--gris-borde);border-radius:8px;padding:8px;font-size:0.75rem;color:var(--gris-texto);cursor:pointer;">
        Cancelar escaneo
      </button>
    </div>

    <form method="POST" action="/croutons/lote/nuevo" id="form-lote">
      <div class="field" style="margin-bottom:14px;" id="campo-codigo-barras">
        <label>Código de barras</label>
        <input type="text" name="codigo_barras" id="input-codigo-barras" placeholder="Se completa solo al escanear, o escribilo a mano">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Producto</label>
          <input type="text" name="producto" id="input-producto" placeholder="Ej: Croutons clásicos, Aceitunas verdes..." required>
        </div>
        <div class="field" style="grid-column:1/-1;background:var(--gris-fondo);border-radius:10px;padding:12px 14px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label>Cantidad de bultos</label>
            <input type="number" name="cantidad" id="input-cantidad" placeholder="Ej: 3" step="1" min="0">
          </div>
          <div>
            <label>Empaque</label>
            <select name="unidad" id="input-unidad" style="width:100%;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
              <option value="unidad">unidad suelta</option>
              <option value="paquete">paquete</option>
              <option value="caja">caja</option>
              <option value="bolsa">bolsa</option>
            </select>
          </div>
          <p style="font-size:0.66rem;color:var(--gris-texto);margin:0;grid-column:1/-1;">Ej: 3 + "caja" = entraron 3 cajas del producto</p>
        </div>

        <div class="field" style="grid-column:1/-1;background:var(--gris-fondo);border-radius:10px;padding:12px 14px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label>Peso o volumen (opcional)</label>
            <input type="number" name="peso" id="input-peso" placeholder="Ej: 5" step="0.01" min="0">
          </div>
          <div>
            <label>Unidad</label>
            <select name="unidad_peso" id="input-unidad-peso" style="width:100%;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
              <option value="kg">kg</option>
              <option value="g">g</option>
              <option value="lt">lt</option>
              <option value="ml">ml</option>
            </select>
          </div>
          <p style="font-size:0.66rem;color:var(--gris-texto);margin:0;grid-column:1/-1;">Ej: 5 + "kg" = cada bulto (o el total) pesa 5 kg — dejalo vacío si no aplica</p>
        </div>

        <div class="field">
          <label>Fecha de ingreso</label>
          <input type="date" name="fecha_ingreso" id="input-fecha-ingreso" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
        <div class="field">
          <label>Fecha de vencimiento</label>
          <input type="date" name="fecha_vencimiento" id="input-fecha-vencimiento" required>
        </div>
        <div class="field">
          <label>Proveedor</label>
          <input type="text" name="proveedor" id="input-proveedor" placeholder="Ej: Distribuidora ABC">
        </div>
        <div class="field">
          <label>Lote del proveedor (opcional)</label>
          <input type="text" name="lote_proveedor" id="input-lote-proveedor" placeholder="Ej: L-4521">
        </div>
        <div class="field">
          <label>Categoría (opcional)</label>
          <select name="categoria" id="input-categoria-lote" onchange="manejarCategoriaLote(this)">
            <option value="">General</option>
            <% categoriasDisponibles.forEach(cat => { if (cat !== 'General') { %><option value="<%= cat %>"><%= cat %></option><% } }) %>
            <option value="__nueva__">+ Nueva categoría...</option>
          </select>
          <input type="text" placeholder="Nombre de la categoría" id="input-categoria-lote-nueva" style="display:none;margin-top:6px;">
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Notas (opcional)</label>
          <input type="text" name="notas" id="input-notas" placeholder="Ej: guardado en depósito seco">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-lote')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary" id="btn-guardar-lote"><i class="ti ti-plus"></i> Agregar lote</button>
      </div>
    </form>
  </div>
</div>

<style>
.tarjeta-unificada{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:22px;box-shadow:var(--sombra);text-align:center;margin-bottom:22px;}
.tarjeta-unificada-icono{width:44px;height:44px;border-radius:10px;background:var(--azul-claro);color:var(--azul);display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 12px;}
.tarjeta-unificada-titulo{font-size:0.9rem;font-weight:600;color:var(--negro);margin:0 0 4px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;}
.tarjeta-unificada-desc{font-size:0.76rem;color:var(--gris-texto);margin:0 0 16px;line-height:1.5;}
.tarjeta-unificada-opciones{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:2px;}
.opcion-precio-sola{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;}
.precio-card-input-categoria{border:1px solid var(--gris-borde);border-radius:8px;padding:9px 12px;font-size:0.8rem;outline:none;background:var(--gris-fondo);min-width:180px;}
.precio-card-input-categoria:focus{border-color:var(--azul);background:var(--blanco);}

.badge-activo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;padding:2px 8px 2px 6px;border-radius:20px;display:inline-flex;align-items:center;gap:4px;}
.badge-activo i{color:#16a34a;}
.badge-inactivo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:var(--gris-texto);background:var(--gris-borde);padding:2px 8px;border-radius:20px;}

.input-archivo{display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--gris-borde);border-radius:8px;font-size:0.8rem;color:var(--gris-texto);cursor:pointer;background:var(--gris-fondo);transition:border-color 0.2s;max-width:220px;}
.input-archivo:hover{border-color:var(--azul);}
.input-archivo span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.input-archivo input[type=file]{display:none;}
.input-archivo-ok{border-color:#16a34a;background:#f0fdf4;color:#16a34a;}

.girando{animation:girar 0.8s linear infinite;}
@keyframes girar{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }

.btn-icono{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:8px;width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--gris-texto);transition:border-color .2s,color .2s;}
.btn-icono:hover{border-color:var(--azul);color:var(--azul);}

.fila-producto:hover{border-color:var(--azul);}

.field{display:flex;flex-direction:column;gap:6px;}
.field label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.04em;}
.field input{border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;background:var(--gris-fondo);}
.field input:focus{border-color:var(--azul);background:var(--blanco);}
#escaner-visor video { width: 100%; border-radius: 8px; display: block; }
#btn-abrir-escaner, #btn-cerrar-escaner { min-height: 44px; }

/* ── Específico de Croutons: nada de esto existe en el CSS global,
   porque son grillas propias de esta pantalla. Los botones, inputs,
   header y modales genéricos ya se resuelven en public/css/style.css
   para toda la app — acá solo lo que le hace falta a este layout puntual. ── */

/* Acordeón de alertas (Vencidos / Por vencer / Stock bajo): colapsado por
   defecto, se despliega al tocar el encabezado — evita mostrar todo junto
   de una y que se sienta desordenado, sobre todo en tablet. */
.acordeon-alerta-header {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 0.83rem;
  font-weight: 600;
  cursor: pointer;
  font-family: var(--font-sans);
}
.acordeon-alerta-badge {
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  padding: 2px 9px;
  border-radius: 20px;
  flex-shrink: 0;
}
.acordeon-alerta-chevron {
  flex-shrink: 0;
  transition: transform .2s;
}
.acordeon-alerta-chevron.abierto {
  transform: rotate(180deg);
}
.acordeon-alerta-body {
  display: none;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
}
.acordeon-alerta-body.abierto {
  display: flex;
}

/* Menús desplegables del header ("Más opciones" y "Nuevo lote") */
.desplegable-croutons { position: relative; }
.desplegable-croutons-panel {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  background: var(--blanco);
  border: 1px solid var(--gris-borde);
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  min-width: 210px;
  padding: 6px;
  z-index: 200;
}
.desplegable-croutons-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  background: none;
  border: none;
  padding: 10px 12px;
  font-size: 0.8rem;
  font-family: var(--font-sans);
  color: var(--negro);
  text-decoration: none;
  cursor: pointer;
  border-radius: 7px;
  text-align: left;
}
.desplegable-croutons-item:hover { background: var(--gris-fondo); }

/* La regla global de mobile fuerza padding:12px en TODOS los inputs (para
   evitar el zoom de iOS) — eso le comía el espacio que este buscador
   reservaba para la lupita a la izquierda. Se lo devolvemos solo a este
   campo puntual, sin tocar la regla global para los demás inputs. */
#buscador-productos {
  padding-left: 34px !important;
}

@media (pointer: coarse) {
  .tarjeta-unificada-opciones {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 480px) {
  /* Tarjetas de resumen (Productos/Vencidos/Vencen en 15 días/Stock bajo):
     grilla de 2 columnas, más cuadradas, en vez de una debajo de otra. */
  div[style*="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))"] {
    grid-template-columns: 1fr 1fr !important;
  }

  /* Fila de producto: un poco más compacta */
  .fila-producto { padding: 12px 14px; }
  .fila-producto p { font-size: 0.82rem; }

  /* Cantidad/Empaque y Peso/Unidad: se apilan en vez de ir en 2 columnas */
  #form-lote > div[style*="grid-template-columns:1fr 1fr"],
  #form-lote div[style*="grid-template-columns:1fr 1fr"] {
    grid-template-columns: 1fr !important;
