<script>
function showModal(id){
  document.getElementById(id).style.display='flex';
  setTimeout(()=>{const f=document.querySelector('#'+id+' input:not([type=hidden])');if(f)f.focus();},100);
}
function hideModal(id){ document.getElementById(id).style.display='none'; }

// ── Acordeón de alertas (Vencidos / Por vencer / Stock bajo) ──
function toggleAcordeon(id) {
  const body = document.getElementById(id);
  const header = body.previousElementSibling;
  const chevron = header.querySelector('.acordeon-alerta-chevron');
  const yaAbierto = body.classList.contains('abierto');
  body.classList.toggle('abierto', !yaAbierto);
  if (chevron) chevron.classList.toggle('abierto', !yaAbierto);
}

// ── Menús desplegables del header ("Más opciones" y "Nuevo lote") ──
function toggleDesplegable(id) {
  const panel = document.getElementById(id);
  const yaAbierto = panel.style.display === 'block';
  cerrarDesplegables();
  if (!yaAbierto) panel.style.display = 'block';
}
function cerrarDesplegables() {
  document.querySelectorAll('.desplegable-croutons-panel').forEach(p => p.style.display = 'none');
}

// ── Pestañas Productos/Alertas (solo importan en celular, ver CSS) ──

document.addEventListener('click', (e) => {
  if (!e.target.closest('.desplegable-croutons')) cerrarDesplegables();
});

// ── Buscador de productos (filtra en el navegador, sin recargar) ──
function filtrarProductos() {
  const q = document.getElementById('buscador-productos').value.trim().toLowerCase();
  const categorias = document.querySelectorAll('.acordeon-categoria');
  let totalVisibles = 0;

  categorias.forEach(cat => {
    const filas = cat.querySelectorAll('.fila-producto');
    let visiblesCat = 0;
    filas.forEach(f => {
      const coincide = f.dataset.nombre.includes(q);
      f.style.display = coincide ? 'flex' : 'none';
      if (coincide) visiblesCat++;
    });
    cat.style.display = visiblesCat > 0 ? 'block' : 'none';
    totalVisibles += visiblesCat;

    // Con búsqueda activa, despliega solas las categorías que tienen
    // resultados — así no hay que ir abriendo una por una para encontrar algo.
    if (q) {
      const body = cat.querySelector('.acordeon-alerta-body');
      const chevron = cat.querySelector('.acordeon-alerta-chevron');
      if (visiblesCat > 0) {
        body.classList.add('abierto');
        if (chevron) chevron.classList.add('abierto');
      }
    }
  });

  const msgVacio = document.getElementById('mensaje-sin-resultados');
  if (msgVacio) msgVacio.style.display = (totalVisibles === 0 && categorias.length > 0) ? 'block' : 'none';
}

// ── Modal Cargar/Editar lote: mismo formulario, dos modos ──
function resetCategoriaLote() {
  const select = document.getElementById('input-categoria-lote');
  const nueva = document.getElementById('input-categoria-lote-nueva');
  select.name = 'categoria';
  select.style.display = '';
  select.value = '';
  nueva.name = '';
  nueva.value = '';
  nueva.style.display = 'none';
}

// Intercambia cuál de los dos campos (select o texto libre) es el que
// realmente se manda en el POST como "categoria" — nunca los dos a la vez.
function manejarCategoriaLote(select) {
  const nueva = document.getElementById('input-categoria-lote-nueva');
  if (select.value === '__nueva__') {
    select.name = '';
    nueva.name = 'categoria';
    nueva.style.display = 'block';
    nueva.focus();
  } else {
    select.name = 'categoria';
    nueva.name = '';
    nueva.value = '';
    nueva.style.display = 'none';
  }
}

function abrirNuevoLote() {
  const form = document.getElementById('form-lote');
  form.reset();
  resetCategoriaLote();
  form.action = '/croutons/lote/nuevo';
  document.getElementById('titulo-modal-lote').textContent = 'Cargar lote';
  document.getElementById('btn-guardar-lote').innerHTML = '<i class="ti ti-plus"></i> Agregar lote';
  document.getElementById('input-fecha-ingreso').value = new Date().toISOString().split('T')[0];
  document.getElementById('campo-codigo-barras').style.display = '';
  document.getElementById('bloque-escaner').style.display = '';
  showModal('modal-lote');
}

function abrirEditarLote(datos) {
  const form = document.getElementById('form-lote');
  form.reset();
  resetCategoriaLote();
  form.action = '/croutons/lote/' + datos.id + '/editar';
  document.getElementById('titulo-modal-lote').textContent = 'Editar lote';
  document.getElementById('btn-guardar-lote').innerHTML = '<i class="ti ti-device-floppy"></i> Guardar cambios';

  document.getElementById('input-producto').value = datos.producto || '';
  document.getElementById('input-cantidad').value = datos.cantidad || '';
  document.getElementById('input-unidad').value = datos.unidad || 'unidad';
  document.getElementById('input-peso').value = datos.peso || '';
  document.getElementById('input-unidad-peso').value = datos.unidad_peso || 'kg';
  document.getElementById('input-fecha-ingreso').value = datos.fecha_ingreso || '';
  document.getElementById('input-fecha-vencimiento').value = datos.fecha_vencimiento || '';
  document.getElementById('input-proveedor').value = datos.proveedor || '';
  document.getElementById('input-lote-proveedor').value = datos.lote_proveedor || '';
  document.getElementById('input-categoria-lote').value = datos.categoria || '';
  document.getElementById('input-notas').value = datos.notas || '';

  // El escáner ahora queda disponible también al editar — por ejemplo,
  // para asociarle un código de barras a un lote que se cargó a mano.
  document.getElementById('campo-codigo-barras').style.display = '';
  document.getElementById('bloque-escaner').style.display = '';

  showModal('modal-lote');
}

// ── Motivo de consumo (se pide antes de marcar un lote como consumido) ──
function abrirConsumirLote(id, producto) {
  document.getElementById('form-motivo-consumo').action = '/croutons/lote/' + id + '/consumir';
  document.getElementById('texto-motivo-consumo').textContent = '¿Por qué se consumió "' + producto + '"?';
  showModal('modal-motivo-consumo');
}

// ── Consumidos (papelera con restaurar) ──
async function abrirConsumidos() {
  showModal('modal-consumidos');
  const cont = document.getElementById('lista-consumidos');
  cont.innerHTML = '<p style="text-align:center;color:var(--gris-texto);font-size:0.82rem;padding:16px;">Cargando...</p>';

  try {
    const resp = await fetch('/croutons/consumidos');
    const data = await resp.json();
    if (!data.ok) throw new Error(data.error || 'Error');

    if (data.consumidos.length === 0) {
      cont.innerHTML = '<p style="text-align:center;color:var(--gris-texto);font-size:0.82rem;padding:16px;">No hay productos consumidos.</p>';
      return;
    }

    cont.innerHTML = data.consumidos.map(c => `
      <div style="background:var(--gris-fondo);border-radius:10px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px;" id="fila-consumido-${c.id}">
        <div style="min-width:0;">
          <p style="font-size:0.82rem;font-weight:600;color:var(--negro);margin:0 0 2px;">${c.producto} — ${c.cantidad} ${c.unidad}</p>
          <p style="font-size:0.72rem;color:var(--gris-texto);margin:0;">Consumido hace ${c.dias_transcurridos} día${c.dias_transcurridos !== 1 ? 's' : ''} · se borra en ${c.dias_restantes} día${c.dias_restantes !== 1 ? 's' : ''}${c.motivo_consumo ? ' · ' + c.motivo_consumo : ''}</p>
        </div>
        <button type="button" class="btn-secondary" style="flex-shrink:0;padding:7px 11px;font-size:0.72rem;" onclick="restaurarLote(${c.id})">
          <i class="ti ti-arrow-back-up"></i> Restaurar
        </button>
      </div>
    `).join('');
  } catch (e) {
    cont.innerHTML = '<p style="text-align:center;color:#dc2626;font-size:0.82rem;padding:16px;">No se pudo cargar la lista.</p>';
  }
}

async function restaurarLote(id) {
  try {
    const resp = await fetch('/croutons/lote/' + id + '/restaurar', { method: 'POST' });
    const data = await resp.json();
    if (data.ok) {
      window.location.reload();
    } else {
      alert('Error al restaurar: ' + (data.error || ''));
    }
  } catch (e) {
    alert('Error de conexión al restaurar.');
  }
}

// ── Catálogo: eliminar un producto (no borra lotes ya cargados con ese nombre) ──
async function eliminarProductoCatalogo(id, nombre) {
  if (!confirm(`¿Eliminar "${nombre}" del catálogo? Esto no borra los lotes ya cargados con ese nombre, solo la categoría y el mínimo configurados.`)) return;
  try {
    const resp = await fetch('/croutons/producto/' + id + '/eliminar', { method: 'POST' });
    const data = await resp.json();
    if (data.ok) {
      window.location.reload();
    } else {
      alert('No se pudo eliminar: ' + (data.error || ''));
    }
  } catch (e) {
    alert('Error de conexión al eliminar.');
  }
}

// ── Catálogo: alta rápida de un producto sin cargarle un lote todavía ──
async function agregarProductoCatalogo(evento) {
  evento.preventDefault();
  const input = document.getElementById('input-nuevo-producto-catalogo');
  const producto = input.value.trim();
  if (!producto) return false;

  try {
    const resp = await fetch('/croutons/producto/nuevo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ producto }),
    });
    const data = await resp.json();
    if (data.ok) {
      window.location.reload();
    } else {
      alert('No se pudo agregar: ' + (data.error || ''));
    }
  } catch (e) {
    alert('Error de conexión al agregar el producto.');
  }
  return false;
}

// ── Unidad por defecto (empaque habitual del producto) ──
async function guardarUnidad(producto, valor, i) {
  const estado = document.getElementById('estado-guardado-categoria-' + i);
  if (estado) estado.textContent = 'Guardando...';
  try {
    const resp = await fetch('/croutons/producto/unidad', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ producto, unidad_default: valor }),
    });
    const data = await resp.json();
    if (data.ok) {
      if (estado) estado.textContent = '✓ Guardado';
      setTimeout(() => { if (estado) estado.textContent = ''; }, 2000);
    } else {
      if (estado) estado.textContent = '';
      alert('No se pudo guardar: ' + (data.error || ''));
    }
  } catch (e) {
    if (estado) estado.textContent = '';
    alert('Error de conexión al guardar la unidad.');
  }
}

