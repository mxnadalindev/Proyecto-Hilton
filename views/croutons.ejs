// ── Stock mínimo (alerta de reposición) ──
const timersStockMinimo = {};
function ajustarStockMinimo(producto, i, delta) {
  const input = document.getElementById('input-stock-minimo-' + i);
  const actual = input.value === '' ? 0 : (parseInt(input.value, 10) || 0);
  const nuevo = Math.max(0, actual + delta);
  input.value = nuevo;

  // No guarda ni recarga en cada click — si no, con la recarga automática
  // de guardarStockMinimo nunca se podría llegar al número deseado
  // tocando varias veces seguidas. Espera una pausa de 700ms sin más
  // clicks antes de guardar de verdad.
  const estado = document.getElementById('estado-guardado-minimo-' + i);
  if (estado) estado.textContent = '';
  clearTimeout(timersStockMinimo[i]);
  timersStockMinimo[i] = setTimeout(() => {
    guardarStockMinimo(producto, nuevo, i);
  }, 700);
}

async function guardarStockMinimo(producto, valor, i) {
  const estado = document.getElementById('estado-guardado-minimo-' + i);
  if (estado) estado.textContent = 'Guardando...';
  try {
    const resp = await fetch('/croutons/producto/minimo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ producto, stock_minimo: valor }),
    });
    const data = await resp.json();
    if (data.ok) {
      if (estado) estado.textContent = '✓ Guardado, actualizando...';
      // Recarga para que las tarjetas de arriba (Stock bajo, badges, panel
      // de alertas) se recalculen ya con el nuevo mínimo — se arman en el
      // servidor, no se recalculan solas en el navegador. Al usarse desde
      // tablet, más vale ver el resultado reflejado ya, aunque se pierda
      // el modal abierto.
      setTimeout(() => { window.location.reload(); }, 500);
    } else {
      if (estado) estado.textContent = '';
      alert('No se pudo guardar: ' + (data.error || ''));
    }
  } catch (e) {
    if (estado) estado.textContent = '';
    alert('Error de conexión al guardar el mínimo.');
  }
}

const geminiConfigurado = <%= geminiConfigurado ? 'true' : 'false' %>;

function esImagen(nombreArchivo) {
  return /\.(jpe?g|png|gif|webp|heic|bmp)$/i.test(nombreArchivo);
}

function detectarTipoArchivoCroutons(input) {
  const label      = input.closest('.input-archivo');
  const nombreSpan = document.getElementById('nombre-archivo-croutons');
  const provInput  = document.getElementById('input-proveedor-csv');
  const textoBoton = document.getElementById('texto-carga-croutons');

  if (!input.files || !input.files[0]) {
    nombreSpan.textContent = 'Elegir archivo';
    label.classList.remove('input-archivo-ok');
    return;
  }

  const archivo = input.files[0];
  nombreSpan.textContent = archivo.name;
  label.classList.add('input-archivo-ok');

  if (esImagen(archivo.name)) {
    provInput.style.display = 'none';
    textoBoton.textContent = 'Subir';
  } else {
    provInput.style.display = '';
    textoBoton.textContent = 'Importar';
  }
}

function prepararEnvioCroutons() {
  const form     = document.getElementById('form-carga-croutons');
  const input    = document.getElementById('input-croutons');
  const provInput = document.getElementById('input-proveedor-csv');
  const btn      = document.getElementById('btn-carga-croutons');
  const icon     = document.getElementById('icon-carga-croutons');
  const texto    = document.getElementById('texto-carga-croutons');

  if (!input.files || !input.files[0]) {
    alert('Primero tenés que elegir un archivo — una foto del remito o el catálogo del proveedor.');
    return false;
  }
  const archivo = input.files[0];

  if (esImagen(archivo.name)) {
    if (!geminiConfigurado) {
      alert('La lectura de fotos todavía no está configurada. Usá el catálogo en su lugar, o cargá el lote a mano.');
      return false;
    }
    form.action = '/croutons/remito';
    input.name = 'remito';
    provInput.name = '';
    texto.textContent = 'Analizando remito...';
  } else {
    form.action = '/croutons/importar';
    input.name = 'archivo_croutons';
    provInput.name = 'proveedor_csv';
    texto.textContent = 'Importando...';
  }

  btn.disabled = true;
  input.style.pointerEvents = 'none';
  icon.className = 'ti ti-loader-2 girando';
  return true;
}

// ── Escáner de código de barras (cámara del dispositivo) ──
let escanerActivo = null;

function abrirEscaner() {
  document.getElementById('btn-abrir-escaner').style.display = 'none';
  document.getElementById('escaner-visor').style.display = 'block';
  document.getElementById('btn-cerrar-escaner').style.display = 'block';
  ocultarEstadoEscaner();

  escanerActivo = new Html5Qrcode('escaner-visor');
  const config = {
    fps: 10,
    qrbox: { width: 260, height: 140 },
    // Sin "formatsToSupport": así la librería intenta reconocer CUALQUIER
    // formato de código (barras o QR), en vez de limitarse a una lista fija.
    // Restringir formatos puede hacer que se le escapen variantes válidas.
  };

  escanerActivo.start(
    { facingMode: 'environment' },
    config,
    onCodigoDetectado,
    () => {}
  ).catch(err => {
    mostrarEstadoEscaner('No se pudo abrir la cámara. Revisá los permisos del navegador/tablet.', 'error');
    cerrarEscaner();
    console.error('Error abriendo cámara:', err);
  });
}

async function onCodigoDetectado(codigoDecodificado) {
  if (escanerActivo) {
    try { await escanerActivo.stop(); } catch (e) {}
  }

  mostrarEstadoEscaner('Código detectado: ' + codigoDecodificado + ' — buscando...', 'info');

  // Un código de barras tradicional (EAN/UPC) es solo números. Si lo
  // escaneado tiene letras, es un QR armado a mano con el nombre del
  // producto como texto — no es un código de barras real, así que ese
  // campo se deja vacío y solo se completa "Producto".
  const pareceTexto = /[a-zA-ZñÑáéíóúÁÉÍÓÚ]/.test(codigoDecodificado);
  if (!pareceTexto) {
    document.getElementById('input-codigo-barras').value = codigoDecodificado;
  }

  try {
    const resp = await fetch('/croutons/productos/buscar?codigo=' + encodeURIComponent(codigoDecodificado));
    const data = await resp.json();

    if (data.encontrado) {
      // Si ya está en el catálogo, el código guardado es el que corresponde
      // a ese producto (numérico o texto), así que sí se muestra.
      document.getElementById('input-codigo-barras').value = codigoDecodificado;
      document.getElementById('input-producto').value = data.producto.nombre;
      if (data.producto.unidad_default) {
        document.getElementById('input-unidad').value = data.producto.unidad_default;
      }
      mostrarEstadoEscaner('✓ Producto reconocido: ' + data.producto.nombre, 'ok');
    } else if (pareceTexto) {
      document.getElementById('input-producto').value = codigoDecodificado;
      mostrarEstadoEscaner('Se completó "Producto" con el texto leído. Revisalo y corregilo si hace falta.', 'info');
    } else {
      mostrarEstadoEscaner('Código nuevo — no está en el catálogo todavía. Escribí el nombre y se va a guardar para la próxima vez.', 'info');
      document.getElementById('input-producto').focus();
    }
  } catch (e) {
    if (!pareceTexto) document.getElementById('input-codigo-barras').value = codigoDecodificado;
    mostrarEstadoEscaner('No se pudo consultar el catálogo, pero el código quedó cargado. Completá el nombre a mano.', 'error');
  }

  cerrarEscanerVisor();
}

function mostrarEstadoEscaner(texto, tipo) {
  const el = document.getElementById('escaner-estado');
  const colores = {
    ok:    { bg: '#f0fdf4', border: '#bbf7d0', color: '#16a34a' },
    info:  { bg: 'var(--azul-claro)', border: 'var(--azul-borde)', color: 'var(--azul)' },
    error: { bg: '#fef2f2', border: '#fecaca', color: '#dc2626' },
  }[tipo] || {};
  el.style.display = 'block';
  el.style.background = colores.bg;
  el.style.border = '1px solid ' + colores.border;
  el.style.color = colores.color;
  el.textContent = texto;
}

function ocultarEstadoEscaner() {
  const el = document.getElementById('escaner-estado');
  el.style.display = 'none';
  el.textContent = '';
}

function cerrarEscanerVisor() {
  document.getElementById('escaner-visor').style.display = 'none';
  document.getElementById('btn-cerrar-escaner').style.display = 'none';
  document.getElementById('btn-abrir-escaner').style.display = 'block';
  document.getElementById('btn-abrir-escaner').innerHTML = '<i class="ti ti-barcode"></i> Escanear otro código';
}

function cerrarEscaner() {
  if (escanerActivo) {
    escanerActivo.stop().catch(() => {}).finally(() => { escanerActivo = null; });
  }
  cerrarEscanerVisor();
  ocultarEstadoEscaner();
}

document.getElementById('modal-lote')?.addEventListener('click', (e) => {
  if (e.target.id === 'modal-lote') cerrarEscaner();
});

// ── Notificaciones push (avisos de vencimiento en tiempo real) ──
const CANAL_AVISOS = 'croutons';

function urlBase64ToUint8Array(base64String) {
  const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  const raw = atob(base64);
  return Uint8Array.from([...raw].map(c => c.charCodeAt(0)));
}

async function actualizarBotonAvisos(activo) {
  const icon = document.getElementById('icon-avisos');
  const texto = document.getElementById('texto-avisos');
  const btn = document.getElementById('btn-avisos');
  if (activo) {
    icon.className = 'ti ti-bell-ringing';
    texto.textContent = 'Avisos activados';
    btn.style.background = '#f0fdf4';
    btn.style.borderColor = '#bbf7d0';
    btn.style.color = '#16a34a';
  } else {
    icon.className = 'ti ti-bell';
    texto.textContent = 'Activar avisos';
    btn.style.background = '';
    btn.style.borderColor = '';
    btn.style.color = '';
  }
}

async function toggleAvisos() {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
    alert('Este navegador no soporta notificaciones push.');
    return;
  }

  const btn = document.getElementById('btn-avisos');
  btn.disabled = true;

  try {
    const registro = await navigator.serviceWorker.ready;
    const suscripcionActual = await registro.pushManager.getSubscription();

    if (suscripcionActual) {
      await fetch('/push/desuscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: suscripcionActual.endpoint }),
      });
      await suscripcionActual.unsubscribe();
      actualizarBotonAvisos(false);
      return;
    }

    const permiso = await Notification.requestPermission();
    if (permiso !== 'granted') {
      alert('No se activaron los avisos — hace falta aceptar el permiso de notificaciones.');
      return;
    }

    const resp = await fetch('/push/vapid-public-key');
    const { publicKey } = await resp.json();
    if (!publicKey) {
      alert('Los avisos push todavía no están configurados del lado del servidor.');
      return;
    }

    const nuevaSuscripcion = await registro.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(publicKey),
    });

    await fetch('/push/suscribir', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...nuevaSuscripcion.toJSON(), canal: CANAL_AVISOS }),
    });

    actualizarBotonAvisos(true);
  } catch (e) {
    console.error('Error activando/desactivando avisos:', e);
    alert('No se pudo cambiar el estado de los avisos.');
  } finally {
    btn.disabled = false;
  }
}

(async () => {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
  try {
    const registro = await navigator.serviceWorker.ready;
    const suscripcion = await registro.pushManager.getSubscription();
    actualizarBotonAvisos(!!suscripcion);
  } catch (e) { /* silencioso, no rompe el resto de la página */ }
})();

// ── Notificación local al entrar (como FreshGuard) ──
// A diferencia del push (que depende de un bot corriendo en el servidor,
// aunque no tengas la página abierta), esto se dispara SOLO ACÁ, apenas se
// abre esta pantalla — no necesita servidor aparte, ni bot programado, y
// funciona hasta en localhost sin HTTPS.
//
// IMPORTANTE: se muestra a través del Service Worker (registration.
// showNotification), no con "new Notification()" directo — en Chrome
// Android (y la mayoría de navegadores mobile) crear la notificación
// directo desde la página está bloqueado y falla en silencio. Pasando por
// el Service Worker funciona igual en celular y en PC.
//
// Una notificación POR PRODUCTO (no una sola con todos juntos), y se
// guarda en localStorage la fecha del último aviso para no repetirlas
// cada vez que se recarga la página en el mismo día.
async function mostrarAlertaLocalAlEntrar() {
  if (!('serviceWorker' in navigator) || !('Notification' in window)) return;
  if (Notification.permission !== 'granted') return;

  const items = <%- JSON.stringify(
    [
      ...vencidos.map(l => ({ producto: l.producto, cuerpo: `Vencido hace ${Math.abs(l.dias_para_vencer)} día(s)` })),
      ...porVencer.map(l => ({ producto: l.producto, cuerpo: l.dias_para_vencer === 0 ? 'Vence hoy' : `Vence en ${l.dias_para_vencer} día(s)` })),
      ...productosStockBajo.map(p => ({ producto: p.producto, cuerpo: `Stock bajo — quedan ${p.stockActual}, mínimo ${p.stockMinimo}` })),
    ]
  ) %>;
  if (items.length === 0) return;

  const hoy = new Date().toISOString().split('T')[0];
  const claveStorage = 'croutons_alerta_local_mostrada';
  if (localStorage.getItem(claveStorage) === hoy) return; // ya se avisó hoy

  try {
    const registro = await navigator.serviceWorker.ready;
    items.forEach((item, i) => {
      registro.showNotification(`Croutons — ${item.producto}`, {
        body: item.cuerpo,
        icon: '/img/BUEHI_K_RGB (1).png',
        tag: 'croutons-alerta-' + i, // cada una queda separada, no se pisan entre sí
      });
    });
    localStorage.setItem(claveStorage, hoy);
  } catch (e) {
    console.error('No se pudieron mostrar las alertas locales:', e);
  }
}
mostrarAlertaLocalAlEntrar();
</script>
