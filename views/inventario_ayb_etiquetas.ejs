<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Etiquetas QR — Inventario AYB</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
  <style>
    /* Botón "chico" (32px), mismo molde que el resto de la aplicación. */
    .btn-chico-azul,.btn-chico-verde{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all .2s;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border:none;}
    .btn-chico-azul{background:rgba(0,47,97,0.12);color:#002f61;border:1px solid rgba(0,47,97,0.28);}
    .btn-chico-azul:hover{background:rgba(0,47,97,0.20);}
    .btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
    .btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
    body{background:var(--gris-fondo);}
    .etiquetas-barra{display:flex;justify-content:space-between;align-items:center;padding:16px 24px;background:var(--blanco);border-bottom:1px solid var(--gris-borde);}
    .etiquetas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;padding:24px;}
    .etiqueta{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:14px;text-align:center;break-inside:avoid;}
    .etiqueta img{width:100%;max-width:150px;height:auto;margin:0 auto 8px;display:block;}
    .etiqueta p{margin:0;font-size:0.78rem;font-weight:600;color:var(--negro);}
    .etiqueta span{font-size:0.66rem;color:var(--gris-texto);}
    @media print {
      .etiquetas-barra{display:none;}
      .etiquetas-grid{padding:0;}
      .etiqueta{border:1px dashed #999;}
    }
  </style>
</head>
<body>
  <div class="etiquetas-barra">
    <div>
      <p style="font-family:var(--font-serif);font-size:1.2rem;font-weight:400;margin:0;">Etiquetas QR — Inventario AYB</p>
      <p style="font-size:0.75rem;color:var(--gris-texto);margin:2px 0 0;">Escaneá una con el celular para ajustar rápido el stock de ese producto.</p>
    </div>
    <div style="display:flex;gap:10px;">
      <a href="/inventario-ayb" class="btn-chico-azul"><i class="ti ti-arrow-left"></i> Volver</a>
      <button onclick="window.print()" class="btn-chico-verde"><i class="ti ti-printer"></i> Imprimir</button>
    </div>
  </div>

  <% if (productos.length === 0) { %>
  <div style="padding:40px;text-align:center;color:var(--gris-texto);">No hay productos activos todavía.</div>
  <% } else { %>
  <div class="etiquetas-grid">
    <% productos.forEach(p => {
      const url = origen + '/inventario-ayb/producto/' + p.id + '/ajustar';
      const qrSrc = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(url);
    %>
    <div class="etiqueta">
      <img src="<%= qrSrc %>" alt="QR <%= p.nombre %>" loading="lazy">
      <p><%= p.nombre %></p>
      <% if (p.categoria) { %><span><%= p.categoria %></span><% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
</body>
</html>
