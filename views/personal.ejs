<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Miembro de equipo — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
<div class="app-layout">
  <% var path = 'personal'; %>
  <%- include('partials/nav', { path: path }) %>

  <main class="main-content">

    <% if (msg === 'empleado_editado') { %>
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#16a34a;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-check"></i> Empleado actualizado.
    </div>
    <% } %>
    <% if (msg === 'mozos_importados') { %>
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#16a34a;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-check"></i> Se cargaron <%= cargadosMozos %> mozo<%= cargadosMozos != 1 ? 's' : '' %><% if (duplicadosMozos > 0) { %> (<%= duplicadosMozos %> ya existían por CUIL y se saltearon)<% } %>.
    </div>
    <% } %>
    <% if (msg && msg !== 'empleado_editado' && msg !== 'mozos_importados') { %>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#dc2626;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-alert-circle"></i> <%= msg %>
    </div>
    <% } %>

    <% if (typeof mozosVencidos !== 'undefined' && (mozosVencidos.length > 0 || mozosPorVencer.length > 0)) { %>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px 16px;margin-bottom:20px;font-size:0.82rem;color:#991b1b;">
      <div style="display:flex;align-items:center;gap:8px;font-weight:600;margin-bottom:<%= (mozosVencidos.length + mozosPorVencer.length) ? '8px' : '0' %>;">
        <i class="ti ti-alert-triangle"></i> Límite de 6 meses de mozos eventuales
      </div>
      <% mozosVencidos.forEach(p => { %>
        <div style="padding:3px 0;">• <strong><%= p.nombre %></strong> superó su límite de 6 meses hace <%= Math.abs(p.dias_para_vencer_mozo) %> día<%= Math.abs(p.dias_para_vencer_mozo) !== 1 ? 's' : '' %> (venció el <%= new Date(p.fecha_vencimiento_mozo).toLocaleDateString('es-AR') %>).</div>
      <% }) %>
      <% mozosPorVencer.forEach(p => { %>
        <div style="padding:3px 0;">• <strong><%= p.nombre %></strong> llega a los 6 meses en <%= p.dias_para_vencer_mozo %> día<%= p.dias_para_vencer_mozo !== 1 ? 's' : '' %> (<%= new Date(p.fecha_vencimiento_mozo).toLocaleDateString('es-AR') %>).</div>
      <% }) %>
    </div>
    <% } %>

    <% if (typeof mesFiltro !== 'undefined' && mesFiltro) {
         const MESES_NOMBRE = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
         const [anioFiltro, mesNumFiltro] = mesFiltro.split('-');
    %>
    <div style="background:var(--azul-claro);border:1px solid var(--azul);border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:var(--azul);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <span><i class="ti ti-filter"></i> Mostrando solo a los mozos con algo cargado en <%= MESES_NOMBRE[parseInt(mesNumFiltro,10)-1] %> de <%= anioFiltro %> (disponibilidad y/o eventos).</span>
      <a href="/personal" style="color:var(--azul);text-decoration:underline;white-space:nowrap;">Ver a todo el equipo</a>
    </div>
    <% } %>

    <!-- Header -->
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Portal interno</p>
        <h1 class="seccion-titulo">Miembro de equipo</h1>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href="/inicio" class="btn-secondary"><i class="ti ti-home"></i> Menú principal</a>
        <a href="/horarios?inicio=<%= inicio %>&fin=<%= fin %>" class="btn-secondary"><i class="ti ti-clock"></i> Ver en Horarios</a>
        <% if (esAdmin) { %>
        <% if (misDepto === 'ayb') { %>
        <button onclick="showModal('modal-importar-mozos')" class="btn-secondary"><i class="ti ti-file-upload"></i> Importar mozos (CSV)</button>
        <button onclick="showModal('modal-importar-mozos-foto')" class="btn-secondary"><i class="ti ti-camera"></i> Cargar con foto</button>
        <% } %>
        <button onclick="showModal('modal-nuevo')" class="btn-primary"><i class="ti ti-plus"></i> Nuevo empleado</button>
        <% } %>
      </div>
    </div>

    <!-- Selector de rango con calendario (Cocina/admin general) -->
    <% if (misDepto !== 'ayb') { %>
    <div style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:16px;padding:20px;margin-bottom:20px;box-shadow:var(--sombra);display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap;">

      <!-- Calendario -->
      <div id="cal-container" style="min-width:280px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <button onclick="calMes(-1)" style="background:none;border:1px solid var(--gris-borde);border-radius:8px;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gris-texto);font-size:16px;">&#8249;</button>
          <span id="cal-titulo" style="font-size:0.9rem;font-weight:600;color:var(--negro);"></span>
          <button onclick="calMes(1)" style="background:none;border:1px solid var(--gris-borde);border-radius:8px;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gris-texto);font-size:16px;">&#8250;</button>
        </div>
        <div id="cal-grid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center;"></div>
        <p style="font-size:0.65rem;color:var(--gris-texto);margin:10px 0 0;text-align:center;">Elegí el día de inicio y después el día de fin.</p>
      </div>

      <!-- Rango seleccionado -->
      <div style="flex:1;">
        <p style="font-size:0.68rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--gris-texto);margin:0 0 8px;">Rango seleccionado</p>
        <p id="semana-label" style="font-size:1.1rem;font-weight:600;color:var(--negro);margin:0 0 12px;"></p>
        <div id="semana-dias" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;"></div>
        <a id="btn-ir-semana" href="/personal?inicio=<%= inicio %>&fin=<%= fin %>" class="btn-primary" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:12px;">
          <i class="ti ti-calendar-check"></i> Cargar este rango
        </a>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <% const leyenda = [{v:'OFF',c:'#fbbf24'},{v:'VAC',c:'#dc2626'},{v:'RECOFF',c:'#22c55e'},{v:'LIBRE',c:'#dc2626'},{v:'ART',c:'#dc2626'},{v:'LICENCIA',c:'#dc2626'},{v:'CUMPLE',c:'#dc2626'},{v:'MUDANZA',c:'#dc2626'}]; %>
          <% leyenda.forEach(l => { %>
          <span style="font-size:0.65rem;font-weight:700;background:<%= l.c %>;border:1px solid <%= l.c %>;color:#fff;padding:3px 11px;border-radius:20px;"><%= l.v %></span>
          <% }) %>
        </div>
      </div>
    </div>
    <% } else { %>
    <!-- AYB: sin selector de estados — solo navegación de período para ver la disponibilidad cargada -->
    <div style="display:flex;align-items:center;justify-content:space-between;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:14px 20px;margin-bottom:20px;box-shadow:var(--sombra);">
      <a href="/personal?inicio=<%= rangoAnterior.inicio %>&fin=<%= rangoAnterior.fin %>" class="btn-secondary" style="padding:6px 14px;">
        <i class="ti ti-chevron-left"></i> Período anterior
      </a>
      <div style="text-align:center;">
        <p style="font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--gris-texto);margin:0 0 2px;">Período</p>
        <p style="font-size:0.95rem;font-weight:600;color:var(--negro);margin:0;">
          <%= new Date(dias[0]+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'long'}) %> — <%= new Date(dias[dias.length-1]+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'long',year:'numeric'}) %>
        </p>
      </div>
      <a href="/personal?inicio=<%= rangoSiguiente.inicio %>&fin=<%= rangoSiguiente.fin %>" class="btn-secondary" style="padding:6px 14px;">
        Período siguiente <i class="ti ti-chevron-right"></i>
      </a>
    </div>
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#1d4ed8;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-info-circle"></i> Esto se arma solo con lo que cada mozo carga en Horarios — no se edita desde acá.
    </div>
    <% } %>

    <!-- Buscador -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
      <div style="position:relative;flex:1;min-width:200px;max-width:300px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <input type="text" id="buscadorPersonal" placeholder="Buscar por nombre..." oninput="buscarPersonal()"
               style="width:100%;padding:8px 12px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
      </div>
      <label style="font-size:0.75rem;color:var(--gris-texto);display:flex;align-items:center;gap:6px;cursor:pointer;">
        <input type="checkbox" id="mostrarInactivos" onchange="filtrarPersonal()" style="accent-color:var(--azul);width:16px;height:16px;">
        Mostrar dados de baja
      </label>
      <span id="contadorActivos" style="font-size:0.72rem;color:var(--gris-texto);"></span>
    </div>

    <!-- Tabla -->
    <div class="tabla-wrap" style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
      <table class="tabla" style="width:100%;min-width:<%= misDepto === 'ayb' ? '1250' : '1050' %>px;table-layout:fixed;">
        <colgroup>
          <% if (misDepto === 'ayb') { %>
          <col style="width:16%"><col style="width:10%"><col style="width:11%"><col style="width:9%">
          <col style="width:46%"><col style="width:8%">
          <% } else { %>
          <!-- "Horas del mes" es un concepto de AYB (seguimiento de horas de
               eventos, sobre todo para mozos Eventual) — no aplica a Cocina,
               esa columna no existe acá. En cambio sí van Puesto/Sector/
               RECOFF, que son de Cocina — se habían perdido de esta tabla
               en un cambio anterior y se restauran a pedido. -->
          <col style="width:15%"><col style="width:10%"><col style="width:12%"><col style="width:8%">
          <col style="width:47%"><col style="width:8%">
          <% } %>
        </colgroup>
        <thead>
          <tr>
            <th>Nombre</th>
            <% if (misDepto === 'ayb') { %>
            <th>Horas del mes</th>
            <th>Vencimiento <span style="font-weight:400;font-size:0.62rem;">(mozos Eventual)</span></th>
            <th>Días trabajados</th>
            <th>Disponibilidad <span style="font-weight:400;font-size:0.62rem;">(cargada por cada mozo en Horarios)</span></th>
            <% } else { %>
            <th>Puesto</th>
            <th>Sector</th>
            <th>RECOFF</th>
            <th>Estados por día <span style="font-weight:400;font-size:0.62rem;">(clickeá cada día para cambiarlo)</span></th>
            <% } %>
            <th></th>
          </tr>
        </thead>
        <tbody id="tbody-personal">
          <% if (personal.length > 0) { %>
            <% personal.forEach(p => { %>
            <%
              const horariosEmp = horarioSemanalMap[p.id] || {};
              const sectoresEmp = sectorDiaMap[p.id] || {};
              let horaActual = '';
              let estadoActual = '';
              const ESTADOS_LIST = ['OFF','VAC','RECOFF','FERIADO','LICENCIA','CUMPLE','MUDANZA','FRANCO'];
              const francosActuales = [];
              dias.forEach(dia => {
                const val = (horariosEmp[dia] || '').toUpperCase();
                if (val === 'FRANCO') { francosActuales.push(dia); }
                else if (ESTADOS_LIST.includes(val)) { if (!estadoActual) estadoActual = val; }
                else if (val && !horaActual) { horaActual = horariosEmp[dia]; }
              });
              const bgEstados = {OFF:'#fbbf24',VAC:'#dc2626',RECOFF:'#22c55e',LIBRE:'#dc2626',FERIADO:'#dc2626',ART:'#dc2626',LICENCIA:'#dc2626',CUMPLE:'#dc2626',MUDANZA:'#dc2626',FRANCO:'#64748b'};
              const bgActual = estadoActual ? bgEstados[estadoActual] : '';
              const NOMBRES_DIA_CORTO = {0:'D',1:'L',2:'M',3:'M',4:'J',5:'V',6:'S'};
            %>
            <tr class="fila-empleado <%= p.activo ? 'fila-activo' : 'fila-inactivo' %>"
                style="<%= p.activo ? '' : 'display:none;' %><%= bgActual ? `background:${bgActual}11;` : '' %>">

              <td>
                <div style="display:flex;align-items:center;gap:8px;overflow:hidden;">
                  <div style="width:30px;height:30px;border-radius:50%;background:<%= p.activo?'var(--azul-claro)':'var(--gris-fondo)' %>;color:<%= p.activo?'var(--azul)':'var(--gris-texto)' %>;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:600;flex-shrink:0;">
                    <%= p.nombre.charAt(0).toUpperCase() %>
                  </div>
                  <span style="font-size:0.8rem;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.nombre %></span>
                </div>
              </td>

              <% if (misDepto !== 'ayb') { %>
              <td>
                <span style="font-size:0.78rem;color:var(--negro);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.puesto || '—' %></span>
              </td>
              <td>
                <span style="display:inline-block;font-size:0.68rem;font-weight:600;color:var(--azul);background:var(--azul-claro);padding:3px 9px;border-radius:999px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;"><%= p.departamento || '—' %></span>
              </td>
              <td>
                <div style="display:flex;align-items:center;gap:4px;">
                  <button type="button" onclick="ajustarRecoff(<%= p.id %>, -1)" style="width:22px;height:22px;border-radius:6px;border:1px solid var(--gris-borde);background:var(--blanco);color:var(--gris-texto);cursor:pointer;font-size:0.8rem;line-height:1;display:flex;align-items:center;justify-content:center;">−</button>
                  <span id="recoff-<%= p.id %>" style="font-size:0.8rem;font-weight:700;color:var(--negro);min-width:16px;text-align:center;"><%= p.recoff_pendiente_real %></span>
                  <button type="button" onclick="ajustarRecoff(<%= p.id %>, 1)" style="width:22px;height:22px;border-radius:6px;border:1px solid var(--gris-borde);background:var(--blanco);color:var(--gris-texto);cursor:pointer;font-size:0.8rem;line-height:1;display:flex;align-items:center;justify-content:center;">+</button>
                </div>
              </td>
              <% } %>

              <% if (misDepto === 'ayb') { %>
              <td>
                <div style="font-size:0.85rem;font-weight:700;color:var(--negro);"><%= p.horas_mes_actual %>hs</div>
                <div style="font-size:0.6rem;color:var(--gris-texto);margin-top:2px;">este mes</div>
                <% if (p.modalidad) { %>
                <div style="font-size:0.62rem;color:var(--gris-texto);margin-top:4px;white-space:nowrap;">
                  <a href="/personal/<%= p.id %>/horas" style="color:inherit;text-decoration:underline;">
                    <%= p.eventos_trabajados %> evento<%= p.eventos_trabajados !== 1 ? 's' : '' %> trabajado<%= p.eventos_trabajados !== 1 ? 's' : '' %>
                  </a>
                </div>
                <% } %>
              </td>
              <td>
                <% if (typeof p.dias_para_vencer_mozo === 'number') { %>
                  <span style="font-size:0.75rem;color:<%= p.dias_para_vencer_mozo < 0 ? '#dc2626' : (p.dias_para_vencer_mozo <= 15 ? '#b45309' : 'var(--negro)') %>;font-weight:<%= p.dias_para_vencer_mozo <= 15 ? '700' : '400' %>;white-space:nowrap;">
                    <%= p.dias_para_vencer_mozo < 0 ? 'Venció hace ' + Math.abs(p.dias_para_vencer_mozo) + 'd' : 'Vence en ' + p.dias_para_vencer_mozo + 'd' %>
                  </span>
                  <div style="font-size:0.6rem;color:var(--gris-texto);margin-top:2px;"><%= new Date(p.fecha_vencimiento_mozo+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %></div>
                <% } else if (p.modalidad === 'Eventual') { %>
                  <span style="font-size:0.7rem;font-style:italic;color:var(--gris-texto);">Sin fecha de alta</span>
                <% } else { %>
                  <span style="font-size:0.72rem;color:var(--gris-texto);">—</span>
                <% } %>
              </td>
              <td>
                <span style="font-size:0.85rem;font-weight:700;color:var(--negro);"><%= p.dias_trabajados_mes %></span>
                <div style="font-size:0.6rem;color:var(--gris-texto);margin-top:2px;">día<%= p.dias_trabajados_mes !== 1 ? 's' : '' %> este mes</div>
              </td>
              <% } %>

              <td>
                <% if (p.departamento === 'ayb') { %>
                <%
                  // AYB no carga estados a mano acá — esto es de solo lectura,
                  // arma lo que cada mozo cargó en Horarios (su propia
                  // disponibilidad). La grilla de estados de arriba es un
                  // concepto de Cocina, no aplica.
                  const dispEmp = dispMap[p.id] || {};
                %>
                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                  <% dias.forEach((dia) => { %>
                  <%
                    const _dow = new Date(dia + 'T00:00:00').getDay();
                    const _numDia = new Date(dia + 'T00:00:00').getDate();
                    const _d = dispEmp[dia];
                    let _texto = 'Sin cargar', _bg = 'var(--gris-fondo)', _color = 'var(--gris-texto)', _border = 'var(--gris-borde)';
                    if (_d) {
                      if (_d.disponible) {
                        _texto = _d.hora_hasta ? `${_d.hora_desde}-${_d.hora_hasta}` : `Desde ${_d.hora_desde}`;
                        _bg = '#f0fdf4'; _color = '#16a34a'; _border = '#bbf7d0';
                      } else {
                        _texto = 'No disp.';
                        _bg = '#fef2f2'; _color = '#dc2626'; _border = '#fecaca';
                      }
                    }
                  %>
                  <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                    <span style="font-size:0.56rem;color:var(--gris-texto);font-weight:600;white-space:nowrap;"><%= NOMBRES_DIA_CORTO[_dow] %> <%= _numDia %></span>
                    <span style="width:64px;text-align:center;font-size:0.58rem;font-weight:600;background:<%= _bg %>;color:<%= _color %>;border:1px solid <%= _border %>;border-radius:5px;padding:3px 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= _texto %></span>
                  </div>
                  <% }) %>
                </div>
                <% } else if (p.activo) { %>
                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                  <% dias.forEach((dia) => { %>
                  <%
                    const _dow = new Date(dia + 'T00:00:00').getDay();
                    const _numDia = new Date(dia + 'T00:00:00').getDate();
                    const _valDia = (horariosEmp[dia] || '').toUpperCase();
                    const _esEstadoDia = ESTADOS_LIST.includes(_valDia);
                    const _bgDia = _esEstadoDia ? bgEstados[_valDia] : '';
                    const _horaDia = (!_esEstadoDia && horariosEmp[dia]) ? horariosEmp[dia] : '';
                  %>
                  <label style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                    <span style="font-size:0.56rem;color:var(--gris-texto);font-weight:600;white-space:nowrap;"><%= NOMBRES_DIA_CORTO[_dow] %> <%= _numDia %></span>
                    <input type="text" class="hora-dia-<%= p.id %> hora-dia-input" data-fecha="<%= dia %>"
                           value="<%= _horaDia %>" placeholder="Hs" maxlength="6" <%= _esEstadoDia ? 'disabled' : '' %>
                           style="width:64px;padding:2px 4px;border:1px solid var(--gris-borde);border-radius:5px;font-size:0.6rem;font-family:var(--font-sans);outline:none;text-align:center;background:<%= _esEstadoDia ? '#f1f5f9' : 'var(--gris-fondo)' %>;color:var(--negro);">
                    <select class="sel-estado-<%= p.id %> sel-dia-estado" data-fecha="<%= dia %>" onchange="onCambioEstadoDia(this, <%= p.id %>)"
                            style="background-color:<%= _bgDia ? _bgDia : 'var(--gris-fondo)' %>;border:1px solid <%= _bgDia ? _bgDia : 'var(--gris-borde)' %>;color:<%= _bgDia ? '#fff' : 'var(--negro)' %>;font-weight:<%= _bgDia ? '700' : '400' %>;">
                      <option value="" style="background:var(--blanco);color:var(--negro);">Normal</option>
                      <% ['OFF','VAC','RECOFF','LIBRE','ART','LICENCIA','CUMPLE','MUDANZA'].forEach(e => { %>
                      <option value="<%= e %>" <%= _valDia === e ? 'selected' : '' %>
                              style="background:<%= bgEstados[e] %>;color:#fff;font-weight:700;"><%= e %></option>
                      <% }) %>
                    </select>
                    <select class="sel-sector-<%= p.id %> sel-sector-dia" data-fecha="<%= dia %>" onchange="onCambioSectorDia(this)"
                            title="Cambiar de sector solo este día, sin tocar su sector general"
                            style="width:64px;font-size:0.56rem;padding:1px 2px;border:1px solid var(--gris-borde);border-radius:5px;background:<%= sectoresEmp[dia] ? 'var(--azul-claro)' : 'var(--gris-fondo)' %>;color:<%= sectoresEmp[dia] ? 'var(--azul)' : 'var(--gris-texto)' %>;font-weight:<%= sectoresEmp[dia] ? '700' : '400' %>;">
                      <option value="">— sector —</option>
                      <% sectores.forEach(s => { %>
                      <option value="<%= s %>" <%= sectoresEmp[dia] === s ? 'selected' : '' %>><%= s %></option>
                      <% }) %>
                    </select>
                  </label>
                  <% }) %>
                </div>
                <% } %>
              </td>

              <td style="text-align:center;position:relative;vertical-align:middle;">
                <% if (p.activo && p.departamento !== 'ayb') { %>
                <button onclick="guardarEmpleado(<%= p.id %>)"
                        class="btn-asignar" title="Guardar rango" style="margin-bottom:4px;display:block;margin:0 auto 4px;">
                  <i class="ti ti-check"></i>
                </button>
                <% } %>
                <% if (esAdmin) { %>
                <button class="btn-menu" onclick="toggleMenu(<%= p.id %>)" title="Opciones">
                  <i class="ti ti-dots-vertical"></i>
                </button>
                <div id="menu-<%= p.id %>" class="dropdown-menu" style="display:none;">
                  <button onclick="abrirEditar(<%= p.id %>, '<%= p.nombre.replace(/'/g,'') %>', '<%= p.email||'' %>', '<%= p.legajo||'' %>', '<%= p.puesto||'' %>', '<%= p.rol||'' %>', '<%= p.departamento === 'ayb' ? '' : (p.departamento||'') %>', '<%= p.modalidad||'' %>', '<%= p.fecha_alta||'' %>', '<%= p.celular||'' %>')" class="dropdown-item">
                    <i class="ti ti-pencil"></i> Editar
                  </button>
                  <button onclick="abrirDisponibilidad(<%= p.id %>, '<%= p.nombre.replace(/'/g,'') %>')" class="dropdown-item">
                    <i class="ti ti-calendar-event"></i> Disponibilidad
                  </button>
                  <button onclick="abrirReset(<%= p.id %>, '<%= p.nombre.replace(/'/g,'') %>')" class="dropdown-item">
                    <i class="ti ti-key"></i> Contraseña
                  </button>
                  <% if (p.activo) { %>
                  <form method="POST" action="/personal/<%= p.id %>/eliminar" style="margin:0;" onsubmit="return confirm('¿Dar de baja a <%= p.nombre %>?')">
                    <button type="submit" class="dropdown-item dropdown-danger"><i class="ti ti-user-off"></i> Dar de baja</button>
                  </form>
                  <% } else { %>
                  <form method="POST" action="/personal/<%= p.id %>/activar" style="margin:0;">
                    <button type="submit" class="dropdown-item dropdown-success"><i class="ti ti-user-check"></i> Reactivar</button>
                  </form>
                  <% } %>
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
          <tr><td colspan="<%= misDepto === 'ayb' ? 6 : 4 %>" style="text-align:center;padding:48px;color:var(--gris-texto);font-style:italic;">No hay personal registrado.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver al menú principal</a>
    </div>
  </main>

  <nav class="mobile-nav">
    <a href="/eventos"  class="mobile-nav-link"><i class="ti ti-calendar-event"></i><span>Eventos</span></a>
    <a href="/personal" class="mobile-nav-link activo"><i class="ti ti-users"></i><span>Miembro de equipo</span></a>
    <a href="/horarios" class="mobile-nav-link"><i class="ti ti-clock"></i><span>Horarios</span></a>
    <a href="/recetas"  class="mobile-nav-link"><i class="ti ti-chef-hat"></i><span>Recetas</span></a>
    <a href="/costos"   class="mobile-nav-link"><i class="ti ti-coin"></i><span>Costos</span></a>
  </nav>
</div>

<!-- Modal editar empleado -->
