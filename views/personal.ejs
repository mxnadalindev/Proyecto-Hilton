      <button onclick="hideModal('modal-disponibilidad')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <p style="font-size:0.8rem;color:var(--gris-texto);margin:0 0 16px;">de <strong id="disp-nombre"></strong></p>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <button onclick="dispMes(-1)" style="background:none;border:1px solid var(--gris-borde);border-radius:8px;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gris-texto);font-size:16px;">&#8249;</button>
      <span id="disp-titulo" style="font-size:0.9rem;font-weight:600;color:var(--negro);"></span>
      <button onclick="dispMes(1)" style="background:none;border:1px solid var(--gris-borde);border-radius:8px;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gris-texto);font-size:16px;">&#8250;</button>
    </div>
    <div id="disp-grid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center;"></div>

    <p style="font-size:0.65rem;color:var(--gris-texto);margin:12px 0 8px;text-align:center;">Click en un día para ir cambiando: sin dato → disponible → no disponible.</p>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      <span style="font-size:0.65rem;font-weight:700;background:#22c55e;border:1px solid #22c55e;color:#fff;padding:3px 11px;border-radius:20px;">Disponible</span>
      <span style="font-size:0.65rem;font-weight:700;background:#dc2626;border:1px solid #dc2626;color:#fff;padding:3px 11px;border-radius:20px;">No disponible</span>
      <span style="font-size:0.65rem;font-weight:700;background:var(--gris-fondo);border:1px solid var(--gris-borde);color:var(--gris-texto);padding:3px 11px;border-radius:20px;">Sin dato</span>
    </div>

    <div style="display:flex;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
      <button type="button" onclick="hideModal('modal-disponibilidad')" class="btn-secondary">Cerrar</button>
    </div>
  </div>
</div>

<style>
.recoff-control{display:inline-flex;align-items:center;gap:6px;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:20px;padding:2px 4px;}
.recoff-control button{width:20px;height:20px;border-radius:50%;border:none;background:var(--blanco);color:var(--gris-texto);cursor:pointer;font-size:0.85rem;line-height:1;display:flex;align-items:center;justify-content:center;transition:background 0.15s,color 0.15s;}
.recoff-control button:hover{background:var(--azul);color:#fff;}
.recoff-numero{font-size:0.78rem;font-weight:700;color:var(--negro);min-width:16px;text-align:center;}
.puesto-badge{font-size:0.68rem;font-weight:500;color:var(--azul);background:var(--azul-claro);padding:2px 7px;border-radius:20px;white-space:nowrap;}
.btn-asignar{background:#7c3aed;color:#fff;border:none;border-radius:6px;padding:5px 9px;cursor:pointer;font-size:13px;transition:background 0.2s;display:inline-flex;align-items:center;}
.btn-asignar:hover{background:#6d28d9;}
.btn-menu{background:none;border:none;cursor:pointer;color:var(--gris-texto);font-size:18px;padding:4px;border-radius:6px;}
.btn-menu:hover{background:var(--gris-fondo);}
.dropdown-menu{position:absolute;right:0;top:36px;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.15);z-index:200;min-width:150px;padding:4px;}
.dropdown-item{display:flex;align-items:center;gap:8px;width:100%;background:none;border:none;padding:8px 12px;font-size:0.78rem;font-family:var(--font-sans);color:var(--negro);cursor:pointer;border-radius:6px;text-align:left;}
.dropdown-item:hover{background:var(--gris-fondo);}
.dropdown-danger{color:#dc2626;}.dropdown-danger:hover{background:#fef2f2;}
.dropdown-success{color:#16a34a;}.dropdown-success:hover{background:#f0fdf4;}
.field label{display:block;font-size:0.68rem;font-weight:500;color:var(--negro);margin-bottom:6px;}
.field input{width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none;}
.field input:focus{border-color:var(--azul);background:var(--blanco);}

/* Select de estado por día — flecha propia chica en vez de la nativa del navegador, para que no tape el texto */
.sel-dia-estado{
  -webkit-appearance:none;
  -moz-appearance:none;
  appearance:none;
  width:70px;
  padding:3px 16px 3px 6px;
  border:1px solid var(--gris-borde);
  border-radius:5px;
  font-size:0.6rem;
  font-family:var(--font-sans);
  outline:none;
  text-align:left;
  text-overflow:ellipsis;
  white-space:nowrap;
  overflow:hidden;
  cursor:pointer;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' fill='none' stroke='%2394a3b8' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'/></svg>");
  background-repeat:no-repeat;
  background-position:right 5px center;
  background-size:8px 5px;
}
.sel-dia-estado:focus{border-color:var(--azul);}

/* Calendario */
.cal-dia{padding:6px 4px;border-radius:6px;cursor:pointer;font-size:0.8rem;color:var(--negro);transition:all 0.15s;border:1px solid transparent;position:relative;}
.cal-dia:hover{background:var(--azul-claro);color:var(--azul);}
.cal-dia.hoy{font-weight:700;color:var(--azul);}
.cal-dia.rango-sel{background:var(--azul);color:#fff;border-radius:0;}
.cal-dia.rango-inicio{border-radius:6px 0 0 6px;}
.cal-dia.rango-fin{border-radius:0 6px 6px 0;}
.cal-dia.rango-inicio.rango-fin{border-radius:6px;}
.cal-dia.rango-pendiente{background:var(--azul-claro);color:var(--azul);border:1.5px dashed var(--azul);border-radius:6px;font-weight:700;}
.cal-dia.vacio{visibility:hidden;}
.cal-dia.es-feriado{border:1.5px solid #dc2626;font-weight:700;}
.cal-dia.es-feriado.rango-sel{border-color:#fff;}
.cal-dia-flag{position:absolute;top:-3px;right:-3px;width:14px;height:14px;border-radius:50%;background:var(--blanco);border:1px solid var(--gris-borde);display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--gris-borde);cursor:pointer;transition:all 0.15s;line-height:1;z-index:2;}
.cal-dia-flag:hover{border-color:#dc2626;color:#dc2626;transform:scale(1.25);}
.cal-dia.es-feriado .cal-dia-flag{background:#dc2626;border-color:#dc2626;color:#fff;}
.cal-nombre-dia{font-size:0.6rem;font-weight:600;color:var(--gris-texto);padding:4px 0;text-align:center;}
</style>

<script>
function ajustarRecoff(uid, delta) {
  fetch(`/personal/${uid}/recoff-ajustar`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: `delta=${delta}`,
  })
    .then(r => r.json())
    .then(data => {
      if (data.ok) {
        document.getElementById('recoff-' + uid).textContent = data.recoff_pendiente;
      }
    });
}

const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const DIAS_SEMANA = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
const bgEstados = {OFF:'#fbbf24',VAC:'#dc2626',RECOFF:'#22c55e',LIBRE:'#dc2626',FERIADO:'#dc2626',ART:'#dc2626',LICENCIA:'#dc2626',CUMPLE:'#dc2626',MUDANZA:'#dc2626',FRANCO:'#64748b'};

// Feriados: mapa fecha -> nombre, para pintar el calendario. Solo visual,
// no toca los horarios de nadie.
const FERIADOS_PREVIOS = <%- JSON.stringify(feriados || []) %>;
const FERIADOS_MAP = {};
FERIADOS_PREVIOS.forEach(f => { FERIADOS_MAP[f.fecha] = f.nombre; });

let calFecha = new Date('<%= inicio %>T00:00:00');
// Rango seleccionado: mientras no se elija el día de fin, rangoFin queda en null.
let rangoInicio = '<%= inicio %>';
let rangoFin    = '<%= fin %>';

function sumarDias(fechaStr, n) {
  const d = new Date(fechaStr + 'T00:00:00');
  d.setDate(d.getDate() + n);
  return d.toISOString().split('T')[0];
}

function getDiasRango(inicioStr, finStr) {
  const dias = [];
  let d = new Date(inicioStr + 'T00:00:00');
  const dFin = new Date(finStr + 'T00:00:00');
  while (d <= dFin) {
    dias.push(d.toISOString().split('T')[0]);
    d.setDate(d.getDate() + 1);
  }
  return dias;
}

function renderCal() {
  const anio = calFecha.getFullYear();
  const mes  = calFecha.getMonth();
  document.getElementById('cal-titulo').textContent = MESES[mes] + ' ' + anio;

  const primerDia = new Date(anio, mes, 1).getDay();
  const diasMes   = new Date(anio, mes + 1, 0).getDate();
  const hoy = new Date().toISOString().split('T')[0];

  let html = DIAS_SEMANA.map(d => `<div class="cal-nombre-dia">${d}</div>`).join('');
  for (let i = 0; i < primerDia; i++) html += `<div class="cal-dia vacio"></div>`;

  for (let d = 1; d <= diasMes; d++) {
    const fechaStr = `${anio}-${String(mes+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const esInicio = fechaStr === rangoInicio;
    const esFin    = !!rangoFin && fechaStr === rangoFin;
    const enMedio  = !!rangoFin && fechaStr > rangoInicio && fechaStr < rangoFin;
    const esHoy    = fechaStr === hoy;
    const nombreFeriado = FERIADOS_MAP[fechaStr];

    let cls = 'cal-dia';
    if (esInicio && !rangoFin) {
      cls += ' rango-pendiente'; // ya elegiste el inicio, falta el fin
    } else if (esInicio || esFin || enMedio) {
      cls += ' rango-sel';
      if (esInicio) cls += ' rango-inicio';
      if (esFin)    cls += ' rango-fin';
    } else if (esHoy) {
      cls += ' hoy';
    }
    if (nombreFeriado) cls += ' es-feriado';

    const titulo = nombreFeriado ? ` title="Feriado: ${nombreFeriado} — click en la banderita para editar/quitar"` : ' title="Click en la banderita para marcar como feriado"';

    html += `<div class="${cls}" onclick="seleccionarDia('${fechaStr}')"${titulo}>${d}<span class="cal-dia-flag" onclick="event.stopPropagation();toggleFeriado('${fechaStr}')"><i class="ti ti-flag-filled"></i></span></div>`;
  }

  document.getElementById('cal-grid').innerHTML = html;
}

// Marca o desmarca un día como feriado, directo desde el calendario (sin recargar la página)
async function toggleFeriado(fechaStr) {
  const yaEsFeriado = !!FERIADOS_MAP[fechaStr];

  if (yaEsFeriado) {
    const confirmar = confirm(`¿Quitar "${FERIADOS_MAP[fechaStr]}" como feriado del ${fechaStr}?`);
    if (!confirmar) return;
    try {
      const resp = await fetch(`/personal/feriados/${fechaStr}/eliminar`, { method: 'POST' });
      const data = await resp.json();
      if (data.ok) { delete FERIADOS_MAP[fechaStr]; renderCal(); }
      else alert('Error: ' + data.error);
    } catch (e) { alert('Error de conexión'); }
    return;
  }

  // En vez de un prompt() nativo del navegador (se veía como una alerta del
  // sistema, poco prolijo), abrimos un modal propio con el mismo estilo que
  // el resto de la pantalla.
  abrirModalFeriado(fechaStr);
}

// Abre el modal para cargar el nombre del feriado de una fecha puntual
function abrirModalFeriado(fechaStr) {
  const fecha = new Date(fechaStr + 'T00:00:00');
  document.getElementById('feriado-fecha-label').textContent =
    fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
  document.getElementById('form-feriado').dataset.fecha = fechaStr;
  document.getElementById('input-feriado-nombre').value = '';
  showModal('modal-feriado');
}

// Guarda el feriado cargado en el modal (mismo pedido que antes hacía el prompt())
async function guardarFeriadoDesdeModal(event) {
  event.preventDefault();
  const fechaStr = document.getElementById('form-feriado').dataset.fecha;
  const nombre = document.getElementById('input-feriado-nombre').value.trim();
  if (!nombre) return false;
  try {
    const resp = await fetch('/personal/feriados', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ fecha: fechaStr, nombre })
    });
    const data = await resp.json();
    if (data.ok) {
      FERIADOS_MAP[fechaStr] = data.nombre;
      renderCal();
      hideModal('modal-feriado');
    } else {
      alert('Error: ' + data.error);
    }
  } catch (e) { alert('Error de conexión'); }
  return false;
}

function seleccionarDia(fechaStr) {
  if (!rangoInicio || rangoFin) {
    // No había nada elegido, o ya había un rango completo: arrancamos uno nuevo
    rangoInicio = fechaStr;
    rangoFin = null;
  } else if (fechaStr === rangoInicio) {
    // Click de nuevo sobre el mismo día que ya era el inicio: lo cancela
    rangoInicio = null;
    rangoFin = null;
  } else {
    // Ya había un inicio elegido, este click define el fin
    if (fechaStr >= rangoInicio) {
      rangoFin = fechaStr;
    } else {
      rangoFin = rangoInicio;
      rangoInicio = fechaStr;
    }
  }
  renderCal();
  actualizarEtiquetaRango();
}

function cancelarSeleccion() {
  rangoInicio = null;
  rangoFin = null;
  renderCal();
  actualizarEtiquetaRango();
}

function calMes(dir) {
  calFecha.setMonth(calFecha.getMonth() + dir);
  renderCal();
}

function actualizarEtiquetaRango() {
  const label = document.getElementById('semana-label');
  const cont  = document.getElementById('semana-dias');
  const btn   = document.getElementById('btn-ir-semana');

  if (!rangoInicio) {
    label.textContent = 'Elegí el día de inicio en el calendario';
    cont.innerHTML = '';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.5';
    return;
  }

  const d0 = new Date(rangoInicio + 'T00:00:00');

  if (!rangoFin) {
    label.innerHTML = d0.toLocaleDateString('es-AR',{day:'numeric',month:'long'}) +
      ' — elegí el día de fin <button type="button" onclick="cancelarSeleccion()" style="background:none;border:none;color:var(--gris-texto);text-decoration:underline;cursor:pointer;font-size:0.75rem;margin-left:6px;">(cambiar inicio)</button>';
    cont.innerHTML = '';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.5';
    return;
  }

  const dFin = new Date(rangoFin + 'T00:00:00');
  label.textContent = d0.toLocaleDateString('es-AR',{day:'numeric',month:'long'}) + ' — ' +
    dFin.toLocaleDateString('es-AR',{day:'numeric',month:'long',year:'numeric'});

  const dias = getDiasRango(rangoInicio, rangoFin);
  cont.innerHTML = dias.map(d => {
    const fecha = new Date(d + 'T00:00:00');
    const dn = DIAS_SEMANA[fecha.getDay()];
    return `<span style="font-size:0.72rem;background:var(--azul-claro);color:var(--azul);padding:3px 8px;border-radius:6px;font-weight:600;">${dn} ${fecha.getDate()}</span>`;
  }).join('');

  btn.style.pointerEvents = '';
  btn.style.opacity = '';
  btn.href = '/personal?inicio=' + rangoInicio + '&fin=' + rangoFin;
}

// Inicializar calendario en el rango actual — este bloque (selector de
// semana para Cocina) no se renderiza para AYB (misDepto === 'ayb'), así
// que #cal-titulo no existe en ese caso; sin este chequeo renderCal()
// tiraba un error y cortaba el resto del script para esos usuarios.
if (document.getElementById('cal-titulo')) {
  renderCal();
  actualizarEtiquetaRango();
}

// ── Guardar empleado ──
function onCambioSectorDia(sel) {
  if (sel.value) {
    sel.style.background = 'var(--azul-claro)';
    sel.style.color = 'var(--azul)';
    sel.style.fontWeight = '700';
  } else {
    sel.style.background = 'var(--gris-fondo)';
    sel.style.color = 'var(--gris-texto)';
    sel.style.fontWeight = '400';
  }
}

async function guardarEmpleado(uid) {
  const valores = {};
  const sectoresDia = {};

  document.querySelectorAll(`.sel-estado-${uid}`).forEach(sel => {
    const fecha = sel.dataset.fecha;
    if (sel.value) {
      // Día con estado especial: eso es lo que se guarda
      valores[fecha] = sel.value;
    } else {
      // Día "Normal": se guarda la hora que haya en su campo puntual (si hay)
      const inputHora = document.querySelector(`.hora-dia-${uid}[data-fecha="${fecha}"]`);
      const h = inputHora?.value?.trim() || '';
      if (h) valores[fecha] = h;
    }
  });

  document.querySelectorAll(`.sel-sector-${uid}`).forEach(sel => {
    if (sel.value) sectoresDia[sel.dataset.fecha] = sel.value;
  });

  try {
    const resp = await fetch('/personal/asignar-semana-completa', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ usuario_id: uid, inicio: rangoInicio, fin: rangoFin || rangoInicio, valores, sectoresDia })
    });
    const data = await resp.json();
    if (data.ok) {
      const btn = document.querySelector(`button[onclick="guardarEmpleado(${uid})"]`);
      if (btn) { btn.style.background = '#16a34a'; setTimeout(() => btn.style.background = '', 1500); }
      actualizarColorFila(uid);
      const recoffSpan = document.getElementById('recoff-' + uid);
      if (recoffSpan && data.recoff_pendiente !== undefined) recoffSpan.textContent = data.recoff_pendiente;
    } else {
      alert('Error: ' + data.error);
    }
  } catch(e) { alert('Error de conexión'); }
}

// Colorea el fondo de la fila según el primer estado (no-franco) encontrado entre los días
function actualizarColorFila(uid) {
  const selects = [...document.querySelectorAll(`.sel-estado-${uid}`)];
  const conEstado = selects.find(s => s.value && s.value !== 'FRANCO');
  const bg = conEstado ? (bgEstados[conEstado.value] || '') : '';
  const fila = selects[0]?.closest('tr');
  if (fila) fila.style.background = bg ? bg + '11' : '';
}

// Se dispara al cambiar el estado de un día puntual
function onCambioEstadoDia(sel, uid) {
  if (sel.value === 'FRANCO') {
    const totalFrancos = [...document.querySelectorAll(`.sel-estado-${uid}`)].filter(s => s.value === 'FRANCO').length;
    if (totalFrancos > 2) {
      alert('Máximo 2 días de franco por rango.');
      sel.value = '';
    }
  }
  const bg = bgEstados[sel.value] || '';
  sel.style.backgroundColor = bg ? bg : 'var(--gris-fondo)';
  sel.style.borderColor = bg ? bg : 'var(--gris-borde)';
  sel.style.color = bg ? '#fff' : 'var(--negro)';
  sel.style.fontWeight = bg ? '700' : '400';

  // Habilita/deshabilita el campo de hora de ese mismo día según si tiene estado especial o no
  const inputHora = document.querySelector(`.hora-dia-${uid}[data-fecha="${sel.dataset.fecha}"]`);
  if (inputHora) {
    if (sel.value) {
      inputHora.disabled = true;
      inputHora.value = '';
      inputHora.style.background = '#f1f5f9';
    } else {
      inputHora.disabled = false;
      inputHora.style.background = 'var(--gris-fondo)';
    }
  }

  actualizarColorFila(uid);
}

// ── Modales ──
function showModal(id){ document.getElementById(id).style.display='flex'; setTimeout(()=>{ const p=document.querySelector('#'+id+' input:not([type=hidden])'); if(p) p.focus(); },100); }
function hideModal(id){ document.getElementById(id).style.display='none'; }

function toggleMenu(id) {
  const menu = document.getElementById('menu-' + id);
  const abierto = menu.style.display === 'block';
  document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
  if (!abierto) menu.style.display = 'block';
}
document.addEventListener('click', e => {
  if (!e.target.closest('.btn-menu') && !e.target.closest('.dropdown-menu'))
    document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
});

function abrirEditar(id, nombre, email, legajo, puesto, rol, sector, modalidad, fechaAlta, celular) {
  document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
  document.getElementById('edit-id').value     = id;
  document.getElementById('edit-nombre').value = nombre;
  document.getElementById('edit-email').value  = email;
  document.getElementById('edit-rol').value    = rol;

  // El modal tiene dos variantes (Cocina: legajo+puesto+sector / AYB:
  // CUIL+modalidad) — solo una está presente en el HTML según misDepto,
  // así que cada campo se llena solo si existe.
  const elLegajo = document.getElementById('edit-legajo');
  if (elLegajo) elLegajo.value = legajo;

  const elCuil = document.getElementById('edit-cuil');
  if (elCuil) elCuil.value = legajo; // el CUIL viaja en el mismo campo "legajo" del lado del servidor

  const selPuesto = document.getElementById('edit-puesto');
  if (selPuesto) {
    // Si el puesto actual del empleado ya no está entre las opciones (por ejemplo,
    // se sacó de la lista después de que se lo asignaron), lo agregamos como opción
    // extra en vez de dejar que el <select> caiga en la primera por defecto sin avisar.
    if (puesto && ![...selPuesto.options].some(o => o.value === puesto)) {
      const opt = document.createElement('option');
      opt.value = puesto;
      opt.textContent = puesto + ' (fuera de lista)';
      selPuesto.appendChild(opt);
    }
    selPuesto.value = puesto;
  }

  const selSector = document.getElementById('edit-sector');
  if (selSector) selSector.value = sector;

  const selModalidad = document.getElementById('edit-modalidad');
  if (selModalidad) selModalidad.value = modalidad;

  const elFechaAlta = document.getElementById('edit-fecha-alta');
  if (elFechaAlta) elFechaAlta.value = fechaAlta || '';

  const elCelular = document.getElementById('edit-celular');
  if (elCelular) elCelular.value = celular || '';

  showModal('modal-editar');
}

function abrirReset(id, nombre) {
  document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
  document.getElementById('reset-nombre').textContent = nombre;
  document.getElementById('form-reset').action = '/personal/' + id + '/reset-password';
  showModal('modal-reset');
}

function toggleResetPass() {
  const input = document.getElementById('input-nuevo-pass');
  const icon  = document.getElementById('eyeReset');
  input.type = input.type === 'text' ? 'password' : 'text';
  icon.className = input.type === 'text' ? 'ti ti-eye-off' : 'ti ti-eye';
}

// ── Disponibilidad: calendario mensual por empleado ──
let dispUid = null;
let dispFecha = new Date();
let dispMapa = {}; // { 'YYYY-MM-DD': {disponible, hora_desde, hora_hasta} }

function abrirDisponibilidad(id, nombre) {
  document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
  dispUid = id;
  dispFecha = new Date();
  document.getElementById('disp-nombre').textContent = nombre;
  showModal('modal-disponibilidad');
  cargarDisponibilidad();
}

function dispMes(dir) {
  dispFecha.setMonth(dispFecha.getMonth() + dir);
  cargarDisponibilidad();
}

async function cargarDisponibilidad() {
  const anio = dispFecha.getFullYear();
  const mes  = dispFecha.getMonth();
  const mesStr = `${anio}-${String(mes+1).padStart(2,'0')}`;
  document.getElementById('disp-titulo').textContent = MESES[mes] + ' ' + anio;
  try {
    const resp = await fetch(`/personal/${dispUid}/disponibilidad?mes=${mesStr}`);
    const data = await resp.json();
    dispMapa = data.ok ? data.dias : {};
  } catch (e) {
    dispMapa = {};
  }
  renderDispCal();
}

function renderDispCal() {
  const anio = dispFecha.getFullYear();
  const mes  = dispFecha.getMonth();
  const primerDia = new Date(anio, mes, 1).getDay();
  const diasMes   = new Date(anio, mes + 1, 0).getDate();
  const hoy = new Date().toISOString().split('T')[0];

  let html = DIAS_SEMANA.map(d => `<div class="cal-nombre-dia">${d}</div>`).join('');
  for (let i = 0; i < primerDia; i++) html += `<div class="cal-dia vacio"></div>`;

  for (let d = 1; d <= diasMes; d++) {
    const fechaStr = `${anio}-${String(mes+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const info = dispMapa[fechaStr]; // {disponible, hora_desde, hora_hasta} o undefined
    const esHoy = fechaStr === hoy;

    let bg = '', color = '', border = 'transparent', titulo = '';
    if (info && info.disponible) {
      bg = '#22c55e'; color = '#fff'; border = '#22c55e';
      titulo = info.hora_hasta ? `Disponible de ${info.hora_desde} a ${info.hora_hasta}` : `Disponible desde las ${info.hora_desde}`;
    } else if (info && !info.disponible) {
      bg = '#dc2626'; color = '#fff'; border = '#dc2626';
      titulo = 'No disponible';
    }

    let cls = 'cal-dia' + (esHoy && !info ? ' hoy' : '');
    html += `<div class="${cls}" title="${titulo}" style="background:${bg};color:${color};border-color:${border};font-weight:${info ? '700' : '400'};" onclick="cicloDisponibilidad('${fechaStr}')">${d}</div>`;
  }

  document.getElementById('disp-grid').innerHTML = html;
}

// Cada click va rotando: sin dato → disponible (pide horario) → no disponible → sin dato de nuevo
async function cicloDisponibilidad(fechaStr) {
  const actual = dispMapa[fechaStr];
  let estado, hora_desde = '', hora_hasta = '';

  if (!actual) {
    estado = 'disponible';
    hora_desde = prompt('¿Desde qué hora está disponible? (ej: 10:00)');
    if (!hora_desde || !hora_desde.trim()) return; // canceló: no guardamos nada
    hora_desde = hora_desde.trim();
    hora_hasta = prompt('¿Hasta qué hora? (dejalo vacío si no tiene límite)') || '';
    hora_hasta = hora_hasta.trim();
  } else if (actual.disponible) {
    estado = 'no_disponible';
  } else {
    estado = '';
  }

  try {
    const resp = await fetch(`/personal/${dispUid}/disponibilidad`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `fecha=${fechaStr}&estado=${estado}&hora_desde=${encodeURIComponent(hora_desde)}&hora_hasta=${encodeURIComponent(hora_hasta)}`
    });
    const data = await resp.json();
    if (!data.ok) { alert('Error: ' + data.error); return; }
    if (estado === '') delete dispMapa[fechaStr];
    else dispMapa[fechaStr] = { disponible: estado === 'disponible', hora_desde, hora_hasta };
    renderDispCal();
  } catch (e) { alert('Error de conexión'); }
}

function buscarPersonal() {
  const q = document.getElementById('buscadorPersonal').value.toLowerCase();
  const mostrarInactivos = document.getElementById('mostrarInactivos').checked;
  document.querySelectorAll('.fila-empleado').forEach(f => {
    const esInactivo = f.classList.contains('fila-inactivo');
    if (!mostrarInactivos && esInactivo) { f.style.display = 'none'; return; }
    f.style.display = f.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

function filtrarPersonal() {
  const mostrar = document.getElementById('mostrarInactivos').checked;
  document.querySelectorAll('.fila-inactivo').forEach(f => f.style.display = mostrar ? '' : 'none');
}

window.addEventListener('DOMContentLoaded', () => {
  const activos   = document.querySelectorAll('.fila-activo').length;
  const inactivos = document.querySelectorAll('.fila-inactivo').length;
  const el = document.getElementById('contadorActivos');
  if (el) el.textContent = activos + ' activo' + (activos!==1?'s':'') + (inactivos > 0 ? ' · ' + inactivos + ' dado'+(inactivos!==1?'s':'') + ' de baja' : '');
});
</script>
