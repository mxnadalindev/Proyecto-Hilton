<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menús — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.menus-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;}
.menu-card{display:block;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:20px;text-decoration:none;box-shadow:var(--sombra);transition:border-color 0.2s;}
.menu-card:hover{border-color:var(--azul-borde);}
.menu-card-nombre{font-size:0.95rem;font-weight:600;color:var(--negro);margin:0 0 6px;}
.menu-card-desc{font-size:0.75rem;color:var(--gris-texto);margin:0 0 14px;line-height:1.4;}
.menu-card-footer{display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;color:var(--gris-texto);padding-top:12px;border-top:1px solid var(--gris-borde);}

/* Botón "chico" (32px), mismo molde que el resto de la aplicación. */
.btn-chico-verde{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label" data-i18n>Portal interno</p>
        <h1 class="seccion-titulo" data-i18n>Menús</h1>
        <%- include('partials/eventos_subnav', { seccionEventos: 'menus' }) %>
      </div>
      <a href="/eventos/menus/nuevo" class="btn-chico-verde"><i class="ti ti-plus"></i> <span data-i18n>Nuevo menú</span></a>
    </div>

    <p style="font-size:0.82rem;color:var(--gris-texto);margin-bottom:20px;" data-i18n>Un menú agrupa varios bocaditos ya cargados en el catálogo de Eventos, para armar combos reutilizables.</p>

    <% if (menus.length > 0) { %>
    <div class="menus-grid">
      <% menus.forEach(m => {
        const costoTotal = m.platos.reduce((s,p) => s + parseFloat(p.costo_unitario || 0) * (p.cantidad_porciones || 1), 0);
      %>
      <a href="/eventos/menus/<%= m.id %>" class="menu-card">
        <p class="menu-card-nombre"><%= m.nombre %></p>
        <% if (m.descripcion) { %><p class="menu-card-desc"><%= m.descripcion %></p><% } %>
        <div class="menu-card-footer">
          <span><%= m.platos.length %> <span data-i18n><%= m.platos.length !== 1 ? 'platos' : 'plato' %></span></span>
          <span style="color:var(--azul);font-weight:600;">$<%= costoTotal.toFixed(2) %></span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <i class="ti ti-list-details" style="font-size:2.5rem;color:var(--gris-borde);margin-bottom:16px;display:block;"></i>
      <p data-i18n>No hay menús creados todavía.</p>
      <a href="/eventos/menus/nuevo" class="btn-chico-verde" style="margin-top:20px;display:inline-flex;"><i class="ti ti-plus"></i> <span data-i18n>Crear el primero</span></a>
    </div>
    <% } %>
  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>

</body>
</html>
