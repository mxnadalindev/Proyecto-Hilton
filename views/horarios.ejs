<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Horarios — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'horarios' }) %>

  <main class="main-content">

    <%
      // Mensaje prolijo para WhatsApp, con las fechas del período en formato D/M.
      function _fechaCorta(iso) {
        const d = new Date(iso + 'T00:00:00');
        return `${d.getDate()}/${d.getMonth() + 1}`;
      }
      const msgHorarios = `Hola! Te envío la planilla de horarios correspondiente a la semana del ${_fechaCorta(inicio)} al ${_fechaCorta(fin)}.`;
    %>

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Portal interno</p>
        <h1 class="seccion-titulo">Horarios</h1>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href="/inicio" class="btn-secondary"><i class="ti ti-home"></i> Menú principal</a>

        <button type="button" class="btn-whatsapp" id="btn-enviar-whatsapp" onclick="enviarExcelPorWhatsapp()">
          <i class="ti ti-brand-whatsapp" id="icon-whatsapp"></i> <span id="texto-whatsapp">Enviar</span>
        </button>

        <a href="/horarios/excel?inicio=<%= inicio %>&fin=<%= fin %>" class="btn-excel">
          <i class="ti ti-file-spreadsheet"></i> Excel
        </a>
        <form method="POST" action="/horarios/copiar-semana" style="margin:0;">
          <input type="hidden" name="inicio_destino" value="<%= inicio %>">
          <input type="hidden" name="fin_destino" value="<%= fin %>">
          <button type="submit" class="btn-secondary" onclick="return confirm('¿Copiar los horarios del período anterior (misma duración) a este período?')">
            <i class="ti ti-copy"></i> Copiar período anterior
          </button>
        </form>
        <% if (puedeReiniciar) { %>
        <form method="POST" action="/horarios/reiniciar-semana" style="margin:0;">
          <input type="hidden" name="inicio" value="<%= inicio %>">
          <input type="hidden" name="fin" value="<%= fin %>">
          <button type="submit" class="btn-secondary" style="color:#dc2626;border-color:#fecaca;"
                  onclick="return confirm('¿Reiniciar todos los horarios de este período? Esta acción no se puede deshacer.')">
            <i class="ti ti-trash"></i> Reiniciar período
          </button>
        </form>
        <% } %>
      </div>
    </div>

    <%# Navegación %>
    <div style="display:flex;align-items:center;justify-content:space-between;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:14px 20px;margin-bottom:20px;box-shadow:var(--sombra);">
      <a href="/horarios?inicio=<%= rangoAnterior.inicio %>&fin=<%= rangoAnterior.fin %>" class="btn-secondary" style="padding:6px 14px;">
        <i class="ti ti-chevron-left"></i> Período anterior
      </a>
      <div style="text-align:center;">
        <p style="font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--gris-texto);margin:0 0 2px;">
          Período <% if (dias.length !== 7) { %>(<%= dias.length %> día<%= dias.length !== 1 ? 's' : '' %>)<% } %>
        </p>
        <p style="font-size:0.95rem;font-weight:600;color:var(--negro);margin:0;">
          <%= new Date(dias[0]+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'long'}) %> — <%= new Date(dias[dias.length-1]+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'long',year:'numeric'}) %>
        </p>
      </div>
      <a href="/horarios?inicio=<%= rangoSiguiente.inicio %>&fin=<%= rangoSiguiente.fin %>" class="btn-secondary" style="padding:6px 14px;">
        Período siguiente <i class="ti ti-chevron-right"></i>
      </a>
    </div>

    <%# Alertas %>
   <% if (typeof msg !== 'undefined' && msg === 'reiniciado') { %> 
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#16a34a;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-check"></i> Horarios del período reiniciados correctamente.
    </div>
    <% } else if (typeof msg !== 'undefined' && msg) { %>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#dc2626;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-alert-circle"></i> <%= decodeURIComponent(msg) %>
    </div>
    <% } %>
    <% if (alertas.length > 0) { %>
    <div style="background:#fef9c3;border:1px solid #fde047;border-radius:10px;padding:12px 16px;margin-bottom:20px;">
      <p style="font-size:0.75rem;font-weight:600;color:#854d0e;margin:0 0 6px;display:flex;align-items:center;gap:6px;">
        <i class="ti ti-alert-triangle"></i> Sectores sin cobertura
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <% alertas.slice(0,8).forEach(a => { %>
        <span style="font-size:0.72rem;background:#fef08a;color:#713f12;padding:2px 8px;border-radius:20px;border:1px solid #fde047;">
          <%= a.sector %> · <%= a.nombreDia %> <%= a.dia.slice(5) %>
        </span>
        <% }) %>
        <% if (alertas.length > 8) { %><span style="font-size:0.72rem;color:#854d0e;">+<%= alertas.length-8 %> más</span><% } %>
      </div>
    </div>
    <% } %>

    <%# Grilla %>
    <div style="overflow-x:auto;border-radius:12px;border:1px solid var(--gris-borde);box-shadow:var(--sombra);">
      <table id="tabla-horarios" style="width:100%;border-collapse:collapse;min-width:<%= 270 + dias.length * 120 %>px;">
        <thead>
          <tr style="background:#1e3a5f;">
            <th style="padding:10px 14px;text-align:left;color:#fff;font-size:0.72rem;font-weight:600;width:200px;">EMPLEADO</th>
            <th style="padding:10px 10px;text-align:center;color:#fff;font-size:0.7rem;font-weight:600;width:70px;" title="Francos compensatorios adeudados">RECOFF</th>
            <% const NOMBRES_DIA = ['DOM','LUN','MAR','MIÉ','JUE','VIE','SÁB']; %>
            <% dias.forEach((d) => { %>
            <% const _fecha = new Date(d + 'T00:00:00'); %>
            <th style="padding:10px 8px;text-align:center;color:#fff;font-size:0.7rem;font-weight:600;min-width:90px;">
              <%= NOMBRES_DIA[_fecha.getDay()] %><br><span style="font-size:0.65rem;opacity:0.8;font-weight:400;"><%= d.slice(5).replace('-','/') %></span>
            </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <%
            const CS = {
              'Supervisores':'#93c5fd','Comis de Recepción':'#6ee7b7','Panadería':'#fde047',
              'Pastelería AM':'#fdba74','Pastelería PM':'#d8b4fe','Faro AM':'#86efac',
              'Faro PM':'#7dd3fc','Nocturno':'#1e293b','BQTs Fríos':'#5eead4',
              'BQTs Calientes':'#fda4af','Farolito':'#bef264','Cocina I+D':'#fcd34d'
            };
          %>
          <% SECTORES.forEach(sector => { %>
            <% if (!porSector[sector]) return; %>
            <tr style="background:<%= CS[sector]||'#f8fafc' %>;">
              <td colspan="<%= 2 + dias.length %>" style="padding:7px 14px;font-size:0.68rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:<%= sector==='Nocturno'?'#fff':'#1e3a5f' %>;">
                <%= sector %>
              </td>
            </tr>
            <% porSector[sector].forEach(emp => { %>
            <tr style="border-bottom:1px solid #f1f5f9;">
              <td style="padding:5px 14px;font-size:0.78rem;font-weight:500;color:var(--negro);background:<%= CS[sector]||'#fff' %>20;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;" title="<%= emp.nombre %>">
                <%= emp.nombre %>
              </td>
              <td style="padding:5px 8px;text-align:center;background:<%= CS[sector]||'#fff' %>20;">
                <span class="recoff-solo-lectura" id="recoff-h-<%= emp.id %>" title="Días de RECOFF pendientes"><%= emp.recoff_pendiente || 0 %></span>
              </td>
              <% dias.forEach(dia => { %>
              <%
                const val = horariosMap[emp.id]?.[dia] || '';
                const esE = ESTADOS.includes(val.toUpperCase());
                const bg = {OFF:'#fbbf24',VAC:'#dc2626',RECOFF:'#22c55e',LIBRE:'#dc2626',FERIADO:'#dc2626',ART:'#dc2626',LICENCIA:'#dc2626',CUMPLE:'#dc2626',MUDANZA:'#dc2626'}[val.toUpperCase()]||'';
                const sectorDelDia = sectorDiaMap[emp.id]?.[dia] || '';
              %>
              <td style="padding:2px 4px;text-align:center;">
                <div style="display:flex;align-items:center;justify-content:center;gap:3px;">
                  <input type="text" class="celda-horario"
                    data-uid="<%= emp.id %>" data-fecha="<%= dia %>"
                    value="<%= val %>" maxlength="10"
                    style="width:<%= sectorDelDia ? '58px' : '80px' %>;text-align:center;border:1px solid <%= bg||'transparent' %>;border-radius:6px;padding:4px;font-size:0.78rem;font-family:var(--font-sans);background:<%= bg||'transparent' %>;color:<%= bg?'#fff':'var(--negro)' %>;font-weight:<%= esE?'700':'500' %>;cursor:pointer;"
                    onfocus="this.style.boxShadow='0 0 0 2px rgba(59,130,246,0.5)';"
                    onblur="this.style.boxShadow='';guardarCelda(this)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault();guardarCelda(this);}if(event.key==='Tab'){event.preventDefault();guardarCelda(this);moverFoco(this,event.shiftKey?-1:1);}"
                  >
                  <% if (sectorDelDia) { %>
                  <span title="Cubre en <%= sectorDelDia %> este día" style="font-size:0.58rem;font-weight:700;background:var(--azul);color:#fff;border-radius:4px;padding:2px 4px;white-space:nowrap;line-height:1.2;">
                    <%= sectorDelDia.length > 10 ? sectorDelDia.substring(0,9)+'…' : sectorDelDia %>
                  </span>
                  <% } %>
                </div>
              </td>
              <% }) %>
            </tr>
            <% }) %>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Leyenda %>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center;">
      <span style="font-size:0.68rem;color:var(--gris-texto);font-weight:600;">ESTADOS:</span>
      <% [{v:'OFF',c:'#fbbf24'},{v:'VAC',c:'#ef4444'},{v:'RECOFF',c:'#22c55e'},{v:'FERIADO',c:'#ef4444'},{v:'LICENCIA',c:'#ec4899'},{v:'CUMPLE',c:'#a855f7'},{v:'MUDANZA',c:'#fb923c'}].forEach(l => { %>
      <span style="font-size:0.68rem;font-weight:700;background:<%= l.c %>40;border:1px solid <%= l.c %>;color:#fff;padding:3px 11px;border-radius:20px;"><%= l.v %></span>
      <% }) %>
    </div>

    <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver al menú principal</a>
    </div>
  </main>
  <%- include('partials/mobile-nav', { path: 'horarios' }) %>
</div>

<style>
.btn-excel{display:inline-flex;align-items:center;gap:6px;background:#16a34a;color:#fff;border:none;border-radius:8px;padding:9px 16px;font-family:var(--font-sans);font-size:0.68rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background 0.2s;}
.btn-excel:hover{background:#15803d;}
.btn-whatsapp{display:inline-flex;align-items:center;gap:6px;background:#25D366;color:#fff;border:none;border-radius:8px;padding:9px 16px;font-family:var(--font-sans);font-size:0.68rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background 0.2s;}
.btn-whatsapp:hover{background:#1ea952;}
.btn-whatsapp:disabled{opacity:0.6;cursor:wait;}
.celda-horario{transition:all 0.15s;}
.celda-horario:hover{box-shadow:0 0 0 1px var(--azul) inset;}
.celda-horario:focus{outline:none;}
.recoff-solo-lectura{display:inline-flex;align-items:center;justify-content:center;min-width:26px;height:22px;padding:0 8px;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:20px;font-size:0.75rem;font-weight:700;color:var(--negro);}
</style>

<script>
const bgEstados = {OFF:'#fbbf24',VAC:'#dc2626',RECOFF:'#22c55e',LIBRE:'#dc2626',FERIADO:'#dc2626',ART:'#dc2626',LICENCIA:'#dc2626',CUMPLE:'#dc2626',MUDANZA:'#dc2626'};

async function guardarCelda(input) {
  const uid   = input.dataset.uid;
  const fecha = input.dataset.fecha;
  const valor = input.value.trim().toUpperCase();
  input.value = valor;
  aplicarColorCelda(input, valor);
  try {
    const resp = await fetch('/horarios/celda', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ usuario_id: uid, fecha, valor })
    });
    const data = await resp.json();
    if (data.ok && data.recoff_pendiente !== undefined) {
      const span = document.getElementById('recoff-h-' + uid);
      if (span) span.textContent = data.recoff_pendiente;
    }
  } catch(e) { console.error(e); }
}

function aplicarColorCelda(input, valor) {
  const td = input.parentElement;
  const bg = bgEstados[valor] || '';
  td.style.background = '';
  input.style.background = bg ? bg : 'transparent';
  input.style.borderColor = bg ? bg : 'transparent';
  input.style.color = bg ? '#fff' : 'var(--negro)';
  input.style.fontWeight = bg ? '700' : '500';
}

function moverFoco(input, dir) {
  const celdas = [...document.querySelectorAll('.celda-horario')];
  const sig = celdas[celdas.indexOf(input) + dir];
  if (sig) { sig.focus(); sig.select(); }
}

document.querySelectorAll('.celda-horario').forEach(input => {
  aplicarColorCelda(input, input.value.toUpperCase());
  input.addEventListener('focus', function() { this.select(); });
});

// ── Enviar por WhatsApp en formato Excel ──
// IMPORTANTE: esta función es 100% síncrona a propósito. Los navegadores de
// escritorio bloquean window.open() como si fuera un pop-up si pasó por algún
// "await" antes (por ejemplo, esperar una descarga) — el clic del usuario deja
// de "contar" como gesto real. Por eso acá no esperamos nada: se descarga el
// Excel y se abre WhatsApp en el mismo instante del clic.
function enviarExcelPorWhatsapp() {
  const mensaje = <%- JSON.stringify(msgHorarios) %>;

  // Solo abre WhatsApp con el mensaje. La descarga del Excel ya la maneja
  // el botón "Excel" aparte — no hace falta duplicarla acá.
  window.open('https://wa.me/?text=' + encodeURIComponent(mensaje), '_blank');
}
</script>
<style>@keyframes girar{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}</style>
</body>
</html>
