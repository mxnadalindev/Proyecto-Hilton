<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nuevo menú — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.form-card{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:24px;box-shadow:var(--sombra);}
.form-card-title{font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azul);margin-bottom:16px;display:flex;align-items:center;gap:7px;}
.field label{display:block;font-size:0.68rem;font-weight:500;color:var(--negro);margin-bottom:6px;}
.field input{width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none;}
.field input:focus{border-color:var(--azul);background:var(--blanco);}
.categoria-bloque{margin-bottom:18px;}
.categoria-bloque:last-child{margin-bottom:0;}
.categoria-titulo{font-size:0.68rem;font-weight:700;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 8px;}
.buscador-platos{width:100%;padding:9px 12px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);margin-bottom:14px;}
.platos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:6px;}
.plato-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:background 0.15s;}
.plato-item:hover{background:var(--azul-claro);}
.plato-item input{width:16px;height:16px;accent-color:var(--azul);flex-shrink:0;}
.plato-nombre{flex:1;font-size:0.8rem;color:var(--negro);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.plato-costo{font-size:0.7rem;color:var(--gris-texto);flex-shrink:0;}
.sin-resultados{font-size:0.8rem;color:var(--gris-texto);font-style:italic;padding:6px 2px;display:none;}

@media (max-width: 600px) {
  .form-card{padding:16px;}
  .platos-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label"><a href="/eventos/menus" style="color:var(--gris-texto);text-decoration:none;display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;"><i class="ti ti-arrow-left"></i> Menús</a></p>
        <h1 class="seccion-titulo">Nuevo menú</h1>
      </div>
    </div>

    <form method="POST" action="/eventos/menus/nuevo">
      <div class="form-card" style="margin-bottom:20px;">
        <div class="field" style="margin-bottom:14px;">
          <label>Nombre del menú</label>
          <input type="text" name="nombre" placeholder="Ej: Menú Buffet Ejecutivo" required>
        </div>
        <div class="field">
          <label>Descripción (opcional)</label>
          <input type="text" name="descripcion" placeholder="Ej: Almuerzo corporativo, hasta 50 personas">
        </div>
      </div>

      <div class="form-card">
        <p class="form-card-title"><i class="ti ti-tools-kitchen-2"></i> Elegí los bocaditos que lo componen</p>

        <% const NOMBRES_CATEGORIA_MENU = { frios: 'Fríos', calientes: 'Calientes', principales: 'Platos principales', postres: 'Postres' }; %>
        <% const hayAlgunPlato = ['frios','calientes','principales','postres'].some(cat => (catalogoBocaditos[cat]||[]).length > 0); %>

        <% if (hayAlgunPlato) { %>
        <input type="text" id="buscador-platos" placeholder="Buscar bocadito..." class="buscador-platos"
               oninput="filtrarPlatos(this.value)">
        <div id="platos-contenedor">
          <% ['frios','calientes','principales','postres'].forEach(cat => { %>
            <% const items = catalogoBocaditos[cat] || []; %>
            <% if (items.length > 0) { %>
            <div class="categoria-bloque" data-categoria-bloque="<%= cat %>">
              <p class="categoria-titulo"><%= NOMBRES_CATEGORIA_MENU[cat] %></p>
              <div class="platos-grid">
                <% items.forEach(b => { %>
                <label class="plato-item" data-nombre="<%= b.nombre.toLowerCase() %>">
                  <input type="checkbox" name="platos" value="<%= b.id %>">
                  <span class="plato-nombre"><%= b.nombre %></span>
                  <span class="plato-costo">$<%= parseFloat(b.costo_unitario || 0).toFixed(2) %>/bocado</span>
                </label>
                <% }) %>
              </div>
            </div>
            <% } %>
          <% }) %>
          <p class="sin-resultados" id="sin-resultados">Sin resultados para esa búsqueda.</p>
        </div>
        <% } else { %>
        <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;">No hay bocaditos cargados en el catálogo de Eventos todavía.</p>
        <% } %>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:20px;">
        <a href="/eventos/menus" class="btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary"><i class="ti ti-device-floppy"></i> Crear menú</button>
      </div>
    </form>
  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>


<script>
function filtrarPlatos(texto) {
  const q = texto.toLowerCase();
  let algunoVisible = false;
  document.querySelectorAll('.categoria-bloque').forEach(bloque => {
    let algunoEnBloque = false;
    bloque.querySelectorAll('.plato-item').forEach(el => {
      const visible = el.dataset.nombre.includes(q);
      el.style.display = visible ? '' : 'none';
      if (visible) algunoEnBloque = true;
    });
    bloque.style.display = algunoEnBloque ? '' : 'none';
    if (algunoEnBloque) algunoVisible = true;
  });
  const sinResultados = document.getElementById('sin-resultados');
  if (sinResultados) sinResultados.style.display = algunoVisible ? 'none' : 'block';
}
</script>
</body>
</html>
