<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"></noscript>
<style>
.cfg-card{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:24px;box-shadow:var(--sombra);}
.cfg-titulo{font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azul);margin:0;display:flex;align-items:center;gap:7px;}
.btn-icono{background:none;border:1px solid var(--gris-borde);border-radius:6px;padding:5px 8px;cursor:pointer;font-size:13px;color:var(--gris-texto);text-decoration:none;display:inline-flex;align-items:center;}
.btn-icono:hover{background:var(--gris-fondo);}
.btn-icono-verde{border-color:#bbf7d0;color:#16a34a;}.btn-icono-verde:hover{background:#f0fdf4;}
.btn-icono-rojo{border-color:#fecaca;color:#dc2626;}.btn-icono-rojo:hover{background:#fef2f2;}
.btn-icono-naranja{border-color:#fed7aa;color:#ea580c;}.btn-icono-naranja:hover{background:#fff7ed;}
.cfg-field{display:flex;flex-direction:column;gap:6px;}
.cfg-field label{font-size:0.78rem;font-weight:600;color:var(--negro);}
.cfg-hint{font-size:0.72rem;color:var(--gris-texto);margin:0;}
.cfg-input{background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:8px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none;}
.cfg-input:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(37,99,235,0.1);}
.cfg-seguridad-grid{grid-template-columns:1fr 1fr;}

/* Modal de confirmación propio (reemplaza el confirm() nativo del
   navegador, que se ve como un cartel gris feo de "localhost:5000 dice")
   para las acciones de "Eliminar"/"Restaurar" de esta página — mismo
   patrón visual (tarjeta blanca redondeada, fondo oscuro atrás) que ya
   usan los demás modales del sitio (ver .modal-lista en costos.ejs). */
.modal-confirmar{position:fixed;inset:0;background:rgba(0,0,0,0);z-index:2000;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity 0.2s ease, background 0.2s ease;}
.modal-confirmar.mostrar{opacity:1;pointer-events:auto;background:rgba(0,0,0,0.45);}
.modal-confirmar-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:380px;padding:26px 28px;box-shadow:0 20px 60px rgba(0,0,0,0.3);text-align:center;transform:scale(0.9);transition:transform 0.2s cubic-bezier(.22,1,.36,1);}
.modal-confirmar.mostrar .modal-confirmar-caja{transform:scale(1);}
.modal-confirmar-icono{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:1.4rem;background:var(--azul-claro);color:var(--azul);}
.modal-confirmar-caja.peligro .modal-confirmar-icono{background:#fef2f2;color:#dc2626;}
.modal-confirmar-msg{font-size:0.88rem;color:var(--negro);font-weight:500;margin:0 0 22px;line-height:1.5;}
.modal-confirmar-botones{display:flex;gap:10px;justify-content:center;}
.modal-confirmar-botones button{font-size:0.78rem;font-weight:600;padding:9px 18px;border-radius:8px;cursor:pointer;font-family:var(--font-sans);}
.modal-confirmar-cancelar{background:none;border:1px solid var(--gris-borde);color:var(--gris-texto);}
.modal-confirmar-cancelar:hover{background:var(--gris-fondo);}
.modal-confirmar-aceptar{background:var(--azul);border:1px solid var(--azul);color:#fff;}
.modal-confirmar-aceptar:hover{background:var(--azul-hover);}
.modal-confirmar-caja.peligro .modal-confirmar-aceptar{background:#dc2626;border-color:#dc2626;}
.modal-confirmar-caja.peligro .modal-confirmar-aceptar:hover{background:#b91c1c;}

@media (max-width: 600px) {
  .cfg-card{padding:16px;}
  .cfg-seguridad-grid{grid-template-columns:1fr !important;}
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'configuracion' }) %>
  <main class="main-content">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Portal interno</p>
        <h1 class="seccion-titulo">Configuración</h1>
      </div>
      <a href="/inicio" class="btn-icono-casa" title="Menú principal"><i class="ti ti-home"></i></a>
    </div>

    <% if (msg) { %>
    <%
      const msgs = {
        rol_actualizado:'Rol actualizado.', depto_actualizado:'Departamento actualizado.',
        admin_general_actualizado:'Acceso de admin general actualizado.',
        usuario_activado:'Usuario activado.', usuario_desactivado:'Usuario desactivado.',
        usuario_eliminado:'Usuario eliminado.', backup_creado:'Backup creado correctamente.',
        backup_eliminado:'Backup eliminado.', backup_restaurado:'Base de datos restaurada.',
        backup_error:'Error al crear el backup.', backup_no_encontrado:'Backup no encontrado.',
        seguridad_actualizada:'Configuración de seguridad guardada.',
        consultora_creada:'Consultora agregada.', consultora_editada:'Consultora actualizada.',
        consultora_activada:'Consultora activada.', consultora_desactivada:'Consultora desactivada.',
        whatsapp_desvinculado:'WhatsApp desvinculado. Escaneá el QR nuevo para volver a vincular un número.',
      };
      const esError = ['backup_error','backup_no_encontrado'].includes(msg);
    %>
    <div style="background:<%= esError?'#fef2f2':'#f0fdf4' %>;border:1px solid <%= esError?'#fecaca':'#bbf7d0' %>;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:<%= esError?'#dc2626':'#16a34a' %>;display:flex;align-items:center;gap:8px;">
      <i class="ti <%= esError?'ti-alert-circle':'ti-check' %>"></i> <%= msgs[msg]||msg %>
    </div>
    <% } %>

    <% if (!general) { %>
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.82rem;color:#1d4ed8;display:flex;align-items:center;gap:8px;">
      <i class="ti ti-info-circle"></i> En Usuarios ves solo a la gente de tu departamento (<%= miDepto %>) — ahí podés activar, desactivar o cambiar el rol de tu equipo. La auditoría también queda acotada a tu sector. Backup y Seguridad son de la base y el login de todo el hotel, así que lo que hagas ahí afecta a todos los departamentos, no solo al tuyo.
    </div>
    <% } %>

    <!-- Tabs -->
    <% const tabList = [{id:'usuarios',label:'Usuarios'},{id:'backup',label:'Backup BD'},{id:'auditoria',label:'Auditoría'},{id:'seguridad',label:'Seguridad'}]; %>
    <% if (verAyb) { tabList.push({id:'consultoras',label:'Consultoras'}, {id:'whatsapp',label:'WhatsApp pendientes'}); } %>
    <% tabList.push({id:'notificaciones',label:'Notificaciones'}, {id:'importacion',label:'Importación'}); %>
    <% if (tabList.length > 1) { %>
    <div style="display:flex;gap:0;margin-bottom:24px;border-bottom:2px solid var(--gris-borde);overflow-x:auto;">
      <% tabList.forEach((t,i) => { %>
      <button onclick="mostrarTab('<%= t.id %>')" id="tab-<%= t.id %>"
              style="padding:10px 16px;background:none;border:none;font-family:var(--font-sans);font-size:0.8rem;font-weight:500;cursor:pointer;border-bottom:2px solid <%= i===0?'var(--azul)':'transparent' %>;margin-bottom:-2px;color:<%= i===0?'var(--azul)':'var(--gris-texto)' %>;white-space:nowrap;transition:all 0.15s;">
        <%= t.label %>
      </button>
      <% }) %>
    </div>
    <% } else { %>
    <div style="margin-bottom:20px;"></div>
    <% } %>

    <!-- TAB: Usuarios -->
    <div id="tab-content-usuarios">
      <div class="cfg-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
          <p class="cfg-titulo"><i class="ti ti-users"></i> Gestión de usuarios</p>
          <div style="position:relative;max-width:260px;width:100%;">
            <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
            <input type="text" id="buscadorUsuarios" placeholder="Buscar..." oninput="buscarUsuario()"
                   style="width:100%;padding:8px 12px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);">
          </div>
        </div>
        <div style="overflow-x:auto;">
          <table class="tabla" style="width:100%;">
            <thead><tr><th>Nombre</th><th>Email</th><th>Departamento</th><th>Rol</th><th>Estado</th><th>Creado</th><th></th></tr></thead>
            <tbody id="tbody-usuarios">
              <% if (!usuarios.length) { %><tr><td colspan="7" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">No hay usuarios registrados.</td></tr><% } %>
              <% usuarios.forEach(u => { %>
              <tr class="fila-usuario" style="border-bottom:1px solid var(--gris-borde);">
                <td><div style="display:flex;align-items:center;gap:8px;"><div style="width:30px;height:30px;border-radius:50%;background:<%= u.activo?'var(--azul-claro)':'var(--gris-fondo)' %>;color:<%= u.activo?'var(--azul)':'var(--gris-texto)' %>;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:600;flex-shrink:0;"><%= (u.nombre||'?').charAt(0).toUpperCase() %></div><span style="font-size:0.82rem;font-weight:500;"><%= u.nombre %></span></div></td>
                <td style="font-size:0.78rem;color:var(--gris-texto);"><%= u.email||'—' %></td>
                <td><% if (general) { %><form method="POST" action="/configuracion/usuario/<%= u.id %>/departamento" style="margin:0;"><select name="departamento" onchange="this.form.submit()" style="padding:4px 8px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.75rem;font-family:var(--font-sans);background:var(--gris-fondo);outline:none;cursor:pointer;max-width:150px;"><option value="">— Sin asignar —</option><% [...DEPTOS,...SECTORES].forEach(d => { %><option value="<%= d %>" <%= u.departamento===d?'selected':'' %>><%= d %></option><% }) %></select></form><% } else { %><span style="font-size:0.78rem;color:var(--gris-texto);"><%= u.departamento||'—' %></span><% } %></td>
                <td>
                  <form method="POST" action="/configuracion/usuario/<%= u.id %>/rol" style="margin:0;"><select name="rol" onchange="this.form.submit()" style="padding:4px 8px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.75rem;font-family:var(--font-sans);background:var(--gris-fondo);outline:none;cursor:pointer;"><option value="empleado" <%= (u.rol||'').toLowerCase()==='empleado'?'selected':'' %>>Empleado</option><option value="supervisor" <%= (u.rol||'').toLowerCase()==='supervisor'?'selected':'' %>>Supervisor</option><option value="admin" <%= (u.rol||'').toLowerCase()==='admin'?'selected':'' %>>Admin</option></select></form>
                  <% if (general && (u.rol||'').toLowerCase()==='admin') { %>
                  <form method="POST" action="/configuracion/usuario/<%= u.id %>/admin-general" style="margin-top:5px;" onsubmit="return true;">
                    <input type="hidden" name="es_admin_general" value="<%= u.es_admin_general ? '0' : '1' %>">
                    <label title="Acceso completo en Configuración (Usuarios sin acotar, reasignar departamentos, Auditoría sin acotar), sin importar el departamento que tenga." style="display:flex;align-items:center;gap:4px;font-size:0.62rem;color:var(--gris-texto);cursor:pointer;white-space:nowrap;">
                      <input type="checkbox" onchange="this.form.submit()" <%= u.es_admin_general ? 'checked' : '' %> style="width:11px;height:11px;accent-color:var(--azul);">
                      Admin general
                    </label>
                  </form>
                  <% } %>
                </td>
                <td><span style="font-size:0.68rem;font-weight:600;background:<%= u.activo?'#f0fdf4':'#fef2f2' %>;color:<%= u.activo?'#16a34a':'#dc2626' %>;border:1px solid <%= u.activo?'#bbf7d0':'#fecaca' %>;padding:2px 8px;border-radius:20px;"><%= u.activo?'Activo':'Inactivo' %></span></td>
                <td style="font-size:0.72rem;color:var(--gris-texto);"><%= u.creado_en?u.creado_en.slice(0,10):'—' %></td>
                <td><div style="display:flex;gap:4px;justify-content:flex-end;"><% if (u.activo) { %><form method="POST" action="/configuracion/usuario/<%= u.id %>/desactivar" style="margin:0;"><button type="submit" title="Desactivar" class="btn-icono"><i class="ti ti-user-off"></i></button></form><% } else { %><form method="POST" action="/configuracion/usuario/<%= u.id %>/activar" style="margin:0;"><button type="submit" title="Activar" class="btn-icono btn-icono-verde"><i class="ti ti-user-check"></i></button></form><% } %><form method="POST" action="/configuracion/usuario/<%= u.id %>/eliminar" style="margin:0;" onsubmit="return confirmarAccion(event, this)"><button type="submit" title="Eliminar" class="btn-icono btn-icono-rojo" data-confirm-msg="¿Eliminar permanentemente a <%= u.nombre %>?" data-confirm-tipo="peligro"><i class="ti ti-trash"></i></button></form></div></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB: Backup -->
    <div id="tab-content-backup" style="display:none;">
      <div class="cfg-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
          <p class="cfg-titulo"><i class="ti ti-database"></i> Backup de base de datos</p>
          <form method="POST" action="/configuracion/backup/crear" style="margin:0;">
            <button type="submit" class="btn-primary"><i class="ti ti-database-export"></i> Crear backup ahora</button>
          </form>
        </div>
        <% if (!general) { %>
        <p style="font-size:0.78rem;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 14px;margin-bottom:16px;">
          <i class="ti ti-alert-triangle"></i> Esta es la base de datos completa de todo el hotel, no solo de <%= miDepto %>. Restaurar un backup viejo pisa los datos de todos los sectores.
        </p>
        <% } %>
        <% if (!backups.length) { %>
        <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;padding:16px 0;">No hay backups disponibles todavía.</p>
        <% } else { %>
        <table class="tabla" style="width:100%;"><thead><tr><th>Archivo</th><th>Tamaño</th><th>Fecha</th><th></th></tr></thead><tbody>
          <% backups.forEach(b => { %>
          <tr style="border-bottom:1px solid var(--gris-borde);">
            <td style="font-size:0.8rem;font-weight:500;"><i class="ti ti-file-database" style="color:var(--azul);margin-right:6px;"></i><%= b.nombre %></td>
            <td style="font-size:0.78rem;color:var(--gris-texto);"><%= b.size %> KB</td>
            <td style="font-size:0.78rem;color:var(--gris-texto);"><%= new Date(b.fecha).toLocaleString('es-AR') %></td>
            <td><div style="display:flex;gap:6px;justify-content:flex-end;">
              <a href="/configuracion/backup/descargar/<%= b.nombre %>" class="btn-icono btn-icono-verde" title="Descargar"><i class="ti ti-download"></i></a>
              <form method="POST" action="/configuracion/backup/restaurar/<%= b.nombre %>" style="margin:0;" onsubmit="return confirmarAccion(event, this)"><button type="submit" title="Restaurar" class="btn-icono btn-icono-naranja" data-confirm-msg="¿Restaurar BD con este backup? Se sobreescribirán todos los datos." data-confirm-tipo="peligro"><i class="ti ti-restore"></i></button></form>
              <form method="POST" action="/configuracion/backup/eliminar/<%= b.nombre %>" style="margin:0;" onsubmit="return confirmarAccion(event, this)"><button type="submit" title="Eliminar" class="btn-icono btn-icono-rojo" data-confirm-msg="¿Eliminar este backup?" data-confirm-tipo="peligro"><i class="ti ti-trash"></i></button></form>
            </div></td>
          </tr>
          <% }) %>
        </tbody></table>
        <% } %>
      </div>
    </div>

    <!-- TAB: Auditoría -->
    <div id="tab-content-auditoria" style="display:none;">
      <div class="cfg-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:8px;">
          <p class="cfg-titulo"><i class="ti ti-history"></i> Registro de auditoría</p>
          <span style="font-size:0.72rem;color:var(--gris-texto);"><%= general ? 'Últimas 100 acciones' : `Últimas 100 acciones de ${miDepto}` %></span>
        </div>
        <% if (!general) { %>
        <p style="font-size:0.78rem;color:var(--gris-texto);margin:-12px 0 16px;">Solo se muestran acciones de usuarios que siguen dados de alta en tu departamento. Si alguien fue eliminado después de la acción, esa fila no aparece acá.</p>
        <% } %>
        <% if (!auditoria.length) { %>
        <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;padding:16px 0;">No hay acciones registradas todavía.</p>
        <% } else { %>
        <div style="overflow-x:auto;"><table class="tabla" style="width:100%;"><thead><tr><th>Usuario</th><th>Acción</th><th>Detalle</th><th>IP</th><th>Fecha</th></tr></thead><tbody>
          <% auditoria.forEach(a => { %>
          <% const bgA = {login:'#dbeafe',logout:'#f1f5f9',registro:'#dcfce7',backup_creado:'#fef9c3',backup_restaurado:'#fed7aa',backup_eliminado:'#fecaca',eliminar_usuario:'#fecaca',activar_usuario:'#dcfce7',desactivar_usuario:'#fef2f2',cambio_rol:'#ede9fe',cambio_departamento:'#dbeafe',cambio_seguridad:'#fef9c3'}[a.accion]||'#f8fafc'; %>
          <tr style="border-bottom:1px solid var(--gris-borde);">
            <td style="font-size:0.78rem;font-weight:500;"><%= a.usuario_nombre||'—' %></td>
            <td><span style="font-size:0.68rem;font-weight:700;background:<%= bgA %>;padding:2px 8px;border-radius:20px;white-space:nowrap;"><%= a.accion %></span></td>
            <td style="font-size:0.75rem;color:var(--gris-texto);"><%= a.detalle||'—' %></td>
            <td style="font-size:0.72rem;color:var(--gris-texto);"><%= a.ip||'—' %></td>
            <td style="font-size:0.72rem;color:var(--gris-texto);white-space:nowrap;"><%= a.creado_en?a.creado_en.slice(0,19).replace('T',' '):'—' %></td>
          </tr>
          <% }) %>
        </tbody></table></div>
        <% } %>
      </div>
    </div>

    <!-- TAB: Seguridad -->
    <div id="tab-content-seguridad" style="display:none;">
      <div class="cfg-card">
        <p class="cfg-titulo" style="margin-bottom:24px;"><i class="ti ti-shield-lock"></i> Configuración de seguridad</p>
        <% if (!general) { %>
        <p style="font-size:0.78rem;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 14px;margin:-14px 0 20px;">
          <i class="ti ti-alert-triangle"></i> Esto es del login de todo el hotel, no solo de <%= miDepto %>. Lo que guardes acá afecta a todos los usuarios del sistema.
        </p>
        <% } %>
        <form method="POST" action="/configuracion/seguridad">
          <div class="cfg-seguridad-grid" style="display:grid;gap:20px;">

            <div class="cfg-field">
              <label>Máximo de intentos de login</label>
              <p class="cfg-hint">Intentos fallidos antes de bloquear la cuenta temporalmente.</p>
              <div style="display:flex;align-items:center;gap:10px;">
                <input type="number" name="max_intentos_login" value="<%= config.max_intentos_login||5 %>" min="1" max="20" class="cfg-input" style="width:100px;">
                <span style="font-size:0.78rem;color:var(--gris-texto);">intentos</span>
              </div>
            </div>

            <div class="cfg-field">
              <label>Tiempo de bloqueo</label>
              <p class="cfg-hint">Minutos que dura el bloqueo tras superar los intentos máximos.</p>
              <div style="display:flex;align-items:center;gap:10px;">
                <input type="number" name="tiempo_bloqueo_min" value="<%= config.tiempo_bloqueo_min||15 %>" min="1" max="1440" class="cfg-input" style="width:100px;">
                <span style="font-size:0.78rem;color:var(--gris-texto);">minutos</span>
              </div>
            </div>

            <div class="cfg-field">
              <label>Duración de sesión</label>
              <p class="cfg-hint">Horas que dura la sesión antes de cerrarse automáticamente.</p>
              <div style="display:flex;align-items:center;gap:10px;">
                <input type="number" name="sesion_horas" value="<%= config.sesion_horas||8 %>" min="1" max="72" class="cfg-input" style="width:100px;">
                <span style="font-size:0.78rem;color:var(--gris-texto);">horas</span>
              </div>
            </div>

            <div class="cfg-field">
              <label>Forzar cambio de contraseña</label>
              <p class="cfg-hint">Obliga a los usuarios a cambiar su contraseña al primer login.</p>
              <select name="forzar_cambio_password" class="cfg-input" style="width:160px;">
                <option value="false" <%= config.forzar_cambio_password==='false'?'selected':'' %>>Desactivado</option>
                <option value="true"  <%= config.forzar_cambio_password==='true'?'selected':'' %>>Activado</option>
              </select>
            </div>

          </div>
          <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--gris-borde);display:flex;justify-content:flex-end;">
            <button type="submit" class="btn-primary"><i class="ti ti-device-floppy"></i> Guardar configuración</button>
          </div>
        </form>
      </div>
    </div>

    <% if (verAyb) { %>
    <!-- TAB: Consultoras -->
    <div id="tab-content-consultoras" style="display:none;">
      <div class="cfg-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;flex-wrap:wrap;gap:10px;">
          <p class="cfg-titulo"><i class="ti ti-building-store"></i> Consultoras de personal eventual</p>
        </div>
        <p style="font-size:0.78rem;color:var(--gris-texto);margin:-2px 0 20px;">Se avisa por WhatsApp a las consultoras activas cuando un evento de AYB sigue sin cubrirse 24hs después de convocar a los mozos Eventuales.</p>

        <form method="POST" action="/configuracion/consultoras" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--gris-borde);">
          <div class="cfg-field" style="flex:1;min-width:160px;">
            <label>Nombre</label>
            <input type="text" name="nombre" required class="cfg-input" placeholder="Ej: Agencia Events SRL">
          </div>
          <div class="cfg-field" style="flex:1;min-width:160px;">
            <label>Celular (WhatsApp)</label>
            <input type="text" name="celular" required class="cfg-input" placeholder="Ej: 5491122334455">
          </div>
          <button type="submit" class="btn-primary"><i class="ti ti-plus"></i> Agregar</button>
        </form>

        <% if (!consultoras.length) { %>
        <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;padding:16px 0;">No hay consultoras cargadas todavía.</p>
        <% } else { %>
        <div style="overflow-x:auto;"><table class="tabla" style="width:100%;"><thead><tr><th>Nombre</th><th>Celular</th><th>Estado</th><th></th></tr></thead><tbody>
          <% consultoras.forEach(c => { %>
          <tr style="border-bottom:1px solid var(--gris-borde);">
            <td>
              <form method="POST" action="/configuracion/consultoras/<%= c.id %>/editar" style="display:flex;gap:6px;align-items:center;margin:0;">
                <input type="text" name="nombre" value="<%= c.nombre %>" style="border:1px solid transparent;background:none;font-size:0.82rem;font-weight:500;padding:4px 6px;border-radius:6px;font-family:var(--font-sans);color:var(--negro);width:170px;" onfocus="this.style.borderColor='var(--gris-borde)';this.style.background='var(--gris-fondo)';">
                <input type="text" name="celular" value="<%= c.celular %>" style="border:1px solid transparent;background:none;font-size:0.78rem;padding:4px 6px;border-radius:6px;font-family:var(--font-sans);color:var(--gris-texto);width:140px;" onfocus="this.style.borderColor='var(--gris-borde)';this.style.background='var(--gris-fondo)';">
                <button type="submit" title="Guardar" class="btn-icono"><i class="ti ti-device-floppy"></i></button>
              </form>
            </td>
            <td style="font-size:0.78rem;color:var(--gris-texto);"><%= c.celular %></td>
            <td><span style="font-size:0.68rem;font-weight:600;background:<%= c.activo?'#f0fdf4':'#fef2f2' %>;color:<%= c.activo?'#16a34a':'#dc2626' %>;border:1px solid <%= c.activo?'#bbf7d0':'#fecaca' %>;padding:2px 8px;border-radius:20px;"><%= c.activo?'Activa':'Inactiva' %></span></td>
            <td><div style="display:flex;gap:4px;justify-content:flex-end;">
              <% if (c.activo) { %>
              <form method="POST" action="/configuracion/consultoras/<%= c.id %>/desactivar" style="margin:0;"><button type="submit" title="Desactivar" class="btn-icono"><i class="ti ti-building-off"></i></button></form>
              <% } else { %>
              <form method="POST" action="/configuracion/consultoras/<%= c.id %>/activar" style="margin:0;"><button type="submit" title="Activar" class="btn-icono btn-icono-verde"><i class="ti ti-check"></i></button></form>
              <% } %>
            </div></td>
          </tr>
          <% }) %>
        </tbody></table></div>
        <% } %>
      </div>
    </div>

    <!-- TAB: WhatsApp pendientes -->
    <div id="tab-content-whatsapp" style="display:none;">
      <!-- Vinculación con número personal (Baileys — NO es la API oficial
           de WhatsApp Business, ver src/services/whatsappPersonal.js). Se
           consulta /configuracion/whatsapp-personal/estado cada pocos
           segundos para que el QR se refresque solo (vencen cada ~20s) y
           para que el panel pase a "Conectado" apenas alguien escanea, sin
           que el admin tenga que recargar la página. -->
      <div class="cfg-card" style="margin-bottom:20px;">
        <p class="cfg-titulo" style="margin-bottom:8px;"><i class="ti ti-brand-whatsapp"></i> WhatsApp — número personal vinculado</p>
        <p style="font-size:0.78rem;color:var(--gris-texto);margin:0 0 16px;">
          Envío automático real (no el link manual de abajo) usando un WhatsApp normal vinculado como dispositivo — igual que WhatsApp Web. No es la cuenta oficial de WhatsApp Business de Meta: es un número de teléfono común (el tuyo, o cualquiera que escanee el QR) mandando estos mensajes automáticamente.
        </p>
        <div id="waPersonalEstado" style="display:flex;flex-direction:column;align-items:flex-start;gap:14px;">
          <p style="font-size:0.82rem;color:var(--gris-texto);">Consultando estado...</p>
        </div>
      </div>

      <div class="cfg-card">
        <p class="cfg-titulo" style="margin-bottom:8px;"><i class="ti ti-brand-whatsapp"></i> WhatsApp pendientes de enviar</p>
        <p style="font-size:0.78rem;color:var(--gris-texto);margin:0 0 20px;">Todavía no hay una cuenta de WhatsApp Business conectada — estos mensajes los arma el sistema solo (convocatorias de eventos de AYB), pero hay que mandarlos a mano tocando el link. Al volver de WhatsApp, marcalo como enviado para que no quede colgado acá.</p>
        <% if (!whatsappPendientes.length) { %>
        <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;padding:16px 0;">No hay mensajes pendientes.</p>
        <% } else { %>
        <% whatsappPendientes.forEach(w => { %>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 4px;border-bottom:1px solid var(--gris-borde);">
          <div style="flex:1;min-width:220px;">
            <div style="font-size:0.75rem;color:var(--gris-texto);margin-bottom:4px;">
              <%= w.destinatario_celular || 'Sin celular cargado' %>
              <% if (w.tanda) { %> · tanda <%= w.tanda %><% } %>
              <% if (w.evento_nombre) { %> · <%= w.evento_nombre %><% } %>
              · <%= w.creado_en ? w.creado_en.slice(0,16).replace('T',' ') : '' %>
            </div>
            <div style="font-size:0.82rem;color:var(--negro);white-space:pre-wrap;"><%= w.mensaje %></div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
            <% if (w.destinatario_celular) { %>
            <a href="https://wa.me/<%= w.destinatario_celular.replace(/\D/g,'') %>?text=<%= encodeURIComponent(w.mensaje) %>" target="_blank" class="btn-whatsapp-cfg" onclick="marcarWhatsappEnviado(<%= w.id %>)" style="display:inline-flex;align-items:center;gap:6px;background:#25D366;color:#fff;border:none;border-radius:8px;padding:8px 14px;font-family:var(--font-sans);font-size:0.72rem;font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;">
              <i class="ti ti-brand-whatsapp"></i> Enviar
            </a>
            <% } else { %>
            <span style="font-size:0.7rem;color:var(--gris-texto);">Sin celular</span>
            <% } %>
            <form method="POST" action="/configuracion/whatsapp-outbox/<%= w.id %>/marcar-enviado" id="form-wa-<%= w.id %>" style="margin:0;">
              <button type="submit" style="background:none;border:none;color:var(--gris-texto);text-decoration:underline;cursor:pointer;font-size:0.68rem;">Marcar enviado</button>
            </form>
          </div>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- TAB: Notificaciones (próximamente) -->
    <div id="tab-content-notificaciones" style="display:none;">
      <div class="cfg-card" style="text-align:center;padding:48px;">
        <i class="ti ti-mail" style="font-size:3rem;color:var(--gris-borde);display:block;margin-bottom:16px;"></i>
        <p style="font-size:1rem;font-weight:600;color:var(--negro);margin-bottom:8px;">Notificaciones</p>
        <p style="font-size:0.85rem;color:var(--gris-texto);">Envío automático de correos y WhatsApp para eventos, horarios y registro de usuarios.</p>
        <span style="font-size:0.68rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;background:var(--gris-fondo);color:var(--gris-texto);padding:4px 12px;border-radius:20px;margin-top:16px;display:inline-block;">Próximamente</span>
      </div>
    </div>

    <!-- TAB: Importación (próximamente) -->
    <div id="tab-content-importacion" style="display:none;">
      <div class="cfg-card" style="text-align:center;padding:48px;">
        <i class="ti ti-file-import" style="font-size:3rem;color:var(--gris-borde);display:block;margin-bottom:16px;"></i>
        <p style="font-size:1rem;font-weight:600;color:var(--negro);margin-bottom:8px;">Importación de recetas</p>
        <p style="font-size:0.85rem;color:var(--gris-texto);">Importar recetas desde archivos Excel o CSV.</p>
        <span style="font-size:0.68rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;background:var(--gris-fondo);color:var(--gris-texto);padding:4px 12px;border-radius:20px;margin-top:16px;display:inline-block;">Próximamente</span>
      </div>
    </div>

    <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver al menú principal</a>
    </div>
  </main>
  <%- include('partials/mobile-nav', { path: 'configuracion' }) %>
</div>

<!-- Modal de confirmación (reemplaza confirm() nativo) — se reusa para
     Eliminar usuario / Restaurar backup / Eliminar backup. -->
<div id="modal-confirmar" class="modal-confirmar" onclick="if(event.target===this) cerrarConfirmar()">
  <div class="modal-confirmar-caja">
    <div class="modal-confirmar-icono"><i class="ti ti-alert-triangle"></i></div>
    <p class="modal-confirmar-msg" id="modalConfirmarMsg"></p>
    <div class="modal-confirmar-botones">
      <button type="button" class="modal-confirmar-cancelar" onclick="cerrarConfirmar()">Cancelar</button>
      <button type="button" class="modal-confirmar-aceptar" onclick="aceptarConfirmar()">Confirmar</button>
    </div>
  </div>
</div>

<script>
const tabIds = <%- JSON.stringify(tabList.map(t => t.id)) %>;

function mostrarTab(tab) {
  tabIds.forEach(t => {
    const content = document.getElementById('tab-content-' + t);
    const btn = document.getElementById('tab-' + t);
    if (content) content.style.display = t === tab ? 'block' : 'none';
    if (btn) {
      btn.style.color = t === tab ? 'var(--azul)' : 'var(--gris-texto)';
      btn.style.borderBottom = t === tab ? '2px solid var(--azul)' : '2px solid transparent';
    }
  });
}

// Abrir tab según query param
const urlTab = new URLSearchParams(window.location.search).get('tab');
if (urlTab) mostrarTab(urlTab);

// Tocar "Enviar" abre WhatsApp con el mensaje ya escrito (target=_blank,
// misma idea que el resto del sitio) Y, en simultáneo, manda el POST que
// lo saca de "pendientes" — así el encargado no tiene que volver acá a
// tocar "Marcar enviado" a mano después de cada uno (queda ese botón
// aparte solo por si mandó el mensaje de otra forma, o se arrepiente de
// haber tocado "Enviar" sin llegar a mandarlo).
function marcarWhatsappEnviado(id) {
  const form = document.getElementById('form-wa-' + id);
  if (form) fetch(form.action, { method: 'POST' }).then(() => {
    const fila = form.closest('div[style*="border-bottom"]');
    if (fila) fila.style.opacity = '0.4';
  }).catch(() => {});
}

// ── Panel de WhatsApp (número personal, Baileys) ──────────────────────
// Polling simple con setInterval (no hay websockets en este portal) —
// alcanza de sobra para esto: el QR vence cada ~20s así que igual hay que
// refrescar seguido mientras se está esperando el escaneo.
<% if (verAyb) { %>
function pintarEstadoWhatsappPersonal(data) {
  const cont = document.getElementById('waPersonalEstado');
  if (!cont) return;
  if (data.estado === 'conectado') {
    cont.innerHTML = `
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="width:9px;height:9px;border-radius:50%;background:#16a34a;display:inline-block;"></span>
        <span style="font-size:0.85rem;font-weight:600;color:var(--negro);">Conectado${data.numero ? ' — +' + data.numero : ''}</span>
      </div>
      <form method="POST" action="/configuracion/whatsapp-personal/desvincular" style="margin:0;">
        <button type="submit" class="btn-icono btn-icono-rojo" style="font-size:0.75rem;padding:7px 14px;"><i class="ti ti-plug-off"></i> Desvincular</button>
      </form>`;
  } else if (data.estado === 'esperando_qr' && data.qr) {
    cont.innerHTML = `
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="width:9px;height:9px;border-radius:50%;background:#ea580c;display:inline-block;"></span>
        <span style="font-size:0.85rem;font-weight:600;color:var(--negro);">Esperando que escanees el QR</span>
      </div>
      <p style="font-size:0.78rem;color:var(--gris-texto);margin:0;">Desde el celular que quieras usar: WhatsApp → Configuración → Dispositivos vinculados → Vincular un dispositivo, y escaneá este código. Se renueva solo si se vence, no hace falta recargar la página.</p>
      <img src="${data.qr}" alt="Código QR para vincular WhatsApp" style="width:220px;height:220px;border:1px solid var(--gris-borde);border-radius:10px;padding:8px;background:#fff;">`;
  } else {
    cont.innerHTML = `
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="width:9px;height:9px;border-radius:50%;background:var(--gris-borde);display:inline-block;"></span>
        <span style="font-size:0.85rem;font-weight:600;color:var(--negro);">Desconectado</span>
      </div>
      <p style="font-size:0.78rem;color:var(--gris-texto);margin:0;">Generando el QR para vincular... si esto no cambia en unos segundos, revisá que el servidor esté corriendo bien.</p>`;
  }
}

function consultarEstadoWhatsappPersonal() {
  fetch('/configuracion/whatsapp-personal/estado')
    .then(r => r.json())
    .then(pintarEstadoWhatsappPersonal)
    .catch(() => {});
}
consultarEstadoWhatsappPersonal();
setInterval(consultarEstadoWhatsappPersonal, 4000);
<% } %>

function buscarUsuario() {
  const q = document.getElementById('buscadorUsuarios').value.toLowerCase();
  document.querySelectorAll('.fila-usuario').forEach(f => {
    f.style.display = f.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

// ── Modal de confirmación propio (Eliminar usuario / Restaurar backup /
// Eliminar backup) en vez del confirm() nativo del navegador — se llama
// desde el onsubmit de cada <form>, leyendo el mensaje y el "tipo" (para
// pintar el ícono/botón en rojo si es una acción de riesgo, "peligro") del
// data-confirm-msg/data-confirm-tipo del botón de submit que hay adentro.
let _formPendienteConfirmar = null;
function confirmarAccion(event, form) {
  event.preventDefault();
  const boton = form.querySelector('[data-confirm-msg]');
  _formPendienteConfirmar = form;
  document.getElementById('modalConfirmarMsg').textContent = boton ? boton.dataset.confirmMsg : '¿Confirmás esta acción?';
  const caja = document.querySelector('#modal-confirmar .modal-confirmar-caja');
  caja.classList.toggle('peligro', !!(boton && boton.dataset.confirmTipo === 'peligro'));
  document.getElementById('modal-confirmar').classList.add('mostrar');
  return false;
}
function cerrarConfirmar() {
  document.getElementById('modal-confirmar').classList.remove('mostrar');
  _formPendienteConfirmar = null;
}
function aceptarConfirmar() {
  const form = _formPendienteConfirmar;
  document.getElementById('modal-confirmar').classList.remove('mostrar');
  // form.submit() (a diferencia de hacer click en el botón) NO vuelve a
  // disparar el evento "submit" del formulario — así no entra de nuevo en
  // confirmarAccion() y se manda derecho.
  if (form) form.submit();
}
</script>
</body>
</html>
