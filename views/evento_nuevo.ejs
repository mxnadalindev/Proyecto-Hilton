<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof evento !== 'undefined' && evento ? 'Editar Evento' : 'Nuevo Evento' %> — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.form-card { background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; box-shadow: var(--sombra); }
.form-card-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--azul); margin-bottom: 18px; display: flex; align-items: center; gap: 7px; }
/* Un solo cuadrado para todo el formulario (como en el detalle de un
   evento): cada sección que antes era su propia .form-card ahora es un
   bloque interno separado con un divisor, en vez de una tarjeta aparte. */
.form-section { padding-top: 22px; margin-top: 22px; border-top: 1px solid var(--gris-borde); }
.form-section:first-child { padding-top: 0; margin-top: 0; border-top: none; }
.field { margin-bottom: 14px; }
.field:last-child { margin-bottom: 0; }
.field label { display: block; font-size: 0.68rem; font-weight: 500; color: var(--negro); margin-bottom: 6px; letter-spacing: 0.05em; }
.field input, .field textarea, .field select {
  width: 100%; background: var(--gris-fondo); border: 1px solid var(--gris-borde);
  border-radius: 8px; padding: 10px 12px; font-family: var(--font-sans);
  font-size: 0.85rem; color: var(--negro); outline: none;
  transition: border-color var(--tr), box-shadow var(--tr);
}
.field input:focus, .field textarea:focus { border-color: var(--azul); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: var(--blanco); }
.field-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
.add-row { display: flex; gap: 8px; margin-bottom: 12px; }
.add-row input { flex: 1; background: var(--gris-fondo); border: 1px solid var(--gris-borde); border-radius: 8px; padding: 9px 12px; font-family: var(--font-sans); font-size: 0.83rem; color: var(--negro); outline: none; transition: border-color var(--tr); }
.add-row input:focus { border-color: var(--azul); background: var(--blanco); }
.btn-add { width: 36px; height: 36px; background: var(--azul); border: none; border-radius: 8px; color: #fff; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background var(--tr); }
.btn-add:hover { background: var(--azul-hover); }
.items-list { min-height: 40px; }
.list-empty { font-size: 0.78rem; color: var(--gris-texto); font-style: italic; padding: 8px 0; }
.item-row { display: flex; align-items: center; gap: 8px; padding: 9px 0; border-bottom: 1px solid var(--gris-borde); font-size: 0.83rem; }
.item-row:last-child { border-bottom: none; }
.item-nombre { flex: 1; color: var(--negro); font-weight: 500; }
.item-detalle { color: var(--gris-texto); font-size: 0.75rem; }
.item-costo { color: var(--azul); font-weight: 600; min-width: 70px; text-align: right; }
.btn-remove { background: none; border: none; color: #dc2626; cursor: pointer; font-size: 16px; padding: 2px; line-height: 1; }
.btn-remove:hover { color: #991b1b; }
.subtotal-row { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--gris-borde); margin-top: 8px; font-size: 0.82rem; color: var(--gris-texto); }
.subtotal-row strong { color: var(--azul); font-size: 1rem; }
.back-link { color: var(--gris-texto); text-decoration: none; font-size: 0.75rem; display: flex; align-items: center; gap: 4px; }
.back-link:hover { color: var(--azul); }
/* Mismo "molde" que .btn-primary/.btn-secondary en style.css, para el
   botón de Cancelar (rojo) que va arriba junto con Eventos y Guardar. */
.btn-danger {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  background: #fef2f2; color: #dc2626;
  border: 1px solid #fecaca; border-radius: 8px;
  padding: 0 18px; box-sizing: border-box; height: 40px;
  font-family: var(--font-sans); font-size: 0.7rem; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;
  cursor: pointer; transition: all var(--tr);
}
.btn-danger:hover { background: #dc2626; color: #fff; }

/* Botones "chicos" (32px), mismo molde que el resto de la aplicación
   (Recetas, Costos, Personal, Eventos) — antes 40px. Los colores del
   encabezado (Volver azul, Guardar verde, Cancelar rojo) ya alternaban
   bien, así que se mantienen. */
.btn-chico-azul,.btn-chico-verde,.btn-chico-rojo{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-azul{background:rgba(0,47,97,0.12);color:#002f61;border:1px solid rgba(0,47,97,0.28);}
.btn-chico-azul:hover{background:rgba(0,47,97,0.20);}
.btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
.btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
.btn-chico-rojo{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.btn-chico-rojo:hover{background:#dc2626;color:#fff;}

/* Cartel de confirmación para "Cancelar", con el mismo estilo de tarjeta
   (fondo blanco, borde, sombra, tipografía Lora) que el resto del sitio,
   en vez del cartel feo del navegador (window.confirm). */
.confirm-overlay {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  z-index: 1000; align-items: center; justify-content: center; padding: 16px;
}
.confirm-overlay.abierto { display: flex; }
.confirm-box {
  background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px;
  box-shadow: var(--sombra-md); padding: 26px; max-width: 360px; width: 100%;
  font-family: var(--font-sans);
}
.confirm-box p.confirm-titulo { font-size: 0.95rem; font-weight: 600; color: var(--negro); margin: 0 0 8px; }
.confirm-box p.confirm-texto { font-size: 0.82rem; color: var(--gris-texto); margin: 0 0 22px; line-height: 1.5; }
.confirm-box .confirm-acciones { display: flex; justify-content: flex-end; gap: 10px; }

/* Desplegable con buscador (multiselección) — usado para fríos/calientes/
   principales/postres y para personal. Envuelve una lista de checkboxes
   ya existente: el buscador solo filtra qué filas se ven, y las filas
   tildadas se muestran además como "chips" debajo, con una X para sacarlas
   rápido sin tener que reabrir la lista. */
.multiselect { position: relative; margin-bottom: 16px; }
.multiselect:last-child { margin-bottom: 0; }
.multiselect > label.ms-label { display: block; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gris-texto); margin-bottom: 6px; }
.multiselect-input-wrap { position: relative; }
.multiselect-input-wrap i { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--gris-texto); font-size: 15px; pointer-events: none; }
.multiselect-input {
  width: 100%; background: var(--gris-fondo); border: 1px solid var(--gris-borde);
  border-radius: 8px; padding: 10px 34px 10px 12px; font-family: var(--font-sans);
  font-size: 0.85rem; color: var(--negro); outline: none;
  transition: border-color var(--tr), box-shadow var(--tr);
}
.multiselect-input:focus { border-color: var(--azul); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: var(--blanco); }
.multiselect-panel {
  /* A propósito NO es "position: absolute": si flotara por encima, al
     abrir un desplegable taparía el campo de abajo (por ej. Calientes
     debajo de Fríos) y un click ahí quedaría atrapado por el panel de
     arriba en vez de llegar al campo tapado. Al ser parte del flujo
     normal, abrir la lista empuja el resto del formulario hacia abajo
     en vez de superponerse. */
  margin-top: 6px;
  background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 8px;
  max-height: 230px; overflow-y: auto;
  display: none;
}
.multiselect-panel.abierto { display: block; }
.multiselect-option { display: flex; align-items: center; gap: 10px; padding: 9px 12px; cursor: pointer; font-size: 0.82rem; color: var(--negro); }
.multiselect-option:hover { background: var(--azul-claro); }
.multiselect-option input { width: 15px; height: 15px; accent-color: var(--azul); flex-shrink: 0; }
.multiselect-option .personal-rol { font-size: 0.65rem; color: var(--gris-texto); text-transform: uppercase; letter-spacing: 0.08em; margin-left: auto; }
.multiselect-option.oculto { display: none; }
.multiselect-empty { padding: 10px 12px; font-size: 0.78rem; color: var(--gris-texto); font-style: italic; display: none; }
.multiselect-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.chip { display: flex; align-items: center; gap: 6px; background: var(--azul-claro); color: var(--azul); border-radius: 999px; padding: 5px 8px 5px 12px; font-size: 0.76rem; font-weight: 500; }
.chip button { background: none; border: none; color: var(--azul); cursor: pointer; font-size: 14px; line-height: 1; padding: 2px; display: flex; }
.chip button:hover { color: #991b1b; }

/* Pestañas del formulario: Información / Platos / Personal. Cada
   .wizard-panel arranca oculto salvo el que tiene .activo; el botón de
   pestaña activo se remarca con el mismo verde traslucido que .btn-primary
   para que quede claro en qué paso está parado. */
.wizard-tabs { display: flex; gap: 6px; margin-bottom: 22px; border-bottom: 1px solid var(--gris-borde); }
.wizard-tab {
  flex: 1; background: none; border: none; border-bottom: 2px solid transparent;
  padding: 12px 10px; font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--gris-texto);
  cursor: pointer; transition: all var(--tr);
}
.wizard-tab:hover { color: var(--negro); }
.wizard-tab.activo { color: var(--azul); border-bottom-color: var(--azul); }
.wizard-panel { display: none; }
.wizard-panel.activo { display: block; }

@media (max-width: 600px) {
  .wizard-tabs { margin-bottom: 16px; }
  .wizard-tab { font-size: 0.62rem; padding: 10px 4px; letter-spacing: 0.03em; }
}

@media (max-width: 900px) {
  .field-row { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  /* Achicado para que entre cómodo en un celular: menos relleno, textos
     un poco más chicos, y la lista desplegable con menos alto (si no,
     una lista larga como "Personal" ocupa toda la pantalla y hay que
     scrollear demasiado para llegar al resto del formulario). */
  .form-card { padding: 14px; }
  .form-card-title { font-size: 0.66rem; margin-bottom: 14px; }
  .form-section { padding-top: 16px; margin-top: 16px; }
  .field { margin-bottom: 11px; }
  .field label, .multiselect > label.ms-label { font-size: 0.65rem; }
  .field input, .field textarea, .multiselect-input { padding: 9px 10px; font-size: 0.82rem; }
  .multiselect { margin-bottom: 12px; }
  .multiselect-panel { max-height: 170px; }
  .multiselect-option { padding: 8px 10px; font-size: 0.8rem; gap: 8px; }
  .multiselect-chips { gap: 5px; }
  .chip { font-size: 0.72rem; padding: 4px 6px 4px 10px; }
  .subtotal-row, .item-row { font-size: 0.78rem; }
  .item-detalle { font-size: 0.7rem; }
  /* Fila de "agregar vajilla" (2 inputs + botón, sin flex-wrap):
     en un celular angosto los inputs no se achican lo suficiente y la
     fila se corta — se envuelve para que cada campo pase a su propia
     línea si hace falta. */
  .add-row { flex-wrap: wrap; }
  .add-row input { flex: 1 1 100%; min-width: 0; }
  .item-row { flex-wrap: wrap; }
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">




<% const editando = typeof evento !== 'undefined' && evento; %>
<% const urlCancelar = editando ? ('/eventos/' + evento.id) : '/eventos'; %>
<div class="seccion-header">
  <div class="seccion-header-left">
    <h1 class="seccion-titulo" data-i18n><%= editando ? 'Editar evento' : 'Nuevo evento' %></h1>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <a href="<%= urlCancelar %>" class="btn-chico-azul"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span data-i18n><%= editando ? 'Volver' : 'Eventos' %></span></a>
    <button type="submit" form="form-evento" class="btn-chico-verde">
      <i class="ti ti-device-floppy" aria-hidden="true"></i> <span data-i18n><%= editando ? 'Guardar cambios' : 'Guardar evento' %></span>
    </button>
    <a href="<%= urlCancelar %>" id="link-cancelar" class="btn-chico-rojo" onclick="event.preventDefault(); abrirConfirmCancelar();">
      <i class="ti ti-x" aria-hidden="true"></i> <span data-i18n>Cancelar</span>
    </a>
  </div>
</div>

<!-- Cartel de confirmación para Cancelar (mismo estilo de tarjeta que el resto del sitio, no el cartel del navegador) -->
<div class="confirm-overlay" id="confirm-cancelar-overlay">
  <div class="confirm-box">
    <p class="confirm-titulo" data-i18n>¿Seguro que querés cancelar?</p>
    <p class="confirm-texto" data-i18n><%= editando ? 'Se van a perder los cambios que hiciste acá.' : 'Se va a perder lo que cargaste en este formulario.' %></p>
    <div class="confirm-acciones">
      <button type="button" class="btn-chico-azul" onclick="cerrarConfirmCancelar()" data-i18n>Seguir cargando</button>
      <a href="<%= urlCancelar %>" class="btn-chico-rojo" data-i18n>Sí, cancelar</a>
    </div>
  </div>
</div>

<form method="POST" action="<%= editando ? ('/eventos/' + evento.id + '/editar') : '/eventos/nuevo' %>" id="form-evento">
<input type="hidden" name="bocaditos_json" id="bocaditos_json" value="[]">
<input type="hidden" name="personal_json" id="personal_json" value="[]">
<input type="hidden" name="vajilla_json" id="vajilla_json" value="[]">

<div class="form-card">

  <!-- Pestañas: Información / Platos / Vajilla / Personal / Costo -->
  <div class="wizard-tabs">
    <button type="button" class="wizard-tab activo" data-target="panel-info">1. <span data-i18n>Información</span></button>
    <button type="button" class="wizard-tab" data-target="panel-platos">2. <span data-i18n>Platos</span></button>
    <button type="button" class="wizard-tab" data-target="panel-vajilla">3. <span data-i18n>Vajilla</span></button>
    <button type="button" class="wizard-tab" data-target="panel-personal">4. <span data-i18n>Personal</span></button>
    <button type="button" class="wizard-tab" data-target="panel-costo">5. <span data-i18n>Costo</span></button>
  </div>

  <!-- ── Pestaña 1: Información ── -->
  <div class="wizard-panel activo" id="panel-info">

    <div class="field">
      <label data-i18n>Nombre del evento</label>
      <input type="text" name="nombre" placeholder="Ej: Casamiento García" data-i18n-ph="Ej: Casamiento García" value="<%= editando ? evento.nombre : '' %>" required>
    </div>

    <div class="field">
      <label data-i18n>Fecha</label>
      <input type="date" name="fecha" id="campo-fecha" value="<%= editando ? evento.fecha : '' %>" required>
    </div>

    <div class="field" style="margin-bottom:0;">
      <label data-i18n>Cantidad de comensales</label>
      <input type="number" id="input-comensales" name="comensales" min="1" placeholder="Ej: 50" data-i18n-ph="Ej: 50" value="<%= editando && evento.comensales ? evento.comensales : '' %>" oninput="recalcularBocaditos()">
    </div>

  </div>

  <!-- ── Pestaña 2: Platos ── -->
  <div class="wizard-panel" id="panel-platos">

    <% const NOMBRES_CATEGORIA = { frios: 'Fríos', calientes: 'Calientes', principales: 'Platos principales', postres: 'Postres' }; %>
    <% ['frios','calientes','principales','postres'].forEach(cat => { %>
    <div class="multiselect" data-nombre-categoria="<%= cat %>">
      <label class="ms-label" data-i18n><%= NOMBRES_CATEGORIA[cat] %></label>
      <div class="multiselect-input-wrap">
        <input type="text" class="multiselect-input" placeholder="Buscar <%= NOMBRES_CATEGORIA[cat].toLowerCase() %>..." data-i18n-ph="Buscar <%= NOMBRES_CATEGORIA[cat].toLowerCase() %>...">
        <i class="ti ti-search" aria-hidden="true"></i>
      </div>
      <div class="multiselect-panel">
        <% (catalogoBocaditos[cat] || []).forEach(b => { %>
        <% const bocaditoYaElegido = editando && typeof bocaditosSeleccionados !== 'undefined' && bocaditosSeleccionados.includes(b.id); %>
        <label class="multiselect-option" data-buscar="<%= b.nombre.toLowerCase() %>" data-nombre="<%= b.nombre %>">
          <input type="checkbox" class="chk-bocadito" id="chk-<%= cat %>-<%= b.id %>"
                 data-id="<%= b.id %>" data-categoria="<%= cat %>" data-nombre="<%= b.nombre %>"
                 data-vajilla-texto="<%= b.vajilla_texto || '' %>" data-vajilla-capacidad="<%= b.vajilla_capacidad || 1 %>"
                 data-costo-unitario="<%= b.costo_unitario || 0 %>"
                 <%= bocaditoYaElegido ? 'checked' : '' %>
                 onchange="recalcularBocaditos()">
          <span><%= b.nombre %></span>
        </label>
        <% }) %>
        <p class="multiselect-empty" data-i18n>No se encontraron platos.</p>
      </div>
    </div>
    <% }) %>

    <!-- Bocaditos calculados -->
    <div class="form-section">
      <p class="form-card-title"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i> <span data-i18n>Bocaditos calculados</span></p>

      <div class="subtotal-row" style="border-top:none;padding-top:0;margin-top:0;">
        <span data-i18n>Platos elegidos:</span>
        <strong id="bocaditos-count">0</strong>
      </div>

      <div id="resumen-bocaditos" class="items-list" style="margin-top:8px;">
        <p class="list-empty" data-i18n>Elegí comensales y platos para ver las cantidades.</p>
      </div>

      <!-- El costo estimado ($) ya no se repite acá: ahora tiene su propia
           pestaña "5. Costo" con el mismo dato. -->
      <strong id="bocaditos-costo-estimado" style="display:none;"></strong>
    </div>

  </div>

  <!-- ── Pestaña 3: Vajilla ──
       Ojo: la lista calculada sale directo de los platos elegidos en la
       pestaña "Platos" (recalcularBocaditos() la arma junto con todo lo
       demás), así que sigue tan "linkeada" a los platos como antes — nada
       más cambió de pestaña, no la lógica. -->
  <div class="wizard-panel" id="panel-vajilla">

    <p class="form-card-title"><i class="ti ti-bowl" aria-hidden="true"></i> <span data-i18n>Vajilla necesaria</span></p>

    <p style="font-size:0.68rem;color:var(--gris-texto);margin-bottom:10px;" data-i18n>
      Se calcula sola a partir de los bocaditos elegidos en la pestaña "Platos". Si hace falta algo extra (cubiertos, servilleteros, etc.), agregalo a mano acá abajo.
    </p>

    <div id="lista-vajilla-calculada" class="items-list">
      <p class="list-empty" data-i18n>Todavía no hay bocaditos elegidos.</p>
    </div>

    <div class="add-row" style="margin-top:14px;">
      <input type="text" id="vajilla-nombre" placeholder="Vajilla extra (opcional)" data-i18n-ph="Vajilla extra (opcional)">
      <input type="number" id="vajilla-cantidad" placeholder="Cantidad" data-i18n-ph="Cantidad" min="1" value="1">
      <button type="button" class="btn-add" onclick="agregarVajilla()">
        <i class="ti ti-plus" aria-hidden="true"></i>
      </button>
    </div>

    <div id="lista-vajilla" class="items-list">
      <p class="list-empty" data-i18n>No hay vajilla extra agregada todavía.</p>
    </div>

  </div>

  <!-- ── Pestaña 4: Personal ── -->
  <div class="wizard-panel" id="panel-personal">

    <p style="font-size:0.78rem;color:var(--gris-texto);margin-bottom:12px;background:var(--gris-fondo);border-radius:8px;padding:10px 12px;">
      <i class="ti ti-info-circle" aria-hidden="true"></i> <span data-i18n>Según la cantidad de comensales hacen falta</span>
      <strong id="personal-requerido-texto" data-i18n>— cocineros de servicio y — de producción</strong>
      <span data-i18n>(2 de servicio y 4 de producción cada 50 comensales). Elegí de la lista quiénes van a cubrir esos puestos.</span>
    </p>

    <% if (personal.length > 0) { %>
    <div class="multiselect">
      <div class="multiselect-input-wrap">
        <input type="text" class="multiselect-input" placeholder="Buscar empleado..." data-i18n-ph="Buscar empleado...">
        <i class="ti ti-search" aria-hidden="true"></i>
      </div>
      <div class="multiselect-panel">
        <% personal.forEach(p => { %>
        <% const personalYaElegido = editando && typeof personalSeleccionado !== 'undefined' && personalSeleccionado.includes(p.id); %>
        <label class="multiselect-option" data-buscar="<%= (p.nombre + ' ' + p.rol).toLowerCase() %>" data-nombre="<%= p.nombre %>">
          <input type="checkbox" class="chk-personal" id="chk-personal-<%= p.id %>" value="<%= p.id %>" data-nombre="<%= p.nombre %>" <%= personalYaElegido ? 'checked' : '' %>>
          <span class="personal-nombre"><%= p.nombre %></span>
          <span class="personal-rol"><%= p.rol %></span>
        </label>
        <% }) %>
        <p class="multiselect-empty" data-i18n>No se encontraron empleados.</p>
      </div>
      <div class="multiselect-chips"></div>
    </div>
    <% } else { %>
      <p class="list-empty" data-i18n>No hay personal registrado todavía.</p>
    <% } %>

    <div class="subtotal-row">
      <span data-i18n>Personal seleccionado:</span>
      <strong id="personal-count">0 personas</strong>
    </div>
  </div>

  <!-- ── Pestaña 5: Costo ──
       Resumen de lo elegido hasta ahora (mismos datos que ya se calculan
       en recalcularBocaditos(), mostrados acá aparte para tener una sola
       pantalla con el total). No es la fuente de verdad: el servidor
       vuelve a calcular todo de cero al guardar el evento. -->
  <div class="wizard-panel" id="panel-costo">

    <p class="form-card-title"><i class="ti ti-report-money" aria-hidden="true"></i> <span data-i18n>Costo de lo elegido hasta ahora</span></p>

    <div class="subtotal-row" style="border-top:none;padding-top:0;margin-top:0;">
      <span data-i18n>Platos elegidos:</span>
      <strong id="costo-bocaditos-count">0</strong>
    </div>

    <div id="resumen-costo" class="items-list" style="margin-top:8px;">
      <p class="list-empty" data-i18n>Todavía no elegiste platos en la pestaña "Platos".</p>
    </div>

    <div class="subtotal-row">
      <span data-i18n>Costo total estimado:</span>
      <strong id="costo-total-estimado">$0.00</strong>
    </div>

    <p style="font-size:0.66rem;color:var(--gris-texto);margin-top:4px;">
      <span data-i18n>Estimado según el costo por bocado cargado en</span> <a href="/eventos/bocaditos-costos" target="_blank" data-i18n>Costos de bocaditos</a>. <span data-i18n>El servidor vuelve a calcularlo al guardar.</span>
    </p>

  </div>

</div>

</form>


<script>
// ── Estado ──────────────────────────────────────────
// Al editar, arranca con la vajilla extra que ya tenía cargada el evento
// (la calculada automáticamente NO va acá: sale sola de los bocaditos
// tildados arriba, igual que al crear uno nuevo).
let vajilla = <%- JSON.stringify((editando && typeof vajillaExtra !== 'undefined') ? vajillaExtra : []) %>;
let bocaditosCalculados = []; // último resultado de recalcularBocaditos(), para mandar al guardar

// ── Bocaditos: misma fórmula que src/services/calculoBocaditos.js ───
// (se duplica acá en JS solo para mostrar el cálculo en vivo mientras se
// elige — el servidor SIEMPRE recalcula todo de nuevo al guardar, así que
// esto es nada más una vista previa, no la fuente de verdad).
const BOCADOS_POR_PERSONA_FRIOS_CALIENTES = 0.82;
const BOCADOS_POR_PERSONA_PRINCIPAL_UNICO = 1.5;
const BOCADOS_POR_PERSONA_PRINCIPAL_MULTIPLE = 1;
const BOCADOS_POR_PERSONA_POSTRES_TOTAL = 2;
const NOMBRES_CATEGORIA_JS = { frios: 'Fríos', calientes: 'Calientes', principales: 'Platos principales', postres: 'Postres' };

function recalcularBocaditos() {
  const pax = parseInt(document.getElementById('input-comensales').value) || 0;
  const chks = [...document.querySelectorAll('.chk-bocadito:checked')];
  document.getElementById('bocaditos-count').textContent = chks.length;

  const porCategoria = { frios: 0, calientes: 0, principales: 0, postres: 0 };
  chks.forEach(c => { porCategoria[c.dataset.categoria] = (porCategoria[c.dataset.categoria]||0) + 1; });

  bocaditosCalculados = chks.map(c => {
    const categoria = c.dataset.categoria;
    let bocadosPorPersona = 0;
    if (categoria === 'frios' || categoria === 'calientes') {
      bocadosPorPersona = BOCADOS_POR_PERSONA_FRIOS_CALIENTES;
    } else if (categoria === 'principales') {
      bocadosPorPersona = porCategoria.principales <= 1 ? BOCADOS_POR_PERSONA_PRINCIPAL_UNICO : BOCADOS_POR_PERSONA_PRINCIPAL_MULTIPLE;
    } else if (categoria === 'postres') {
      bocadosPorPersona = BOCADOS_POR_PERSONA_POSTRES_TOTAL / (porCategoria.postres || 1);
    }
    const bocados_totales = Math.round(bocadosPorPersona * pax);
    const capacidad = parseInt(c.dataset.vajillaCapacidad) || 1;
    const vajilla_cantidad = bocados_totales > 0 ? Math.ceil(bocados_totales / capacidad) : 0;
    const costo_unitario = parseFloat(c.dataset.costoUnitario) || 0;
    const costo_total = Math.round(bocados_totales * costo_unitario * 100) / 100;
    return {
      id: c.dataset.id, categoria, nombre: c.dataset.nombre,
      vajilla_texto: c.dataset.vajillaTexto, vajilla_capacidad: capacidad,
      bocados_totales, vajilla_cantidad, costo_unitario, costo_total,
    };
  });

  // Resumen de bocados
  // tHilton() traduce estos textos armados en JS si hay un idioma distinto
  // de español elegido (ver public/js/i18n.js) — no son data-i18n porque se
  // reescriben en vivo acá, no vienen ya armados desde el servidor.
  const elResumen = document.getElementById('resumen-bocaditos');
  if (!bocaditosCalculados.length) {
    elResumen.innerHTML = `<p class="list-empty" data-i18n>${tHilton('Elegí comensales y platos para ver las cantidades.')}</p>`;
  } else {
    elResumen.innerHTML = bocaditosCalculados.map(b => `
      <div class="item-row">
        <span class="item-nombre">${b.nombre}</span>
        <span class="item-detalle"><span data-i18n>${tHilton(NOMBRES_CATEGORIA_JS[b.categoria])}</span>${b.costo_unitario > 0 ? ' · $' + b.costo_total.toFixed(2) : ''}</span>
        <span class="item-costo">${b.bocados_totales} <span data-i18n>${tHilton('bocados')}</span></span>
      </div>
    `).join('');
  }

  const costoEstimadoTotal = bocaditosCalculados.reduce((acc, b) => acc + b.costo_total, 0);
  document.getElementById('bocaditos-costo-estimado').textContent = '$' + costoEstimadoTotal.toFixed(2);

  // Misma info, repetida en la pestaña "Costo" para tener un resumen aparte.
  document.getElementById('costo-bocaditos-count').textContent = chks.length;
  const elResumenCosto = document.getElementById('resumen-costo');
  if (!bocaditosCalculados.length) {
    elResumenCosto.innerHTML = `<p class="list-empty" data-i18n>${tHilton('Todavía no elegiste platos en la pestaña "Platos".')}</p>`;
  } else {
    elResumenCosto.innerHTML = bocaditosCalculados.map(b => `
      <div class="item-row">
        <span class="item-nombre">${b.nombre}</span>
        <span class="item-detalle"><span data-i18n>${tHilton(NOMBRES_CATEGORIA_JS[b.categoria])}</span> · ${b.bocados_totales} <span data-i18n>${tHilton('bocados')}</span></span>
        <span class="item-costo">$${b.costo_total.toFixed(2)}</span>
      </div>
    `).join('');
  }
  document.getElementById('costo-total-estimado').textContent = '$' + costoEstimadoTotal.toFixed(2);

  // Vajilla calculada (una fila por plato, agrupando el mismo tipo de vajilla del mismo plato)
  const elVajillaCalc = document.getElementById('lista-vajilla-calculada');
  const conVajilla = bocaditosCalculados.filter(b => b.vajilla_texto && b.vajilla_cantidad > 0);
  if (!conVajilla.length) {
    elVajillaCalc.innerHTML = `<p class="list-empty" data-i18n>${tHilton('Todavía no hay bocaditos elegidos.')}</p>`;
  } else {
    elVajillaCalc.innerHTML = conVajilla.map(b => `
      <div class="item-row">
        <span class="item-nombre">${b.vajilla_texto}</span>
        <span class="item-detalle"><span data-i18n>${tHilton('para')}</span> ${b.nombre}</span>
        <span class="item-costo">${b.vajilla_cantidad}</span>
      </div>
    `).join('');
  }

  document.getElementById('bocaditos_json').value = JSON.stringify(bocaditosCalculados);

  // Personal requerido (2 de servicio + 4 de producción cada 50 comensales, redondeando para arriba)
  const bloques = pax > 0 ? Math.ceil(pax / 50) : 0;
  const servicio = bloques * 2, produccion = bloques * 4;
  document.getElementById('personal-requerido-texto').textContent =
    (pax > 0 ? `${servicio} cocineros de servicio y ${produccion} de producción` : '— cocineros de servicio y — de producción');
}

// ── Personal ─────────────────────────────────────────
document.querySelectorAll('.chk-personal').forEach(chk => {
  chk.addEventListener('change', actualizarPersonal);
});

function actualizarPersonal() {
  const sel = [...document.querySelectorAll('.chk-personal:checked')];
  document.getElementById('personal-count').textContent = sel.length + ' persona' + (sel.length !== 1 ? 's' : '');
  document.getElementById('personal_json').value = JSON.stringify(sel.map(c => c.value));
}

// ── Vajilla ──────────────────────────────────────────
function agregarVajilla() {
  const nombre = document.getElementById('vajilla-nombre').value.trim();
  const cantidad = parseInt(document.getElementById('vajilla-cantidad').value) || 1;
  if (!nombre) { document.getElementById('vajilla-nombre').focus(); return; }
  vajilla.push({ nombre, cantidad });
  document.getElementById('vajilla-nombre').value = '';
  document.getElementById('vajilla-cantidad').value = '1';
  renderVajilla();
}

function eliminarVajilla(i) {
  vajilla.splice(i, 1);
  renderVajilla();
}

function renderVajilla() {
  const el = document.getElementById('lista-vajilla');
  if (!vajilla.length) {
    el.innerHTML = `<p class="list-empty" data-i18n>${tHilton('No hay vajilla agregada todavía.')}</p>`;
    return;
  }
  el.innerHTML = vajilla.map((v, i) => `
    <div class="item-row">
      <span class="item-nombre">${v.nombre}</span>
      <span class="item-detalle">${v.cantidad} <span data-i18n>${tHilton('unidades')}</span></span>
      <button type="button" class="btn-remove" onclick="eliminarVajilla(${i})">
        <i class="ti ti-x" aria-hidden="true"></i>
      </button>
    </div>
  `).join('');
  document.getElementById('vajilla_json').value = JSON.stringify(vajilla);
}

// ── Desplegables con buscador (fríos/calientes/principales/postres y
// personal) ────────────────────────────────────────────────────────
// Envuelven checkboxes que ya existían (.chk-bocadito / .chk-personal):
// el buscador solo filtra qué filas se ven, y abajo se arma la lista de
// "chips" con lo tildado para sacar algo sin tener que reabrir la lista.
const TODOS_LOS_PANELES_MULTISELECT = [];

function cerrarOtrosPaneles(exceptoPanel) {
  TODOS_LOS_PANELES_MULTISELECT.forEach(p => { if (p !== exceptoPanel) p.classList.remove('abierto'); });
}

function initMultiselect(container) {
  const input = container.querySelector('.multiselect-input');
  const panel = container.querySelector('.multiselect-panel');
  const chipsEl = container.querySelector('.multiselect-chips');
  const vacioMsg = container.querySelector('.multiselect-empty');
  const opciones = [...container.querySelectorAll('.multiselect-option')];
  if (!input || !panel) return;
  TODOS_LOS_PANELES_MULTISELECT.push(panel);

  function filtrar() {
    const q = input.value.trim().toLowerCase();
    let visibles = 0;
    opciones.forEach(op => {
      const coincide = op.dataset.buscar.includes(q);
      op.classList.toggle('oculto', !coincide);
      if (coincide) visibles++;
    });
    if (vacioMsg) vacioMsg.style.display = visibles ? 'none' : 'block';
  }

  function renderChips() {
    if (!chipsEl) return; // esta categoría no muestra chips (ver más abajo en el HTML)
    const marcadas = opciones.filter(op => op.querySelector('input').checked);
    if (!marcadas.length) { chipsEl.innerHTML = ''; return; }
    chipsEl.innerHTML = marcadas.map(op => {
      const chk = op.querySelector('input');
      return `<span class="chip">${op.dataset.nombre}<button type="button" data-target="${chk.id}"><i class="ti ti-x" aria-hidden="true"></i></button></span>`;
    }).join('');
    chipsEl.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const chk = document.getElementById(btn.dataset.target);
        if (!chk) return;
        chk.checked = false;
        chk.dispatchEvent(new Event('change'));
      });
    });
  }

  input.addEventListener('focus', () => { cerrarOtrosPaneles(panel); panel.classList.add('abierto'); });
  input.addEventListener('input', filtrar);
  // Escape cierra el desplegable sin tener que ir a clickear afuera.
  input.addEventListener('keydown', e => {
    if (e.key === 'Escape') { panel.classList.remove('abierto'); input.blur(); }
  });
  opciones.forEach(op => op.querySelector('input').addEventListener('change', renderChips));
  document.addEventListener('click', e => {
    if (!container.contains(e.target)) panel.classList.remove('abierto');
  });

  filtrar();
  renderChips();
}

document.querySelectorAll('.multiselect').forEach(initMultiselect);

// Al editar, los checkboxes ya vienen tildados desde el servidor (arriba),
// pero las tablas de resumen (bocaditos, vajilla calculada, costo, personal)
// solo se arman cuando algo dispara un "change" — así que se recalcula todo
// una vez al cargar la página, para que se vea consistente desde el arranque.
renderVajilla();
<% if (editando) { %>
recalcularBocaditos();
actualizarPersonal();
<% } %>

// ── Enter en el input de vajilla extra ────────────────
document.getElementById('vajilla-cantidad').addEventListener('keydown', e => { if(e.key==='Enter'){e.preventDefault();agregarVajilla();} });

// ── Cartel de confirmación de Cancelar ────────────────
function abrirConfirmCancelar() {
  document.getElementById('confirm-cancelar-overlay').classList.add('abierto');
}
function cerrarConfirmCancelar() {
  document.getElementById('confirm-cancelar-overlay').classList.remove('abierto');
}
// Clickear el fondo oscuro (fuera de la tarjeta) también cierra, y Escape también.
document.getElementById('confirm-cancelar-overlay').addEventListener('click', e => {
  if (e.target.id === 'confirm-cancelar-overlay') cerrarConfirmCancelar();
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') cerrarConfirmCancelar();
});

// ── Pestañas del formulario (Información / Platos / Personal) ────────
const wizardTabs = [...document.querySelectorAll('.wizard-tab')];
function irAPestana(target) {
  wizardTabs.forEach(t => t.classList.toggle('activo', t.dataset.target === target));
  document.querySelectorAll('.wizard-panel').forEach(p => p.classList.toggle('activo', p.id === target));
}
wizardTabs.forEach(tab => tab.addEventListener('click', () => irAPestana(tab.dataset.target)));

// Nombre y Fecha (required) viven en la pestaña "Información": si el
// usuario los deja vacíos parado en otra pestaña, esos campos quedan con
// display:none y el navegador ni siquiera llega a disparar el evento
// "submit" (la validación nativa los encuentra inválidos pero no puede
// enfocarlos por estar ocultos, y aborta el envío en silencio — no hay
// forma de engancharse ahí). Por eso el chequeo se hace un paso antes, en
// el click del botón "Guardar evento", con la misma lógica que usaría el
// navegador pero mostrando primero la pestaña donde está el problema.
const formEvento = document.getElementById('form-evento');
document.querySelector('button[form="form-evento"]').addEventListener('click', function (e) {
  const campoNombre = formEvento.querySelector('[name="nombre"]');
  const campoFecha = formEvento.querySelector('[name="fecha"]');
  if ((campoNombre && !campoNombre.value.trim()) || (campoFecha && !campoFecha.value)) {
    e.preventDefault();
    irAPestana('panel-info');
    // Recién con la pestaña visible el navegador puede enfocar el campo y
    // mostrar el globito de validación nativo.
    requestAnimationFrame(() => formEvento.reportValidity());
  }
});
</script>

  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>
</body>
</html>
