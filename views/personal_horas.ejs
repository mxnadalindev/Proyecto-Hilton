<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Horas trabajadas — <%= empleado.nombre %> — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
/* Botón "chico" (32px), mismo molde que el resto de la aplicación
   (Recetas, Costos, Miembro de equipo), en vez de los 40px de .btn-secondary. */
.btn-chico-azul{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);background:rgba(0,47,97,0.12);color:#002f61;border:1px solid rgba(0,47,97,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-azul:hover{background:rgba(0,47,97,0.20);}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'personal' }) %>

  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label" data-i18n>Miembro de equipo</p>
        <h1 class="seccion-titulo"><span data-i18n>Horas de</span> <%= empleado.nombre %></h1>
      </div>
      <a href="/miembros-de-equipo" class="btn-chico-azul"><i class="ti ti-arrow-left"></i> <span data-i18n>Volver al equipo</span></a>
    </div>

    <div style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:16px;padding:24px 28px;margin-bottom:24px;box-shadow:var(--sombra);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
      <div style="display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:50%;background:var(--azul-claro);color:var(--azul);display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:600;">
          <%= empleado.nombre.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-size:1rem;font-weight:600;color:var(--negro);"><%= empleado.nombre %></div>
          <div style="font-size:0.78rem;color:var(--gris-texto);">
            <%= empleado.modalidad %><% if (!empleado.modalidad) { %><span data-i18n>Sin modalidad</span><% } %><% if (empleado.legajo) { %> · <span data-i18n>CUIL</span> <%= empleado.legajo %><% } %>
          </div>
        </div>
      </div>
      <div style="text-align:right;">
        <p style="font-size:0.68rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--gris-texto);margin:0 0 4px;" data-i18n>Total histórico</p>
        <p style="font-size:1.6rem;font-weight:700;color:var(--negro);margin:0;"><%= totalGeneral %><span data-i18n>hs</span></p>
      </div>
    </div>

    <% if (meses.length === 0) { %>
      <div style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:16px;padding:40px;text-align:center;color:var(--gris-texto);font-size:0.85rem;" data-i18n>Todavía no tiene ningún evento marcado como "vino" — cuando el encargado empiece a marcar asistencia en los eventos, va a aparecer acá.</div>
    <% } %>

    <% meses.forEach(m => { %>
    <div style="background:var(--blanco);border:1px solid var(--gris-borde);border-radius:16px;padding:24px 28px;margin-bottom:16px;box-shadow:var(--sombra);">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <h2 style="font-size:1rem;font-weight:600;color:var(--negro);text-transform:capitalize;"><%= m.etiqueta %></h2>
        <span style="font-size:0.85rem;font-weight:700;color:var(--azul);"><%= m.subtotal %><span data-i18n>hs</span></span>
      </div>
      <div class="tabla-wrap">
        <table class="tabla" style="width:100%;">
          <thead>
            <tr><th data-i18n>Fecha</th><th data-i18n>Evento</th><th data-i18n>Horario</th><th style="text-align:right;" data-i18n>Horas</th></tr>
          </thead>
          <tbody>
            <% m.eventos.forEach(ev => { %>
            <tr>
              <td style="font-size:0.82rem;"><%= new Date(ev.fecha+'T00:00:00').toLocaleDateString('es-AR',{weekday:'short',day:'numeric',month:'short'}) %></td>
              <td style="font-size:0.82rem;font-weight:500;"><%= ev.nombre %></td>
              <td style="font-size:0.82rem;color:var(--gris-texto);"><% if (ev.hora_hasta) { %><%= ev.hora_desde %> <span data-i18n>a</span> <%= ev.hora_hasta %><% } else { %><span data-i18n>desde las</span> <%= ev.hora_desde %><% } %></td>
              <td style="font-size:0.82rem;text-align:right;font-weight:600;"><%= ev.horas %><span data-i18n>hs</span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% }) %>
  </main>
  <%- include('partials/mobile-nav', { path: 'personal' }) %>
</div>
</body>
</html>
