<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orden de evento — <%= evento.nombre %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
  * { box-sizing: border-box; }
  body { font-family: var(--font-sans); color: var(--negro); margin: 0; background: var(--gris-fondo); }
  .hoja { max-width: 800px; margin: 24px auto; background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 10px; padding: 36px 40px; box-shadow: var(--sombra); }
  .barra-acciones { max-width: 800px; margin: 16px auto 0; display: flex; justify-content: space-between; align-items: center; padding: 0 4px; }

  /* Mismo estilo "vidrio" azul/verde traslúcido que .btn-secondary/.btn-primary
     en style.css (usado en Horas Extra, Inventario AYB, etc.): volver = azul
     traslúcido, imprimir (acción principal de esta pantalla) = verde traslúcido. */
  .btn-volver-beo {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    background: rgba(0,47,97,0.12); color: #002f61;
    border: 1px solid rgba(0,47,97,0.28); border-radius: 8px;
    padding: 0 12px; box-sizing: border-box; height: 32px;
    font-family: var(--font-sans); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; transition: all var(--tr);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .btn-volver-beo:hover { background: rgba(0,47,97,0.20); }

  .btn-imprimir {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    background: rgba(6,147,126,0.14); color: #06937e;
    border: 1px solid rgba(6,147,126,0.32); border-radius: 8px;
    padding: 0 12px; box-sizing: border-box; height: 32px;
    font-family: var(--font-sans); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; transition: all var(--tr);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .btn-imprimir:hover { background: rgba(6,147,126,0.24); }

  /* "Descargar PDF" separado de "Imprimir" — mismo box-model, color navy
     traslúcido (igual que "Volver al evento") para diferenciarlo del verde
     de Imprimir, que sigue siendo la acción principal de esta pantalla. */
  .btn-descargar-pdf {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    background: rgba(0,47,97,0.12); color: #002f61;
    border: 1px solid rgba(0,47,97,0.28); border-radius: 8px;
    padding: 0 12px; box-sizing: border-box; height: 32px;
    font-family: var(--font-sans); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; transition: all var(--tr);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .btn-descargar-pdf:hover { background: rgba(0,47,97,0.20); }
  .btn-descargar-pdf[aria-disabled="true"] { opacity: 0.6; cursor: default; pointer-events: none; }

  .encabezado { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid var(--azul); padding-bottom: 16px; margin-bottom: 20px; }
  .encabezado h1 { font-size: 1.5rem; margin: 0 0 4px; color: var(--azul); }
  .encabezado .subtitulo { font-size: 0.8rem; color: var(--gris-texto); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }
  .encabezado .hotel { text-align: right; font-size: 0.78rem; color: var(--gris-texto); }
  .encabezado .hotel strong { display: block; color: var(--azul); font-size: 0.92rem; margin-bottom: 2px; }

  .datos-evento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
  .dato { background: var(--gris-fondo); border-radius: 8px; padding: 10px 12px; }
  .dato-label { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gris-texto); margin-bottom: 3px; }
  .dato-valor { font-size: 0.95rem; font-weight: 600; color: var(--negro); }

  .seccion { margin-bottom: 22px; }
  .seccion-titulo { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--azul); border-bottom: 1px solid var(--gris-borde); padding-bottom: 6px; margin-bottom: 10px; }
  .categoria-titulo { font-size: 0.7rem; font-weight: 700; color: var(--gris-texto); text-transform: uppercase; letter-spacing: 0.06em; margin: 10px 0 4px; }

  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th { text-align: left; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gris-texto); padding: 5px 6px; border-bottom: 1px solid var(--gris-borde); }
  td { padding: 7px 6px; border-bottom: 1px solid var(--gris-borde); color: var(--negro); }
  tr:last-child td { border-bottom: none; }
  .num { text-align: right; white-space: nowrap; }
  .lista-simple { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.85rem; }
  .lista-simple span { display: inline-flex; gap: 4px; }
  .lista-simple .rol { color: var(--gris-texto); font-size: 0.75rem; }
  .vacio { font-size: 0.8rem; color: var(--gris-texto); font-style: italic; }

  .total-final { display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 6px; padding-top: 10px; border-top: 2px solid var(--azul); }
  .total-final .num-total { font-size: 1.3rem; font-weight: 700; color: var(--azul); }

  .pie { margin-top: 28px; padding-top: 12px; border-top: 1px solid var(--gris-borde); font-size: 0.68rem; color: var(--gris-texto); display: flex; justify-content: space-between; }

  @media print {
    body { background: #fff; }
    .barra-acciones { display: none; }
    .hoja { box-shadow: none; border: none; margin: 0; max-width: none; padding: 0; }
    @page { margin: 14mm; }
  }
</style>
</head>
<body>

<!-- Esta pantalla es una "hoja suelta" (no incluye partials/nav, es la orden
     para imprimir/descargar) así que, a diferencia del resto del sitio, acá
     hay que cargar el traductor a mano — en las demás pantallas ya viene
     con el header. -->
<script src="/js/i18n.js"></script>

<div class="barra-acciones">
  <a href="/eventos/<%= evento.id %>" class="btn-volver-beo"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span data-i18n>Volver al evento</span></a>
  <div style="display:flex;gap:10px;">
    <button class="btn-imprimir" onclick="window.print()"><i class="ti ti-printer" aria-hidden="true"></i> <span data-i18n>Imprimir</span></button>
    <a href="/eventos/<%= evento.id %>/beo/pdf" class="btn-descargar-pdf" id="btn-descargar-pdf" onclick="marcarDescargandoPdf(this)">
      <i class="ti ti-download" aria-hidden="true"></i> <span id="txt-descargar-pdf" data-i18n>Descargar PDF</span>
    </a>
  </div>
</div>
<script>
// El PDF se arma en el servidor (Puppeteer) recién al tocar el botón, así
// que tarda unos segundos — este cartel evita que parezca que no pasó nada
// mientras se genera. No bloquea nada: si tarda más de lo esperado, el
// texto vuelve solo y se puede tocar de nuevo sin problema.
// tHilton() traduce "Generando…" si hay un idioma distinto de español
// elegido (ver public/js/i18n.js) — así el cartel también queda traducido.
function marcarDescargandoPdf(el) {
  const txt = document.getElementById('txt-descargar-pdf');
  const original = txt.textContent;
  txt.textContent = window.tHilton ? window.tHilton('Generando…') : 'Generando…';
  el.setAttribute('aria-disabled', 'true');
  setTimeout(() => { txt.textContent = original; el.removeAttribute('aria-disabled'); }, 8000);
}
</script>

<div class="hoja">

  <div class="encabezado">
    <div>
      <p class="subtitulo" data-i18n>Orden de evento (BEO)</p>
      <h1><%= evento.nombre %></h1>
    </div>
    <div class="hotel">
      <strong>Hilton Buenos Aires</strong>
      <span data-i18n>Emitido el</span> <%= new Date().toLocaleDateString('es-AR') %>
    </div>
  </div>

  <div class="datos-evento">
    <div class="dato">
      <div class="dato-label" data-i18n>Fecha</div>
      <div class="dato-valor"><%= evento.fecha %></div>
    </div>
    <div class="dato">
      <div class="dato-label" data-i18n>Horario</div>
      <div class="dato-valor"><%= evento.hora_inicio ? evento.hora_inicio + (evento.hora_fin ? ' – ' + evento.hora_fin : '') : '—' %></div>
    </div>
    <div class="dato">
      <div class="dato-label" data-i18n>Comensales</div>
      <div class="dato-valor"><%= evento.comensales || '—' %></div>
    </div>
    <div class="dato">
      <div class="dato-label" data-i18n>Personal requerido</div>
      <div class="dato-valor">
        <% if (evento.comensales) { %>
          <%= evento.personal_servicio_requerido || 0 %> <span data-i18n>serv.</span> + <%= evento.personal_produccion_requerido || 0 %> <span data-i18n>prod.</span>
        <% } else { %>—<% } %>
      </div>
    </div>
  </div>

  <% if (bocaditos.length > 0) { %>
  <div class="seccion">
    <p class="seccion-titulo"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i> <span data-i18n>Menú — bocaditos</span></p>
    <% const NOMBRES_CATEGORIA_BEO = { frios: 'Fríos', calientes: 'Calientes', principales: 'Platos principales', postres: 'Postres' }; %>
    <% ['frios','calientes','principales','postres'].forEach(cat => { %>
      <% const items = bocaditos.filter(b => b.categoria === cat); %>
      <% if (items.length > 0) { %>
      <p class="categoria-titulo" data-i18n><%= NOMBRES_CATEGORIA_BEO[cat] %></p>
      <table>
        <thead><tr><th data-i18n>Plato</th><th class="num" data-i18n>Bocados</th><th data-i18n>Vajilla</th></tr></thead>
        <tbody>
          <% items.forEach(b => { %>
          <tr>
            <td><%= b.nombre %></td>
            <td class="num"><%= b.bocados_totales %></td>
            <td><%= b.vajilla_texto ? (b.vajilla_cantidad + ' × ' + b.vajilla_texto) : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    <% }) %>
  </div>
  <% } %>

  <% if (platos.length > 0) { %>
  <div class="seccion">
    <p class="seccion-titulo"><i class="ti ti-list-details" aria-hidden="true"></i> <span data-i18n>Otros platos del menú</span></p>
    <table>
      <thead><tr><th data-i18n>Plato</th><th class="num" data-i18n>Porciones</th><th class="num" data-i18n>Subtotal</th></tr></thead>
      <tbody>
        <% platos.forEach(p => { %>
        <tr>
          <td><%= p.plato_nombre %></td>
          <td class="num"><%= p.cantidad_porciones %></td>
          <td class="num">$<%= parseFloat(p.subtotal).toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="seccion">
    <p class="seccion-titulo"><i class="ti ti-bowl" aria-hidden="true"></i> <span data-i18n>Vajilla necesaria</span></p>
    <% if (vajilla.length > 0) { %>
      <table>
        <thead><tr><th data-i18n>Vajilla</th><th class="num" data-i18n>Cantidad</th></tr></thead>
        <tbody>
          <% vajilla.forEach(v => { %>
          <tr><td><%= v.vajilla_nombre %></td><td class="num"><%= v.cantidad %></td></tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="vacio" data-i18n>Sin vajilla registrada.</p>
    <% } %>
  </div>

  <div class="seccion">
    <p class="seccion-titulo"><i class="ti ti-users" aria-hidden="true"></i> <span data-i18n>Personal asignado</span></p>
    <% if (personal.length > 0) { %>
      <div class="lista-simple">
        <% personal.forEach(p => { %>
        <span><%= p.nombre %> <span class="rol">(<%= p.rol %>)</span></span>
        <% }) %>
      </div>
    <% } else { %>
      <p class="vacio" data-i18n>Sin personal asignado.</p>
    <% } %>
  </div>

  <% if (evento.descripcion) { %>
  <div class="seccion">
    <p class="seccion-titulo"><i class="ti ti-note" aria-hidden="true"></i> <span data-i18n>Notas</span></p>
    <p style="font-size:0.85rem;"><%= evento.descripcion %></p>
  </div>
  <% } %>

  <div class="total-final">
    <span style="font-size:0.78rem;color:var(--gris-texto);" data-i18n>Costo total del evento</span>
    <span class="num-total">$<%= parseFloat(evento.costo_total || 0).toFixed(2) %></span>
  </div>

  <div class="pie">
    <span><span data-i18n>Cargado por</span> <%= evento.creador || '—' %></span>
    <span data-i18n>Portal interno Hilton Buenos Aires</span>
  </div>

</div>

</body>
</html>
