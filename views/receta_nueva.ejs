<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= receta ? 'Editar receta' : 'Nueva receta' %> — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'recetas' }) %>

  <main class="main-content">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label"><a href="/recetas" class="back-link"><i class="ti ti-arrow-left"></i> Recetas</a></p>
        <h1 class="seccion-titulo"><%= receta ? 'Editar receta' : 'Nueva receta' %></h1>
      </div>
    </div>

    <form method="POST" action="<%= receta ? '/recetas/'+receta.id+'/editar' : '/recetas/nueva' %>" enctype="multipart/form-data">
      <div class="form-grid">

        <!-- Columna izquierda -->
        <div class="form-col">
          <div class="form-card">
            <p class="form-card-title"><i class="ti ti-info-circle"></i> Información general</p>
            <div class="field">
              <label>Nombre de la receta</label>
              <input type="text" name="nombre" placeholder="Ej: Risotto de hongos" value="<%= receta?.nombre || '' %>" required>
            </div>
            <div class="field">
              <label>Categoría</label>
              <select name="categoria" id="sel-categoria" onchange="toggleOtro('categoria')">
                <option value="">Seleccionar...</option>
                <% categorias.forEach(c => { %>
                  <option value="<%= c %>" <%= receta?.categoria === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
                <option value="otro" <%= (receta?.categoria && !categorias.includes(receta.categoria)) ? 'selected' : '' %>>Otra (escribir)</option>
              </select>
              <input type="text" name="categoria_otro" id="otro-categoria" placeholder="Escribir categoría..."
                     value="<%= (receta?.categoria && !categorias.includes(receta.categoria)) ? receta.categoria : '' %>"
                     style="display:<%= (receta?.categoria && !categorias.includes(receta.categoria)) ? 'block' : 'none' %>;margin-top:8px;">
            </div>
            <div class="field">
              <label>Área</label>
              <select name="area" id="sel-area" onchange="toggleOtro('area')">
                <option value="">Seleccionar...</option>
                <% areas.forEach(a => { %>
                  <option value="<%= a %>" <%= receta?.area === a ? 'selected' : '' %>><%= a %></option>
                <% }) %>
                <option value="otro" <%= (receta?.area && !areas.includes(receta.area)) ? 'selected' : '' %>>Otra (escribir)</option>
              </select>
              <input type="text" name="area_otro" id="otro-area" placeholder="Escribir área..."
                     value="<%= (receta?.area && !areas.includes(receta.area)) ? receta.area : '' %>"
                     style="display:<%= (receta?.area && !areas.includes(receta.area)) ? 'block' : 'none' %>;margin-top:8px;">
            </div>
            <div class="field">
              <label>Imagen de portada <% if (receta?.imagen) { %>(dejar vacío para conservar la actual)<% } %></label>
              <input type="file" name="imagen" accept="image/*" style="padding:8px 0;">
              <% if (receta?.imagen) { %>
                <img src="/uploads/<%= receta.imagen %>" style="width:100%;max-height:140px;object-fit:cover;border-radius:8px;margin-top:8px;">
              <% } %>
            </div>
          </div>

          <div class="form-card">
            <p class="form-card-title"><i class="ti ti-video"></i> Videos</p>
            <div id="videos-body"></div>
            <button type="button" class="btn-secondary" onclick="agregarFilaVideo()" style="margin-top:8px;">
              <i class="ti ti-plus"></i> Agregar video
            </button>
          </div>

          <div class="form-card">
            <p class="form-card-title"><i class="ti ti-photo"></i> Fotos (Preparación, Montaje, etc.)</p>
            <div id="fotos-body"></div>
            <button type="button" class="btn-secondary" onclick="agregarFilaFoto()" style="margin-top:8px;">
              <i class="ti ti-plus"></i> Agregar foto
            </button>
          </div>
        </div>

        <!-- Columna derecha -->
        <div class="form-col">
          <div class="form-card">
            <p class="form-card-title"><i class="ti ti-list"></i> Ingredientes</p>
            <p style="font-size:0.72rem;color:var(--gris-texto);margin:-10px 0 14px;">
              Se eligen de la lista de insumos cargada en Costos — el precio se toma en vivo de ahí.
            </p>
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
            <table class="tabla-ingredientes">
              <thead>
                <tr><th>Insumo</th><th>Cantidad</th><th>Unidad</th><th>Subtotal</th><th></th></tr>
              </thead>
              <tbody id="ingredientes-body"></tbody>
            </table>
            </div>
            <button type="button" class="btn-secondary" onclick="agregarFilaIngrediente()" style="margin-top:10px;">
              <i class="ti ti-plus"></i> Agregar ingrediente
            </button>
          </div>

          <div class="form-card">
            <p class="form-card-title"><i class="ti ti-list-numbers"></i> Procedimiento</p>
            <div class="field">
              <label>Describí cada paso</label>
              <textarea name="procedimiento" rows="9"
                placeholder="Paso 1: Mezclar la harina con los huevos.&#10;Paso 2: Agregar la leche de a poco.&#10;..."><%= receta?.procedimiento || '' %></textarea>
            </div>
          </div>
        </div>

      </div>

      <div class="form-actions">
        <a href="/recetas" class="btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary">
          <i class="ti ti-device-floppy"></i> Guardar receta
        </button>
      </div>
    </form>

  </main>
  <%- include('partials/mobile-nav', { path: 'recetas' }) %>
</div>

<style>
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-col { display: flex; flex-direction: column; gap: 20px; }
.form-card { background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; box-shadow: var(--sombra); }
.form-card-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--azul); margin-bottom: 18px; display: flex; align-items: center; gap: 7px; }
.field { margin-bottom: 16px; }
.field:last-child { margin-bottom: 0; }
.field label { display: block; font-size: 0.68rem; font-weight: 500; color: var(--negro); margin-bottom: 6px; letter-spacing: 0.05em; }
.field input[type="text"],
.field input[type="number"],
.field select,
.field textarea {
  width: 100%; background: var(--gris-fondo); border: 1px solid var(--gris-borde);
  border-radius: 8px; padding: 10px 12px; font-family: var(--font-sans);
  font-size: 0.85rem; color: var(--negro); outline: none;
  transition: border-color var(--tr), box-shadow var(--tr);
  resize: vertical;
}
.field input:focus, .field select:focus, .field textarea:focus {
  border-color: var(--azul);
  box-shadow: 0 0 0 3px var(--azul-claro);
  background: var(--blanco);
}
.form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--gris-borde); }
.back-link { color: var(--gris-texto); text-decoration: none; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 4px; }
.back-link:hover { color: var(--azul); }
@media (max-width: 900px) { .form-grid { grid-template-columns: 1fr; } }

/* Tabla de ingredientes */
.tabla-ingredientes { width: 100%; min-width: 480px; border-collapse: collapse; }
.tabla-ingredientes th { font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gris-texto); text-align: left; padding: 0 6px 8px; }
.tabla-ingredientes td { padding: 4px 6px 4px 0; vertical-align: middle; }
.tabla-ingredientes input, .tabla-ingredientes select { width: 100%; background: var(--gris-fondo); border: 1px solid var(--gris-borde); border-radius: 7px; padding: 7px 9px; font-family: var(--font-sans); font-size: 0.8rem; color: var(--negro); outline: none; }
.tabla-ingredientes input:focus, .tabla-ingredientes select:focus { border-color: var(--azul); background: var(--blanco); }
.subtotal-ing { font-size: 0.78rem; font-weight: 600; color: var(--azul); white-space: nowrap; }
.btn-fila-quitar { background: var(--rojo-claro); border: none; color: var(--rojo); width: 28px; height: 28px; border-radius: 7px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.btn-fila-quitar:hover { background: var(--rojo); color: #fff; }

/* Filas de video / foto */
.fila-video, .fila-foto { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; background: var(--gris-fondo); border: 1px solid var(--gris-borde); border-radius: 9px; padding: 10px; margin-bottom: 8px; }
.fila-video select, .fila-video input[type="text"], .fila-foto select { background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 7px; padding: 7px 9px; font-family: var(--font-sans); font-size: 0.78rem; color: var(--negro); outline: none; }
.fila-video input[type="file"], .fila-foto input[type="file"] { font-size: 0.75rem; max-width: 180px; }
.fila-foto-preview { font-size: 0.7rem; color: var(--gris-texto); font-style: italic; }

@media (max-width: 600px) {
  .form-card { padding: 16px; }
}
</style>

<script>
function toggleOtro(campo) {
  const sel = document.getElementById('sel-' + campo);
  const otro = document.getElementById('otro-' + campo);
  otro.style.display = sel.value === 'otro' ? 'block' : 'none';
  if (sel.value === 'otro') otro.focus();
}

// ── Insumos disponibles (para el <select> de ingredientes) ──
const INSUMOS_DISPONIBLES = <%- JSON.stringify(todosInsumos || []) %>;

function formatoMoneda(n) {
  return '$' + (Number(n) || 0).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// ── Ingredientes ──
let contadorIng = 0;
function agregarFilaIngrediente(datos) {
  const idx = contadorIng++;
  const tbody = document.getElementById('ingredientes-body');
  const tr = document.createElement('tr');
  tr.id = 'fila-ing-' + idx;

  const insumoIdActual = datos?.insumo_id || '';
  const opciones = INSUMOS_DISPONIBLES.map(ins =>
    `<option value="${ins.id}" data-unidad="${ins.unidad}" data-precio="${ins.precio_unitario}" ${String(ins.id) === String(insumoIdActual) ? 'selected' : ''}>
      ${ins.nombre} ($${Number(ins.precio_unitario).toFixed(2)}/${ins.unidad})
    </option>`
  ).join('');

  tr.innerHTML = `
    <td>
      <select name="ing_insumo_id_${idx}" onchange="actualizarSubtotalIng(${idx})" required>
        <option value="">Seleccionar insumo...</option>
        ${opciones}
      </select>
    </td>
    <td><input type="number" name="ing_cantidad_${idx}" placeholder="0" step="0.01" min="0"
        value="${datos?.cantidad || ''}" oninput="actualizarSubtotalIng(${idx})" style="max-width:90px;"></td>
    <td><input type="text" name="ing_unidad_${idx}" placeholder="kg" value="${datos?.unidad || ''}" style="max-width:80px;"></td>
    <td><span class="subtotal-ing" id="subtotal-ing-${idx}">—</span></td>
    <td><button type="button" class="btn-fila-quitar" onclick="document.getElementById('fila-ing-${idx}').remove()"><i class="ti ti-x"></i></button></td>
  `;
  tbody.appendChild(tr);

  // Si al elegir el insumo la fila de unidad está vacía, la completa con la unidad del insumo
  const selectInsumo = tr.querySelector(`select[name="ing_insumo_id_${idx}"]`);
  selectInsumo.addEventListener('change', () => {
    const opt = selectInsumo.selectedOptions[0];
    const unidadInput = tr.querySelector(`input[name="ing_unidad_${idx}"]`);
    if (opt && !unidadInput.value) unidadInput.value = opt.dataset.unidad || '';
  });

  actualizarSubtotalIng(idx);
}

function actualizarSubtotalIng(idx) {
  const fila = document.getElementById('fila-ing-' + idx);
  if (!fila) return;
  const select = fila.querySelector(`select[name="ing_insumo_id_${idx}"]`);
  const cantidadInput = fila.querySelector(`input[name="ing_cantidad_${idx}"]`);
  const opt = select?.selectedOptions[0];
  const precio = opt ? parseFloat(opt.dataset.precio) || 0 : 0;
  const cantidad = parseFloat(cantidadInput?.value) || 0;
  const span = document.getElementById('subtotal-ing-' + idx);
  span.textContent = (opt && opt.value) ? formatoMoneda(precio * cantidad) : '—';
}

// ── Videos ──
let contadorVideo = 0;
function agregarFilaVideo(datos) {
  const idx = contadorVideo++;
  const cont = document.getElementById('videos-body');
  const div = document.createElement('div');
  div.className = 'fila-video';
  div.id = 'fila-video-' + idx;
  const clasificacionSel = datos?.clasificacion || 'Preparación';
  const esUrl = !datos || datos.origen === 'url';
  div.innerHTML = `
    <select name="video_clasificacion_${idx}">
      <option value="Preparación" ${clasificacionSel === 'Preparación' ? 'selected' : ''}>Preparación</option>
      <option value="Montaje" ${clasificacionSel === 'Montaje' ? 'selected' : ''}>Montaje</option>
      <option value="Otros" ${clasificacionSel === 'Otros' ? 'selected' : ''}>Otros</option>
    </select>
    <select name="video_tipo_${idx}" onchange="toggleTipoVideo(${idx}, this.value)">
      <option value="url" ${esUrl ? 'selected' : ''}>Link (YouTube/Drive)</option>
      <option value="archivo" ${!esUrl ? 'selected' : ''}>Archivo</option>
    </select>
    <input type="text" name="video_url_${idx}" placeholder="https://..." value="${esUrl && datos ? datos.valor : ''}" style="display:${esUrl ? 'block' : 'none'};flex:1;min-width:160px;" id="video-url-${idx}">
    <input type="file" name="video_archivo_${idx}" accept="video/*" style="display:${!esUrl ? 'block' : 'none'};" id="video-archivo-${idx}">
    <button type="button" class="btn-fila-quitar" onclick="document.getElementById('fila-video-${idx}').remove()"><i class="ti ti-x"></i></button>
  `;
  cont.appendChild(div);
}

function toggleTipoVideo(idx, tipo) {
  document.getElementById('video-url-' + idx).style.display = tipo === 'url' ? 'block' : 'none';
  document.getElementById('video-archivo-' + idx).style.display = tipo === 'archivo' ? 'block' : 'none';
}

// ── Fotos (con clasificación: Preparación, Montaje, Otros) ──
let contadorFoto = 0;
function agregarFilaFoto(datos) {
  const idx = contadorFoto++;
  const cont = document.getElementById('fotos-body');
  const div = document.createElement('div');
  div.className = 'fila-foto';
  div.id = 'fila-foto-' + idx;
  const clasificacionSel = datos?.clasificacion || 'Preparación';
  div.innerHTML = `
    <select name="foto_clasificacion_${idx}">
      <option value="Preparación" ${clasificacionSel === 'Preparación' ? 'selected' : ''}>Preparación</option>
      <option value="Montaje" ${clasificacionSel === 'Montaje' ? 'selected' : ''}>Montaje</option>
      <option value="Otros" ${clasificacionSel === 'Otros' ? 'selected' : ''}>Otros</option>
    </select>
    <input type="file" name="foto_archivo_${idx}" accept="image/*">
    <input type="hidden" name="foto_existente_${idx}" value="${datos?.archivo || ''}">
    ${datos?.archivo ? `<span class="fila-foto-preview"><i class="ti ti-photo"></i> Foto actual (se conserva si no elegís otra)</span>` : ''}
    <button type="button" class="btn-fila-quitar" onclick="document.getElementById('fila-foto-${idx}').remove()"><i class="ti ti-x"></i></button>
  `;
  cont.appendChild(div);
}

// Precarga de datos si es edición
const INGREDIENTES_PREVIOS = <%- JSON.stringify(ingredientesActuales || []) %>;
const VIDEOS_PREVIOS = <%- JSON.stringify(videos || []) %>;
const FOTOS_PREVIAS = <%- JSON.stringify(fotos || []) %>;

if (INGREDIENTES_PREVIOS.length > 0) {
  INGREDIENTES_PREVIOS.forEach(ing => agregarFilaIngrediente(ing));
} else {
  agregarFilaIngrediente();
}

if (VIDEOS_PREVIOS.length > 0) {
  VIDEOS_PREVIOS.forEach(v => agregarFilaVideo(v));
}

if (FOTOS_PREVIAS.length > 0) {
  FOTOS_PREVIAS.forEach(f => agregarFilaFoto(f));
}
</script>
</body>
</html>
