<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= menu.nombre %> — Menús</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.form-card{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:24px;box-shadow:var(--sombra);}
.form-card-title{font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azul);margin-bottom:16px;display:flex;align-items:center;gap:7px;}
.tabla-interna{width:100%;border-collapse:collapse;font-size:0.82rem;}
.tabla-interna th{font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--gris-texto);padding:8px 0;border-bottom:1px solid var(--gris-borde);text-align:left;}
.tabla-interna td{padding:10px 0;border-bottom:1px solid var(--gris-borde);color:var(--negro);}
.tabla-interna tr:last-child td{border-bottom:none;}
.btn-remove{background:none;border:none;color:#dc2626;cursor:pointer;font-size:15px;padding:2px;}
.btn-remove:hover{color:#991b1b;}
.btn-danger{background:#fef2f2;border:1px solid #fecaca;color:#dc2626;font-family:var(--font-sans);font-size:0.68rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;padding:8px 16px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:6px;}
.btn-danger:hover{background:#dc2626;color:#fff;}

/* Botones "chicos" (32px), mismo molde que el resto de la aplicación. */
.btn-chico-rojo,.btn-chico-verde{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-rojo{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.btn-chico-rojo:hover{background:#dc2626;color:#fff;}
.btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
.btn-chico-verde:hover{background:rgba(6,147,126,0.24);}

@media (max-width: 600px) {
  .form-card{padding:16px;}
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label"><a href="/eventos/menus" style="color:var(--gris-texto);text-decoration:none;display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;"><i class="ti ti-arrow-left"></i> <span data-i18n>Menús</span></a></p>
        <h1 class="seccion-titulo"><%= menu.nombre %></h1>
        <% if (menu.descripcion) { %><p style="font-size:0.82rem;color:var(--gris-texto);margin:4px 0 0;"><%= menu.descripcion %></p><% } %>
      </div>
      <form method="POST" action="/eventos/menus/<%= menu.id %>/eliminar" onsubmit="return confirm(tHilton('¿Eliminar este menú? Los bocaditos del catálogo no se borran, solo se desvinculan.'))">
        <button type="submit" class="btn-chico-rojo"><i class="ti ti-trash"></i> <span data-i18n>Eliminar menú</span></button>
      </form>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <p class="form-card-title"><i class="ti ti-plus"></i> <span data-i18n>Agregar bocadito al menú</span></p>
      <form method="POST" action="/eventos/menus/<%= menu.id %>/plato" style="display:flex;gap:8px;">
        <% const NOMBRES_CATEGORIA_MD = { frios: 'Fríos', calientes: 'Calientes', principales: 'Platos principales', postres: 'Postres' }; %>
        <select name="plato_id" required style="flex:1;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
          <option value="" data-i18n>Seleccionar bocadito...</option>
          <% ['frios','calientes','principales','postres'].forEach(cat => { %>
            <% const items = catalogoBocaditos[cat] || []; %>
            <% if (items.length > 0) { %>
            <optgroup label="<%= NOMBRES_CATEGORIA_MD[cat] %>">
              <% items.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.nombre %> ($<%= parseFloat(b.costo_unitario || 0).toFixed(2) %>/bocado)</option>
              <% }) %>
            </optgroup>
            <% } %>
          <% }) %>
        </select>
        <button type="submit" class="btn-chico-verde"><i class="ti ti-plus"></i> <span data-i18n>Agregar</span></button>
      </form>
    </div>

    <div class="form-card">
      <p class="form-card-title"><i class="ti ti-tools-kitchen-2"></i> <span data-i18n>Bocaditos de este menú</span> (<%= platosDelMenu.length %>)</p>
      <% if (platosDelMenu.length > 0) { %>
      <table class="tabla-interna">
        <thead><tr><th data-i18n>Bocadito</th><th data-i18n>Categoría</th><th data-i18n>Costo/bocado</th><th></th></tr></thead>
        <tbody>
          <% platosDelMenu.forEach(p => { %>
          <tr>
            <td><%= p.nombre %></td>
            <td data-i18n><%= NOMBRES_CATEGORIA_MD[p.categoria] || p.categoria %></td>
            <td style="color:var(--azul);font-weight:600;">$<%= parseFloat(p.costo_unitario || 0).toFixed(2) %></td>
            <td>
              <form method="POST" action="/eventos/menus/<%= menu.id %>/plato/<%= p.menu_plato_id %>/eliminar" style="margin:0;">
                <button type="submit" class="btn-remove" title="Quitar del menú" data-i18n-title="Quitar del menú"><i class="ti ti-x"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;" data-i18n>Sin bocaditos todavía. Agregá el primero arriba.</p>
      <% } %>
    </div>
  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>

</body>
</html>
