<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Costos — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
.main-content-ancho{max-width:1600px;}
.puesto-badge{font-size:0.68rem;font-weight:500;color:var(--azul);background:var(--azul-claro);padding:2px 8px;border-radius:20px;}
.field{margin-bottom:0;}
.field label{display:block;font-size:0.68rem;font-weight:500;color:var(--negro);margin-bottom:6px;}
.field input,.field select{width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none;transition:border-color 0.2s;}
.field input:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(37,99,235,0.1);background:var(--blanco);}

/* Tarjeta unificada de importación, centrada, arriba de cada columna */
.tarjeta-unificada{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:22px;box-shadow:var(--sombra);text-align:center;margin-bottom:22px;}
.tarjeta-unificada-icono{width:44px;height:44px;border-radius:10px;background:var(--azul-claro);color:var(--azul);display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 12px;}
.tarjeta-unificada-icono-csv{background:#f0fdf4;color:#16a34a;}
.tarjeta-unificada-titulo{font-size:0.9rem;font-weight:600;color:var(--negro);margin:0 0 4px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;}
.tarjeta-unificada-desc{font-size:0.76rem;color:var(--gris-texto);margin:0 0 16px;line-height:1.5;}
.tarjeta-unificada-opciones{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:2px;}
.opcion-precio-sola{flex-shrink:0;}
.opcion-precio{display:flex;flex-direction:column;align-items:center;gap:8px;}
.opcion-precio-sola{flex-direction:row;flex-wrap:wrap;justify-content:center;}
.opcion-precio-label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);display:flex;align-items:center;gap:5px;}
.opcion-divisor{width:1px;align-self:stretch;background:var(--gris-borde);min-height:60px;}

/* Tarjeta resumen (reemplaza a la tabla siempre visible) */
.tarjeta-resumen-lista{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:26px 22px;box-shadow:var(--sombra);text-align:center;}
.tarjeta-resumen-numero{font-family:var(--font-serif);font-size:2.4rem;font-weight:400;color:var(--negro);margin:4px 0 0;line-height:1;}
.tarjeta-resumen-lista .tarjeta-unificada-desc{margin-bottom:18px;}
.tarjeta-resumen-lista .btn-primary{width:100%;justify-content:center;}

/* Modal de lista completa: overlay a pantalla completa, la caja centrada y grande */
.modal-lista{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;}
.modal-lista-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:800px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
.modal-lista-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--gris-borde);flex-shrink:0;}
.modal-lista-titulo{font-size:0.95rem;font-weight:600;color:var(--negro);display:flex;align-items:center;gap:8px;margin:0;}
.modal-lista-cerrar{background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);padding:4px;}
.modal-lista-cerrar:hover{color:var(--negro);}
.modal-lista-body{padding:18px 22px;overflow-y:auto;}

/* En celular, el modal ocupa toda la pantalla */
@media (max-width:700px){
  .modal-lista{padding:0;}
  .modal-lista-caja{max-width:100%;max-height:100vh;height:100vh;border-radius:0;}
}
@media (max-width:600px){
  .opcion-divisor{display:none;}
}
.precio-card-input-categoria{padding:9px 10px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.8rem;outline:none;background:var(--gris-fondo);color:var(--negro);}
.precio-card-input-categoria:focus{border-color:var(--azul);background:var(--blanco);}

/* Solapas alfabéticas — discretas, tipo índice de agenda */
.solapas-letras{display:flex;gap:2px;overflow-x:auto;padding-bottom:10px;margin-bottom:12px;-webkit-overflow-scrolling:touch;border-bottom:1px solid var(--gris-borde);}
.solapas-letras::-webkit-scrollbar{height:3px;}
.solapas-letras::-webkit-scrollbar-thumb{background:var(--azul-borde);border-radius:3px;}
.solapa-letra{flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:24px;height:26px;padding:0 6px;border-radius:5px;color:var(--gris-texto);font-size:0.68rem;font-weight:600;text-decoration:none;transition:all 0.15s;border:1px solid transparent;}
.solapa-letra:hover{background:var(--azul-claro);color:var(--azul);}
.solapa-letra.activa{background:var(--azul);color:#fff;}
.badge-activo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;padding:2px 8px 2px 6px;border-radius:20px;display:inline-flex;align-items:center;gap:4px;}
.badge-activo i{color:#16a34a;}
.badge-inactivo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:var(--gris-texto);background:var(--gris-borde);padding:2px 8px;border-radius:20px;}
.input-archivo{display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--gris-borde);border-radius:8px;font-size:0.8rem;color:var(--gris-texto);cursor:pointer;background:var(--gris-fondo);transition:border-color 0.2s;max-width:220px;}
.input-archivo:hover{border-color:var(--azul);}
.input-archivo span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.input-archivo input[type=file]{display:none;}
.input-archivo-disabled{opacity:0.5;cursor:not-allowed;}
.input-archivo-disabled:hover{border-color:var(--gris-borde);}
.input-archivo-ok{border-color:#16a34a;background:#f0fdf4;color:#16a34a;}
@keyframes girar{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
.girando{animation:girar 0.8s linear infinite;}
.btn-excel{display:inline-flex;align-items:center;gap:6px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-family:var(--font-sans);font-weight:600;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background 0.2s;}
.btn-excel:hover{background:#15803d;}

/* Chips de período y pestañas de la Variación de precios */
.chip-periodo{font-size:0.72rem;font-weight:600;color:var(--gris-texto);background:var(--gris-fondo);border:1px solid var(--gris-borde);padding:5px 13px;border-radius:20px;text-decoration:none;transition:all 0.15s;}
.chip-periodo:hover{border-color:var(--azul);color:var(--azul);}
.chip-periodo.activo{background:var(--azul);border-color:var(--azul);color:#fff;}
.tab-variacion{font-size:0.76rem;font-weight:600;color:var(--gris-texto);text-decoration:none;padding:8px 14px;display:inline-flex;align-items:center;gap:6px;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all 0.15s;}
.tab-variacion:hover{color:var(--negro);}
.tab-variacion.activo{color:var(--negro);border-bottom-color:var(--azul);}

/* Variación de precios: único cartel fijo arriba de todo, chico y azul, centrado */
.tarjeta-variacion-chica{max-width:480px;margin:0 auto 26px;background:rgba(0,47,97,0.10);border:1px solid rgba(0,47,97,0.26);border-radius:12px;padding:16px 20px;text-align:center;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.tarjeta-variacion-chica .tarjeta-unificada-icono{background:rgba(0,47,97,0.14);color:#002f61;width:36px;height:36px;font-size:16px;}
.tarjeta-variacion-chica .tarjeta-unificada-titulo{justify-content:center;color:#002f61;font-size:0.82rem;}
.tarjeta-variacion-chica .tarjeta-unificada-desc{font-size:0.72rem;margin-bottom:12px;}

/* Carrusel con las otras 4 tarjetas (Insumos, Costeo de platos, Actualización
   de precios, Costeo Excel/CSV) — mismo patrón que ya usa Horas Extra para
   las fichas de empleados: ancho completo, muestra las que entren en pantalla
   y pagina de a una "pantalla" por vez con flechas/puntitos, en vez de que
   la página se angoste de golpe como con un carrusel de una tarjeta sola. */
.costos-carousel-outer{position:relative;padding:0 44px;}
/* justify-content:center: cuando las 4 tarjetas entran en el ancho
   disponible (pantallas grandes) quedan centradas como el resto de la
   página, en vez de pegadas al borde izquierdo con un hueco vacío a la
   derecha. Cuando NO entran (pantallas chicas, hay que scrollear) esto no
   tiene efecto — el carrusel arranca igual desde la primera tarjeta. */
.costos-carousel{display:flex;align-items:stretch;justify-content:center;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:2px 2px 10px;-ms-overflow-style:none;scrollbar-width:none;}
.costos-carousel::-webkit-scrollbar{display:none;}
.costos-card{flex:0 0 320px;scroll-snap-align:start;height:288px;}
/* Mismo alto para las 4, sin importar cuánto texto/formulario tenga cada
   una — ícono/título/descripción arriba, y el botón o formulario siempre
   pegado abajo (margin-top:auto), para que no queden salteadas. */
.costos-card .tarjeta-unificada,.costos-card .tarjeta-resumen-lista{height:100%;box-sizing:border-box;margin-bottom:0;padding:18px;display:flex;flex-direction:column;}
.costos-card .tarjeta-unificada-icono{margin-bottom:8px;}
.costos-card .tarjeta-unificada-desc{margin-bottom:10px;font-size:0.7rem;line-height:1.4;}
.costos-card .precio-card-input-categoria{padding:7px 10px;font-size:0.76rem;}
/* "Elegir archivo" + el botón, en la misma fila y angostos, para que
   entren los dos sin desbordar el ancho fijo de la tarjeta (antes se
   pasaban del borde y aparecía una barra de scroll horizontal). */
.costos-card .tarjeta-unificada-opciones{gap:8px;overflow-x:visible;}
.costos-card .input-archivo{max-width:145px;flex:0 1 auto;padding:9px 10px;}
.costos-card .input-archivo span{max-width:85px;}
.costos-card .btn-primary{padding:9px 12px;font-size:0.64rem;white-space:nowrap;}
.costos-card .tarjeta-unificada-opciones,.costos-card .tarjeta-resumen-lista>.btn-primary,.costos-card form{margin-top:auto;}
@media (max-width:480px){
  .costos-card{flex-basis:82vw;height:auto;min-height:288px;}
  .costos-carousel-outer{padding:0 36px;}
}
.costos-flecha{position:absolute;top:50%;transform:translateY(-50%);z-index:2;background:var(--blanco);box-shadow:var(--sombra);}
.costos-flecha-izq{left:0;}
.costos-flecha-der{right:0;}
.carousel-arrow{width:32px;height:32px;border-radius:50%;background:var(--gris-fondo);border:1px solid var(--gris-borde);color:var(--gris-texto);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:background 0.2s,color 0.2s;}
.carousel-arrow:hover{background:var(--azul-claro);color:var(--azul);}
.deck-controls{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:14px;}
.carousel-dots{display:flex;gap:7px;}
.dot{width:7px;height:7px;border-radius:50%;background:var(--gris-borde);cursor:pointer;transition:background 0.2s, transform 0.2s;}
.dot.activa{background:var(--azul);transform:scale(1.3);}
</style>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'costos' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label"><%= typeof depto !== 'undefined' && depto === 'ayb' ? 'AYB' : 'Cocina' %></p>
        <h1 class="seccion-titulo">Costos</h1>
        <% // Este selector solo lo ve un admin general (sin departamento propio) —
           // una cuenta de Cocina o de AYB ya ve directo lo suyo, sin nada para
           // elegir acá. Cocina ve sus insumos/platos de siempre; AYB ve el
           // catálogo de Inventario AYB (sin costeo de platos, no aplica). %>
        <% if (typeof esAdminGeneral !== 'undefined' && esAdminGeneral) { %>
        <p style="font-size:0.75rem;color:var(--gris-texto);margin-top:4px;">
          Viendo <strong><%= depto === 'ayb' ? 'AYB' : 'Cocina' %></strong> ·
          <a href="/costos<%= depto === 'ayb' ? '' : '?depto=ayb' %>" style="color:var(--azul);"><%= depto === 'ayb' ? 'ver Cocina' : 'ver AYB' %></a>
        </p>
        <% } %>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/inicio" class="btn-icono-casa" title="Menú principal"><i class="ti ti-home"></i></a>
        <% if (typeof esAyb !== 'undefined' && esAyb) { %>
        <a href="/inventario-ayb" class="btn-secondary">
          <i class="ti ti-package"></i> Gestionar productos
        </a>
        <% } else { %>
        <button onclick="showModal('modal-insumo')" class="btn-secondary">
          <i class="ti ti-plus"></i> Nuevo insumo
        </button>
        <button onclick="showModal('modal-plato')" class="btn-primary">
          <i class="ti ti-tools-kitchen-2"></i> Nuevo plato
        </button>
        <% } %>
      </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) {
      const msgTexto = decodeURIComponent(msg);
      const esError  = /error/i.test(msgTexto);
    %>
    <div style="background:<%= esError ? '#fef2f2' : 'var(--azul-claro)' %>;border:1px solid <%= esError ? '#fecaca' : 'var(--azul-borde)' %>;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:0.83rem;color:<%= esError ? '#dc2626' : 'var(--azul)' %>;display:flex;align-items:center;gap:10px;">
      <i class="ti <%= esError ? 'ti-alert-circle' : 'ti-check' %>" style="font-size:18px;"></i>
      <%= msgTexto %>
    </div>
    <% } %>

    <% // Para un admin general viendo AYB, hay que arrastrar "&depto=ayb" en
       // los links de variación (período/pestañas/Excel) — si no, al hacer
       // clic se vuelve a Cocina, porque esos datos ahora salen de tablas
       // distintas según el departamento. %>
    <% const qDepto = (typeof esAyb !== 'undefined' && esAyb) ? '&depto=ayb' : ''; %>

    <!-- Variación de precios: único cartel fijo arriba de todo, chico y azul -->
    <div class="tarjeta-variacion-chica">
      <div class="tarjeta-unificada-icono"><i class="ti ti-trending-up"></i></div>
      <p class="tarjeta-unificada-titulo">Variación de precios</p>
      <p class="tarjeta-unificada-desc">Los insumos que más subieron, bajaron o se mantuvieron en un período.</p>
      <a href="/costos?dias=<%= diasVariacion %>&tipoVariacion=<%= tipoVariacion %><%= qDepto %>#modal-variacion-precios" class="btn-secondary">
        <i class="ti ti-chart-line"></i> Ver variación
      </a>
    </div>

    <!-- Carrusel con las otras 4 tarjetas — mismo patrón que el de fichas de
         empleados en Horas Extra (ancho completo, flechas a los costados,
         puntitos abajo, pagina según cuántas entren en pantalla). -->
    <div class="costos-carousel-outer">
      <button type="button" class="carousel-arrow costos-flecha costos-flecha-izq" onclick="pasoCostosCarousel(-1)" aria-label="Anterior"><i class="ti ti-chevron-left"></i></button>
      <button type="button" class="carousel-arrow costos-flecha costos-flecha-der" onclick="pasoCostosCarousel(1)" aria-label="Siguiente"><i class="ti ti-chevron-right"></i></button>
      <div class="costos-carousel" id="costosCarousel">

        <!-- Resumen de Insumos, la lista completa vive en el modal. En AYB
             esta lista es directamente el catálogo de Inventario AYB. -->
        <div class="costos-card">
          <div class="tarjeta-resumen-lista">
            <div class="tarjeta-unificada-icono"><i class="ti ti-package"></i></div>
            <p class="tarjeta-unificada-titulo">Insumos / Ingredientes</p>
            <p class="tarjeta-resumen-numero"><%= totalInsumos %></p>
            <p class="tarjeta-unificada-desc">
              insumo<%= totalInsumos !== 1 ? 's' : '' %> cargado<%= totalInsumos !== 1 ? 's' : '' %>
              <% if (typeof esAyb !== 'undefined' && esAyb) { %><br>(catálogo de Inventario AYB)<% } %>
            </p>
            <button type="button" class="btn-primary" onclick="showModal('modal-lista-insumos')">
              <i class="ti ti-list"></i> Ver insumos
            </button>
          </div>
        </div>

        <% if (typeof esAyb === 'undefined' || !esAyb) { %>
        <!-- Resumen de Platos, la lista completa vive en el modal. No aplica a AYB. -->
        <div class="costos-card">
          <div class="tarjeta-resumen-lista">
            <div class="tarjeta-unificada-icono tarjeta-unificada-icono-csv"><i class="ti ti-tools-kitchen-2"></i></div>
            <p class="tarjeta-unificada-titulo">Costeo de platos</p>
            <p class="tarjeta-resumen-numero"><%= totalPlatos %></p>
            <p class="tarjeta-unificada-desc">plato<%= totalPlatos !== 1 ? 's' : '' %> costeado<%= totalPlatos !== 1 ? 's' : '' %></p>
            <button type="button" class="btn-primary" onclick="showModal('modal-lista-platos')">
              <i class="ti ti-list"></i> Ver platos
            </button>
          </div>
        </div>
        <% } %>

        <!-- Actualización de precios: un solo selector, detecta foto vs. catálogo solo -->
        <div class="costos-card">
          <div class="tarjeta-unificada">
            <div class="tarjeta-unificada-icono"><i class="ti ti-refresh"></i></div>
            <p class="tarjeta-unificada-titulo">
              Actualización de precios
              <% if (geminiConfigurado) { %>
                <span class="badge-activo"><i class="ti ti-circle-filled" style="font-size:7px;"></i> Activo</span>
              <% } else { %>
                <span class="badge-inactivo">Foto no configurada</span>
              <% } %>
            </p>
            <p class="tarjeta-unificada-desc">Elegí una foto de factura o el catálogo del proveedor — el sistema detecta solo cuál es.</p>

            <div class="tarjeta-unificada-opciones">
              <form id="form-actualizacion" method="POST" enctype="multipart/form-data"
                    class="opcion-precio opcion-precio-sola" onsubmit="return prepararEnvioUnificado()">
                <input type="text" id="input-categoria-unificada" placeholder="Categoría (si es catálogo)" class="precio-card-input-categoria" style="display:none;">
                <label class="input-archivo" id="label-archivo-unificado">
                  <i class="ti ti-paperclip"></i>
                  <span id="nombre-archivo-unificado">Elegir archivo</span>
                  <input type="file" id="input-unificado" required onchange="detectarTipoArchivo(this)">
                </label>
                <button type="submit" id="btn-actualizar-unificado" class="btn-primary">
                  <i class="ti ti-upload" id="icon-actualizar-unificado"></i>
                  <span id="texto-actualizar-unificado">Actualizar</span>
                </button>
              </form>
            </div>
          </div>
        </div>

        <% if (typeof esAyb === 'undefined' || !esAyb) { %>
        <!-- Importar costeo de platos. No aplica a AYB. -->
        <div class="costos-card">
          <div class="tarjeta-unificada">
            <div class="tarjeta-unificada-icono tarjeta-unificada-icono-csv"><i class="ti ti-file-spreadsheet"></i></div>
            <p class="tarjeta-unificada-titulo">Costeo de platos (Excel/CSV)</p>
            <p class="tarjeta-unificada-desc">Planilla de costeo — un bloque por plato. Si ya existe (mismo nombre), se actualizan sus ingredientes.</p>

            <form id="form-importar-platos" method="POST" action="/costos/platos/importar" enctype="multipart/form-data" onsubmit="return prepararEnvioPlatos()">
              <input type="text" name="categoria_platos" id="input-categoria-platos" placeholder="Categoría (ej: Pastelería)" required class="precio-card-input-categoria" style="width:100%;box-sizing:border-box;margin-bottom:10px;">
              <div class="opcion-precio opcion-precio-sola">
              <label class="input-archivo">
                <i class="ti ti-paperclip"></i>
                <span id="nombre-archivo-platos">Elegir archivo</span>
                <input type="file" id="input-platos" name="archivo_platos" required
                       onchange="marcarArchivoPlatosElegido(this)">
              </label>
              <button type="submit" id="btn-importar-platos" class="btn-primary">
                <i class="ti ti-upload" id="icon-importar-platos"></i>
                <span id="texto-importar-platos">Importar</span>
              </button>
              </div>
            </form>
          </div>
        </div>
        <% } %>

      </div>
    </div>
    <div class="deck-controls">
      <div class="carousel-dots" id="costosDots"></div>
    </div>

    <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver al menú principal</a>
    </div>
  </main>

  <%- include('partials/mobile-nav', { path: 'costos' }) %>
</div>

<!-- Modal: lista completa de Insumos -->
<div id="modal-lista-insumos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-insumos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-package"></i> Insumos / Ingredientes</p>
      <button onclick="hideModal('modal-lista-insumos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <div style="position:relative;margin-bottom:12px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <form method="GET" action="/costos">
          <% if (typeof esAyb !== 'undefined' && esAyb) { %><input type="hidden" name="depto" value="ayb"><% } %>
          <input type="text" name="buscar" id="buscar-insumos-input" value="<%= buscar %>" placeholder="Buscar insumo por nombre o código..."
                 oninput="filtrarInsumosEnVivo()"
                 style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
          <% if (buscar) { %>
          <a href="/costos<%= (typeof esAyb !== 'undefined' && esAyb) ? '?depto=ayb' : '' %>#modal-lista-insumos" title="Limpiar búsqueda" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"><i class="ti ti-x"></i></a>
          <% } %>
        </form>
      </div>

      <p id="contador-resultados-insumos" style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;<%= buscar ? '' : 'display:none;' %>">
        <%= totalInsumos %> resultado<%= totalInsumos !== 1 ? 's' : '' %> para "<%= buscar %>"
      </p>

      <div id="solapas-letras-insumos" class="solapas-letras" style="<%= buscar ? 'display:none;' : '' %>">
        <a href="/costos<%= (typeof esAyb !== 'undefined' && esAyb) ? '?depto=ayb' : '' %>" class="solapa-letra <%= !letra ? 'activa' : '' %>">Todos</a>
        <% 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(l => { %>
        <a href="/costos?letra=<%= l %><%= qDepto %>" class="solapa-letra <%= letra === l ? 'activa' : '' %>"><%= l %></a>
        <% }) %>
      </div>

      <div class="tabla-wrap">
        <table class="tabla" style="table-layout:fixed;">
          <colgroup>
            <col style="width:16%"><col style="width:44%"><col style="width:32%"><col style="width:8%">
          </colgroup>
          <thead>
            <tr>
              <th>Código</th>
              <th>Insumo</th>
              <th>Precio unitario</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tabla-insumos-body">
            <% if (insumos.length > 0) { %>
              <% insumos.forEach(ins => { %>
              <tr data-nombre="<%= (ins.nombre || '').toLowerCase() %>" data-codigo="<%= (ins.codigo || '').toLowerCase() %>">
                <td style="font-size:0.72rem;color:var(--gris-texto);font-family:monospace;"><%= ins.codigo || '—' %></td>
                <td style="font-weight:500;">
                  <%= ins.nombre %>
                  <% if (!ins.precio_unitario || parseFloat(ins.precio_unitario) === 0) { %>
                    <span style="display:inline-block;margin-left:6px;font-size:0.6rem;font-weight:700;background:#fef3c7;color:#92400e;padding:1px 7px;border-radius:20px;">SIN PRECIO</span>
                  <% } %>
                </td>
                <td>
                  <form method="POST" action="<%= (typeof esAyb !== 'undefined' && esAyb) ? '/costos/producto-ayb/' : '/costos/insumo/' %><%= ins.id %>/precio" style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">
                    <span style="font-size:0.78rem;color:var(--gris-texto);">$</span>
                    <input type="number" name="precio_nuevo" value="<%= ins.precio_unitario %>" placeholder="Ej: 4500" step="0.01" min="0"
                           style="width:80px;padding:4px 8px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.82rem;outline:none;">
                    <button type="submit" class="btn-sm" style="padding:4px 8px;">✓</button>
                    <label title="El precio no baja solo — tildá esto solo si es una corrección real y querés bajarlo igual" style="display:flex;align-items:center;gap:3px;font-size:0.62rem;color:var(--gris-texto);cursor:pointer;white-space:nowrap;">
                      <input type="checkbox" name="forzar_menor" value="1" style="width:11px;height:11px;accent-color:var(--rojo);">
                      Forzar
                    </label>
                  </form>
                </td>
                <td>
                  <% if (typeof esAyb !== 'undefined' && esAyb) { %>
                    <a href="/inventario-ayb" title="Gestionar en Inventario AYB" style="background:var(--azul-claro);color:var(--azul);display:inline-flex;align-items:center;justify-content:center;font-size:15px;padding:5px 8px;border-radius:6px;text-decoration:none;">
                      <i class="ti ti-external-link"></i>
                    </a>
                  <% } else { %>
                  <form method="POST" action="/costos/insumo/<%= ins.id %>/eliminar"
                        onsubmit="return confirm('¿Eliminar este insumo?')" style="margin:0;">
                    <button type="submit"
                            style="background:var(--azul-claro);border:none;color:var(--azul);cursor:pointer;font-size:15px;padding:5px 8px;border-radius:6px;transition:all 0.2s;"
                            title="Eliminar"
                            onmouseover="this.style.background='#dc2626';this.style.color='#fff';"
                            onmouseout="this.style.background='var(--azul-claro)';this.style.color='var(--azul)';">
                      <i class="ti ti-trash"></i>
                    </button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                <% if (buscar) { %>
                  No se encontraron insumos para "<%= buscar %>".
                <% } else if (letra) { %>
                  No hay insumos que empiecen con "<%= letra %>".
                <% } else if (typeof esAyb !== 'undefined' && esAyb) { %>
                  Sin productos cargados. Agregalos desde <a href="/inventario-ayb">Inventario AYB</a>.
                <% } else { %>
                  Sin insumos. Agregá el primero.
                <% } %>
              </td></tr>
            <% } %>
            <tr id="fila-sin-resultados-js" style="display:none;">
              <td colspan="4" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                No se encontraron insumos para "<span id="fila-sin-resultados-js-texto"></span>".
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if (typeof esAyb === 'undefined' || !esAyb) { %>
<!-- Modal: lista completa de Platos. No aplica a AYB. -->
<div id="modal-lista-platos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-platos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-tools-kitchen-2"></i> Costeo de platos</p>
      <button onclick="hideModal('modal-lista-platos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <div style="position:relative;margin-bottom:12px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <form method="GET" action="/costos">
          <% // Hidden para que un admin general que esté viendo AYB no "pierda"
             // ese contexto al buscar — una cuenta de Cocina/AYB no lo necesita
             // (departamentoEfectivo ignora este parámetro para ellas). %>
          <% if (typeof depto !== 'undefined' && depto === 'ayb') { %><input type="hidden" name="depto" value="ayb"><% } %>
          <input type="text" name="buscarPlato" value="<%= buscarPlato %>" placeholder="Buscar plato por nombre..."
                 style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
          <% if (buscarPlato) { %>
          <a href="/costos<%= depto === 'ayb' ? '?depto=ayb' : '' %>#modal-lista-platos" title="Limpiar búsqueda" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"><i class="ti ti-x"></i></a>
          <% } %>
        </form>
      </div>

      <% if (buscarPlato) { %>
        <p style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;">
          <%= totalPlatos %> resultado<%= totalPlatos !== 1 ? 's' : '' %> para "<%= buscarPlato %>"
        </p>
      <% } %>

      <% if (!buscarPlato) { %>
      <div class="solapas-letras">
        <a href="/costos<%= depto === 'ayb' ? '?depto=ayb' : '' %>" class="solapa-letra <%= !letraPlato ? 'activa' : '' %>">Todos</a>
        <% 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(l => { %>
        <a href="/costos?letraPlato=<%= l %><%= depto === 'ayb' ? '&depto=ayb' : '' %>" class="solapa-letra <%= letraPlato === l ? 'activa' : '' %>"><%= l %></a>
        <% }) %>
      </div>
      <% } %>

      <div class="tabla-wrap">
        <table class="tabla">
          <thead>
            <tr>
              <th>Plato</th>
              <th>Costo</th>
              <th>Margen</th>
              <th>Precio venta</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (platos.length > 0) { %>
              <% platos.forEach(p => { %>
              <tr>
                <td style="font-weight:500;">
                  <a href="/costos/plato/<%= p.id %>" style="color:var(--negro);text-decoration:none;">
                    <%= p.nombre %>
                  </a>
                  <% if (p.categoria) { %>
                    <span style="display:block;font-size:0.65rem;color:var(--gris-texto);"><%= p.categoria %></span>
                  <% } %>
                </td>
                <td style="color:var(--azul);font-weight:600;">$<%= parseFloat(p.costo_total).toFixed(2) %></td>
                <td>
                  <span style="font-size:0.72rem;background:var(--azul-claro);color:var(--azul);padding:2px 8px;border-radius:20px;font-weight:500;">
                    <%= p.margen_ganancia %>%
                  </span>
                </td>
                <td style="font-weight:600;color:#16a34a;">
                  $<%= (parseFloat(p.costo_total) * (1 + parseFloat(p.margen_ganancia)/100)).toFixed(2) %>
                </td>
                <td><a href="/costos/plato/<%= p.id %>" class="btn-sm">Ver</a></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                <% if (buscarPlato) { %>
                  No se encontraron platos para "<%= buscarPlato %>".
                <% } else if (letraPlato) { %>
                  No hay platos que empiecen con "<%= letraPlato %>".
                <% } else { %>
                  Sin platos. Agregá el primero.
                <% } %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Modal: Variación de precios -->
<div id="modal-variacion-precios" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-variacion-precios')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-chart-line"></i> Variación de precios</p>
      <div style="display:flex;align-items:center;gap:8px;">
        <a href="/costos/variacion-excel?dias=<%= diasVariacion %>&tipoVariacion=<%= tipoVariacion %><%= qDepto %>" class="btn-excel" style="padding:7px 12px;font-size:0.65rem;">
          <i class="ti ti-file-spreadsheet"></i> Excel
        </a>
        <button onclick="hideModal('modal-variacion-precios')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
      </div>
    </div>

    <div class="modal-lista-body">
      <!-- Selector de período -->
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">
        <% [{v:7,l:'7 días'},{v:14,l:'14 días'},{v:21,l:'21 días'},{v:28,l:'28 días'}].forEach(p => { %>
        <a href="/costos?dias=<%= p.v %>&tipoVariacion=<%= tipoVariacion %><%= qDepto %>#modal-variacion-precios"
           class="chip-periodo <%= diasVariacion === p.v ? 'activo' : '' %>"><%= p.l %></a>
        <% }) %>
      </div>

      <!-- Pestañas subieron / bajaron / iguales -->
      <div style="display:flex;gap:6px;margin-bottom:16px;border-bottom:1px solid var(--gris-borde);flex-wrap:wrap;">
        <a href="/costos?dias=<%= diasVariacion %>&tipoVariacion=subieron<%= qDepto %>#modal-variacion-precios"
           class="tab-variacion <%= tipoVariacion === 'subieron' ? 'activo' : '' %>">
          <i class="ti ti-trending-up" style="color:#dc2626;"></i> Subieron
        </a>
        <a href="/costos?dias=<%= diasVariacion %>&tipoVariacion=bajaron<%= qDepto %>#modal-variacion-precios"
           class="tab-variacion <%= tipoVariacion === 'bajaron' ? 'activo' : '' %>">
          <i class="ti ti-trending-down" style="color:#16a34a;"></i> Bajaron
        </a>
        <a href="/costos?dias=<%= diasVariacion %>&tipoVariacion=iguales<%= qDepto %>#modal-variacion-precios"
           class="tab-variacion <%= tipoVariacion === 'iguales' ? 'activo' : '' %>">
          <i class="ti ti-minus" style="color:var(--gris-texto);"></i> Se mantuvieron
        </a>
      </div>

      <p style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:12px;">
        Comparando el precio de hoy contra el precio de hace <%= diasVariacion %> día<%= diasVariacion !== 1 ? 's' : '' %>.
        Top <%= variacionPrecios.length %> resultado<%= variacionPrecios.length !== 1 ? 's' : '' %>.
      </p>

      <div class="tabla-wrap">
        <table class="tabla">
          <thead>
            <tr>
              <th>Insumo</th>
              <th>Precio antes</th>
              <th>Precio actual</th>
              <th>Variación</th>
            </tr>
          </thead>
          <tbody>
            <% if (variacionPrecios.length > 0) { %>
              <% variacionPrecios.forEach(f => { %>
              <tr>
                <td style="font-weight:500;">
                  <%= f.nombre %>
                  <% if (f.categoria) { %><span style="display:block;font-size:0.65rem;color:var(--gris-texto);"><%= f.categoria %></span><% } %>
                </td>
                <td style="color:var(--gris-texto);">$<%= parseFloat(f.precio_inicio).toFixed(2) %></td>
                <td style="font-weight:600;">$<%= parseFloat(f.precio_actual).toFixed(2) %></td>
                <td>
                  <span style="font-weight:700;font-size:0.82rem;color:<%= f.variacion_abs > 0 ? '#dc2626' : (f.variacion_abs < 0 ? '#16a34a' : 'var(--gris-texto)') %>;">
                    <%= f.variacion_abs > 0 ? '+' : '' %><%= parseFloat(f.variacion_pct).toFixed(1) %>%
                  </span>
                  <span style="display:block;font-size:0.68rem;color:var(--gris-texto);">
                    <%= f.variacion_abs > 0 ? '+' : '' %>$<%= parseFloat(f.variacion_abs).toFixed(2) %>
                  </span>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                No hay insumos que <%= tipoVariacion === 'subieron' ? 'hayan subido de precio' : (tipoVariacion === 'bajaron' ? 'hayan bajado de precio' : 'se hayan mantenido igual') %> en este período.
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if (typeof esAyb === 'undefined' || !esAyb) { %>
<!-- Modal nuevo insumo. Para AYB, los productos se cargan desde Inventario AYB. -->
<div id="modal-insumo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Nuevo insumo</h2>
      <button onclick="hideModal('modal-insumo')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" action="/costos/insumo/nuevo">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Nombre del insumo</label>
          <input type="text" name="nombre" placeholder="Ej: Harina 000" required>
        </div>
        <div class="field">
          <label>Código interno (opcional)</label>
          <input type="text" name="codigo" placeholder="Ej: 100001">
        </div>
        <div class="field">
          <label>Categoría</label>
          <input type="text" name="categoria" placeholder="Ej: Lácteos, Carnes">
        </div>
        <div class="field">
          <label>Unidad de medida</label>
          <select name="unidad" style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
            <option value="kg">kg</option>
            <option value="g">g</option>
            <option value="lt">lt</option>
            <option value="ml">ml</option>
            <option value="unidad">unidad</option>
            <option value="docena">docena</option>
            <option value="caja">caja</option>
            <option value="botella">botella</option>
          </select>
        </div>
        <div class="field">
          <label>Precio por unidad ($)</label>
          <input type="number" name="precio_unitario" placeholder="0.00" step="0.01" min="0">
        </div>
        <div class="field">
          <label>Stock actual (cantidad)</label>
          <input type="number" name="stock_actual" placeholder="Ej: 10" step="0.01" min="0">
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Proveedor</label>
          <input type="text" name="proveedor" placeholder="Ej: Distribuidora XYZ">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-insumo')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary"><i class="ti ti-plus"></i> Agregar insumo</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal nuevo plato -->
<div id="modal-plato" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Nuevo plato</h2>
      <button onclick="hideModal('modal-plato')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" action="/costos/plato/nuevo<%= typeof depto !== 'undefined' && depto === 'ayb' ? '?depto=ayb' : '' %>">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Nombre del plato</label>
          <input type="text" name="nombre" placeholder="Ej: Risotto de hongos" required>
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Categoría</label>
          <select name="categoria" id="sel-cat-plato" onchange="toggleOtroPlato()"
                  style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;color:var(--negro);outline:none;">
            <option value="">Seleccionar...</option>
            <option>Entrada</option><option>Sopa</option><option>Ensalada</option>
            <option>Principal</option><option>Guarnición</option><option>Postre</option>
            <option>Desayuno</option><option>Merienda</option><option>Panadería</option>
            <option>Pastelería</option><option>Bebida</option>
            <option value="otro">Otro (escribir)</option>
          </select>
          <input type="text" id="otro-cat-plato" name="categoria_otro" placeholder="Escribir categoría..."
                 style="display:none;margin-top:6px;width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;color:var(--negro);outline:none;">
        </div>
        <div class="field">
          <label>Porciones que rinde</label>
          <input type="number" name="porciones" placeholder="1" min="1" value="1">
        </div>
        <div class="field">
          <label>Margen de ganancia (%)</label>
          <input type="number" name="margen_ganancia" placeholder="30" min="0" max="100" value="30">
        </div>
        <div class="field">
          <label>Precio de venta ($)</label>
          <input type="number" name="precio_venta" placeholder="0.00" step="0.01" min="0">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-plato')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary" onclick="prepararPlato()"><i class="ti ti-plus"></i> Crear plato</button>
      </div>
    </form>
  </div>
</div>
<% } %>


<script>
function showModal(id){
  document.getElementById(id).style.display='flex';
  setTimeout(()=>{const f=document.querySelector('#'+id+' input:not([type=hidden])');if(f)f.focus();},100);
}
function hideModal(id){ document.getElementById(id).style.display='none'; }

// Búsqueda de insumos en vivo (sin esperar Enter ni recargar la página).
// OJO: la pantalla principal solo trae los primeros 200 insumos por
// defecto (para no cargar toda la tabla de una) — así que filtrar nomás
// lo que ya está en el DOM se queda corto: un insumo fuera de esos
// primeros 200 (por orden de categoría/nombre) no aparecía nunca, aunque
// existiera de verdad. Por eso esto le pregunta al servidor (ruta
// /costos/insumos/buscar-vivo) contra TODA la tabla, igual que hacía
// antes el buscador con Enter — solo que ahora se dispara solo, con un
// pequeño debounce para no mandar un pedido por cada letra tipeada.

const ES_AYB = <%= (typeof esAyb !== 'undefined' && esAyb) ? 'true' : 'false' %>;

function escaparHtml(t) {
  const div = document.createElement('div');
  div.textContent = t == null ? '' : String(t);
  return div.innerHTML;
}

function filaInsumoHtml(ins) {
  const sinPrecio = !ins.precio_unitario || parseFloat(ins.precio_unitario) === 0;
  const rutaPrecio = ES_AYB ? '/costos/producto-ayb/' : '/costos/insumo/';
  const colEliminar = ES_AYB
    ? `<a href="/inventario-ayb" title="Gestionar en Inventario AYB" style="background:var(--azul-claro);color:var(--azul);display:inline-flex;align-items:center;justify-content:center;font-size:15px;padding:5px 8px;border-radius:6px;text-decoration:none;"><i class="ti ti-external-link"></i></a>`
    : `<form method="POST" action="/costos/insumo/${ins.id}/eliminar"
              onsubmit="return confirm('¿Eliminar este insumo?')" style="margin:0;">
          <button type="submit"
                  style="background:var(--azul-claro);border:none;color:var(--azul);cursor:pointer;font-size:15px;padding:5px 8px;border-radius:6px;transition:all 0.2s;"
                  title="Eliminar"
                  onmouseover="this.style.background='#dc2626';this.style.color='#fff';"
                  onmouseout="this.style.background='var(--azul-claro)';this.style.color='var(--azul)';">
            <i class="ti ti-trash"></i>
          </button>
        </form>`;
  return `
    <tr>
      <td style="font-size:0.72rem;color:var(--gris-texto);font-family:monospace;">${ins.codigo ? escaparHtml(ins.codigo) : '—'}</td>
      <td style="font-weight:500;">
        ${escaparHtml(ins.nombre)}
        ${sinPrecio ? '<span style="display:inline-block;margin-left:6px;font-size:0.6rem;font-weight:700;background:#fef3c7;color:#92400e;padding:1px 7px;border-radius:20px;">SIN PRECIO</span>' : ''}
      </td>
      <td>
        <form method="POST" action="${rutaPrecio}${ins.id}/precio" style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">
          <span style="font-size:0.78rem;color:var(--gris-texto);">$</span>
          <input type="number" name="precio_nuevo" value="${ins.precio_unitario != null ? ins.precio_unitario : ''}" placeholder="Ej: 4500" step="0.01" min="0"
                 style="width:80px;padding:4px 8px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.82rem;outline:none;">
          <button type="submit" class="btn-sm" style="padding:4px 8px;">✓</button>
          <label title="El precio no baja solo — tildá esto solo si es una corrección real y querés bajarlo igual" style="display:flex;align-items:center;gap:3px;font-size:0.62rem;color:var(--gris-texto);cursor:pointer;white-space:nowrap;">
            <input type="checkbox" name="forzar_menor" value="1" style="width:11px;height:11px;accent-color:var(--rojo);">
            Forzar
          </label>
        </form>
      </td>
      <td>${colEliminar}</td>
    </tr>
  `;
}

// Guardamos el contenido original de la tabla (los primeros 200) para
// restaurarlo tal cual cuando el usuario borra la búsqueda.
let TBODY_INSUMOS_ORIGINAL = null;
let _debounceInsumos = null;
let _pedidoInsumosEnCurso = 0;

function filtrarInsumosEnVivo() {
  const input = document.getElementById('buscar-insumos-input');
  const tbody = document.getElementById('tabla-insumos-body');
  if (TBODY_INSUMOS_ORIGINAL === null) TBODY_INSUMOS_ORIGINAL = tbody.innerHTML;

  const texto = input.value.trim();
  const solapas = document.getElementById('solapas-letras-insumos');
  const contador = document.getElementById('contador-resultados-insumos');

  clearTimeout(_debounceInsumos);

  if (!texto) {
    // Buscador vacío: volvemos a mostrar la tabla como estaba al cargar la página.
    tbody.innerHTML = TBODY_INSUMOS_ORIGINAL;
    if (solapas) solapas.style.display = '';
    if (contador) contador.style.display = 'none';
    return;
  }

  if (solapas) solapas.style.display = 'none';

  _debounceInsumos = setTimeout(async () => {
    const idPedido = ++_pedidoInsumosEnCurso;
    let data;
    try {
      const resp = await fetch('/costos/insumos/buscar-vivo?q=' + encodeURIComponent(texto) + (ES_AYB ? '&depto=ayb' : ''));
      data = await resp.json();
    } catch (e) {
      return; // sin conexión momentánea: dejamos lo último que había en pantalla
    }
    // Si mientras esperábamos la respuesta el usuario ya tipeó algo nuevo
    // (y disparó otro pedido más reciente), descartamos esta respuesta vieja.
    if (idPedido !== _pedidoInsumosEnCurso) return;

    const insumos = data.insumos || [];
    if (contador) {
      contador.style.display = '';
      contador.textContent = insumos.length + ' resultado' + (insumos.length !== 1 ? 's' : '') + ' para "' + texto + '"';
    }
    tbody.innerHTML = insumos.length > 0
      ? insumos.map(filaInsumoHtml).join('')
      : `<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">No se encontraron insumos para "${escaparHtml(texto)}".</td></tr>`;
  }, 300);
}

// Si venimos de buscar o filtrar por letra, reabrir el modal correspondiente
<% if (buscar || letra) { %>
showModal('modal-lista-insumos');
<% } %>
<% if ((buscarPlato || letraPlato) && (typeof esAyb === 'undefined' || !esAyb)) { %>
showModal('modal-lista-platos');
<% } %>
<% if (mostrarModalVariacion) { %>
showModal('modal-variacion-precios');
<% } %>

function toggleOtroPlato() {
  const sel  = document.getElementById('sel-cat-plato');
  const otro = document.getElementById('otro-cat-plato');
  otro.style.display = sel.value === 'otro' ? 'block' : 'none';
  if (sel.value === 'otro') otro.focus();
}

function prepararPlato() {
  const sel  = document.getElementById('sel-cat-plato');
  const otro = document.getElementById('otro-cat-plato');
  if (sel.value === 'otro' && otro.value.trim()) {
    sel.name  = '';
    otro.name = 'categoria';
  }
}

const geminiConfigurado = <%= geminiConfigurado ? 'true' : 'false' %>;

// Ojo: a pesar del nombre, esta función decide "¿es una factura (foto o PDF)
// para mandarle a la IA, o es el catálogo CSV del proveedor?". Primero mira
// el tipo real que el navegador ya detectó del archivo (archivo.type) — así
// reconoce CUALQUIER tipo de imagen (incluidas las que no están en la lista
// de extensiones de abajo, como .tif, .avif, fotos de celular con nombres
// raros, etc.) sin tener que mantener una lista a mano. Si el navegador no
// pudo determinar el tipo (pasa a veces con archivos de celular), cae al
// respaldo de mirar la extensión del nombre. "pdf" está incluido a
// propósito, aunque un PDF no sea técnicamente una imagen — antes no
// estaba, así que un PDF de factura se mandaba por error al importador de
// catálogos (que espera un CSV con columnas Code/Description/Precio#) y
// tiraba ese error de "no se encontró la fila de encabezado".
function esImagen(archivo) {
  const nombreArchivo = typeof archivo === 'string' ? archivo : archivo.name;
  const tipoReal = typeof archivo === 'string' ? '' : (archivo.type || '');
  if (tipoReal) {
    return tipoReal.startsWith('image/') || tipoReal === 'application/pdf';
  }
  return /\.(jpe?g|png|gif|webp|heic|heif|bmp|tiff?|avif|pdf)$/i.test(nombreArchivo);
}

// Al elegir el archivo, muestra u oculta el campo Categoría según sea foto o catálogo
function detectarTipoArchivo(input) {
  const label       = input.closest('.input-archivo');
  const nombreSpan  = document.getElementById('nombre-archivo-unificado');
  const catInput    = document.getElementById('input-categoria-unificada');
  const textoBoton  = document.getElementById('texto-actualizar-unificado');

  if (!input.files || !input.files[0]) {
    nombreSpan.textContent = 'Elegir archivo';
    label.classList.remove('input-archivo-ok');
    return;
  }

  const archivo = input.files[0];
  nombreSpan.textContent = archivo.name;
  label.classList.add('input-archivo-ok');

  if (esImagen(archivo)) {
    catInput.style.display = 'none';
    catInput.required = false;
    textoBoton.textContent = 'Subir';
  } else {
    catInput.style.display = '';
    catInput.required = true;
    textoBoton.textContent = 'Importar';
  }
}

// Al enviar, arma la acción y el nombre del campo según haya detectado foto o catálogo
function prepararEnvioUnificado() {
  const form     = document.getElementById('form-actualizacion');
  const input    = document.getElementById('input-unificado');
  const catInput = document.getElementById('input-categoria-unificada');
  const btn      = document.getElementById('btn-actualizar-unificado');
  const icon     = document.getElementById('icon-actualizar-unificado');
  const texto    = document.getElementById('texto-actualizar-unificado');

  if (!input.files || !input.files[0]) {
    alert('Primero tenés que elegir un archivo — una foto de factura o el catálogo del proveedor.');
    return false;
  }
  const archivo = input.files[0];

  if (esImagen(archivo)) {
    if (!geminiConfigurado) {
      alert('La lectura de fotos de factura todavía no está configurada. Usá el catálogo en su lugar.');
      return false;
    }
    form.action = '/costos/factura' + (ES_AYB ? '?depto=ayb' : '');
    input.name = 'factura';
    catInput.name = '';
    texto.textContent = 'Analizando factura...';
  } else {
    if (!catInput.value.trim()) {
      alert('Escribí a qué categoría pertenece este catálogo (ej: Frescos, Secos, Congelados).');
      return false;
    }
    form.action = '/costos/insumos/importar' + (ES_AYB ? '?depto=ayb' : '');
    input.name = 'archivo_csv';
    catInput.name = 'categoria';
    texto.textContent = 'Importando...';
  }

  btn.disabled = true;
  input.style.pointerEvents = 'none';
  icon.className = 'ti ti-loader-2 girando';
  return true;
}

function marcarArchivoPlatosElegido(input) {
  const label  = input.closest('.input-archivo');
  const nombre = document.getElementById('nombre-archivo-platos');
  if (input.files && input.files[0]) {
    nombre.textContent = input.files[0].name;
    label.classList.add('input-archivo-ok');
  } else {
    nombre.textContent = 'Elegir archivo';
    label.classList.remove('input-archivo-ok');
  }
}

function prepararEnvioPlatos() {
  const btn      = document.getElementById('btn-importar-platos');
  const icon     = document.getElementById('icon-importar-platos');
  const texto    = document.getElementById('texto-importar-platos');
  const input    = document.getElementById('input-platos');
  const catInput = document.getElementById('input-categoria-platos');

  if (!catInput.value.trim()) {
    alert('Escribí a qué categoría pertenecen estos platos (ej: Pastelería, Principales).');
    return false;
  }
  if (!input.files || input.files.length === 0) {
    alert('Primero tenés que elegir el archivo.');
    return false;
  }

  btn.disabled = true;
  input.style.pointerEvents = 'none';
  icon.className = 'ti ti-loader-2 girando';
  texto.textContent = 'Importando...';
  return true;
}

// ── Carrusel de las 4 tarjetas (Insumos, Costeo de platos, Actualización de
// precios, Costeo Excel/CSV) — mismo patrón que el carrusel de fichas de
// empleados de Horas Extra: muestra las que entren juntas en el ancho de
// pantalla disponible y pagina de a una "pantalla" por vez, en vez de una
// tarjeta sola a la vez (así en pantallas anchas se ven varias juntas, sin
// angostar la página de golpe).
let costosPaginaActual = 0;

function costosPorPagina() {
  const cont = document.getElementById('costosCarousel');
  const primera = cont ? cont.querySelector('.costos-card') : null;
  if (!cont || !primera) return 1;
  const ancho = primera.getBoundingClientRect().width + 14; // + gap
  return Math.max(1, Math.floor(cont.clientWidth / ancho));
}

function actualizarDotsCostos() {
  const cont = document.getElementById('costosCarousel');
  const dotsEl = document.getElementById('costosDots');
  if (!cont || !dotsEl) return;
  const total = cont.querySelectorAll('.costos-card').length;
  const totalPaginas = Math.max(1, Math.ceil(total / costosPorPagina()));
  dotsEl.innerHTML = '';
  for (let i = 0; i < totalPaginas; i++) {
    const d = document.createElement('span');
    d.className = 'dot' + (i === 0 ? ' activa' : '');
    d.onclick = () => irAPaginaCostos(i);
    dotsEl.appendChild(d);
  }
}

function irAPaginaCostos(i) {
  const cont = document.getElementById('costosCarousel');
  const tarjetas = cont ? [...cont.querySelectorAll('.costos-card')] : [];
  const objetivo = tarjetas[i * costosPorPagina()];
  if (!cont || !objetivo) return;
  cont.scrollTo({ left: objetivo.offsetLeft - cont.offsetLeft, behavior: 'smooth' });
  document.querySelectorAll('#costosDots .dot').forEach((d, di) => d.classList.toggle('activa', di === i));
  costosPaginaActual = i;
}

function pasoCostosCarousel(dir) {
  const totalPaginas = document.querySelectorAll('#costosDots .dot').length;
  const nueva = Math.min(Math.max(costosPaginaActual + dir, 0), totalPaginas - 1);
  irAPaginaCostos(nueva);
}

document.addEventListener('DOMContentLoaded', actualizarDotsCostos);
let _resizeCostosTimer;
window.addEventListener('resize', () => {
  clearTimeout(_resizeCostosTimer);
  _resizeCostosTimer = setTimeout(actualizarDotsCostos, 200);
});

// Si el usuario arrastra el carrusel a mano (swipe táctil) en vez de usar
// las flechas/puntitos, igual mantenemos el puntito activo sincronizado.
// (Ojo: con pocas tarjetas la última "página" no siempre llega a desplazarse
// un ancho completo de página — el navegador frena el scroll antes porque no
// queda más contenido — así que esa última posición se detecta aparte, en
// vez de calcularla dividiendo la posición por el ancho de una página.)
(function () {
  const cont = document.getElementById('costosCarousel');
  if (!cont) return;
  let timer;
  cont.addEventListener('scroll', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const tarjetas = [...cont.querySelectorAll('.costos-card')];
      const totalPaginas = document.querySelectorAll('#costosDots .dot').length;
      if (!tarjetas.length || !totalPaginas) return;

      let pagina;
      const alFinal = cont.scrollLeft >= cont.scrollWidth - cont.clientWidth - 2;
      if (alFinal) {
        pagina = totalPaginas - 1;
      } else {
        const anchoPagina = costosPorPagina() * (tarjetas[0].getBoundingClientRect().width + 14);
        pagina = Math.min(totalPaginas - 1, Math.round(cont.scrollLeft / anchoPagina));
      }

      document.querySelectorAll('#costosDots .dot').forEach((d, di) => d.classList.toggle('activa', di === pagina));
      costosPaginaActual = pagina;
    }, 120);
  });
})();
</script>
</body>
</html>
