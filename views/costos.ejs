<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Costos — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'costos' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Portal interno</p>
        <h1 class="seccion-titulo">Costos</h1>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/inicio" class="btn-secondary"><i class="ti ti-home"></i> Menú principal</a>
        <button onclick="showModal('modal-insumo')" class="btn-secondary">
          <i class="ti ti-plus"></i> Nuevo insumo
        </button>
        <button onclick="showModal('modal-plato')" class="btn-primary">
          <i class="ti ti-tools-kitchen-2"></i> Nuevo plato
        </button>
      </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) {
      const msgTexto = decodeURIComponent(msg);
      const esError  = /error/i.test(msgTexto);
    %>
    <div style="background:<%= esError ? '#fef2f2' : 'var(--azul-claro)' %>;border:1px solid <%= esError ? '#fecaca' : 'var(--azul-borde)' %>;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:0.83rem;color:<%= esError ? '#dc2626' : 'var(--azul)' %>;display:flex;align-items:center;gap:10px;">
      <i class="ti <%= esError ? 'ti-alert-circle' : 'ti-check' %>" style="font-size:18px;"></i>
      <%= msgTexto %>
    </div>
    <% } %>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <!-- INSUMOS -->
      <div>
        <!-- Actualización de precios: un solo selector, detecta foto vs. catálogo solo -->
        <div class="tarjeta-unificada">
          <div class="tarjeta-unificada-icono"><i class="ti ti-refresh"></i></div>
          <p class="tarjeta-unificada-titulo">
            Actualización de precios
            <% if (geminiConfigurado) { %>
              <span class="badge-activo"><i class="ti ti-circle-filled" style="font-size:7px;"></i> Activo</span>
            <% } else { %>
              <span class="badge-inactivo">Foto no configurada</span>
            <% } %>
          </p>
          <p class="tarjeta-unificada-desc">Elegí una foto de factura o el catálogo del proveedor — el sistema detecta solo cuál es.</p>

          <div class="tarjeta-unificada-opciones">
            <form id="form-actualizacion" method="POST" enctype="multipart/form-data"
                  class="opcion-precio opcion-precio-sola" onsubmit="return prepararEnvioUnificado()">
              <input type="text" id="input-categoria-unificada" placeholder="Categoría (si es catálogo)" class="precio-card-input-categoria" style="display:none;">
              <label class="input-archivo" id="label-archivo-unificado">
                <i class="ti ti-paperclip"></i>
                <span id="nombre-archivo-unificado">Elegir archivo</span>
                <input type="file" id="input-unificado" required onchange="detectarTipoArchivo(this)">
              </label>
              <button type="submit" id="btn-actualizar-unificado" class="btn-primary">
                <i class="ti ti-upload" id="icon-actualizar-unificado"></i>
                <span id="texto-actualizar-unificado">Actualizar</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Resumen de Insumos, la lista completa vive en el modal -->
        <div class="tarjeta-resumen-lista">
          <div class="tarjeta-unificada-icono"><i class="ti ti-package"></i></div>
          <p class="tarjeta-unificada-titulo">Insumos / Ingredientes</p>
          <p class="tarjeta-resumen-numero"><%= totalInsumos %></p>
          <p class="tarjeta-unificada-desc">insumo<%= totalInsumos !== 1 ? 's' : '' %> cargado<%= totalInsumos !== 1 ? 's' : '' %></p>
          <button type="button" class="btn-primary" onclick="showModal('modal-lista-insumos')">
            <i class="ti ti-list"></i> Ver insumos
          </button>
        </div>
      </div>

      <!-- PLATOS -->
      <div>
        <!-- Importar costeo de platos, centrado -->
        <div class="tarjeta-unificada">
          <div class="tarjeta-unificada-icono tarjeta-unificada-icono-csv"><i class="ti ti-file-spreadsheet"></i></div>
          <p class="tarjeta-unificada-titulo">Costeo de platos (Excel/CSV)</p>
          <p class="tarjeta-unificada-desc">Planilla de costeo — un bloque por plato. Si ya existe (mismo nombre), se actualizan sus ingredientes.</p>

          <form id="form-importar-platos" method="POST" action="/costos/platos/importar" enctype="multipart/form-data"
                class="opcion-precio opcion-precio-sola" onsubmit="return prepararEnvioPlatos()">
            <input type="text" name="categoria_platos" id="input-categoria-platos" placeholder="Categoría (ej: Pastelería)" required class="precio-card-input-categoria">
            <label class="input-archivo">
              <i class="ti ti-paperclip"></i>
              <span id="nombre-archivo-platos">Elegir archivo</span>
              <input type="file" id="input-platos" name="archivo_platos" required
                     onchange="marcarArchivoPlatosElegido(this)">
            </label>
            <button type="submit" id="btn-importar-platos" class="btn-primary">
              <i class="ti ti-upload" id="icon-importar-platos"></i>
              <span id="texto-importar-platos">Importar</span>
            </button>
          </form>
        </div>

        <!-- Resumen de Platos, la lista completa vive en el modal -->
        <div class="tarjeta-resumen-lista">
          <div class="tarjeta-unificada-icono tarjeta-unificada-icono-csv"><i class="ti ti-tools-kitchen-2"></i></div>
          <p class="tarjeta-unificada-titulo">Costeo de platos</p>
          <p class="tarjeta-resumen-numero"><%= totalPlatos %></p>
          <p class="tarjeta-unificada-desc">plato<%= totalPlatos !== 1 ? 's' : '' %> costeado<%= totalPlatos !== 1 ? 's' : '' %></p>
          <button type="button" class="btn-primary" onclick="showModal('modal-lista-platos')">
            <i class="ti ti-list"></i> Ver platos
          </button>
        </div>
      </div>
    </div>

    <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver al menú principal</a>
    </div>
  </main>

  <%- include('partials/mobile-nav', { path: 'costos' }) %>
</div>

<!-- Modal: lista completa de Insumos -->
<div id="modal-lista-insumos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-insumos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-package"></i> Insumos / Ingredientes</p>
      <button onclick="hideModal('modal-lista-insumos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <div style="position:relative;margin-bottom:12px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <form method="GET" action="/costos">
          <input type="text" name="buscar" value="<%= buscar %>" placeholder="Buscar insumo por nombre o código..."
                 style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
          <% if (buscar) { %>
          <a href="/costos#modal-lista-insumos" title="Limpiar búsqueda" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"><i class="ti ti-x"></i></a>
          <% } %>
        </form>
      </div>

      <% if (buscar) { %>
        <p style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;">
          <%= totalInsumos %> resultado<%= totalInsumos !== 1 ? 's' : '' %> para "<%= buscar %>"
        </p>
      <% } %>

      <% if (!buscar) { %>
      <div class="solapas-letras">
        <a href="/costos" class="solapa-letra <%= !letra ? 'activa' : '' %>">Todos</a>
        <% 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(l => { %>
        <a href="/costos?letra=<%= l %>" class="solapa-letra <%= letra === l ? 'activa' : '' %>"><%= l %></a>
        <% }) %>
      </div>
      <% } %>

      <div class="tabla-wrap">
        <table class="tabla" style="table-layout:fixed;">
          <colgroup>
            <col style="width:16%"><col style="width:44%"><col style="width:32%"><col style="width:8%">
          </colgroup>
          <thead>
            <tr>
              <th>Código</th>
              <th>Insumo</th>
              <th>Precio unitario</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (insumos.length > 0) { %>
              <% insumos.forEach(ins => { %>
              <tr>
                <td style="font-size:0.72rem;color:var(--gris-texto);font-family:monospace;"><%= ins.codigo || '—' %></td>
                <td style="font-weight:500;">
                  <%= ins.nombre %>
                  <% if (!ins.precio_unitario || parseFloat(ins.precio_unitario) === 0) { %>
                    <span style="display:inline-block;margin-left:6px;font-size:0.6rem;font-weight:700;background:#fef3c7;color:#92400e;padding:1px 7px;border-radius:20px;">SIN PRECIO</span>
                  <% } %>
                </td>
                <td>
                  <form method="POST" action="/costos/insumo/<%= ins.id %>/precio" style="display:flex;gap:4px;align-items:center;">
                    <span style="font-size:0.78rem;color:var(--gris-texto);">$</span>
                    <input type="number" name="precio_nuevo" value="<%= ins.precio_unitario %>" placeholder="Ej: 4500" step="0.01" min="0"
                           style="width:80px;padding:4px 8px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.82rem;outline:none;">
                    <button type="submit" class="btn-sm" style="padding:4px 8px;">✓</button>
                  </form>
                </td>
                <td>
                  <form method="POST" action="/costos/insumo/<%= ins.id %>/eliminar"
                        onsubmit="return confirm('¿Eliminar este insumo?')" style="margin:0;">
                    <button type="submit"
                            style="background:var(--azul-claro);border:none;color:var(--azul);cursor:pointer;font-size:15px;padding:5px 8px;border-radius:6px;transition:all 0.2s;"
                            title="Eliminar"
                            onmouseover="this.style.background='#dc2626';this.style.color='#fff';"
                            onmouseout="this.style.background='var(--azul-claro)';this.style.color='var(--azul)';">
                      <i class="ti ti-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                <% if (buscar) { %>
                  No se encontraron insumos para "<%= buscar %>".
                <% } else if (letra) { %>
                  No hay insumos que empiecen con "<%= letra %>".
                <% } else { %>
                  Sin insumos. Agregá el primero.
                <% } %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal: lista completa de Platos -->
<div id="modal-lista-platos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-platos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-tools-kitchen-2"></i> Costeo de platos</p>
      <button onclick="hideModal('modal-lista-platos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <div style="position:relative;margin-bottom:12px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <form method="GET" action="/costos">
          <input type="text" name="buscarPlato" value="<%= buscarPlato %>" placeholder="Buscar plato por nombre..."
                 style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
          <% if (buscarPlato) { %>
          <a href="/costos#modal-lista-platos" title="Limpiar búsqueda" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"><i class="ti ti-x"></i></a>
          <% } %>
        </form>
      </div>

      <% if (buscarPlato) { %>
        <p style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;">
          <%= totalPlatos %> resultado<%= totalPlatos !== 1 ? 's' : '' %> para "<%= buscarPlato %>"
        </p>
      <% } %>

      <% if (!buscarPlato) { %>
      <div class="solapas-letras">
        <a href="/costos" class="solapa-letra <%= !letraPlato ? 'activa' : '' %>">Todos</a>
        <% 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(l => { %>
        <a href="/costos?letraPlato=<%= l %>" class="solapa-letra <%= letraPlato === l ? 'activa' : '' %>"><%= l %></a>
        <% }) %>
      </div>
      <% } %>

      <div class="tabla-wrap">
        <table class="tabla">
          <thead>
            <tr>
              <th>Plato</th>
              <th>Costo</th>
              <th>Margen</th>
              <th>Precio venta</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (platos.length > 0) { %>
              <% platos.forEach(p => { %>
              <tr>
                <td style="font-weight:500;">
                  <a href="/costos/plato/<%= p.id %>" style="color:var(--negro);text-decoration:none;">
                    <%= p.nombre %>
                  </a>
                  <% if (p.categoria) { %>
                    <span style="display:block;font-size:0.65rem;color:var(--gris-texto);"><%= p.categoria %></span>
                  <% } %>
                </td>
                <td style="color:var(--azul);font-weight:600;">$<%= parseFloat(p.costo_total).toFixed(2) %></td>
                <td>
                  <span style="font-size:0.72rem;background:var(--azul-claro);color:var(--azul);padding:2px 8px;border-radius:20px;font-weight:500;">
                    <%= p.margen_ganancia %>%
                  </span>
                </td>
                <td style="font-weight:600;color:#16a34a;">
                  $<%= (parseFloat(p.costo_total) * (1 + parseFloat(p.margen_ganancia)/100)).toFixed(2) %>
                </td>
                <td><a href="/costos/plato/<%= p.id %>" class="btn-sm">Ver</a></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
                <% if (buscarPlato) { %>
                  No se encontraron platos para "<%= buscarPlato %>".
                <% } else if (letraPlato) { %>
                  No hay platos que empiecen con "<%= letraPlato %>".
                <% } else { %>
                  Sin platos. Agregá el primero.
                <% } %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal nuevo insumo -->
<div id="modal-insumo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Nuevo insumo</h2>
      <button onclick="hideModal('modal-insumo')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" action="/costos/insumo/nuevo">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Nombre del insumo</label>
          <input type="text" name="nombre" placeholder="Ej: Harina 000" required>
        </div>
        <div class="field">
          <label>Código interno (opcional)</label>
          <input type="text" name="codigo" placeholder="Ej: 100001">
        </div>
        <div class="field">
          <label>Categoría</label>
          <input type="text" name="categoria" placeholder="Ej: Lácteos, Carnes">
        </div>
        <div class="field">
          <label>Unidad de medida</label>
          <select name="unidad" style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
            <option value="kg">kg</option>
            <option value="g">g</option>
            <option value="lt">lt</option>
            <option value="ml">ml</option>
            <option value="unidad">unidad</option>
            <option value="docena">docena</option>
            <option value="caja">caja</option>
            <option value="botella">botella</option>
          </select>
        </div>
        <div class="field">
          <label>Precio por unidad ($)</label>
          <input type="number" name="precio_unitario" placeholder="0.00" step="0.01" min="0">
        </div>
        <div class="field">
          <label>Stock actual (cantidad)</label>
          <input type="number" name="stock_actual" placeholder="Ej: 10" step="0.01" min="0">
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Proveedor</label>
          <input type="text" name="proveedor" placeholder="Ej: Distribuidora XYZ">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-insumo')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary"><i class="ti ti-plus"></i> Agregar insumo</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal nuevo plato -->
<div id="modal-plato" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Nuevo plato</h2>
      <button onclick="hideModal('modal-plato')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" action="/costos/plato/nuevo">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Nombre del plato</label>
          <input type="text" name="nombre" placeholder="Ej: Risotto de hongos" required>
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Categoría</label>
          <select name="categoria" id="sel-cat-plato" onchange="toggleOtroPlato()"
                  style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;color:var(--negro);outline:none;">
            <option value="">Seleccionar...</option>
            <option>Entrada</option><option>Sopa</option><option>Ensalada</option>
            <option>Principal</option><option>Guarnición</option><option>Postre</option>
            <option>Desayuno</option><option>Merienda</option><option>Panadería</option>
            <option>Pastelería</option><option>Bebida</option>
            <option value="otro">Otro (escribir)</option>
          </select>
          <input type="text" id="otro-cat-plato" name="categoria_otro" placeholder="Escribir categoría..."
                 style="display:none;margin-top:6px;width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;color:var(--negro);outline:none;">
        </div>
        <div class="field">
          <label>Porciones que rinde</label>
          <input type="number" name="porciones" placeholder="1" min="1" value="1">
        </div>
        <div class="field">
          <label>Margen de ganancia (%)</label>
          <input type="number" name="margen_ganancia" placeholder="30" min="0" max="100" value="30">
        </div>
        <div class="field">
          <label>Precio de venta ($)</label>
          <input type="number" name="precio_venta" placeholder="0.00" step="0.01" min="0">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-plato')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary" onclick="prepararPlato()"><i class="ti ti-plus"></i> Crear plato</button>
      </div>
    </form>
  </div>
</div>

<style>
.main-content-ancho{max-width:1600px;}
.puesto-badge{font-size:0.68rem;font-weight:500;color:var(--azul);background:var(--azul-claro);padding:2px 8px;border-radius:20px;}
.field{margin-bottom:0;}
.field label{display:block;font-size:0.68rem;font-weight:500;color:var(--negro);margin-bottom:6px;}
.field input,.field select{width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none;transition:border-color 0.2s;}
.field input:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(37,99,235,0.1);background:var(--blanco);}

/* Tarjeta unificada de importación, centrada, arriba de cada columna */
.tarjeta-unificada{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:22px;box-shadow:var(--sombra);text-align:center;margin-bottom:22px;}
.tarjeta-unificada-icono{width:44px;height:44px;border-radius:10px;background:var(--azul-claro);color:var(--azul);display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 12px;}
.tarjeta-unificada-icono-csv{background:#f0fdf4;color:#16a34a;}
.tarjeta-unificada-titulo{font-size:0.9rem;font-weight:600;color:var(--negro);margin:0 0 4px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;}
.tarjeta-unificada-desc{font-size:0.76rem;color:var(--gris-texto);margin:0 0 16px;line-height:1.5;}
.tarjeta-unificada-opciones{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:2px;}
.opcion-precio-sola{flex-shrink:0;}
.opcion-precio{display:flex;flex-direction:column;align-items:center;gap:8px;}
.opcion-precio-sola{flex-direction:row;flex-wrap:wrap;justify-content:center;}
.opcion-precio-label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);display:flex;align-items:center;gap:5px;}
.opcion-divisor{width:1px;align-self:stretch;background:var(--gris-borde);min-height:60px;}

/* Tarjeta resumen (reemplaza a la tabla siempre visible) */
.tarjeta-resumen-lista{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:26px 22px;box-shadow:var(--sombra);text-align:center;}
.tarjeta-resumen-numero{font-family:var(--font-serif);font-size:2.4rem;font-weight:400;color:var(--negro);margin:4px 0 0;line-height:1;}
.tarjeta-resumen-lista .tarjeta-unificada-desc{margin-bottom:18px;}
.tarjeta-resumen-lista .btn-primary{width:100%;justify-content:center;}

/* Modal de lista completa: overlay a pantalla completa, la caja centrada y grande */
.modal-lista{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;}
.modal-lista-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:800px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
.modal-lista-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--gris-borde);flex-shrink:0;}
.modal-lista-titulo{font-size:0.95rem;font-weight:600;color:var(--negro);display:flex;align-items:center;gap:8px;margin:0;}
.modal-lista-cerrar{background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);padding:4px;}
.modal-lista-cerrar:hover{color:var(--negro);}
.modal-lista-body{padding:18px 22px;overflow-y:auto;}

/* En celular, el modal ocupa toda la pantalla */
@media (max-width:700px){
  .modal-lista{padding:0;}
  .modal-lista-caja{max-width:100%;max-height:100vh;height:100vh;border-radius:0;}
}
@media (max-width:600px){.opcion-divisor{display:none;}}
.precio-card-input-categoria{padding:9px 10px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.8rem;outline:none;background:var(--gris-fondo);color:var(--negro);}
.precio-card-input-categoria:focus{border-color:var(--azul);background:var(--blanco);}

/* Solapas alfabéticas — discretas, tipo índice de agenda */
.solapas-letras{display:flex;gap:2px;overflow-x:auto;padding-bottom:10px;margin-bottom:12px;-webkit-overflow-scrolling:touch;border-bottom:1px solid var(--gris-borde);}
.solapas-letras::-webkit-scrollbar{height:3px;}
.solapas-letras::-webkit-scrollbar-thumb{background:var(--azul-borde);border-radius:3px;}
.solapa-letra{flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:24px;height:26px;padding:0 6px;border-radius:5px;color:var(--gris-texto);font-size:0.68rem;font-weight:600;text-decoration:none;transition:all 0.15s;border:1px solid transparent;}
.solapa-letra:hover{background:var(--azul-claro);color:var(--azul);}
.solapa-letra.activa{background:var(--azul);color:#fff;}
.badge-activo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;padding:2px 8px 2px 6px;border-radius:20px;display:inline-flex;align-items:center;gap:4px;}
.badge-activo i{color:#16a34a;}
.badge-inactivo{font-size:0.62rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:var(--gris-texto);background:var(--gris-borde);padding:2px 8px;border-radius:20px;}
.input-archivo{display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--gris-borde);border-radius:8px;font-size:0.8rem;color:var(--gris-texto);cursor:pointer;background:var(--gris-fondo);transition:border-color 0.2s;max-width:220px;}
.input-archivo:hover{border-color:var(--azul);}
.input-archivo span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.input-archivo input[type=file]{display:none;}
.input-archivo-disabled{opacity:0.5;cursor:not-allowed;}
.input-archivo-disabled:hover{border-color:var(--gris-borde);}
.input-archivo-ok{border-color:#16a34a;background:#f0fdf4;color:#16a34a;}
@keyframes girar{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
.girando{animation:girar 0.8s linear infinite;}
</style>

<script>
function showModal(id){
  document.getElementById(id).style.display='flex';
  setTimeout(()=>{const f=document.querySelector('#'+id+' input:not([type=hidden])');if(f)f.focus();},100);
}
function hideModal(id){ document.getElementById(id).style.display='none'; }

// Si venimos de buscar o filtrar por letra, reabrir el modal correspondiente
<% if (buscar || letra) { %>
showModal('modal-lista-insumos');
<% } %>
<% if (buscarPlato || letraPlato) { %>
showModal('modal-lista-platos');
<% } %>

function toggleOtroPlato() {
  const sel  = document.getElementById('sel-cat-plato');
  const otro = document.getElementById('otro-cat-plato');
  otro.style.display = sel.value === 'otro' ? 'block' : 'none';
  if (sel.value === 'otro') otro.focus();
}

function prepararPlato() {
  const sel  = document.getElementById('sel-cat-plato');
  const otro = document.getElementById('otro-cat-plato');
  if (sel.value === 'otro' && otro.value.trim()) {
    sel.name  = '';
    otro.name = 'categoria';
  }
}

const geminiConfigurado = <%= geminiConfigurado ? 'true' : 'false' %>;

function esImagen(nombreArchivo) {
  return /\.(jpe?g|png|gif|webp|heic|bmp)$/i.test(nombreArchivo);
}

// Al elegir el archivo, muestra u oculta el campo Categoría según sea foto o catálogo
function detectarTipoArchivo(input) {
  const label       = input.closest('.input-archivo');
  const nombreSpan  = document.getElementById('nombre-archivo-unificado');
  const catInput    = document.getElementById('input-categoria-unificada');
  const textoBoton  = document.getElementById('texto-actualizar-unificado');

  if (!input.files || !input.files[0]) {
    nombreSpan.textContent = 'Elegir archivo';
    label.classList.remove('input-archivo-ok');
    return;
  }

  const archivo = input.files[0];
  nombreSpan.textContent = archivo.name;
  label.classList.add('input-archivo-ok');

  if (esImagen(archivo.name)) {
    catInput.style.display = 'none';
    catInput.required = false;
    textoBoton.textContent = 'Subir';
  } else {
    catInput.style.display = '';
    catInput.required = true;
    textoBoton.textContent = 'Importar';
  }
}

// Al enviar, arma la acción y el nombre del campo según haya detectado foto o catálogo
function prepararEnvioUnificado() {
  const form     = document.getElementById('form-actualizacion');
  const input    = document.getElementById('input-unificado');
  const catInput = document.getElementById('input-categoria-unificada');
  const btn      = document.getElementById('btn-actualizar-unificado');
  const icon     = document.getElementById('icon-actualizar-unificado');
  const texto    = document.getElementById('texto-actualizar-unificado');

  if (!input.files || !input.files[0]) {
    alert('Primero tenés que elegir un archivo — una foto de factura o el catálogo del proveedor.');
    return false;
  }
  const archivo = input.files[0];

  if (esImagen(archivo.name)) {
    if (!geminiConfigurado) {
      alert('La lectura de fotos de factura todavía no está configurada. Usá el catálogo en su lugar.');
      return false;
    }
    form.action = '/costos/factura';
    input.name = 'factura';
    catInput.name = '';
    texto.textContent = 'Analizando factura...';
  } else {
    if (!catInput.value.trim()) {
      alert('Escribí a qué categoría pertenece este catálogo (ej: Frescos, Secos, Congelados).');
      return false;
    }
    form.action = '/costos/insumos/importar';
    input.name = 'archivo_csv';
    catInput.name = 'categoria';
    texto.textContent = 'Importando...';
  }

  btn.disabled = true;
  input.style.pointerEvents = 'none';
  icon.className = 'ti ti-loader-2 girando';
  return true;
}

function marcarArchivoPlatosElegido(input) {
  const label  = input.closest('.input-archivo');
  const nombre = document.getElementById('nombre-archivo-platos');
  if (input.files && input.files[0]) {
    nombre.textContent = input.files[0].name;
    label.classList.add('input-archivo-ok');
  } else {
    nombre.textContent = 'Elegir archivo';
    label.classList.remove('input-archivo-ok');
  }
}

function prepararEnvioPlatos() {
  const btn      = document.getElementById('btn-importar-platos');
  const icon     = document.getElementById('icon-importar-platos');
  const texto    = document.getElementById('texto-importar-platos');
  const input    = document.getElementById('input-platos');
  const catInput = document.getElementById('input-categoria-platos');

  if (!catInput.value.trim()) {
    alert('Escribí a qué categoría pertenecen estos platos (ej: Pastelería, Principales).');
    return false;
  }
  if (!input.files || input.files.length === 0) {
    alert('Primero tenés que elegir el archivo.');
    return false;
  }

  btn.disabled = true;
  input.style.pointerEvents = 'none';
  icon.className = 'ti ti-loader-2 girando';
  texto.textContent = 'Importando...';
  return true;
}
</script>
</body>
</html>
