﻿<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= plato.nombre %> — Costos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.form-card { background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:24px;box-shadow:var(--sombra); }
.form-card-title { font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azul);margin-bottom:18px;display:flex;align-items:center;gap:7px; }
.field { margin-bottom:0; }
.field label { display:block;font-size:0.68rem;font-weight:500;color:var(--negro);margin-bottom:6px; }
.field input { width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-family:var(--font-sans);font-size:0.85rem;color:var(--negro);outline:none; }
.field input:focus { border-color:var(--azul);background:var(--blanco); }
/* height:40px fijo (en vez de depender del padding) para que quede a la
   misma altura que .btn-primary — ver el comentario junto a .btn-primary
   en style.css sobre por qué esos botones tienen altura fija: el mismo
   desfasaje que resolvieron ahí pasaba acá entre "Guardar" y "Eliminar". */
.btn-danger { background:#fef2f2;border:1px solid #fecaca;color:#dc2626;font-family:var(--font-sans);font-size:0.68rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;padding:0 16px;height:40px;box-sizing:border-box;border-radius:8px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all 0.2s; }
.btn-danger:hover { background:#dc2626;color:#fff; }

/* Botones "chicos" (32px), mismo molde que Recetas/Costos, para que
   Guardar/Eliminar y "Agregar ingrediente" queden del mismo tamaño que el
   resto de la aplicación en vez del tamaño grande (40px) de antes. */
.btn-chico{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
.btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
.btn-chico-rojo{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.btn-chico-rojo:hover{background:#dc2626;color:#fff;}

.costos-plato-grid{grid-template-columns:1fr 1fr;}
.costos-plato-stats{grid-template-columns:1fr 1fr;}

.combo-resultados{display:none;position:absolute;top:100%;left:0;right:0;margin-top:4px;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:8px;max-height:260px;overflow-y:auto;z-index:50;box-shadow:0 8px 24px rgba(0,0,0,0.14);}
.combo-resultados.mostrar{display:block;}
.combo-grupo-titulo{font-size:0.65rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--gris-texto);background:var(--gris-fondo);padding:6px 12px;position:sticky;top:0;}
.combo-item{padding:8px 12px;font-size:0.82rem;cursor:pointer;display:flex;justify-content:space-between;gap:8px;}
.combo-item:hover, .combo-item.activo{background:var(--azul-claro);}
.combo-item-precio{color:var(--gris-texto);font-size:0.76rem;white-space:nowrap;}
.combo-sin-resultados{padding:12px;font-size:0.8rem;color:var(--gris-texto);text-align:center;}

.modal-confirmar{position:fixed;inset:0;background:rgba(0,0,0,0);z-index:2000;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity 0.2s ease, background 0.2s ease;}
.modal-confirmar.mostrar{opacity:1;pointer-events:auto;background:rgba(0,0,0,0.45);}
.modal-confirmar-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:380px;padding:26px 28px;box-shadow:0 20px 60px rgba(0,0,0,0.3);text-align:center;transform:scale(0.9);transition:transform 0.2s cubic-bezier(.22,1,.36,1);}
.modal-confirmar.mostrar .modal-confirmar-caja{transform:scale(1);}
.modal-confirmar-icono{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:1.4rem;background:#fef2f2;color:#dc2626;}
.modal-confirmar-msg{font-size:0.88rem;color:var(--negro);font-weight:500;margin:0 0 22px;line-height:1.5;}
.modal-confirmar-botones{display:flex;gap:10px;justify-content:center;}
.modal-confirmar-botones button{font-size:0.78rem;font-weight:600;padding:9px 18px;border-radius:8px;cursor:pointer;font-family:var(--font-sans);}
.modal-confirmar-cancelar{background:none;border:1px solid var(--gris-borde);color:var(--gris-texto);}
.modal-confirmar-cancelar:hover{background:var(--gris-fondo);}
.modal-confirmar-aceptar{background:#dc2626;border:1px solid #dc2626;color:#fff;}
.modal-confirmar-aceptar:hover{background:#b91c1c;}

/* ── Responsive: celulares chicos (320-428px típicos) ── */
@media (max-width: 600px) {
  .costos-plato-grid{grid-template-columns:1fr !important;}
}
@media (max-width: 374px) {
  /* Las 4 tarjetas de estadísticas (costo total, precio venta, margen,
     porciones) quedan muy apretadas en 2 columnas en el celular más
     angosto — pasan a una sola columna solo ahí. */
  .costos-plato-stats{grid-template-columns:1fr !important;}
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'costos' }) %>

  <main class="main-content">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label"><a href="/costos" style="color:var(--gris-texto);text-decoration:none;display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;"><i class="ti ti-arrow-left"></i> Costos</a></p>
        <h1 class="seccion-titulo"><%= plato.nombre %></h1>
      </div>
      <div style="display:flex;gap:10px;">
        <form method="POST" action="/costos/plato/<%= plato.id %>/guardar" style="margin:0;">
          <button type="submit" class="btn-chico btn-chico-verde"><i class="ti ti-device-floppy"></i> Guardar</button>
        </form>
        <form method="POST" action="/costos/plato/<%= plato.id %>/eliminar" id="form-eliminar-plato"
              onsubmit="return confirmarAccion(event, this)">
          <button type="submit" class="btn-chico btn-chico-rojo" data-confirm-msg="¿Eliminar est<%= esAyb ? 'e trago' : 'e plato' %>?"><i class="ti ti-trash"></i> Eliminar</button>
        </form>
      </div>
    </div>

    <div class="costos-plato-grid" style="display:grid;gap:20px;">

      <!-- Resumen del plato -->
      <div class="form-card">
        <p class="form-card-title"><i class="ti ti-chart-pie"></i> Resumen de costos</p>

        <div class="costos-plato-stats" style="display:grid;gap:12px;margin-bottom:20px;">
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">Costo total</p>
            <p style="font-size:1.5rem;font-weight:700;color:var(--azul);margin:0;">$<%= parseFloat(plato.costo_total).toFixed(2) %></p>
          </div>
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">Precio venta sugerido</p>
            <p style="font-size:1.5rem;font-weight:700;color:#16a34a;margin:0;">$<%= (parseFloat(plato.costo_total) * (1 + parseFloat(plato.margen_ganancia)/100)).toFixed(2) %></p>
          </div>
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">Margen ganancia</p>
            <form method="POST" action="/costos/plato/<%= plato.id %>/margen" style="display:flex;align-items:center;justify-content:center;gap:6px;margin:0;">
              <input type="number" name="margen_ganancia" value="<%= plato.margen_ganancia %>" min="0" step="1"
                     style="width:64px;text-align:center;font-size:1.3rem;font-weight:700;color:#f59e0b;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:6px;padding:2px 4px;font-family:var(--font-sans);outline:none;">
              <span style="font-size:1.3rem;font-weight:700;color:#f59e0b;">%</span>
              <button type="submit" class="btn-sm" title="Guardar margen" style="padding:5px 8px;">✓</button>
            </form>
          </div>
          <% if (esAyb) {
               // Para tragos, "porciones" no dice nada (siempre es 1) — en su
               // lugar se muestran rentabilidad y %costo, las mismas columnas
               // que traía la planilla de Excel que este módulo reemplaza.
               const ventaSugerida = parseFloat(plato.costo_total) * (1 + parseFloat(plato.margen_ganancia)/100);
               const rentabilidad = ventaSugerida - parseFloat(plato.costo_total);
               const pctCosto = ventaSugerida > 0 ? (parseFloat(plato.costo_total) / ventaSugerida) * 100 : 0;
          %>
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">Rentabilidad</p>
            <p style="font-size:1.5rem;font-weight:700;color:#16a34a;margin:0;">$<%= rentabilidad.toFixed(2) %></p>
          </div>
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">% Costo</p>
            <p style="font-size:1.5rem;font-weight:700;color:var(--negro);margin:0;"><%= pctCosto.toFixed(1) %>%</p>
          </div>
          <% } else { %>
          <div style="background:var(--gris-fondo);border-radius:10px;padding:16px;text-align:center;">
            <p style="font-size:0.65rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;">Porciones</p>
            <p style="font-size:1.5rem;font-weight:700;color:var(--negro);margin:0;"><%= plato.porciones %></p>
          </div>
          <% } %>
        </div>

        <% if (plato.porciones > 1 && plato.costo_total > 0) { %>
        <div style="background:var(--azul-claro);border-radius:8px;padding:12px;font-size:0.78rem;color:var(--azul);">
          <i class="ti ti-info-circle"></i>
          Costo por porción: <strong>$<%= (parseFloat(plato.costo_total) / plato.porciones).toFixed(2) %></strong>
          · Precio venta por porción: <strong>$<%= (parseFloat(plato.costo_total) * (1 + parseFloat(plato.margen_ganancia)/100) / plato.porciones).toFixed(2) %></strong>
        </div>
        <% } %>
      </div>

      <!-- Agregar ingrediente -->
      <div class="form-card">
        <p class="form-card-title"><i class="ti ti-plus"></i> Agregar ingrediente</p>
        <form method="POST" action="/costos/plato/<%= plato.id %>/insumo">
          <div class="field" style="margin-bottom:12px;position:relative;">
            <label>Insumo</label>
            <input type="text" id="insumo-buscar" placeholder="Buscar insumo..." autocomplete="off"
                   style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
            <input type="hidden" name="insumo_id" id="insumo-id-elegido">
            <div id="insumo-resultados" class="combo-resultados"></div>
          </div>
          <div class="costos-plato-stats" style="display:grid;gap:10px;margin-bottom:12px;">
            <div class="field">
              <label>Cantidad</label>
              <input type="number" name="cantidad" placeholder="0" step="0.01" min="0" required>
            </div>
            <div class="field">
              <label>Unidad</label>
              <select name="unidad" style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
                <option value="kg">kg</option>
                <option value="g">g</option>
                <option value="lt">lt</option>
                <option value="ml">ml</option>
                <option value="unidad">unidad</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn-chico btn-chico-verde" style="width:100%;">
            <i class="ti ti-plus"></i> Agregar ingrediente
          </button>
        </form>
      </div>

      <!-- Lista de ingredientes -->
      <div class="form-card" style="grid-column:1/-1;">
        <p class="form-card-title"><i class="ti ti-list"></i> Ingredientes del <%= esAyb ? 'trago' : 'plato' %></p>
        <% if (ingredientes.length > 0) { %>
        <div class="tabla-wrap" style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
        <table class="tabla">
          <thead>
            <tr>
              <th>Ingrediente</th>
              <th>Cantidad</th>
              <th>Precio unitario</th>
              <th>Costo parcial</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% ingredientes.forEach(ing => { %>
            <tr>
              <td style="font-weight:500;"><%= ing.insumo_nombre %></td>
              <td>
                <form method="POST" action="/costos/plato/<%= plato.id %>/insumo/<%= ing.id %>/cantidad" style="display:flex;gap:4px;align-items:center;margin:0;">
                  <input type="number" name="cantidad" value="<%= ing.cantidad %>" step="0.01" min="0"
                         style="width:75px;padding:4px 6px;border:1px solid var(--gris-borde);border-radius:6px;font-size:0.8rem;font-family:var(--font-sans);outline:none;text-align:center;">
                  <span style="font-size:0.75rem;color:var(--gris-texto);"><%= ing.unidad %></span>
                  <button type="submit" class="btn-sm" style="padding:3px 7px;" title="Guardar cantidad">✓</button>
                </form>
              </td>
              <td style="color:var(--gris-texto);">$<%= parseFloat(ing.precio_unitario).toFixed(2) %></td>
              <td style="font-weight:600;color:var(--azul);">$<%= parseFloat(ing.costo_parcial).toFixed(2) %></td>
              <td>
                <form method="POST" action="/costos/plato/<%= plato.id %>/insumo/<%= ing.id %>/eliminar" style="margin:0;">
                  <button type="submit" style="background:none;border:none;color:var(--gris-borde);cursor:pointer;font-size:15px;" title="Quitar">
                    <i class="ti ti-x"></i>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
            <tr style="background:var(--gris-fondo);">
              <td colspan="3" style="font-weight:600;text-align:right;padding-right:12px;">TOTAL</td>
              <td style="font-weight:700;color:var(--azul);font-size:1rem;">$<%= parseFloat(plato.costo_total).toFixed(2) %></td>
              <td></td>
            </tr>
          </tbody>
        </table>
        </div>
        <% } else { %>
          <p style="font-size:0.82rem;color:var(--gris-texto);font-style:italic;padding:16px 0;">Sin ingredientes todavía. Agregá el primero.</p>
        <% } %>
      </div>

    </div>

  </main>
  <%- include('partials/mobile-nav', { path: 'costos' }) %>
</div>

<div id="modal-confirmar" class="modal-confirmar" onclick="if(event.target===this) cerrarConfirmar()">
  <div class="modal-confirmar-caja">
    <div class="modal-confirmar-icono"><i class="ti ti-alert-triangle"></i></div>
    <p class="modal-confirmar-msg" id="modalConfirmarMsg"></p>
    <div class="modal-confirmar-botones">
      <button type="button" class="modal-confirmar-cancelar" onclick="cerrarConfirmar()">Cancelar</button>
      <button type="button" class="modal-confirmar-aceptar" onclick="aceptarConfirmar()">Confirmar</button>
    </div>
  </div>
</div>

<script>
// ── Confirmación de acciones (reemplaza el confirm() nativo del navegador
// por un cartel propio de la aplicación) ──
let _formConfirmarPendiente = null;

function confirmarAccion(event, form) {
  if (form.dataset.confirmado === '1') { form.dataset.confirmado = ''; return true; }
  event.preventDefault();
  const boton = form.querySelector('[data-confirm-msg]');
  document.getElementById('modalConfirmarMsg').textContent = boton ? boton.dataset.confirmMsg : '¿Confirmás esta acción?';
  _formConfirmarPendiente = form;
  document.getElementById('modal-confirmar').classList.add('mostrar');
  return false;
}

function cerrarConfirmar() {
  document.getElementById('modal-confirmar').classList.remove('mostrar');
  _formConfirmarPendiente = null;
}

function aceptarConfirmar() {
  const form = _formConfirmarPendiente;
  document.getElementById('modal-confirmar').classList.remove('mostrar');
  if (form) {
    form.dataset.confirmado = '1';
    form.requestSubmit ? form.requestSubmit() : form.submit();
  }
  _formConfirmarPendiente = null;
}

// ── Selector de insumo buscable (reemplaza el <select> nativo, que con
// listas largas hacía que cada letra tipeada "saltara" a otro producto
// distinto en vez de dejar buscar por nombre) ──
const TODOS_INSUMOS = <%- JSON.stringify(todosInsumos.map(i => ({
  id: i.id,
  nombre: i.nombre,
  categoria: (i.categoria || '').trim() || 'Sin categoría',
  precio: parseFloat(i.precio_unitario) || 0,
  unidad: i.unidad
}))) %>;

const inputBuscar = document.getElementById('insumo-buscar');
const inputElegido = document.getElementById('insumo-id-elegido');
const cajaResultados = document.getElementById('insumo-resultados');

function normalizar(txt) {
  return (txt || '').toString().normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
}

function renderResultadosInsumo(filtro) {
  const q = normalizar(filtro);
  const filtrados = TODOS_INSUMOS.filter(i => normalizar(i.nombre).includes(q));

  if (filtrados.length === 0) {
    cajaResultados.innerHTML = '<div class="combo-sin-resultados">Sin resultados</div>';
    cajaResultados.classList.add('mostrar');
    return;
  }

  // Agrupados por categoría, cada grupo ordenado alfabéticamente.
  const grupos = {};
  filtrados.forEach(i => {
    if (!grupos[i.categoria]) grupos[i.categoria] = [];
    grupos[i.categoria].push(i);
  });

  let html = '';
  Object.keys(grupos).sort((a, b) => a.localeCompare(b, 'es')).forEach(cat => {
    html += '<div class="combo-grupo-titulo">' + cat + '</div>';
    grupos[cat].forEach(i => {
      html += '<div class="combo-item" data-id="' + i.id + '">'
        + '<span>' + i.nombre + '</span>'
        + '<span class="combo-item-precio">$' + i.precio.toFixed(2) + '/' + i.unidad + '</span>'
        + '</div>';
    });
  });
  cajaResultados.innerHTML = html;
  cajaResultados.classList.add('mostrar');
}

inputBuscar.addEventListener('focus', () => renderResultadosInsumo(inputBuscar.value));
inputBuscar.addEventListener('input', () => {
  inputElegido.value = '';
  renderResultadosInsumo(inputBuscar.value);
});

cajaResultados.addEventListener('click', (ev) => {
  const item = ev.target.closest('.combo-item');
  if (!item) return;
  const insumo = TODOS_INSUMOS.find(i => String(i.id) === item.dataset.id);
  if (!insumo) return;
  inputBuscar.value = insumo.nombre;
  inputElegido.value = insumo.id;
  cajaResultados.classList.remove('mostrar');
});

document.addEventListener('click', (ev) => {
  if (!ev.target.closest('#insumo-buscar') && !ev.target.closest('#insumo-resultados')) {
    cajaResultados.classList.remove('mostrar');
  }
});

document.querySelector('form[action$="/insumo"]').addEventListener('submit', (ev) => {
  if (!inputElegido.value) {
    ev.preventDefault();
    inputBuscar.style.borderColor = '#dc2626';
    inputBuscar.focus();
    renderResultadosInsumo(inputBuscar.value);
  }
});
</script>

</body>
</html>

