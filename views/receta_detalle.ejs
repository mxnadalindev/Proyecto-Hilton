<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= receta.nombre %> — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
.detalle-card { background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; box-shadow: var(--sombra); }
.detalle-card-title { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--azul); margin-bottom: 18px; display: flex; align-items: center; gap: 7px; }
.info-rows { display: flex; flex-direction: column; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--gris-borde); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 0.75rem; color: var(--gris-texto); }
.info-val { font-size: 0.85rem; color: var(--negro); font-weight: 500; }
.list-empty { font-size: 0.78rem; color: var(--gris-texto); font-style: italic; padding: 8px 0; }
/* Recetas (volver) / Compartir / Editar / Eliminar: los 4 botones de
   acción de esta pantalla, todos del mismo tamaño (cuadrados, solo ícono,
   sin texto) y con el mismo "molde" que .btn-icono-casa en style.css —
   cada uno con su color: volver y editar en azul, compartir en verde
   traslúcido (el mismo verde del resto del sitio, no el verde de marca de
   WhatsApp), eliminar en rojo. */
.btn-icono-accion {
  display: inline-flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; box-sizing: border-box; padding: 0;
  border-radius: 8px; font-size: 15px; text-decoration: none; cursor: pointer;
  transition: all var(--tr);
  -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
}
.btn-icono-azul { background: rgba(0,47,97,0.12); color: #002f61; border: 1px solid rgba(0,47,97,0.28); }
.btn-icono-azul:hover { background: rgba(0,47,97,0.20); }
.btn-icono-verde { background: rgba(6,147,126,0.14); color: #06937e; border: 1px solid rgba(6,147,126,0.32); }
.btn-icono-verde:hover { background: rgba(6,147,126,0.24); }
.btn-icono-rojo { background: var(--rojo-claro); color: var(--rojo); border: 1px solid var(--rojo-borde); }
.btn-icono-rojo:hover { background: var(--rojo); color: #fff; }

/* "Ver video" y "Agregar procedimiento" — mismo molde chico (32px) que el
   resto del módulo de Recetas, en vez de .btn-primary (40px) y .btn-sm
   (otro estilo más viejo, sin el mismo verde/azul traslúcido). */
.btn-chico-verde { background: rgba(6,147,126,0.14); color: #06937e; border: 1px solid rgba(6,147,126,0.32); font-family: var(--font-sans); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0 12px; height: 32px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; text-decoration: none; transition: all var(--tr); box-sizing: border-box; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
.btn-chico-verde:hover { background: rgba(6,147,126,0.24); }

.receta-foto { margin-bottom: 20px; border-radius: 12px; overflow: hidden; box-shadow: var(--sombra); }
.receta-foto img { width: 100%; max-height: 380px; object-fit: cover; display: block; }
.receta-medio { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 900px) { .receta-medio { grid-template-columns: 1fr; } }

.tabla-ingredientes-ver { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
.tabla-ingredientes-ver th { font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gris-texto); text-align: left; padding: 0 6px 8px; border-bottom: 1px solid var(--gris-borde); }
.tabla-ingredientes-ver td { padding: 8px 6px; font-size: 0.83rem; color: var(--negro); border-bottom: 1px solid var(--gris-borde); }
.tabla-ingredientes-ver tr:last-child td { border-bottom: none; }

.videos-grid { display: flex; flex-direction: column; gap: 18px; }
.fotos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
.fotos-grid img { width: 100%; height: 160px; object-fit: cover; border-radius: 8px; display: block; }

@media (max-width: 600px) {
  .detalle-card { padding: 16px; }
}
</style>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'recetas'}) %>

  <main class="main-content">

    <%
      let msgWhatsapp = `*${receta.nombre}*\n\n`;
      if (ingredientes.length) {
        msgWhatsapp += `_Ingredientes:_\n`;
        ingredientes.forEach(ing => {
          let linea = `• ${ing.nombre}`;
          if (ing.cantidad) linea += ` — ${ing.cantidad}${ing.unidad ? ' ' + ing.unidad : ''}`;
          msgWhatsapp += linea + `\n`;
        });
        msgWhatsapp += `\n`;
      }
      if (receta.procedimiento) {
        msgWhatsapp += `_Procedimiento:_\n${receta.procedimiento}`;
      }
      const CLASIFICACIONES = ['Preparación', 'Montaje', 'Otros'];
      const videosPorGrupo = { 'Preparación': [], 'Montaje': [], 'Otros': [] };
      (videos || []).forEach(v => {
        const g = videosPorGrupo[v.clasificacion] ? v.clasificacion : 'Otros';
        videosPorGrupo[g].push(v);
      });
      const fotosPorGrupo = { 'Preparación': [], 'Montaje': [], 'Otros': [] };
      (fotos || []).forEach(f => {
        const g = fotosPorGrupo[f.clasificacion] ? f.clasificacion : 'Otros';
        fotosPorGrupo[g].push(f);
      });
    %>

    <% if (typeof msg !== 'undefined' && msg) {
      const mensajesReceta = { creada: 'Receta guardada correctamente.', actualizada: 'Receta actualizada correctamente.' };
      const textoMsg = mensajesReceta[msg] || null;
    %>
    <% if (textoMsg) { %>
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:0.83rem;color:#16a34a;display:flex;align-items:center;gap:10px;">
      <i class="ti ti-check" style="font-size:18px;"></i> <span data-i18n><%= textoMsg %></span>
    </div>
    <% } %>
    <% } %>

    <div class="seccion-header">
      <div class="seccion-header-left">
        <h1 class="seccion-titulo"><%= receta.nombre %></h1>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <a href="/recetas" class="btn-icono-accion btn-icono-azul" title="Recetas" data-i18n-title="Recetas"><i class="ti ti-arrow-left"></i></a>
        <a href="https://wa.me/?text=<%= encodeURIComponent(msgWhatsapp) %>" target="_blank" class="btn-icono-accion btn-icono-verde" title="Compartir" data-i18n-title="Compartir">
          <i class="ti ti-brand-whatsapp"></i>
        </a>
        <% if (puedeEditar) { %>
          <a href="/recetas/<%= receta.id %>/editar" class="btn-icono-accion btn-icono-azul" title="Editar" data-i18n-title="Editar">
            <i class="ti ti-pencil"></i>
          </a>
          <form method="POST" action="/recetas/<%= receta.id %>/eliminar"
                onsubmit="return confirm(tHilton('¿Eliminar esta receta?'))">
            <button type="submit" class="btn-icono-accion btn-icono-rojo" title="Eliminar" data-i18n-title="Eliminar">
              <i class="ti ti-trash"></i>
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- ============ 1) FOTO — arriba, ancho completo ============ -->

    <!-- Foto de portada, si la cargaron -->
    <% if (receta.imagen) { %>
    <div class="receta-foto">
      <img src="/uploads/<%= receta.imagen %>" alt="<%= receta.nombre %>">
    </div>
    <% } %>

    <!-- Fotos clasificadas (Preparación / Montaje / Otros) -->
    <% if ((fotos || []).length > 0) { %>
    <div class="detalle-card" style="margin-bottom:20px;">
      <p class="detalle-card-title"><i class="ti ti-photo"></i> <span data-i18n>Fotos</span></p>
      <% CLASIFICACIONES.forEach(grupo => { %>
        <% if (fotosPorGrupo[grupo].length > 0) { %>
        <div style="margin-bottom:18px;">
          <p style="font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;" data-i18n><%= grupo %></p>
          <div class="fotos-grid">
            <% fotosPorGrupo[grupo].forEach(f => { %>
              <img src="/uploads/<%= f.archivo %>" alt="<%= grupo %>" loading="lazy">
            <% }) %>
          </div>
        </div>
        <% } %>
      <% }) %>
    </div>
    <% } %>

    <!-- ============ 2) INGREDIENTES | PROCEDIMIENTO — en el medio ============ -->
    <div class="receta-medio">
      <div class="detalle-card">
        <p class="detalle-card-title"><i class="ti ti-list"></i> <span data-i18n>Ingredientes</span></p>
        <% if (ingredientes.length > 0) { %>
          <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
          <table class="tabla-ingredientes-ver">
            <thead><tr><th data-i18n>Ingrediente</th><th data-i18n>Cantidad</th><th data-i18n>Precio unit.</th><th data-i18n>Subtotal</th></tr></thead>
            <tbody>
              <% ingredientes.forEach(ing => {
                   const cant = parseFloat(ing.cantidad) || 0;
                   const precio = parseFloat(ing.precio_unitario) || 0;
              %>
              <tr>
                <td><%= ing.nombre %></td>
                <td><%= cant %> <%= ing.unidad || '' %></td>
                <td>$<%= precio.toFixed(2) %></td>
                <td style="font-weight:600;color:var(--azul);">$<%= (cant * precio).toFixed(2) %></td>
              </tr>
              <% }) %>
              <tr style="background:var(--gris-fondo);">
                <td colspan="3" style="font-weight:600;text-align:right;padding-right:12px;" data-i18n>COSTO TOTAL</td>
                <td style="font-weight:700;color:var(--azul);font-size:1rem;">$<%= parseFloat(costoTotal).toFixed(2) %></td>
              </tr>
            </tbody>
          </table>
          </div>
          <p style="font-size:0.68rem;color:var(--gris-texto);margin-top:6px;font-style:italic;" data-i18n>Los precios se toman en vivo desde Costos — si cambia el precio de un insumo, se actualiza acá solo.</p>
        <% } else { %>
          <p class="list-empty" data-i18n>Sin ingredientes cargados.</p>
        <% } %>

        <div style="margin-top:14px;">
          <p class="detalle-card-title"><i class="ti ti-info-circle"></i> <span data-i18n>Información</span></p>
          <div class="info-rows">
            <div class="info-row"><span class="info-label" data-i18n>Categoría</span><span class="info-val"><%= receta.categoria || '—' %></span></div>
            <div class="info-row"><span class="info-label" data-i18n>Área</span><span class="info-val"><%= receta.area || '—' %></span></div>
          </div>
        </div>
      </div>

      <div class="detalle-card">
        <p class="detalle-card-title"><i class="ti ti-list-numbers"></i> <span data-i18n>Procedimiento</span></p>
        <% if (receta.procedimiento) { %>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <% receta.procedimiento.split('\n').forEach((paso, i) => { %>
              <% if (paso.trim()) { %>
                <div style="display:flex;gap:14px;align-items:flex-start;">
                  <div style="width:28px;height:28px;border-radius:50%;background:var(--azul);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:600;flex-shrink:0;">
                    <%= i + 1 %>
                  </div>
                  <p style="font-size:0.85rem;color:var(--negro);line-height:1.7;margin:4px 0;"><%= paso.replace(/^Paso \d+:\s*/i, '').trim() %></p>
                </div>
              <% } %>
            <% }) %>
          </div>
        <% } else { %>
          <p class="list-empty" data-i18n>Sin procedimiento cargado.</p>
          <% if (puedeEditar) { %>
          <a href="/recetas/<%= receta.id %>/editar" class="btn-chico-verde" style="margin-top:10px;">
            <i class="ti ti-plus"></i> <span data-i18n>Agregar procedimiento</span>
          </a>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- ============ 3) VIDEO — abajo, ancho completo ============ -->
    <% if ((videos || []).length > 0) { %>
    <div class="detalle-card" style="margin-top:20px;">
      <p class="detalle-card-title"><i class="ti ti-video"></i> <span data-i18n>Videos</span></p>
      <% CLASIFICACIONES.forEach(grupo => { %>
        <% if (videosPorGrupo[grupo].length > 0) { %>
        <div style="margin-bottom:18px;">
          <p style="font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;" data-i18n><%= grupo %></p>
          <div class="videos-grid">
            <% videosPorGrupo[grupo].forEach(v => { %>
              <% if (v.origen === 'url' && (v.valor.includes('youtube') || v.valor.includes('youtu.be'))) { %>
                <% const ytId = v.valor.includes('youtu.be') ? v.valor.split('/').pop() : v.valor.split('v=')[1]?.split('&')[0]; %>
                <iframe width="100%" src="https://www.youtube.com/embed/<%= ytId %>" frameborder="0" allowfullscreen style="border-radius:8px;aspect-ratio:16/9;display:block;"></iframe>
              <% } else if (v.origen === 'url') { %>
                <a href="<%= v.valor %>" target="_blank" class="btn-chico-verde" style="display:inline-flex;">
                  <i class="ti ti-external-link"></i> <span data-i18n>Ver video</span>
                </a>
              <% } else { %>
                <video controls style="width:100%;max-height:75vh;border-radius:8px;display:block;background:#000;">
                  <source src="/uploads/<%= v.valor %>">
                </video>
              <% } %>
            <% }) %>
          </div>
        </div>
        <% } %>
      <% }) %>
    </div>
    <% } %>

  </main>
  <%- include('partials/mobile-nav', { path: 'recetas' }) %>
</div>


</body>
</html>
