<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventario AYB — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
  <style>
.btn-icono{background:none;border:1px solid var(--gris-borde);border-radius:8px;width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--gris-texto);transition:border-color .2s,color .2s;text-decoration:none;}
.btn-icono:hover{border-color:var(--azul);color:var(--azul);}

/* Botones "vidrio" verde/navy — mismo estilo traslúcido que ya usamos en
   las tarjetas de resumen y la barra de arriba, aplicado acá a los botones
   de esta pantalla (antes eran grises/celestes lisos).
   Tamaño "chico" (32px), mismo molde que el resto de la aplicación. */
.btn-glass-verde,.btn-glass-navy{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:5px;height:32px;border-radius:8px;padding:0 12px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:all .2s;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-glass-verde{background:rgba(6,147,126,0.14);border:1px solid rgba(6,147,126,0.32);color:#06937e;}
.btn-glass-verde:hover{background:rgba(6,147,126,0.24);}
.btn-glass-navy{background:rgba(0,47,97,0.12);border:1px solid rgba(0,47,97,0.28);color:#002f61;}
.btn-glass-navy:hover{background:rgba(0,47,97,0.20);}
.btn-glass-icono{padding:0;width:32px;font-size:15px;}
.btn-icono-glass-verde,.btn-icono-glass-navy{border-radius:8px;width:32px;height:32px;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);transition:all .2s;}
.btn-icono-glass-verde{background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);color:#06937e;}
.btn-icono-glass-verde:hover{background:rgba(6,147,126,0.22);}
.btn-icono-glass-navy{background:rgba(0,47,97,0.10);border:1px solid rgba(0,47,97,0.26);color:#002f61;}
.btn-icono-glass-navy:hover{background:rgba(0,47,97,0.18);}
.field{display:flex;flex-direction:column;gap:6px;}
.field label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.04em;}
.field input,.field select{border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;background:var(--gris-fondo);}
.field input:focus,.field select:focus{border-color:var(--azul);background:var(--blanco);}

/* "Otras opciones" — mismo patrón que ya usan Horarios y Horas extra:
   agrupa acá los botones secundarios (antes eran 4-5 botones sueltos que
   no entraban en una sola fila y se amontonaban en pantallas chicas). */
.dropdown-otras-opciones{position:absolute;right:0;top:calc(100% + 6px);background:var(--blanco);border:1px solid var(--gris-borde);border-radius:10px;box-shadow:var(--sombra-md);padding:6px;min-width:220px;display:none;flex-direction:column;gap:2px;z-index:50;}
.dropdown-otras-opciones.abierto{display:flex;}
.dropdown-otras-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:7px;font-size:0.83rem;color:var(--negro);text-decoration:none;transition:background .15s;}
.dropdown-otras-item:hover{background:var(--gris-fondo);}
.dropdown-otras-item i{font-size:15px;color:var(--gris-texto);flex-shrink:0;}
/* Un color por tipo de acción, para distinguirlas de un vistazo — mismo
   patrón que ya usan los desplegables de Costos/Horarios/Horas extra
   (ahí "Excel" ya venía verde): acá se agrega "crear" (verde principal
   del sitio) y "nav" (azul marino) para las que faltaban. */
.dropdown-otras-item-crear{ color:#057a68; }
.dropdown-otras-item-crear i{ color:#06937e; }
.dropdown-otras-item-crear:hover{ background:rgba(6,147,126,0.10); }
.dropdown-otras-item-excel{ color:#15803d; }
.dropdown-otras-item-excel i{ color:#16a34a; }
.dropdown-otras-item-excel:hover{ background:#f0fdf4; }
.dropdown-otras-item-nav{ color:#002f61; }
.dropdown-otras-item-nav i{ color:#1d4e89; }
.dropdown-otras-item-nav:hover{ background:rgba(0,47,97,0.08); }

/* Modal de lista completa: overlay a pantalla completa, la caja centrada
   y grande — igual que el de Insumos en Costos. */
.modal-lista{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;}
.modal-lista-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:820px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
.modal-lista-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--gris-borde);flex-shrink:0;}
.modal-lista-titulo{font-size:0.95rem;font-weight:600;color:var(--negro);display:flex;align-items:center;gap:8px;margin:0;}
.modal-lista-cerrar{background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);padding:4px;}
.modal-lista-cerrar:hover{color:var(--negro);}
/* min-width:0 acá es la pieza que faltaba: .modal-lista-body es un hijo de
   .modal-lista-caja (que es flex-direction:column), y por default un hijo
   de flex NO se achica más allá de lo que necesite su contenido más ancho
   (en este caso, una tabla con muchas columnas + nombres largos). Sin
   min-width:0, el modal entero se estiraba para hacerle lugar a esa tabla
   en vez de quedarse en los 820px y dejar que la tabla scrollee sola
   adentro (el overflow-x:auto de .tabla-wrap en style.css nunca llegaba a
   activarse por esto — mismo patrón de bug que ya se había resuelto antes
   en .main-content, ver el comentario ahí). */
.modal-lista-body{padding:18px 22px;overflow-y:auto;min-width:0;}
@media (max-width:700px){
  .modal-lista{padding:0;}
  .modal-lista-caja{max-width:100%;max-height:100vh;height:100vh;border-radius:0;}
}

/* Rubros (categorías) — mismas "solapas" tipo índice que usa Costos para
   las letras, pero acá cada solapa es un rubro en vez de una letra. */
.solapas-rubros{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;margin-bottom:14px;-webkit-overflow-scrolling:touch;border-bottom:1px solid var(--gris-borde);flex-wrap:nowrap;}
.solapas-rubros::-webkit-scrollbar{height:3px;}
.solapas-rubros::-webkit-scrollbar-thumb{background:var(--azul-borde);border-radius:3px;}
.solapa-rubro{flex-shrink:0;display:flex;align-items:center;justify-content:center;padding:5px 12px;border-radius:20px;color:var(--gris-texto);font-size:0.7rem;font-weight:600;text-decoration:none;transition:all 0.15s;border:1px solid var(--gris-borde);white-space:nowrap;}
.solapa-rubro:hover{background:var(--azul-claro);color:var(--azul);border-color:var(--azul-borde);}
.solapa-rubro.activa{background:var(--azul);color:#fff;border-color:var(--azul);}

/* Encabezado de rubro dentro de la tabla, cuando se ven todos los
   productos juntos (sin buscar ni filtrar por un rubro puntual). */
.fila-rubro td{background:var(--gris-fondo);font-size:0.68rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--gris-texto);padding:7px 12px;}

/* Esta tabla en particular (nombres de producto largos + una columna con
   un formulario adentro + dos columnas de íconos al final) es de las más
   angostas-de-margen que hay en el sitio. En vez de confiar en que el
   texto se ajuste solo (que en algunos navegadores/fuentes termina
   apretando tanto las columnas de los botones que quedan invisibles o
   recortadas), le ponemos un ancho mínimo fijo — así, si no entra, se
   activa el scroll horizontal de .tabla-wrap de forma predecible en vez
   de "capaz entra, capaz no" según la pantalla de cada uno. */
#modal-lista-productos .tabla{min-width:640px;}

/* Solución definitiva para que Editar/Eliminar NUNCA queden escondidos:
   en vez de depender de que el usuario sepa que puede hacer scroll para
   el costado (algo que no es obvio y fue justo el problema reportado —
   "en la categoría 300 no se ve Editar/Eliminar"), esta columna queda
   "pegada" al borde derecho de la tabla todo el tiempo, sin importar cuán
   ancha sea la tabla ni el ancho de pantalla de cada uno. El box-shadow
   es solo una sombrita sutil para que se note que hay más contenido
   scrolleable detrás, como en Google Sheets o Excel con paneles fijos. */
#modal-lista-productos .tabla td.td-acciones,
#modal-lista-productos .tabla th.th-acciones{
  position:sticky;right:0;background:var(--blanco);
  box-shadow:-6px 0 6px -6px rgba(0,0,0,0.18);
}
#modal-lista-productos .tabla thead th.th-acciones{background:var(--gris-fondo);}
/* El verde de "fila con el mouse encima" (var(--azul-claro)) es un color
   CON TRANSPARENCIA (10% de opacidad), no un verde sólido. Esta celda,
   al estar "pegada" con position:sticky, queda dibujada arriba de la
   tabla que sigue existiendo (y scrolleando) debajo suyo — como esa
   tabla de abajo TAMBIÉN está pintada del mismo verde transparente en la
   fila con el mouse encima, se terminan superponiendo dos capas del
   mismo verde transparente una sobre la otra, y el resultado se ve más
   oscuro/saturado que el resto de la fila (que tiene una sola capa). Por
   eso acá, a diferencia de arriba, no usamos el verde transparente sino
   el mismo color pero ya "resuelto" contra fondo blanco (sólido, sin
   transparencia) — así no hay dos capas que sumar y queda parejo con el
   resto de la fila. */
#modal-lista-productos .tabla tbody tr:hover td.td-acciones{background:#e6f4f2;box-shadow:none;}
#modal-lista-productos .tabla tr.fila-rubro td.td-acciones{background:var(--gris-fondo);box-shadow:none;}

/* Transición suave de alto al cambiar de rubro/categoría — sin esto, pasar
   de una categoría con muchos productos a una con pocos (ej. "280") hacía
   que la lista se achicara de golpe, lo cual se nota como un salto aunque
   ya no haya ninguna recarga real de por medio. */
/* Antes se intentó animar el ALTO en píxeles al cambiar de categoría, pero
   con tablas grandes (miles de píxeles) esa animación pasa casi entera
   fuera de lo que se ve en pantalla y el resultado seguía sintiéndose como
   un salto. Ahora en cambio se hace un fundido (fade): el contenido viejo
   se desvanece, el cambio de alto pasa MIENTRAS está invisible, y recién
   ahí aparece el contenido nuevo ya con su alto definitivo — mucho más
   parecido a lo que se ve en apps como Notion o Linear al cambiar de
   pestaña/filtro. */
#contenedor-productos-lista{transition:opacity .18s ease;}
  </style>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'inventario-ayb' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Alimentos y Bebidas</p>
        <h1 class="seccion-titulo">Inventario</h1>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/inicio" class="btn-glass-verde btn-glass-icono" title="Menú principal"><i class="ti ti-home"></i></a>
        <div class="menu-otras-opciones" style="position:relative;">
          <button type="button" class="btn-glass-navy" onclick="toggleOtrasOpciones(event)" id="btn-otras-opciones">
            <i class="ti ti-dots"></i> Otras opciones <i class="ti ti-chevron-down" style="font-size:12px;"></i>
          </button>
          <div class="dropdown-otras-opciones" id="dropdown-otras-opciones">
            <a href="#" onclick="hideOtrasOpciones();showModal('modal-producto');return false;" class="dropdown-otras-item dropdown-otras-item-crear"><i class="ti ti-plus"></i> Nuevo producto</a>
            <a href="#" onclick="hideOtrasOpciones();showModal('modal-importar');return false;" class="dropdown-otras-item dropdown-otras-item-excel"><i class="ti ti-file-spreadsheet"></i> Importar productos (Excel)</a>
            <a href="/inventario-ayb/precios/importar" class="dropdown-otras-item dropdown-otras-item-excel"><i class="ti ti-currency-dollar"></i> Actualizar precios (Excel)</a>
            <a href="/inventario-ayb/necesidad-semanal" class="dropdown-otras-item dropdown-otras-item-nav"><i class="ti ti-clipboard-list"></i> Necesidad semanal</a>
            <a href="/inventario-ayb/reportes" class="dropdown-otras-item dropdown-otras-item-nav"><i class="ti ti-chart-bar"></i> Reportes de consumo</a>
            <a href="/inventario-ayb/etiquetas" class="dropdown-otras-item dropdown-otras-item-nav"><i class="ti ti-qrcode"></i> Imprimir etiquetas QR</a>
            <% if (typeof geminiConfigurado !== 'undefined' && geminiConfigurado) { %>
            <a href="/inventario-ayb/reconocer" class="dropdown-otras-item dropdown-otras-item-nav"><i class="ti ti-camera"></i> Reconocer con foto</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) {
      // Ver comentario en inventario_ayb_ajustar.ejs: si el mensaje trae un
      // "%" que no forma parte de un %XX válido, decodificarlo de nuevo acá
      // tira "URI malformed" — con el try/catch se muestra tal cual llegó.
      let msgTexto;
      try { msgTexto = decodeURIComponent(msg); } catch (e) { msgTexto = msg; }
      const esError  = /error/i.test(msgTexto);
    %>
    <div style="background:<%= esError ? '#fef2f2' : 'var(--azul-claro)' %>;border:1px solid <%= esError ? '#fecaca' : 'var(--azul-borde)' %>;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:0.83rem;color:<%= esError ? '#dc2626' : 'var(--azul)' %>;display:flex;align-items:center;gap:10px;">
      <i class="ti <%= esError ? 'ti-alert-circle' : 'ti-check' %>" style="font-size:18px;"></i>
      <%= msgTexto %>
    </div>
    <% } %>

    <!-- Resumen: las dos tarjetas son botones que abren cada una su modal
         con el detalle completo (lista de productos por rubro / lista de
         stock bajo) — antes el total de productos se repetía acá arriba Y
         en una tarjeta blanca aparte más abajo, con el mismo número dos
         veces en la misma pantalla; ahora esta tarjeta verde cumple las dos
         funciones (mostrar el total y abrir la lista) y la tarjeta blanca
         de abajo se sacó. -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px;">
      <button type="button"
              onclick="showModal('modal-lista-productos')"
              title="Ver productos"
              style="background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;font-family:inherit;width:100%;cursor:pointer;transition:background .15s ease;"
              onmouseover="this.style.background='rgba(6,147,126,0.20)'" onmouseout="this.style.background='rgba(6,147,126,0.12)'">
        <p id="contador-total-productos" style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= totalProductos %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Producto<%= totalProductos !== 1 ? 's' : '' %> activo<%= totalProductos !== 1 ? 's' : '' %></p>
      </button>
      <button type="button"
              <% if (bajoStock.length > 0) { %>onclick="showModal('modal-stock-bajo')"<% } else { %>disabled<% } %>
              title="<%= bajoStock.length > 0 ? 'Ver productos con stock bajo el mínimo' : 'No hay productos con stock bajo el mínimo' %>"
              style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;font-family:inherit;width:100%;<%= bajoStock.length > 0 ? 'cursor:pointer;' : 'cursor:default;' %>transition:background .15s ease;"
              <% if (bajoStock.length > 0) { %>onmouseover="this.style.background='rgba(220,38,38,0.16)'" onmouseout="this.style.background='rgba(220,38,38,0.10)'"<% } %>>
        <p id="contador-stock-bajo" style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= bajoStock.length %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Con stock bajo el mínimo</p>
      </button>
    </div>

  </main>

  <%- include('partials/mobile-nav', { path: 'inventario-ayb' }) %>
</div>

<!-- Modal: lista completa de productos, separada por rubro -->
<div id="modal-lista-productos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-productos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-bottle"></i> Productos</p>
      <button onclick="hideModal('modal-lista-productos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <form method="GET" action="/inventario-ayb" style="position:relative;margin-bottom:12px;" onsubmit="return false;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <input type="text" name="buscar" id="buscar-productos-input" value="<%= buscar %>" placeholder="Buscar por nombre, categoría o código..."
               oninput="filtrarProductosEnVivo()"
               style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
        <a href="#" title="Limpiar búsqueda" onclick="event.preventDefault();document.getElementById('buscar-productos-input').value='';filtrarProductosEnVivo();" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;<%= buscar ? '' : 'display:none;' %>" id="btn-limpiar-buscar-productos"><i class="ti ti-x"></i></a>
      </form>

      <p id="contador-resultados-productos" style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;<%= buscar ? '' : 'display:none;' %>">
        <%= totalListado %> resultado<%= totalListado !== 1 ? 's' : '' %> para "<%= buscar %>"
      </p>

      <!-- Rubros (categorías) — filtra la lista a un solo rubro por vez. Se
           esconde mientras se está buscando, igual que antes. Antes eran
           <a href> que navegaban de nuevo a /inventario-ayb (recarga
           entera de la página, con el parpadeo/salto que reportó Maxi);
           ahora son botones que piden solo los datos por JS (ver
           seleccionarRubro más abajo) y no navegan. -->
      <div class="solapas-rubros" id="solapas-rubros-productos" style="<%= buscar ? 'display:none;' : '' %>">
        <button type="button" data-rubro="" class="solapa-rubro <%= !rubro ? 'activa' : '' %>" onclick="seleccionarRubro(this)">Todos</button>
        <% categoriasDisponibles.forEach(cat => { %>
        <button type="button" data-rubro="<%= cat %>" class="solapa-rubro <%= rubro === cat ? 'activa' : '' %>" onclick="seleccionarRubro(this)"><%= cat %></button>
        <% }) %>
      </div>

      <div id="contenedor-productos-lista">
      <% if (productos.length === 0) { %>
        <div style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
          <% if (buscar) { %>
            No se encontró ningún producto para "<%= buscar %>".
          <% } else if (rubro) { %>
            No hay productos en el rubro "<%= rubro %>".
          <% } else { %>
            Todavía no hay ningún producto cargado. Usá "Nuevo producto" para empezar.
          <% } %>
        </div>
      <% } else { %>
      <div class="tabla-wrap">
        <table class="tabla" style="width:100%;">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Categoría</th>
              <th>Stock actual</th>
              <th>Mínimo</th>
              <th></th>
              <th class="th-acciones"></th>
            </tr>
          </thead>
          <tbody>
            <% let categoriaAnterior = null; %>
            <% productos.forEach(p => {
              const bajo = p.stock_minimo != null && (p.stock_actual || 0) <= p.stock_minimo;
              // Encabezado de rubro: solo cuando se ven todos juntos (sin
              // buscar ni filtrar por un rubro puntual), y solo al cambiar
              // de categoría — la lista ya viene ordenada por categoría.
              const mostrarEncabezadoRubro = !buscar && !rubro && p.categoria !== categoriaAnterior;
              if (mostrarEncabezadoRubro) categoriaAnterior = p.categoria;
            %>
            <% if (mostrarEncabezadoRubro) { %>
            <tr class="fila-rubro"><td colspan="6"><%= p.categoria || 'Sin categoría' %></td></tr>
            <% } %>
            <tr>
              <td style="font-size:0.82rem;font-weight:500;">
                <%= p.nombre %>
                <% if (p.codigo_barras) { %><span style="display:block;font-size:0.68rem;color:var(--gris-texto);">Cód: <%= p.codigo_barras %></span><% } %>
              </td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.categoria || '—' %></td>
              <td>
                <form method="POST" action="/inventario-ayb/producto/<%= p.id %>/ajustar" class="form-ajustar-stock" data-bajo-actual="<%= bajo ? '1' : '0' %>" style="display:flex;gap:4px;align-items:center;">
                  <input type="hidden" name="modo" value="establecer">
                  <input type="hidden" name="volver_lista" value="1">
                  <input type="hidden" name="buscar_actual" value="<%= buscar %>">
                  <input type="hidden" name="rubro_actual" value="<%= rubro %>">
                  <input type="number" name="cantidad" value="<%= p.stock_actual || 0 %>" step="0.01" min="0"
                         style="width:70px;background:<%= bajo ? '#fef3c7' : 'var(--gris-fondo)' %>;border:1px solid <%= bajo ? '#fde68a' : 'var(--gris-borde)' %>;border-radius:6px;padding:5px 7px;font-size:0.8rem;">
                  <span style="color:var(--gris-texto);"><%= p.unidad_default || '' %></span>
                  <button type="submit" class="btn-icono-glass-verde" title="Guardar cantidad"><i class="ti ti-device-floppy"></i></button>
                </form>
              </td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.stock_minimo != null ? p.stock_minimo : '—' %></td>
              <td style="white-space:nowrap;">
                <a href="/inventario-ayb/producto/<%= p.id %>/ajustar" class="btn-icono-glass-navy" title="Ver QR / ajuste rápido"><i class="ti ti-qrcode"></i></a>
              </td>
              <td class="td-acciones" style="white-space:nowrap;">
                <button type="button" class="btn-icono-glass-navy" title="Editar" onclick='abrirModalEditar(<%- JSON.stringify({id:p.id,nombre:p.nombre,categoria:p.categoria||"",unidad_default:p.unidad_default||"",stock_minimo:p.stock_minimo,precio_unitario:p.precio_unitario,codigo_barras:p.codigo_barras||""}).replace(/'/g, "&#39;") %>)'><i class="ti ti-pencil"></i></button>
                <form method="POST" action="/inventario-ayb/producto/<%= p.id %>/eliminar" class="form-eliminar-producto" style="display:inline;">
                  <input type="hidden" name="volver_lista" value="1">
                  <input type="hidden" name="buscar_actual" value="<%= buscar %>">
                  <input type="hidden" name="rubro_actual" value="<%= rubro %>">
                  <button type="submit" class="btn-icono" title="Dar de baja" style="color:#dc2626;"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal: productos con stock bajo el mínimo — se abre desde la tarjeta roja
     "Con stock bajo el mínimo" de arriba. Antes esa info se mostraba siempre
     abierta en un cartel amarillo debajo de las tarjetas; ahora la tarjeta
     roja es un botón que abre esto en una ventana emergente y el cartel
     amarillo se sacó. -->
<div id="modal-stock-bajo" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-stock-bajo')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-alert-triangle" style="color:#dc2626;"></i> Con stock bajo el mínimo</p>
      <button onclick="hideModal('modal-stock-bajo')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>
    <div class="modal-lista-body">
      <% if (bajoStock.length === 0) { %>
        <div style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
          No hay productos con stock bajo el mínimo.
        </div>
      <% } else { %>
      <div class="tabla-wrap">
        <table class="tabla" style="width:100%;">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Categoría</th>
              <th>Stock actual</th>
              <th>Mínimo</th>
            </tr>
          </thead>
          <tbody>
            <% bajoStock.forEach(p => { %>
            <tr>
              <td style="font-size:0.82rem;font-weight:500;"><%= p.nombre %></td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.categoria || '—' %></td>
              <td style="font-size:0.82rem;color:#dc2626;font-weight:600;"><%= p.stock_actual || 0 %> <%= p.unidad_default || '' %></td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.stock_minimo != null ? p.stock_minimo : '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal nuevo producto -->
