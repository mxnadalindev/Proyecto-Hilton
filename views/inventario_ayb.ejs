<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventario AYB — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <style>
.btn-icono{background:none;border:1px solid var(--gris-borde);border-radius:8px;width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--gris-texto);transition:border-color .2s,color .2s;text-decoration:none;}
.btn-icono:hover{border-color:var(--azul);color:var(--azul);}

/* Botones "vidrio" verde/navy — mismo estilo traslúcido que ya usamos en
   las tarjetas de resumen y la barra de arriba, aplicado acá a los botones
   de esta pantalla (antes eran grises/celestes lisos). */
.btn-glass-verde,.btn-glass-navy{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;border-radius:8px;padding:0 18px;font-family:var(--font-sans);font-size:0.7rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:all .2s;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-glass-verde{background:rgba(6,147,126,0.14);border:1px solid rgba(6,147,126,0.32);color:#06937e;}
.btn-glass-verde:hover{background:rgba(6,147,126,0.24);}
.btn-glass-navy{background:rgba(0,47,97,0.12);border:1px solid rgba(0,47,97,0.28);color:#002f61;}
.btn-glass-navy:hover{background:rgba(0,47,97,0.20);}
.btn-glass-icono{padding:0;width:40px;font-size:16px;}
.btn-icono-glass-verde,.btn-icono-glass-navy{border-radius:8px;width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);transition:all .2s;}
.btn-icono-glass-verde{background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);color:#06937e;}
.btn-icono-glass-verde:hover{background:rgba(6,147,126,0.22);}
.btn-icono-glass-navy{background:rgba(0,47,97,0.10);border:1px solid rgba(0,47,97,0.26);color:#002f61;}
.btn-icono-glass-navy:hover{background:rgba(0,47,97,0.18);}
.field{display:flex;flex-direction:column;gap:6px;}
.field label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.04em;}
.field input,.field select{border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;background:var(--gris-fondo);}
.field input:focus,.field select:focus{border-color:var(--azul);background:var(--blanco);}

/* "Otras opciones" — mismo patrón que ya usan Horarios y Horas extra:
   agrupa acá los botones secundarios (antes eran 4-5 botones sueltos que
   no entraban en una sola fila y se amontonaban en pantallas chicas). */
.dropdown-otras-opciones{position:absolute;right:0;top:calc(100% + 6px);background:var(--blanco);border:1px solid var(--gris-borde);border-radius:10px;box-shadow:var(--sombra-md);padding:6px;min-width:220px;display:none;flex-direction:column;gap:2px;z-index:50;}
.dropdown-otras-opciones.abierto{display:flex;}
.dropdown-otras-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:7px;font-size:0.83rem;color:var(--negro);text-decoration:none;transition:background .15s;}
.dropdown-otras-item:hover{background:var(--gris-fondo);}
.dropdown-otras-item i{font-size:15px;color:var(--gris-texto);flex-shrink:0;}

/* Tarjeta resumen que reemplaza a la tabla siempre visible — mismo patrón
   que "Insumos / Ingredientes" en Costos: un cartel con el total y un
   botón que abre la lista completa en un modal, en vez de que la lista
   ocupe toda la pantalla de entrada (con muchos productos se hacía
   kilométrica). */
.tarjeta-resumen-lista{max-width:360px;margin:0 auto 26px;background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:26px 22px;box-shadow:var(--sombra);text-align:center;}
.tarjeta-resumen-lista-icono{width:44px;height:44px;border-radius:10px;background:var(--azul-claro);color:var(--azul);display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 12px;}
.tarjeta-resumen-lista-titulo{font-size:0.9rem;font-weight:600;color:var(--negro);margin:0 0 4px;}
.tarjeta-resumen-numero{font-family:var(--font-serif);font-size:2.4rem;font-weight:400;color:var(--negro);margin:4px 0 0;line-height:1;}
.tarjeta-resumen-lista-desc{font-size:0.76rem;color:var(--gris-texto);margin:0 0 18px;}
.tarjeta-resumen-lista .btn-glass-verde{width:100%;}

/* Modal de lista completa: overlay a pantalla completa, la caja centrada
   y grande — igual que el de Insumos en Costos. */
.modal-lista{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;}
.modal-lista-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:820px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);}
.modal-lista-header{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--gris-borde);flex-shrink:0;}
.modal-lista-titulo{font-size:0.95rem;font-weight:600;color:var(--negro);display:flex;align-items:center;gap:8px;margin:0;}
.modal-lista-cerrar{background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);padding:4px;}
.modal-lista-cerrar:hover{color:var(--negro);}
.modal-lista-body{padding:18px 22px;overflow-y:auto;}
@media (max-width:700px){
  .modal-lista{padding:0;}
  .modal-lista-caja{max-width:100%;max-height:100vh;height:100vh;border-radius:0;}
}

/* Rubros (categorías) — mismas "solapas" tipo índice que usa Costos para
   las letras, pero acá cada solapa es un rubro en vez de una letra. */
.solapas-rubros{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;margin-bottom:14px;-webkit-overflow-scrolling:touch;border-bottom:1px solid var(--gris-borde);flex-wrap:nowrap;}
.solapas-rubros::-webkit-scrollbar{height:3px;}
.solapas-rubros::-webkit-scrollbar-thumb{background:var(--azul-borde);border-radius:3px;}
.solapa-rubro{flex-shrink:0;display:flex;align-items:center;justify-content:center;padding:5px 12px;border-radius:20px;color:var(--gris-texto);font-size:0.7rem;font-weight:600;text-decoration:none;transition:all 0.15s;border:1px solid var(--gris-borde);white-space:nowrap;}
.solapa-rubro:hover{background:var(--azul-claro);color:var(--azul);border-color:var(--azul-borde);}
.solapa-rubro.activa{background:var(--azul);color:#fff;border-color:var(--azul);}

/* Encabezado de rubro dentro de la tabla, cuando se ven todos los
   productos juntos (sin buscar ni filtrar por un rubro puntual). */
.fila-rubro td{background:var(--gris-fondo);font-size:0.68rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--gris-texto);padding:7px 12px;}
  </style>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'inventario-ayb' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Alimentos y Bebidas</p>
        <h1 class="seccion-titulo">Inventario</h1>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/inicio" class="btn-glass-verde btn-glass-icono" title="Menú principal"><i class="ti ti-home"></i></a>
        <div class="menu-otras-opciones" style="position:relative;">
          <button type="button" class="btn-glass-navy" onclick="toggleOtrasOpciones(event)" id="btn-otras-opciones">
            <i class="ti ti-dots"></i> Otras opciones <i class="ti ti-chevron-down" style="font-size:12px;"></i>
          </button>
          <div class="dropdown-otras-opciones" id="dropdown-otras-opciones">
            <a href="#" onclick="hideOtrasOpciones();showModal('modal-producto');return false;" class="dropdown-otras-item"><i class="ti ti-plus"></i> Nuevo producto</a>
            <a href="#" onclick="hideOtrasOpciones();showModal('modal-importar');return false;" class="dropdown-otras-item"><i class="ti ti-file-spreadsheet"></i> Importar productos (Excel)</a>
            <a href="/inventario-ayb/necesidad-semanal" class="dropdown-otras-item"><i class="ti ti-clipboard-list"></i> Necesidad semanal</a>
            <a href="/inventario-ayb/reportes" class="dropdown-otras-item"><i class="ti ti-chart-bar"></i> Reportes de consumo</a>
            <a href="/inventario-ayb/etiquetas" class="dropdown-otras-item"><i class="ti ti-qrcode"></i> Imprimir etiquetas QR</a>
            <% if (typeof geminiConfigurado !== 'undefined' && geminiConfigurado) { %>
            <a href="/inventario-ayb/reconocer" class="dropdown-otras-item"><i class="ti ti-camera"></i> Reconocer con foto</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) {
      // Ver comentario en inventario_ayb_ajustar.ejs: si el mensaje trae un
      // "%" que no forma parte de un %XX válido, decodificarlo de nuevo acá
      // tira "URI malformed" — con el try/catch se muestra tal cual llegó.
      let msgTexto;
      try { msgTexto = decodeURIComponent(msg); } catch (e) { msgTexto = msg; }
      const esError  = /error/i.test(msgTexto);
    %>
    <div style="background:<%= esError ? '#fef2f2' : 'var(--azul-claro)' %>;border:1px solid <%= esError ? '#fecaca' : 'var(--azul-borde)' %>;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:0.83rem;color:<%= esError ? '#dc2626' : 'var(--azul)' %>;display:flex;align-items:center;gap:10px;">
      <i class="ti <%= esError ? 'ti-alert-circle' : 'ti-check' %>" style="font-size:18px;"></i>
      <%= msgTexto %>
    </div>
    <% } %>

    <!-- Resumen -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px;">
      <div style="background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
        <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= totalProductos %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Producto<%= totalProductos !== 1 ? 's' : '' %> activo<%= totalProductos !== 1 ? 's' : '' %></p>
      </div>
      <div style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
        <p style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= bajoStock.length %></p>
        <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Con stock bajo el mínimo</p>
      </div>
    </div>

    <% if (bajoStock.length > 0) { %>
    <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:12px 16px;margin-bottom:20px;">
      <p style="font-size:0.75rem;font-weight:600;color:#854d0e;margin:0 0 6px;display:flex;align-items:center;gap:6px;">
        <i class="ti ti-alert-triangle"></i> Por debajo del mínimo
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <% bajoStock.forEach(p => { %>
        <span style="font-size:0.72rem;background:#fef08a;color:#713f12;padding:2px 8px;border-radius:20px;border:1px solid #fde047;">
          <%= p.nombre %> (<%= p.stock_actual || 0 %>/<%= p.stock_minimo %> <%= p.unidad_default || '' %>)
        </span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Resumen de productos: la lista completa vive en el modal, separada
         por rubro — antes esto era una tabla siempre abierta debajo del
         buscador, que con muchos productos ocupaba toda la pantalla. -->
    <div class="tarjeta-resumen-lista">
      <div class="tarjeta-resumen-lista-icono"><i class="ti ti-bottle"></i></div>
      <p class="tarjeta-resumen-lista-titulo">Productos</p>
      <p class="tarjeta-resumen-numero"><%= totalProductos %></p>
      <p class="tarjeta-resumen-lista-desc">producto<%= totalProductos !== 1 ? 's' : '' %> activo<%= totalProductos !== 1 ? 's' : '' %>, por rubro</p>
      <button type="button" class="btn-glass-verde" onclick="showModal('modal-lista-productos')">
        <i class="ti ti-list"></i> Ver productos
      </button>
    </div>

  </main>

  <%- include('partials/mobile-nav', { path: 'inventario-ayb' }) %>
</div>

<!-- Modal: lista completa de productos, separada por rubro -->
<div id="modal-lista-productos" class="modal-lista" style="display:none;" onclick="if(event.target===this)hideModal('modal-lista-productos')">
  <div class="modal-lista-caja">
    <div class="modal-lista-header">
      <p class="modal-lista-titulo"><i class="ti ti-bottle"></i> Productos</p>
      <button onclick="hideModal('modal-lista-productos')" class="modal-lista-cerrar"><i class="ti ti-x"></i></button>
    </div>

    <div class="modal-lista-body">
      <form method="GET" action="/inventario-ayb" style="position:relative;margin-bottom:12px;">
        <i class="ti ti-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"></i>
        <input type="text" name="buscar" value="<%= buscar %>" placeholder="Buscar por nombre, categoría o código..."
               style="width:100%;padding:8px 32px 8px 32px;border:1px solid var(--gris-borde);border-radius:8px;font-family:var(--font-sans);font-size:0.82rem;outline:none;background:var(--gris-fondo);color:var(--negro);">
        <% if (buscar) { %>
        <a href="/inventario-ayb#modal-lista-productos" title="Limpiar búsqueda" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--gris-texto);font-size:15px;"><i class="ti ti-x"></i></a>
        <% } %>
      </form>

      <% if (buscar) { %>
        <p style="font-size:0.72rem;color:var(--gris-texto);margin-bottom:10px;">
          <%= totalListado %> resultado<%= totalListado !== 1 ? 's' : '' %> para "<%= buscar %>"
        </p>
      <% } else { %>
      <!-- Rubros (categorías) — filtra la lista a un solo rubro por vez. -->
      <div class="solapas-rubros">
        <a href="/inventario-ayb#modal-lista-productos" class="solapa-rubro <%= !rubro ? 'activa' : '' %>">Todos</a>
        <% categoriasDisponibles.forEach(cat => { %>
        <a href="/inventario-ayb?rubro=<%= encodeURIComponent(cat) %>#modal-lista-productos" class="solapa-rubro <%= rubro === cat ? 'activa' : '' %>"><%= cat %></a>
        <% }) %>
      </div>
      <% } %>

      <% if (productos.length === 0) { %>
        <div style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">
          <% if (buscar) { %>
            No se encontró ningún producto para "<%= buscar %>".
          <% } else if (rubro) { %>
            No hay productos en el rubro "<%= rubro %>".
          <% } else { %>
            Todavía no hay ningún producto cargado. Usá "Nuevo producto" para empezar.
          <% } %>
        </div>
      <% } else { %>
      <div class="tabla-wrap">
        <table class="tabla" style="width:100%;">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Categoría</th>
              <th>Stock actual</th>
              <th>Mínimo</th>
              <th></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% let categoriaAnterior = null; %>
            <% productos.forEach(p => {
              const bajo = p.stock_minimo != null && (p.stock_actual || 0) <= p.stock_minimo;
              // Encabezado de rubro: solo cuando se ven todos juntos (sin
              // buscar ni filtrar por un rubro puntual), y solo al cambiar
              // de categoría — la lista ya viene ordenada por categoría.
              const mostrarEncabezadoRubro = !buscar && !rubro && p.categoria !== categoriaAnterior;
              if (mostrarEncabezadoRubro) categoriaAnterior = p.categoria;
            %>
            <% if (mostrarEncabezadoRubro) { %>
            <tr class="fila-rubro"><td colspan="6"><%= p.categoria || 'Sin categoría' %></td></tr>
            <% } %>
            <tr>
              <td style="font-size:0.82rem;font-weight:500;">
                <%= p.nombre %>
                <% if (p.codigo_barras) { %><span style="display:block;font-size:0.68rem;color:var(--gris-texto);">Cód: <%= p.codigo_barras %></span><% } %>
              </td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.categoria || '—' %></td>
              <td>
                <form method="POST" action="/inventario-ayb/producto/<%= p.id %>/ajustar" style="display:flex;gap:4px;align-items:center;">
                  <input type="hidden" name="modo" value="establecer">
                  <input type="hidden" name="volver_lista" value="1">
                  <input type="hidden" name="buscar_actual" value="<%= buscar %>">
                  <input type="hidden" name="rubro_actual" value="<%= rubro %>">
                  <input type="number" name="cantidad" value="<%= p.stock_actual || 0 %>" step="0.01" min="0"
                         style="width:70px;background:<%= bajo ? '#fef3c7' : 'var(--gris-fondo)' %>;border:1px solid <%= bajo ? '#fde68a' : 'var(--gris-borde)' %>;border-radius:6px;padding:5px 7px;font-size:0.8rem;">
                  <span style="color:var(--gris-texto);"><%= p.unidad_default || '' %></span>
                  <button type="submit" class="btn-icono-glass-verde" title="Guardar cantidad"><i class="ti ti-device-floppy"></i></button>
                </form>
              </td>
              <td style="font-size:0.8rem;color:var(--gris-texto);"><%= p.stock_minimo != null ? p.stock_minimo : '—' %></td>
              <td style="white-space:nowrap;">
                <a href="/inventario-ayb/producto/<%= p.id %>/ajustar" class="btn-icono-glass-navy" title="Ver QR / ajuste rápido"><i class="ti ti-qrcode"></i></a>
              </td>
              <td style="white-space:nowrap;">
                <button type="button" class="btn-icono-glass-navy" title="Editar" onclick='abrirModalEditar(<%- JSON.stringify({id:p.id,nombre:p.nombre,categoria:p.categoria||"",unidad_default:p.unidad_default||"",stock_minimo:p.stock_minimo,codigo_barras:p.codigo_barras||""}) %>)'><i class="ti ti-pencil"></i></button>
                <form method="POST" action="/inventario-ayb/producto/<%= p.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Dar de baja este producto? No se borra el historial.');">
                  <input type="hidden" name="volver_lista" value="1">
                  <input type="hidden" name="buscar_actual" value="<%= buscar %>">
                  <input type="hidden" name="rubro_actual" value="<%= rubro %>">
                  <button type="submit" class="btn-icono" title="Dar de baja" style="color:#dc2626;"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal nuevo producto -->
<div id="modal-producto" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Nuevo producto</h2>
      <button onclick="hideModal('modal-producto')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" action="/inventario-ayb/producto/nuevo">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Producto</label>
          <input type="text" name="nombre" placeholder="Ej: Vodka Absolut 750ml" required>
        </div>
        <div class="field">
          <label>Categoría (opcional)</label>
          <input type="text" name="categoria" placeholder="Ej: Destilados">
        </div>
        <div class="field">
          <label>Unidad</label>
          <select name="unidad_default" style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
            <option value="unidad">unidad</option>
            <option value="botella">botella</option>
            <option value="litro">litro</option>
            <option value="kg">kg</option>
            <option value="caja">caja</option>
            <option value="paquete">paquete</option>
          </select>
        </div>
        <div class="field">
          <label>Stock actual</label>
          <input type="number" name="stock_actual" placeholder="Ej: 12" step="0.01" min="0">
        </div>
        <div class="field">
          <label>Stock mínimo (opcional)</label>
          <input type="number" name="stock_minimo" placeholder="Ej: 3" step="0.01" min="0">
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Código de barras (opcional)</label>
          <input type="text" name="codigo_barras" placeholder="Si lo tiene">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-producto')" class="btn-glass-navy">Cancelar</button>
        <button type="submit" class="btn-glass-verde"><i class="ti ti-plus"></i> Agregar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal importar productos desde Excel/CSV -->
<div id="modal-importar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Importar productos</h2>
      <button onclick="hideModal('modal-importar')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <p style="font-size:0.82rem;color:var(--gris-texto);line-height:1.6;margin-bottom:16px;">
      Subí un Excel o CSV con la lista de productos y se cargan todos de una — no hace falta que tenga un formato exacto, alcanza con que tenga una columna con el nombre del producto (y opcionalmente categoría, unidad, stock actual, stock mínimo o código de barras). Si el archivo tiene varias hojas (por ejemplo una por sector), se leen todas. Los productos que ya existan no se tocan.
    </p>
    <p style="margin-bottom:16px;">
      <a href="/inventario-ayb/importar/plantilla" style="font-size:0.8rem;color:var(--azul);text-decoration:underline;"><i class="ti ti-download"></i> Descargar una plantilla de ejemplo</a>
    </p>
    <form method="POST" action="/inventario-ayb/importar" enctype="multipart/form-data">
      <div class="field">
        <label>Archivo (.xlsx o .csv)</label>
        <input type="file" name="archivo_productos" accept=".xlsx,.xls,.csv" required>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-importar')" class="btn-glass-navy">Cancelar</button>
        <button type="submit" class="btn-glass-verde"><i class="ti ti-upload"></i> Importar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal editar producto -->
<div id="modal-editar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:400;">Editar producto</h2>
      <button onclick="hideModal('modal-editar')" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gris-texto);"><i class="ti ti-x"></i></button>
    </div>
    <form method="POST" id="form-editar-producto" action="">
      <input type="hidden" name="volver_lista" id="edit-volver-lista" value="1">
      <input type="hidden" name="buscar_actual" value="<%= buscar %>">
      <input type="hidden" name="rubro_actual" value="<%= rubro %>">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="field" style="grid-column:1/-1;">
          <label>Producto</label>
          <input type="text" name="nombre" id="edit-nombre" required>
        </div>
        <div class="field">
          <label>Categoría (opcional)</label>
          <input type="text" name="categoria" id="edit-categoria">
        </div>
        <div class="field">
          <label>Unidad</label>
          <select name="unidad_default" id="edit-unidad" style="width:100%;background:var(--gris-fondo);border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;">
            <option value="unidad">unidad</option>
            <option value="botella">botella</option>
            <option value="litro">litro</option>
            <option value="kg">kg</option>
            <option value="caja">caja</option>
            <option value="paquete">paquete</option>
          </select>
        </div>
        <div class="field">
          <label>Stock mínimo (opcional)</label>
          <input type="number" name="stock_minimo" id="edit-stock-minimo" step="0.01" min="0">
        </div>
        <div class="field" style="grid-column:1/-1;">
          <label>Código de barras (opcional)</label>
          <input type="text" name="codigo_barras" id="edit-codigo-barras">
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--gris-borde);">
        <button type="button" onclick="hideModal('modal-editar')" class="btn-glass-navy">Cancelar</button>
        <button type="submit" class="btn-glass-verde"><i class="ti ti-device-floppy"></i> Guardar</button>
      </div>
    </form>
  </div>
</div>

<script>
function showModal(id){
  document.getElementById(id).style.display='flex';
  setTimeout(()=>{const f=document.querySelector('#'+id+' input:not([type=hidden])');if(f)f.focus();},100);
}
function hideModal(id){ document.getElementById(id).style.display='none'; }

function toggleOtrasOpciones(ev) {
  ev.stopPropagation();
  document.getElementById('dropdown-otras-opciones').classList.toggle('abierto');
}
function hideOtrasOpciones() {
  document.getElementById('dropdown-otras-opciones').classList.remove('abierto');
}
document.addEventListener('click', (ev) => {
  const dropdown = document.getElementById('dropdown-otras-opciones');
  const boton = document.getElementById('btn-otras-opciones');
  if (dropdown && dropdown.classList.contains('abierto') && !dropdown.contains(ev.target) && ev.target !== boton && !boton.contains(ev.target)) {
    dropdown.classList.remove('abierto');
  }
});

// Si venimos de buscar, filtrar por rubro, o de guardar un cambio hecho
// desde adentro del modal (ej. actualizar una cantidad de stock), reabrir
// el modal de productos directamente en vez de que el usuario tenga que
// volver a abrirlo a mano y perder dónde estaba.
<% if (buscar || rubro || (typeof abrirModalLista !== 'undefined' && abrirModalLista)) { %>
showModal('modal-lista-productos');
<% } %>

function abrirModalEditar(p) {
  document.getElementById('form-editar-producto').action = '/inventario-ayb/producto/' + p.id + '/editar';
  document.getElementById('edit-nombre').value = p.nombre || '';
  document.getElementById('edit-categoria').value = p.categoria || '';
  document.getElementById('edit-unidad').value = p.unidad_default || 'unidad';
  document.getElementById('edit-stock-minimo').value = p.stock_minimo != null ? p.stock_minimo : '';
  document.getElementById('edit-codigo-barras').value = p.codigo_barras || '';
  showModal('modal-editar');
}
</script>

<% /* Alerta de stock bajo empujada al asistente — mismo patrón que las
      alertas de eventuales de AYB en horarios_ayb.ejs (agregarMensajeAsistente,
      ya definido en nav.ejs). Esta pantalla ya solo la ve un gestor de AYB
      (el router la filtra antes de llegar acá), así que no hace falta
      repetir ese chequeo del lado de la vista. */ %>
<% if (bajoStock.length > 0) { %>
<script>
(function () {
  const productosBajoStock = <%- JSON.stringify(bajoStock.map(p => ({ nombre: p.nombre, stock_actual: p.stock_actual || 0, stock_minimo: p.stock_minimo, unidad: p.unidad_default || '' }))) %>;
  const panel = document.getElementById('asistentePanel');
  const burbuja = document.getElementById('asistenteBurbuja');
  if (!panel || !burbuja || typeof agregarMensajeAsistente !== 'function') return;

  agregarMensajeAsistente(
    `⚠️ Hay ${productosBajoStock.length} producto${productosBajoStock.length === 1 ? '' : 's'} de Inventario AYB por debajo del stock mínimo:`,
    'bot'
  );
  agregarMensajeAsistente(
    productosBajoStock.map(p => `• ${p.nombre}: ${p.stock_actual} ${p.unidad} (mínimo ${p.stock_minimo})`).join('\n'),
    'bot'
  );

  // Igual que en Horarios AYB: abre el panel solo para que la alerta se
  // vea apenas se entra a la pantalla, no hace falta abrir el chat a mano.
  panel.classList.add('abierto');
  burbuja.classList.add('oculta-pulso');
})();
</script>
<% } %>
</body>
</html>
