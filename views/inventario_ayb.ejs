<script src="/js/ui-comun.js"></script>
<script>
function hideOtrasOpciones() {
  document.getElementById('dropdown-otras-opciones').classList.remove('abierto');
}
document.addEventListener('click', (ev) => {
  const dropdown = document.getElementById('dropdown-otras-opciones');
  const boton = document.getElementById('btn-otras-opciones');
  if (dropdown && dropdown.classList.contains('abierto') && !dropdown.contains(ev.target) && ev.target !== boton && !boton.contains(ev.target)) {
    dropdown.classList.remove('abierto');
  }
});

// Si venimos de buscar, filtrar por rubro, o de guardar un cambio hecho
// desde adentro del modal (ej. actualizar una cantidad de stock), reabrir
// el modal de productos directamente en vez de que el usuario tenga que
// volver a abrirlo a mano y perder dónde estaba.
<% if (buscar || rubro || (typeof abrirModalLista !== 'undefined' && abrirModalLista)) { %>
showModal('modal-lista-productos');
<% } %>

// Rubro que se está viendo ahora mismo en el modal — arranca con el que
// vino del server (si se entró por un link con ?rubro=...), pero después
// lo actualiza seleccionarRubro() sin recargar la página.
let RUBRO_ACTUAL = <%- JSON.stringify(rubro || '') %>;

function abrirModalEditar(p) {
  document.getElementById('form-editar-producto').action = '/inventario-ayb/producto/' + p.id + '/editar';
  document.getElementById('edit-nombre').value = p.nombre || '';
  document.getElementById('edit-categoria').value = p.categoria || '';
  document.getElementById('edit-unidad').value = p.unidad_default || 'unidad';
  document.getElementById('edit-stock-minimo').value = p.stock_minimo != null ? p.stock_minimo : '';
  document.getElementById('edit-precio-unitario').value = p.precio_unitario != null ? p.precio_unitario : '';
  document.getElementById('edit-codigo-barras').value = p.codigo_barras || '';
  // Recién acá, no al cargar la página: si mientras tanto se cambió de
  // rubro o se buscó algo (todo por JS, sin recargar), que "Guardar" en
  // Editar vuelva a ese mismo lugar y no al que tenía la página al abrirse.
  const inputBuscar = document.getElementById('buscar-productos-input');
  document.getElementById('edit-buscar-actual').value = inputBuscar ? inputBuscar.value.trim() : '';
  document.getElementById('edit-rubro-actual').value = RUBRO_ACTUAL || '';
  showModal('modal-editar');
}

// ── Búsqueda en vivo (mientras se escribe, sin Enter) ───────────────
// Antes había que tocar Enter para que el buscador de arriba hiciera algo
// (era un form GET normal) — sin ningún botón "Buscar" a la vista, quedaba
// pareciendo roto. Ahora, igual que el buscador de Insumos en Costos, cada
// letra tipeada dispara (con un pequeño debounce) un pedido a
// /inventario-ayb/productos/buscar-vivo que consulta TODA la tabla —no
// solo lo que ya está en pantalla— y reemplaza la lista sin recargar la
// página.
let _debounceProductos = null;
let _pedidoProductosEnCurso = 0;
let CONTENEDOR_PRODUCTOS_ORIGINAL = null;

function esperar(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

function escaparHtmlProductos(t) {
  const div = document.createElement('div');
  div.textContent = t == null ? '' : String(t);
  return div.innerHTML;
}

function filaProductoHtml(p) {
  const bajo = p.stock_minimo != null && (p.stock_actual || 0) <= p.stock_minimo;
  // Ojo acá: esto va adentro de un atributo onclick='...' con comillas
  // simples, así que cualquier nombre o categoría que traiga un apóstrofe
  // (ej. "Baileys's", nombres con comilla tipeados en una importación)
  // corta el atributo a la mitad y deja los botones de Editar/Eliminar de
  // esa fila (y a veces de las que siguen) rotos — sin ningún error visible
  // en consola. Por eso se reemplaza el apóstrofe por &#39; antes de meterlo
  // en el HTML, además de escapar el resto con escaparHtmlProductos.
  const pJson = escaparHtmlProductos(JSON.stringify({
    id: p.id, nombre: p.nombre, categoria: p.categoria || '', unidad_default: p.unidad_default || '',
    stock_minimo: p.stock_minimo, precio_unitario: p.precio_unitario, codigo_barras: p.codigo_barras || ''
  })).replace(/&quot;/g, '&#34;').replace(/'/g, '&#39;');
  const buscarVal = escaparHtmlProductos(document.getElementById('buscar-productos-input').value);
  const rubroVal = escaparHtmlProductos(RUBRO_ACTUAL || '');
  return `
    <tr>
      <td style="font-size:0.82rem;font-weight:500;">
        ${escaparHtmlProductos(p.nombre)}
        ${p.codigo_barras ? `<span style="display:block;font-size:0.68rem;color:var(--gris-texto);">Cód: ${escaparHtmlProductos(p.codigo_barras)}</span>` : ''}
      </td>
      <td style="font-size:0.8rem;color:var(--gris-texto);">${p.categoria ? escaparHtmlProductos(p.categoria) : '—'}</td>
      <td>
        <form method="POST" action="/inventario-ayb/producto/${p.id}/ajustar" class="form-ajustar-stock" data-bajo-actual="${bajo ? '1' : '0'}" style="display:flex;gap:4px;align-items:center;">
          <input type="hidden" name="modo" value="establecer">
          <input type="hidden" name="volver_lista" value="1">
          <input type="hidden" name="buscar_actual" value="${buscarVal}">
          <input type="hidden" name="rubro_actual" value="${rubroVal}">
          <input type="number" name="cantidad" value="${p.stock_actual || 0}" step="0.01" min="0"
                 style="width:70px;background:${bajo ? '#fef3c7' : 'var(--gris-fondo)'};border:1px solid ${bajo ? '#fde68a' : 'var(--gris-borde)'};border-radius:6px;padding:5px 7px;font-size:0.8rem;">
          <span style="color:var(--gris-texto);">${p.unidad_default ? escaparHtmlProductos(p.unidad_default) : ''}</span>
          <button type="submit" class="btn-icono-glass-verde" title="Guardar cantidad"><i class="ti ti-device-floppy"></i></button>
        </form>
      </td>
      <td style="font-size:0.8rem;color:var(--gris-texto);">${p.stock_minimo != null ? p.stock_minimo : '—'}</td>
      <td style="white-space:nowrap;">
        <a href="/inventario-ayb/producto/${p.id}/ajustar" class="btn-icono-glass-navy" title="Ver QR / ajuste rápido"><i class="ti ti-qrcode"></i></a>
      </td>
      <td class="td-acciones" style="white-space:nowrap;">
        <button type="button" class="btn-icono-glass-navy" title="Editar" onclick='abrirModalEditar(${pJson})'><i class="ti ti-pencil"></i></button>
        <form method="POST" action="/inventario-ayb/producto/${p.id}/eliminar" class="form-eliminar-producto" style="display:inline;">
          <input type="hidden" name="volver_lista" value="1">
          <input type="hidden" name="buscar_actual" value="${buscarVal}">
          <input type="hidden" name="rubro_actual" value="${rubroVal}">
          <button type="submit" class="btn-icono" title="Dar de baja" style="color:#dc2626;"><i class="ti ti-trash"></i></button>
        </form>
      </td>
    </tr>
  `;
}

function filaEncabezadoRubroHtml(categoria) {
  return `<tr class="fila-rubro"><td colspan="6">${escaparHtmlProductos(categoria || 'Sin categoría')}</td></tr>`;
}

function renderProductosBuscados(productos, texto, opciones) {
  opciones = opciones || {};
  const contenedor = document.getElementById('contenedor-productos-lista');
  if (productos.length === 0) {
    const vacio = texto
      ? `No se encontró ningún producto para "${escaparHtmlProductos(texto)}".`
      : (opciones.rubroVacio ? `No hay productos en el rubro "${escaparHtmlProductos(opciones.rubroVacio)}".` : 'Todavía no hay ningún producto cargado.');
    contenedor.innerHTML = `<div style="text-align:center;padding:32px;color:var(--gris-texto);font-style:italic;">${vacio}</div>`;
    return;
  }
  // "Todos" (sin buscar ni filtrar por un rubro puntual) agrupa con un
  // encabezado por categoría, igual que el render del primer cargado de
  // la página — la lista ya viene ordenada por categoría.
  let filas;
  if (opciones.agruparPorCategoria) {
    let categoriaAnterior = null;
    filas = productos.map(p => {
      let encabezado = '';
      if (p.categoria !== categoriaAnterior) {
        encabezado = filaEncabezadoRubroHtml(p.categoria);
        categoriaAnterior = p.categoria;
      }
      return encabezado + filaProductoHtml(p);
    }).join('');
  } else {
    filas = productos.map(filaProductoHtml).join('');
  }
  contenedor.innerHTML = `
    <div class="tabla-wrap">
      <table class="tabla" style="width:100%;">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Stock actual</th>
            <th>Mínimo</th>
            <th></th>
            <th class="th-acciones"></th>
          </tr>
        </thead>
        <tbody>${filas}</tbody>
      </table>
    </div>
  `;
}

// ── Cambiar de rubro (solapa) sin recargar la página ─────────────────
// Antes cada solapa era un <a href="/inventario-ayb?rubro=..."> — eso
// navegaba de nuevo a la página entera (todos los assets, el nav, todo) y
// recién ahí el script de abajo volvía a abrir el modal: se veía como un
// parpadeo/salto de la pantalla cada vez que se tocaba una solapa. Ahora
// pide solo los productos de ese rubro por fetch y reemplaza la tabla.
async function seleccionarRubro(el) {
  const rubro = el.getAttribute('data-rubro') || '';
  RUBRO_ACTUAL = rubro;

  document.querySelectorAll('#solapas-rubros-productos .solapa-rubro').forEach(b => b.classList.remove('activa'));
  el.classList.add('activa');

  // El cambio de categoría se hace con un FUNDIDO: el contenido viejo se
  // desvanece, mientras tanto se trae el nuevo y se reemplaza (el cambio
  // de alto pasa acá, pero está invisible), y recién ahí aparece con su
  // alto definitivo. Así el "salto" de alto nunca se ve, sin importar
  // cuánto más chica o grande sea la categoría nueva — antes se intentó
  // animar el alto en píxeles directamente, pero con tablas de miles de
  // píxeles esa animación pasaba casi entera fuera de lo que se ve en
  // pantalla y seguía sintiéndose como un salto.
  const contenedor = document.getElementById('contenedor-productos-lista');
  contenedor.style.pointerEvents = 'none';
  contenedor.style.opacity = '0';

  const [resultadoFetch] = await Promise.all([
    fetch('/inventario-ayb/productos/buscar-vivo?rubro=' + encodeURIComponent(rubro))
      .then(r => r.json())
      .catch(() => null),
    esperar(180), // le da tiempo al fundido de salida a que se termine de ver
  ]);

  if (!resultadoFetch) {
    contenedor.innerHTML = '<div style="text-align:center;padding:32px;color:var(--gris-texto);">No se pudo cargar. Probá de nuevo.</div>';
  } else {
    renderProductosBuscados(resultadoFetch.productos || [], null, { agruparPorCategoria: resultadoFetch.agruparPorCategoria, rubroVacio: rubro });
  }
  // El contenido nuevo ya está adentro pero invisible — recién ahora se
  // muestra, con un frame de por medio para que el navegador "registre" el
  // opacity:0 antes de animar a 1 (si no, a veces salta directo a visible
  // sin transición).
  requestAnimationFrame(() => {
    contenedor.style.opacity = '1';
    contenedor.style.pointerEvents = '';
  });

  // Mantiene la URL sincronizada (útil si se comparte el link o se recarga
  // la página estando en ese rubro) sin disparar una navegación real.
  const url = new URL(window.location.href.split('#')[0]);
  if (rubro) url.searchParams.set('rubro', rubro); else url.searchParams.delete('rubro');
  url.searchParams.delete('buscar');
  history.replaceState(null, '', url.toString() + '#modal-lista-productos');
}

// ── Guardar cantidad / dar de baja sin recargar la página ────────────
// Antes ambos formularios eran POST normales: el navegador recargaba la
// página entera (aunque el modal se reabriera después por JS, se veía el
// parpadeo de la recarga completa). Ahora se interceptan acá y se mandan
// por fetch — la página nunca navega. La cabecera X-Requested-With le avisa
// a la ruta en el server que responda JSON en vez de hacer un redirect.
document.getElementById('contenedor-productos-lista').addEventListener('submit', async (ev) => {
  const form = ev.target;
  if (!(form instanceof HTMLFormElement)) return;

  if (form.classList.contains('form-ajustar-stock')) {
    ev.preventDefault();
    const boton = form.querySelector('button[type="submit"]');
    const iconoOriginal = boton.innerHTML;
    boton.disabled = true;
    try {
      const resp = await fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'fetch' }, body: new URLSearchParams(new FormData(form)) });
      const data = await resp.json();
      boton.innerHTML = data.ok ? '<i class="ti ti-check"></i>' : '<i class="ti ti-alert-circle"></i>';
      if (!data.ok) {
        alert(data.error || 'No se pudo guardar la cantidad.');
      } else if (data.producto) {
        // Recalcular el color de "stock bajo" de esta fila y el contador de
        // arriba con el dato que acaba de confirmar el server — antes esto
        // solo se veía bien después de recargar toda la página (que era
        // justo lo que dejamos de hacer), así que quedaba desactualizado.
        const p = data.producto;
        const inputCantidad = form.querySelector('input[name="cantidad"]');
        const bajoAhora = p.stock_minimo != null && (p.stock_actual || 0) <= p.stock_minimo;
        inputCantidad.style.background = bajoAhora ? '#fef3c7' : 'var(--gris-fondo)';
        inputCantidad.style.borderColor = bajoAhora ? '#fde68a' : 'var(--gris-borde)';

        const bajoAntes = form.dataset.bajoActual === '1';
        if (bajoAhora !== bajoAntes) {
          form.dataset.bajoActual = bajoAhora ? '1' : '0';
          const contador = document.getElementById('contador-stock-bajo');
          if (contador) contador.textContent = Math.max(0, parseInt(contador.textContent, 10) + (bajoAhora ? 1 : -1));
        }
      }
    } catch (e) {
      boton.innerHTML = '<i class="ti ti-alert-circle"></i>';
      alert('No se pudo guardar (sin conexión).');
    }
    setTimeout(() => { boton.innerHTML = iconoOriginal; boton.disabled = false; }, 1200);
    return;
  }

  if (form.classList.contains('form-eliminar-producto')) {
    ev.preventDefault();
    if (!confirm('¿Dar de baja este producto? No se borra el historial.')) return;
    try {
      const resp = await fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'fetch' }, body: new URLSearchParams(new FormData(form)) });
      const data = await resp.json();
      if (data.ok) {
        const fila = form.closest('tr');
        const estabaBajo = fila && fila.querySelector('.form-ajustar-stock')?.dataset.bajoActual === '1';
        if (fila) fila.remove();
        ['contador-total-productos', 'contador-total-productos-tarjeta'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.textContent = Math.max(0, parseInt(el.textContent, 10) - 1);
        });
        if (estabaBajo) {
          const contador = document.getElementById('contador-stock-bajo');
          if (contador) contador.textContent = Math.max(0, parseInt(contador.textContent, 10) - 1);
        }
      } else {
        alert(data.error || 'No se pudo dar de baja el producto.');
      }
    } catch (e) {
      alert('No se pudo dar de baja (sin conexión).');
    }
  }
});

function filtrarProductosEnVivo() {
  const input = document.getElementById('buscar-productos-input');
  const contenedor = document.getElementById('contenedor-productos-lista');
  if (CONTENEDOR_PRODUCTOS_ORIGINAL === null) CONTENEDOR_PRODUCTOS_ORIGINAL = contenedor.innerHTML;

  const texto = input.value.trim();
  const solapas = document.getElementById('solapas-rubros-productos');
  const contador = document.getElementById('contador-resultados-productos');
  const btnLimpiar = document.getElementById('btn-limpiar-buscar-productos');

  clearTimeout(_debounceProductos);

  if (!texto) {
    // Buscador vacío: volvemos a mostrar la lista tal como estaba al cargar la página.
    contenedor.innerHTML = CONTENEDOR_PRODUCTOS_ORIGINAL;
    if (solapas) solapas.style.display = '';
    if (contador) contador.style.display = 'none';
    if (btnLimpiar) btnLimpiar.style.display = 'none';
    return;
  }

  if (solapas) solapas.style.display = 'none';
  if (btnLimpiar) btnLimpiar.style.display = '';

  _debounceProductos = setTimeout(async () => {
    const idPedido = ++_pedidoProductosEnCurso;
    let data;
    try {
      const resp = await fetch('/inventario-ayb/productos/buscar-vivo?q=' + encodeURIComponent(texto));
      data = await resp.json();
    } catch (e) {
      return; // sin conexión momentánea: dejamos lo último que había en pantalla
    }
    // Si mientras esperábamos la respuesta el usuario ya tipeó algo nuevo
    // (y disparó otro pedido más reciente), descartamos esta respuesta vieja.
    if (idPedido !== _pedidoProductosEnCurso) return;

    const productos = data.productos || [];
    if (contador) {
      contador.style.display = '';
      contador.textContent = productos.length + ' resultado' + (productos.length !== 1 ? 's' : '') + ' para "' + texto + '"';
    }
    renderProductosBuscados(productos, texto);
  }, 300);
}
</script>

<% /* Alerta de stock bajo empujada al asistente — mismo patrón que las
      alertas de eventuales de AYB en horarios_ayb.ejs (agregarMensajeAsistente,
      ya definido en nav.ejs). Esta pantalla ya solo la ve un gestor de AYB
      (el router la filtra antes de llegar acá), así que no hace falta
      repetir ese chequeo del lado de la vista. */ %>
<% if (bajoStock.length > 0) { %>
<script>
(function () {
  const productosBajoStock = <%- JSON.stringify(bajoStock.map(p => ({ nombre: p.nombre, stock_actual: p.stock_actual || 0, stock_minimo: p.stock_minimo, unidad: p.unidad_default || '' }))) %>;
  const panel = document.getElementById('asistentePanel');
  const burbuja = document.getElementById('asistenteBurbuja');
  if (!panel || !burbuja || typeof agregarMensajeAsistente !== 'function') return;

  agregarMensajeAsistente(
    `⚠️ Hay ${productosBajoStock.length} producto${productosBajoStock.length === 1 ? '' : 's'} de Inventario AYB por debajo del stock mínimo:`,
    'bot'
  );
  agregarMensajeAsistente(
    productosBajoStock.map(p => `• ${p.nombre}: ${p.stock_actual} ${p.unidad} (mínimo ${p.stock_minimo})`).join('\n'),
    'bot'
  );

  // Igual que en Horarios AYB: abre el panel solo para que la alerta se
  // vea apenas se entra a la pantalla, no hace falta abrir el chat a mano.
  panel.classList.add('abierto');
  burbuja.classList.add('oculta-pulso');
})();
</script>
<% } %>
</body>
</html>
