<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalle Evento — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
<style>
/* Por ahora, un solo cuadrado por sección en vez de la grilla de 2
   columnas (Personal asignado y Vajilla necesaria se sacaron de acá
   temporalmente — a pedido, hasta que se defina cómo acomodarlos). */
.detalle-grid { display: flex; flex-direction: column; gap: 20px; }
.detalle-card { background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; box-shadow: var(--sombra); }
.detalle-card-title { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--azul); margin-bottom: 18px; display: flex; align-items: center; gap: 7px; }
.info-rows { display: flex; flex-direction: column; gap: 0; }
.info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid var(--gris-borde); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 0.75rem; color: var(--gris-texto); }
.info-val { font-size: 0.85rem; color: var(--negro); font-weight: 500; text-align: right; max-width: 60%; }
.costo-grande { color: var(--azul); font-size: 1.1rem; font-weight: 700; }
.tabla-interna { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
.tabla-interna th { font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris-texto); padding: 8px 0; border-bottom: 1px solid var(--gris-borde); text-align: left; }
.tabla-interna td { padding: 10px 0; border-bottom: 1px solid var(--gris-borde); color: var(--negro); }
.tabla-interna tr:last-child td { border-bottom: none; }
.total-row { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid var(--gris-borde); margin-top: 8px; font-size: 0.82rem; color: var(--gris-texto); }
.total-row strong { color: var(--azul); font-size: 1rem; }
.personal-lista-detalle { display: flex; flex-direction: column; gap: 8px; }
.personal-item-detalle { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--gris-borde); }
.personal-item-detalle:last-child { border-bottom: none; }
.avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--azul-claro); color: var(--azul); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 600; flex-shrink: 0; }
.p-nombre { font-size: 0.85rem; font-weight: 500; color: var(--negro); margin: 0 0 2px; }
.p-rol { font-size: 0.65rem; color: var(--gris-texto); text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }
.vajilla-lista { display: flex; flex-direction: column; gap: 4px; }
.vajilla-item { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--gris-borde); }
.vajilla-item:last-child { border-bottom: none; }
.vajilla-nombre { font-size: 0.85rem; color: var(--negro); font-weight: 500; }
.vajilla-cant { font-size: 0.78rem; color: var(--gris-texto); }
.list-empty { font-size: 0.78rem; color: var(--gris-texto); font-style: italic; padding: 8px 0; }
.add-plato-row { display: flex; gap: 6px; margin-bottom: 10px; align-items: center; }
.add-plato-row select, .add-plato-row input { background: var(--gris-fondo); border: 1px solid var(--gris-borde); border-radius: 8px; padding: 8px 10px; font-family: var(--font-sans); font-size: 0.8rem; color: var(--negro); outline: none; }
.add-plato-row select { flex: 2; }
.add-plato-row input[type="number"] { flex: 1; min-width: 70px; }
.add-plato-row .btn-add { width: 34px; height: 34px; background: var(--azul); border: none; border-radius: 8px; color: #fff; font-size: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.add-plato-row .btn-add:hover { background: var(--azul-hover); }
.btn-remove { background: none; border: none; color: #dc2626; cursor: pointer; font-size: 15px; padding: 2px; }
.btn-remove:hover { color: #991b1b; }
.back-link { color: var(--gris-texto); text-decoration: none; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 4px; }
.back-link:hover { color: var(--azul); }
/* Mismo "molde" (alto fijo, padding, tamaño de letra) que .btn-secondary
   en style.css: antes .btn-danger tenía su propio padding/tamaño de letra
   armado a mano y quedaba un par de píxeles más bajo que el botón de al
   lado (BEO), así que no se veían parejos en la misma fila. */
.btn-danger {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  background: #fef2f2; color: #dc2626;
  border: 1px solid #fecaca; border-radius: 8px;
  padding: 0 18px; box-sizing: border-box; height: 40px;
  font-family: var(--font-sans); font-size: 0.7rem; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;
  transition: all var(--tr);
}
.btn-danger:hover { background: #dc2626; color: #fff; }

/* Botones "chicos" (32px), mismo molde que el resto de la aplicación.
   "Eventos" y "Más opciones" quedaban pegados y los dos eran azules
   (.btn-secondary), así que "Más opciones" pasa a verde para que no se
   repita el color al lado del otro. */
.btn-chico-azul,.btn-chico-verde,.btn-chico-rojo{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all var(--tr);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.btn-chico-azul{background:rgba(0,47,97,0.12);color:#002f61;border:1px solid rgba(0,47,97,0.28);}
.btn-chico-azul:hover{background:rgba(0,47,97,0.20);}
.btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
.btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
.btn-chico-rojo{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.btn-chico-rojo:hover{background:#dc2626;color:#fff;}

/* "Otras opciones" — mismas clases que ya usan Horas Extra/Horarios/Personal/
   Costos/Inventario AYB (viven en su propio <style> ahí también, no en
   style.css global). Acá agrupa Editar/BEO/Eliminar bajo un solo botón de
   "Más opciones" al lado de "Eventos", para que el encabezado no quede con
   4 botones sueltos en fila. */
.dropdown-otras-opciones{
  display:none;
  position:absolute; right:0; top:calc(100% + 6px); z-index:200;
  background:var(--blanco); border:1px solid var(--gris-borde); border-radius:10px;
  box-shadow:0 8px 24px rgba(0,0,0,0.15);
  min-width:200px; padding:6px;
}
.dropdown-otras-opciones.abierto{ display:flex; flex-direction:column; gap:2px; }
.dropdown-otras-item{
  display:flex; align-items:center; gap:8px; width:100%;
  background:none; border:none; padding:9px 12px;
  font-family:var(--font-sans); font-size:0.78rem; font-weight:500;
  color:var(--negro); text-decoration:none; cursor:pointer;
  border-radius:6px; text-align:left;
}
.dropdown-otras-item:hover{ background:var(--gris-fondo); }
.dropdown-otras-item i{ font-size:15px; color:var(--gris-texto); flex-shrink:0; }
.dropdown-otras-item-nav{ color:#1d4e89; }
.dropdown-otras-item-nav i{ color:#002f61; }
.dropdown-otras-item-nav:hover{ background:rgba(0,47,97,0.08); }
.dropdown-otras-item-danger{ color:#dc2626; }
.dropdown-otras-item-danger i{ color:#dc2626; }
.dropdown-otras-item-danger:hover{ background:#fef2f2; }

/* Cartel de confirmación para "Eliminar", mismo estilo de tarjeta (fondo
   blanco, borde, sombra, tipografía Lora) que el resto del sitio, en vez
   del cartel feo del navegador (window.confirm) que usaba antes. */
.confirm-overlay {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  z-index: 1000; align-items: center; justify-content: center; padding: 16px;
}
.confirm-overlay.abierto { display: flex; }
.confirm-box {
  background: var(--blanco); border: 1px solid var(--gris-borde); border-radius: 12px;
  box-shadow: var(--sombra-md); padding: 26px; max-width: 360px; width: 100%;
  font-family: var(--font-sans);
}
.confirm-box p.confirm-titulo { font-size: 0.95rem; font-weight: 600; color: var(--negro); margin: 0 0 8px; }
.confirm-box p.confirm-texto { font-size: 0.82rem; color: var(--gris-texto); margin: 0 0 22px; line-height: 1.5; }
.confirm-box .confirm-acciones { display: flex; justify-content: flex-end; gap: 10px; }

@media (max-width: 900px) { .detalle-grid { grid-template-columns: 1fr; } }

@media (max-width: 600px) {
  .detalle-card { padding: 16px; }
  /* La fila para agregar plato (select + 2 inputs numéricos + botón) no
     tenía flex-wrap: en una pantalla angosta el <select> con nombres
     largos de plato no se achica (los flex-item no se encogen por debajo
     de su contenido salvo que se lo indique) y la fila se salía del
     recuadro. Se envuelve y cada campo pasa a ocupar el ancho completo. */
  .add-plato-row { flex-wrap: wrap; }
  .add-plato-row select { flex: 1 1 100%; min-width: 0; }
  .add-plato-row input[type="text"],
  .add-plato-row input[type="number"] { flex: 1 1 auto; min-width: 0; }
  .tabla-interna { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
}
</style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">




<div class="seccion-header">
  <div class="seccion-header-left">
    <h1 class="seccion-titulo"><%= evento.nombre %></h1>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <a href="/eventos" class="btn-chico-azul"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span data-i18n>Eventos</span></a>

    <!-- "Más opciones": agrupa Editar/BEO/Eliminar (antes 3 botones sueltos
         al lado de "Eventos") bajo un solo desplegable, mismo patrón que
         "Otras opciones" en Horas Extra/Horarios/Personal/Costos/Inventario. -->
    <div class="menu-otras-opciones" style="position:relative;">
      <button type="button" class="btn-chico-verde" onclick="toggleOtrasOpciones(event)" id="btn-otras-opciones">
        <i class="ti ti-dots"></i> <span data-i18n>Más opciones</span> <i class="ti ti-chevron-down" style="font-size:12px;"></i>
      </button>
      <div class="dropdown-otras-opciones" id="dropdown-otras-opciones">
        <a href="/eventos/<%= evento.id %>/editar" class="dropdown-otras-item dropdown-otras-item-nav">
          <i class="ti ti-edit" aria-hidden="true"></i> <span data-i18n>Editar</span>
        </a>
        <a href="/eventos/<%= evento.id %>/beo" class="dropdown-otras-item dropdown-otras-item-nav">
          <i class="ti ti-file-text" aria-hidden="true"></i> BEO
        </a>
        <form method="POST" action="/eventos/<%= evento.id %>/eliminar" id="form-eliminar-evento"
              onsubmit="return false;">
          <button type="button" class="dropdown-otras-item dropdown-otras-item-danger"
                  onclick="document.getElementById('dropdown-otras-opciones').classList.remove('abierto');abrirConfirmEliminar()">
            <i class="ti ti-trash" aria-hidden="true"></i> <span data-i18n>Eliminar</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Cartel de confirmación para Eliminar (mismo estilo de tarjeta que el resto del sitio, no el cartel del navegador) -->
<div class="confirm-overlay" id="confirm-eliminar-overlay">
  <div class="confirm-box">
    <p class="confirm-titulo" data-i18n>¿Eliminar este evento?</p>
    <p class="confirm-texto"><span data-i18n>Esta acción no se puede deshacer. Se va a borrar</span> "<%= evento.nombre %>" <span data-i18n>y todo lo que tenga cargado (platos, personal, vajilla).</span></p>
    <div class="confirm-acciones">
      <button type="button" class="btn-chico-azul" onclick="cerrarConfirmEliminar()" data-i18n>Cancelar</button>
      <button type="button" class="btn-chico-rojo" onclick="document.getElementById('form-eliminar-evento').removeAttribute('onsubmit'); document.getElementById('form-eliminar-evento').submit();" data-i18n>Sí, eliminar</button>
    </div>
  </div>
</div>

<script src="/js/ui-comun.js"></script>
<script>
function abrirConfirmEliminar() {
  document.getElementById('confirm-eliminar-overlay').classList.add('abierto');
}
function cerrarConfirmEliminar() {
  document.getElementById('confirm-eliminar-overlay').classList.remove('abierto');
}
document.getElementById('confirm-eliminar-overlay').addEventListener('click', e => {
  if (e.target.id === 'confirm-eliminar-overlay') cerrarConfirmEliminar();
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') cerrarConfirmEliminar();
});

// Menú "Más opciones" (mismo patrón que Horas Extra/Horarios/Personal/
// Costos/Inventario AYB): cerrar el desplegable si se hace clic afuera.
document.addEventListener('click', (ev) => {
  const dropdown = document.getElementById('dropdown-otras-opciones');
  const boton = document.getElementById('btn-otras-opciones');
  if (dropdown && dropdown.classList.contains('abierto') && !dropdown.contains(ev.target) && ev.target !== boton && !boton.contains(ev.target)) {
    dropdown.classList.remove('abierto');
  }
});
</script>

<div class="detalle-grid">

  <!-- Info general -->
  <div class="detalle-card">
    <p class="detalle-card-title"><i class="ti ti-info-circle" aria-hidden="true"></i> <span data-i18n>Información general</span></p>
    <div class="info-rows">
      <div class="info-row"><span class="info-label" data-i18n>Fecha</span><span class="info-val"><%= evento.fecha %></span></div>
      <% if (evento.comensales) { %>
      <div class="info-row"><span class="info-label" data-i18n>Comensales</span><span class="info-val"><%= evento.comensales %></span></div>
      <div class="info-row"><span class="info-label" data-i18n>Personal requerido</span><span class="info-val"><%= evento.personal_servicio_requerido || 0 %> <span data-i18n>servicio</span> + <%= evento.personal_produccion_requerido || 0 %> <span data-i18n>producción</span></span></div>
      <% } %>
      <div class="info-row"><span class="info-label" data-i18n>Miembros de equipo</span><span class="info-val"><%= evento.cantidad_personal %> <span data-i18n>personas</span></span></div>
      <div class="info-row"><span class="info-label" data-i18n>Costo total</span><span class="info-val costo-grande">$<%= parseFloat(evento.costo_total).toFixed(2) %></span></div>
      <% if (evento.descripcion) { %>
      <div class="info-row"><span class="info-label" data-i18n>Notas</span><span class="info-val"><%= evento.descripcion %></span></div>
      <% } %>
    </div>
  </div>

  <% if (bocaditos.length > 0) { %>
  <!-- Bocaditos -->
  <div class="detalle-card">
    <p class="detalle-card-title"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i> <span data-i18n>Bocaditos calculados</span></p>
    <table class="tabla-interna">
      <thead><tr><th data-i18n>Plato</th><th data-i18n>Categoría</th><th data-i18n>Bocados</th><th data-i18n>Vajilla</th><th data-i18n>Costo</th></tr></thead>
      <tbody>
        <% const NOMBRES_CATEGORIA_DET = { frios: 'Fríos', calientes: 'Calientes', principales: 'Plato principal', postres: 'Postre' }; %>
        <% bocaditos.forEach(b => { %>
        <tr>
          <td><%= b.nombre %></td>
          <td data-i18n><%= NOMBRES_CATEGORIA_DET[b.categoria] || b.categoria %></td>
          <td style="font-weight:600;color:var(--azul)"><%= b.bocados_totales %></td>
          <td><%= b.vajilla_texto ? (b.vajilla_cantidad + ' × ' + b.vajilla_texto) : '—' %></td>
          <td>$<%= parseFloat(b.costo_total || 0).toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="total-row">
      <span data-i18n>Costo bocaditos:</span>
      <strong>$<%= parseFloat(evento.costo_bocaditos || 0).toFixed(2) %></strong>
    </div>
  </div>
  <% } %>

  <!-- Personal asignado y Vajilla necesaria se sacaron de acá por ahora
       (a pedido, "vemos cómo acomodamos lo otro" más adelante). Los datos
       siguen intactos: se siguen calculando igual y se ven completos en
       la Orden de evento (BEO). -->

</div>



  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>
</body>
</html>

