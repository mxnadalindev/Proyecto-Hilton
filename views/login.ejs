<% if (typeof success !== 'undefined' && success) { %>
<script src="/js/particulas.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  mostrarParticulasBienvenida('BIENVENIDOS AL PORTAL HILTON');
});
</script>
<% } %>

<script>
// Mostrar el modo correcto según mensajes que vengan del servidor
<% if (typeof errorReg !== 'undefined' && errorReg) { %>
window.addEventListener('DOMContentLoaded', () => setMode('registro'));
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
window.addEventListener('DOMContentLoaded', () => setMode('login'));
<% } %>

function setMode(mode) {
  document.getElementById('authShell').classList.toggle('mode-registro', mode === 'registro');
}

function togglePass(inputId, iconId) {
  const input = document.getElementById(inputId);
  const icon  = document.getElementById(iconId);
  const visible = input.type === 'text';
  input.type = visible ? 'password' : 'text';
  icon.className = visible ? 'ti ti-eye' : 'ti ti-eye-off';
}

const emailInput = document.getElementById('email');
if (emailInput) {
  emailInput.addEventListener('blur', () => {
    const field = document.getElementById('field-email');
    if (emailInput.value && emailInput.checkValidity()) {
      field.className = 'field field-valid';
    } else if (emailInput.value) {
      field.className = 'field field-error';
    }
  });
}

document.getElementById('loginForm').addEventListener('submit', () => {
  const btn = document.getElementById('submitBtn');
  btn.classList.add('loading');
  btn.disabled = true;
});

// ── Select custom de Departamento (vidrio esmerilado) ──
// El <select> real (#deptoSelectReal) queda oculto pero vive en el DOM y
// es el que efectivamente viaja con el form — este bloque solo sincroniza
// el trigger/lista visuales con su valor.
(function () {
  const wrap    = document.getElementById('deptoCustomSelect');
  const trigger = document.getElementById('deptoTrigger');
  const list    = document.getElementById('deptoList');
  const real    = document.getElementById('deptoSelectReal');
  if (!wrap || !trigger || !list || !real) return;

  function cerrar() { wrap.classList.remove('abierto'); }
  function abrir() {
    // Si no entra la lista completa hacia abajo dentro del panel con
    // scroll (el campo puede quedar cerca del final del form), la abrimos
    // hacia arriba en vez de que quede tapada/cortada por el borde del
    // panel — igual que haría un <select> nativo.
    const scrollPanel = wrap.closest('.auth-form-inner');
    const espacioAbajo = scrollPanel
      ? scrollPanel.getBoundingClientRect().bottom - wrap.getBoundingClientRect().bottom
      : window.innerHeight - wrap.getBoundingClientRect().bottom;
    list.classList.toggle('hacia-arriba', espacioAbajo < 180);
    wrap.classList.add('abierto');
  }

  trigger.addEventListener('click', () => {
    wrap.classList.contains('abierto') ? cerrar() : abrir();
  });
  trigger.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(); }
    if (e.key === 'Escape') cerrar();
  });

  list.querySelectorAll('.custom-select-opcion').forEach((opcion) => {
    opcion.addEventListener('click', () => {
      const valor = opcion.dataset.value;
      real.value = valor;
      trigger.textContent = opcion.textContent;
      trigger.classList.toggle('tiene-valor', !!valor);
      list.querySelectorAll('.custom-select-opcion').forEach((o) => o.classList.toggle('seleccionada', o === opcion));
      cerrar();
      real.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });

  document.addEventListener('click', (e) => {
    if (!wrap.contains(e.target)) cerrar();
  });
})();
</script>
</body>
</html>
