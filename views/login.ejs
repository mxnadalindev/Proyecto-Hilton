            <div class="custom-select-list" id="deptoList" role="listbox">
              <div class="custom-select-opcion seleccionada" data-value="">Seleccioná tu área...</div>
              <div class="custom-select-opcion" data-value="cocina">Cocina</div>
              <div class="custom-select-opcion" data-value="compras">Compras</div>
