<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#0f172a">
  <title>Acceso — Hilton Buenos Aires</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0f172a; --navy-800: #1e293b; --navy-700: #334155; --navy-600: #475569;
      --slate-400: #94a3b8; --slate-200: #e2e8f0; --slate-100: #f1f5f9; --white: #ffffff;
      --accent: #3b82f6; --accent-h: #2563eb; --accent-l: #dbeafe;
      --gold: #c9a84c; --error: #ef4444; --error-l: #fef2f2; --success: #22c55e;
      --tr: 0.2s ease; --tr-slide: 0.7s cubic-bezier(.77,0,.18,1);
    }
    html, body { height: 100%; }
    body {
      font-family: 'Inter', system-ui, sans-serif; font-size: 15px; color: var(--navy);
      min-height: 100vh; background: var(--navy);
      background-image: radial-gradient(circle at 15% 10%, rgba(59,130,246,0.18) 0%, transparent 45%),
                         radial-gradient(circle at 85% 90%, rgba(201,168,76,0.12) 0%, transparent 45%);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 32px 16px;
    }

    /* ── Contenedor deslizante ── */
    .auth-shell {
      position: relative;
      width: min(920px, 100%);
      height: 720px;
      background: var(--white);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0,0,0,0.4);
    }

    .auth-form-side {
      position: absolute; top: 0; height: 100%; width: 56%;
      display: flex; align-items: center; overflow: visible;
      transition: opacity 0.3s ease 0.15s;
    }
    .auth-form-login { left: 0; }
    .auth-form-registro { right: 0; opacity: 0; pointer-events: none; }
    .auth-shell.mode-registro .auth-form-login { opacity: 0; pointer-events: none; }
    .auth-shell.mode-registro .auth-form-registro { opacity: 1; pointer-events: auto; }
    .auth-form-inner { width: 100%; padding: 44px 56px; }

    .brand-mini { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
    .brand-icon { width: 36px; height: 36px; background: var(--accent); border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 17px; color: #fff; flex-shrink: 0; }
    .brand-name { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 500; color: var(--navy); line-height: 1.2; }
    .brand-sub { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate-400); }

    .form-title { font-family: 'Playfair Display', serif; font-size: 1.7rem; font-weight: 400; color: var(--navy); margin-bottom: 6px; }
    .form-subtitle { font-size: 0.82rem; color: var(--navy-600); margin-bottom: 20px; }

    /* Banners */
    .error-banner, .success-banner, .info-banner { display: flex; align-items: center; gap: 10px; border-radius: 10px; padding: 11px 13px; margin-bottom: 16px; font-size: 0.8rem; animation: slideDown 0.2s ease; }
    .error-banner { background: var(--error-l); border: 1px solid #fecaca; color: #dc2626; }
    .success-banner { background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; }
    .info-banner { background: var(--accent-l); border: 1px solid #bfdbfe; color: var(--accent-h); }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

    /* Campos */
    .field { margin-bottom: 14px; }
    .field-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .field-label span { font-size: 0.73rem; font-weight: 500; color: var(--navy); letter-spacing: 0.03em; }
    .field-label small { font-size: 0.66rem; color: var(--slate-400); }
    .input-wrap { position: relative; display: flex; align-items: center; }
    .input-icon { position: absolute; left: 13px; font-size: 16px; color: var(--slate-400); pointer-events: none; }
    .input-wrap input, .input-wrap select { width: 100%; height: 43px; background: var(--slate-100); border: 1.5px solid var(--slate-200); border-radius: 9px; padding: 0 40px; font-family: 'Inter', sans-serif; font-size: 0.85rem; color: var(--navy); outline: none; transition: border-color var(--tr), background var(--tr), box-shadow var(--tr); appearance: none; }
    .input-wrap input::placeholder { color: var(--slate-400); }
    .input-wrap input:focus, .input-wrap select:focus { background: var(--white); border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .toggle-pass { position: absolute; right: 12px; background: none; border: none; font-size: 16px; color: var(--slate-400); cursor: pointer; padding: 4px; }
    .field-valid .input-wrap input { border-color: var(--success); }
    .field-error .input-wrap input { border-color: var(--error); background: var(--error-l); }
    .pass-hint { font-size: 0.66rem; color: var(--slate-400); margin-top: 4px; }

    .check-row { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
    .check-row input { width: 15px; height: 15px; accent-color: var(--accent); cursor: pointer; }
    .check-row label { font-size: 0.78rem; color: var(--navy-600); cursor: pointer; }

    .btn-submit { width: 100%; height: 45px; background: var(--accent); border: none; border-radius: 9px; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background var(--tr), transform var(--tr); position: relative; overflow: hidden; }
    .btn-submit:hover { background: var(--accent-h); transform: translateY(-1px); }
    .btn-submit:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
    .btn-submit .spinner { display: none; width: 17px; height: 17px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-submit.loading .spinner { display: block; }
    .btn-submit.loading .btn-text { opacity: 0; position: absolute; }

    .mobile-switch { display: none; text-align: center; font-size: 0.8rem; color: var(--navy-600); margin-top: 18px; }
    .mobile-switch button { background: none; border: none; color: var(--accent); font-weight: 600; cursor: pointer; font-size: 0.8rem; }

    /* ── Overlay diagonal deslizante ── */
    .auth-overlay {
      position: absolute; top: 0; height: 100%; width: 46%;
      left: 54%;
      background: linear-gradient(135deg, var(--navy) 0%, var(--accent-h) 100%);
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
      transition: left var(--tr-slide), clip-path var(--tr-slide);
      z-index: 5; color: #fff; overflow: hidden;
    }
    .auth-shell.mode-registro .auth-overlay {
      left: 0;
      clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%);
    }
    .auth-overlay::before { content: ''; position: absolute; top: -120px; right: -100px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(201,168,76,0.18) 0%, transparent 70%); }
    .auth-overlay-content {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; justify-content: center;
      padding: 48px 44px; opacity: 1; transition: opacity 0.35s ease 0.25s;
    }
    #overlayRegistro { opacity: 0; pointer-events: none; }
    .auth-shell.mode-registro #overlayLogin { opacity: 0; pointer-events: none; }
    .auth-shell.mode-registro #overlayRegistro { opacity: 1; pointer-events: auto; }
    .overlay-icon { font-size: 30px; color: var(--gold); margin-bottom: 18px; }
    .auth-overlay-content h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 400; margin-bottom: 12px; line-height: 1.3; }
    .auth-overlay-content p { font-size: 0.82rem; color: rgba(255,255,255,0.75); line-height: 1.6; margin-bottom: 26px; }
    .btn-ghost { align-self: flex-start; background: transparent; border: 1.5px solid rgba(255,255,255,0.5); color: #fff; font-family: 'Inter', sans-serif; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 11px 22px; border-radius: 9px; cursor: pointer; transition: background var(--tr), border-color var(--tr); }
    .btn-ghost:hover { background: rgba(255,255,255,0.12); border-color: #fff; }

    .page-footer { color: var(--navy-600); font-size: 0.7rem; margin-top: 22px; text-align: center; }

    /* ── Mobile: sin overlay, cambio simple con botón ── */
    @media (max-width: 768px) {
      .auth-shell { height: auto; border-radius: 16px; }
      .auth-form-side { position: static; width: 100%; opacity: 1 !important; pointer-events: auto !important; }
      .auth-form-registro { display: none; }
      .auth-shell.mode-registro .auth-form-login { display: none; }
      .auth-shell.mode-registro .auth-form-registro { display: flex; }
      .auth-form-inner { padding: 32px 24px; }
      .auth-overlay { display: none; }
      .mobile-switch { display: block; }
    }
  </style>
</head>
<body>

<div class="auth-shell" id="authShell">

  <!-- Formulario LOGIN -->
  <div class="auth-form-side auth-form-login">
    <div class="auth-form-inner">
      <div class="brand-mini">
        <div class="brand-icon"><i class="ti ti-building" aria-hidden="true"></i></div>
        <div>
          <div class="brand-name">Hilton</div>
          <div class="brand-sub">Buenos Aires · Portal interno</div>
        </div>
      </div>
      <h2 class="form-title">Bienvenido</h2>
      <p class="form-subtitle">Ingresá con tu cuenta corporativa para continuar</p>

      <% if (error) { %>
      <div class="error-banner"><i class="ti ti-alert-circle"></i> <%= error %></div>
      <% } %>
      <% if (typeof info !== 'undefined' && info) { %>
      <div class="info-banner"><i class="ti ti-info-circle"></i> <%= info %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-banner"><i class="ti ti-check"></i> <%= success %></div>
      <% } %>

      <form method="POST" action="/login" id="loginForm" novalidate>
        <div class="field" id="field-email">
          <div class="field-label"><span>Correo electrónico</span></div>
          <div class="input-wrap">
            <i class="ti ti-mail input-icon"></i>
            <input type="email" name="email" id="email" placeholder="tu.nombre@hilton.com" autocomplete="email" required>
          </div>
        </div>
        <div class="field">
          <div class="field-label">
            <span>Contraseña</span>
            <small>Contactá al administrador</small>
          </div>
          <div class="input-wrap">
            <i class="ti ti-lock input-icon"></i>
            <input type="password" name="password" id="password" placeholder="••••••••" autocomplete="current-password" required>
            <button type="button" class="toggle-pass" onclick="togglePass('password','eye1')">
              <i class="ti ti-eye" id="eye1"></i>
            </button>
          </div>
        </div>
        <div class="check-row">
          <input type="checkbox" id="remember" name="remember">
          <label for="remember">Mantener sesión iniciada</label>
        </div>
        <button type="submit" class="btn-submit" id="submitBtn">
          <div class="spinner"></div>
          <span class="btn-text">Ingresar al portal</span>
          <i class="ti ti-arrow-right btn-text"></i>
        </button>
      </form>

      <p class="mobile-switch">¿No tenés cuenta? <button type="button" onclick="setMode('registro')">Registrate</button></p>
    </div>
  </div>

  <!-- Formulario REGISTRO -->
  <div class="auth-form-side auth-form-registro">
    <div class="auth-form-inner">
      <div class="brand-mini">
        <div class="brand-icon"><i class="ti ti-building" aria-hidden="true"></i></div>
        <div>
          <div class="brand-name">Hilton</div>
          <div class="brand-sub">Buenos Aires · Portal interno</div>
        </div>
      </div>
      <h2 class="form-title">Crear cuenta</h2>
      <p class="form-subtitle">Registrate para acceder al portal</p>

      <% if (typeof errorReg !== 'undefined' && errorReg) { %>
      <div class="error-banner"><i class="ti ti-alert-circle"></i> <%= errorReg %></div>
      <% } %>

      <form method="POST" action="/registro" novalidate>
        <div class="field">
          <div class="field-label"><span>Nombre y apellido</span></div>
          <div class="input-wrap">
            <i class="ti ti-user input-icon"></i>
            <input type="text" name="nombre" placeholder="Juan García" required>
          </div>
        </div>
        <div class="field">
          <div class="field-label"><span>Correo electrónico corporativo</span></div>
          <div class="input-wrap">
            <i class="ti ti-mail input-icon"></i>
            <input type="email" name="email" placeholder="tu.nombre@hilton.com" required>
          </div>
        </div>
        <div class="field">
          <div class="field-label"><span>Contraseña</span></div>
          <div class="input-wrap">
            <i class="ti ti-lock input-icon"></i>
            <input type="password" name="password" id="pass-reg" placeholder="••••••••" required>
            <button type="button" class="toggle-pass" onclick="togglePass('pass-reg','eye2')">
              <i class="ti ti-eye" id="eye2"></i>
            </button>
          </div>
          <p class="pass-hint">Mínimo 8 caracteres, una mayúscula y un número.</p>
        </div>
        <div class="field">
          <div class="field-label"><span>Repetir contraseña</span></div>
          <div class="input-wrap">
            <i class="ti ti-lock input-icon"></i>
            <input type="password" name="password2" placeholder="••••••••" required>
          </div>
        </div>
        <div class="field">
          <div class="field-label"><span>Departamento</span></div>
          <div class="input-wrap">
            <i class="ti ti-building input-icon"></i>
            <select name="departamento" required>
              <option value="">Seleccioná tu área...</option>
              <option value="cocina">Cocina</option>
              <option value="ayb">Alimentos y Bebidas</option>
              <option value="compras">Compras</option>
              <option value="finanzas">Finanzas</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn-submit" style="margin-top:4px;">
          <span class="btn-text">Crear cuenta</span>
          <i class="ti ti-user-plus btn-text"></i>
        </button>
      </form>

      <p class="mobile-switch">¿Ya tenés cuenta? <button type="button" onclick="setMode('login')">Iniciar sesión</button></p>
    </div>
  </div>

  <!-- Overlay diagonal deslizante (solo desktop) -->
  <div class="auth-overlay" id="authOverlay">
    <div class="auth-overlay-content" id="overlayLogin">
      <i class="ti ti-chef-hat overlay-icon" aria-hidden="true"></i>
      <h3>¿Nuevo en el equipo?</h3>
      <p>Registrate para empezar a usar horarios, recetas, eventos y costos desde un solo lugar.</p>
      <button type="button" class="btn-ghost" onclick="setMode('registro')">Crear cuenta</button>
    </div>
    <div class="auth-overlay-content" id="overlayRegistro">
      <i class="ti ti-lock overlay-icon" aria-hidden="true"></i>
      <h3>¿Ya sos parte del equipo?</h3>
      <p>Iniciá sesión con tu cuenta corporativa para acceder al portal interno.</p>
      <button type="button" class="btn-ghost" onclick="setMode('login')">Iniciar sesión</button>
    </div>
  </div>

</div>

<p class="page-footer">© 2026 Hilton Buenos Aires · Future Lab</p>

<% if (typeof success !== 'undefined' && success) { %>
<script src="/js/particulas.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  mostrarParticulasBienvenida('BIENVENIDOS AL PORTAL HILTON');
});
</script>
<% } %>

<script>
// Mostrar el modo correcto según mensajes que vengan del servidor
<% if (typeof errorReg !== 'undefined' && errorReg) { %>
window.addEventListener('DOMContentLoaded', () => setMode('registro'));
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
window.addEventListener('DOMContentLoaded', () => setMode('login'));
<% } %>

function setMode(mode) {
  document.getElementById('authShell').classList.toggle('mode-registro', mode === 'registro');
}

function togglePass(inputId, iconId) {
  const input = document.getElementById(inputId);
  const icon  = document.getElementById(iconId);
  const visible = input.type === 'text';
  input.type = visible ? 'password' : 'text';
  icon.className = visible ? 'ti ti-eye' : 'ti ti-eye-off';
}

const emailInput = document.getElementById('email');
if (emailInput) {
  emailInput.addEventListener('blur', () => {
    const field = document.getElementById('field-email');
    if (emailInput.value && emailInput.checkValidity()) {
      field.className = 'field field-valid';
    } else if (emailInput.value) {
      field.className = 'field field-error';
    }
  });
}

document.getElementById('loginForm').addEventListener('submit', () => {
  const btn = document.getElementById('submitBtn');
  btn.classList.add('loading');
  btn.disabled = true;
});
</script>
</body>
</html>
