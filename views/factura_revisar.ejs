<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Revisar factura — Hilton</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'costos' }) %>

  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Costos</p>
        <h1 class="seccion-titulo">Revisar factura</h1>
      </div>
      <a href="/costos" class="btn-secondary"><i class="ti ti-arrow-left"></i> Cancelar y volver</a>
    </div>

    <% if (typeof autoAplicados !== 'undefined' && autoAplicados > 0) { %>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 16px;color:#15803d;margin-bottom:14px;font-size:0.85rem;">
        <i class="ti ti-check"></i> <%= autoAplicados %> precio(s) ya se actualizaron solos (coincidencia de alta confianza, ≥<%= umbralAuto %>%). Lo que queda abajo necesita que lo confirmes vos.
      </div>
    <% } %>
    <% if (typeof avisoDuplicada !== 'undefined' && avisoDuplicada) { %>
      <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px 16px;color:#92400e;margin-bottom:14px;font-size:0.85rem;">
        <i class="ti ti-alert-triangle"></i> <%= avisoDuplicada %>
      </div>
    <% } %>

    <% if (comparacion.length === 0) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:16px;color:#dc2626;">
        No hay ninguna factura pendiente de revisión. <a href="/costos">Volver a Costos</a>.
      </div>
    <% } else { %>

      <p style="font-size:0.85rem;color:var(--gris-texto);margin-bottom:16px;">
        Gemini detectó <%= comparacion.length %> ítem(s) que necesitan tu confirmación. Tildá los que querés aplicar — solo se van a actualizar los insumos que ya existen en tu lista (los que no matchearon con ninguno quedan sin tildar y no se tocan).
      </p>

      <%
        // Armamos un resumen de qué platos usan los insumos detectados, para
        // mostrarlo como un cartel de advertencia bien visible antes de la
        // tabla (además del detalle por fila). Ojo: NO filtramos por si el
        // precio efectivamente subió — Gemini puede detectar el mismo precio
        // (0% de diferencia, por ejemplo en una factura repetida o de
        // prueba) y aun así el usuario quiere saber qué platos usan ese
        // insumo, para no llevarse una sorpresa el día que sí suba.
        const platosUnicos = new Map(); // nombre plato -> [{insumo, pct}]
        comparacion.forEach((item) => {
          const tieneMatch = !!item.insumo_id;
          if (!tieneMatch) return;
          const dif = item.precio_detectado - item.precio_actual;
          const pct = item.precio_actual > 0 ? ((dif / item.precio_actual) * 100) : null;
          (item.platos_afectados || []).forEach((nombrePlato) => {
            if (!platosUnicos.has(nombrePlato)) platosUnicos.set(nombrePlato, []);
            platosUnicos.get(nombrePlato).push({ insumo: item.insumo_nombre, pct });
          });
        });
      %>
      <% if (platosUnicos.size > 0) { %>
        <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px 16px;color:#92400e;margin-bottom:14px;font-size:0.85rem;">
          <div style="display:flex;align-items:flex-start;gap:10px;">
            <i class="ti ti-alert-triangle" style="font-size:1.1rem;margin-top:1px;"></i>
            <div>
              <strong>Este aumento te afecta en <%= platosUnicos.size %> plato(s):</strong>
              <ul style="margin:8px 0 0;padding-left:18px;">
                <% [...platosUnicos.entries()].forEach(([nombrePlato, insumos]) => { %>
                  <li style="margin-bottom:3px;">
                    <strong><%= nombrePlato %></strong>
                    — por <%= insumos.map(i => i.insumo + (i.pct != null ? ' (' + (i.pct > 0 ? '+' : '') + i.pct.toFixed(1) + '%)' : '')).join(', ') %>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      <% } %>

      <form method="POST" action="/costos/factura/aplicar" id="form-factura">
        <div class="tabla-wrap">
          <table class="tabla" style="width:100%;">
            <thead>
              <tr>
                <th></th>
                <th>Detectado en factura</th>
                <th>Cant. / Unidad</th>
                <th>Insumo en tu lista</th>
                <th>Confianza</th>
                <th>Precio actual</th>
                <th>Precio detectado</th>
                <th>Diferencia</th>
              </tr>
            </thead>
            <tbody>
              <% comparacion.forEach((item) => {
                const tieneMatch = !!item.insumo_id;
                const diferencia = tieneMatch ? (item.precio_detectado - item.precio_actual) : null;
                const porcentaje = tieneMatch && item.precio_actual > 0 ? ((diferencia / item.precio_actual) * 100).toFixed(1) : null;
              %>
              <tr style="<%= tieneMatch ? '' : 'opacity:0.55;' %>">
                <td style="text-align:center;">
                  <% if (tieneMatch) { %>
                  <input type="checkbox" name="aplicar" value="<%= item.idx %>" <%= item.sube ? 'checked' : '' %>
                         style="accent-color:var(--azul);width:16px;height:16px;">
                  <% } else { %>
                  <i class="ti ti-help-circle" title="No se encontró un insumo parecido en tu lista" style="color:var(--gris-texto);"></i>
                  <% } %>
                </td>
                <td style="font-size:0.82rem;font-weight:500;"><%= item.nombre_detectado %></td>
                <td style="font-size:0.8rem;color:var(--gris-texto);"><%= item.cantidad %> <%= item.unidad %></td>
                <td style="font-size:0.82rem;">
                  <% if (tieneMatch) { %>
                    <%= item.insumo_nombre %>
                    <% if (item.platos_afectados && item.platos_afectados.length > 0) { %>
                      <div style="font-size:0.68rem;color:#b45309;margin-top:3px;display:flex;align-items:flex-start;gap:3px;">
                        <i class="ti ti-tools-kitchen-2" style="margin-top:1px;"></i>
                        <span>
                          Usado en <%= item.platos_afectados.length %> plato(s):
                          <%= item.platos_afectados.slice(0, 3).join(', ') %><% if (item.platos_afectados.length > 3) { %> y <%= item.platos_afectados.length - 3 %> más<% } %>
                        </span>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span style="color:var(--gris-texto);font-style:italic;">Sin coincidencia — revisar a mano</span>
                  <% } %>
                </td>
                <td style="font-size:0.78rem;">
                  <% if (tieneMatch) { %>
                    <span style="color:<%= item.confianza >= 70 ? '#15803d' : '#b45309' %>;font-weight:600;"><%= item.confianza %>%</span>
                  <% } else { %>—<% } %>
                </td>
                <td style="font-size:0.82rem;"><%= tieneMatch ? ('$' + Number(item.precio_actual).toLocaleString('es-AR')) : '—' %></td>
                <td style="font-size:0.82rem;font-weight:600;">$<%= Number(item.precio_detectado).toLocaleString('es-AR') %></td>
                <td style="font-size:0.8rem;">
                  <% if (tieneMatch) { %>
                    <span style="color:<%= diferencia > 0 ? '#dc2626' : (diferencia < 0 ? '#16a34a' : 'var(--gris-texto)') %>;font-weight:600;">
                      <%= diferencia > 0 ? '+' : '' %><%= porcentaje %>%
                    </span>
                    <% if (diferencia < 0) { %>
                      <span style="display:block;font-size:0.62rem;color:var(--gris-texto);font-style:italic;">No se aplica: es menor al actual</span>
                    <% } %>
                  <% } else { %>—<% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div style="margin-top:20px;display:flex;gap:12px;">
          <button type="button" class="btn-primary" onclick="intentarAplicar()"><i class="ti ti-check"></i> Aplicar cambios tildados</button>
          <a href="/costos" class="btn-secondary">Descartar todo</a>
        </div>
      </form>

      <!-- Ventana emergente: antes de aplicar, si algún ítem tildado afecta
           platos, se lo mostramos acá con un cartel de advertencia, en vez
           de solo dejarlo como texto en la tabla — mismo estilo que el
           modal de "Reiniciar período" en Horarios. -->
      <div id="modal-platos-afectados" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
        <div style="background:var(--blanco);border-radius:16px;padding:32px;width:100%;max-width:460px;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
          <div style="text-align:center;">
            <div style="width:64px;height:64px;border-radius:50%;background:#fffbeb;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
              <i class="ti ti-alert-triangle" style="font-size:32px;color:#b45309;"></i>
            </div>
            <p style="font-family:var(--font-serif);font-size:1.2rem;font-weight:600;margin-bottom:8px;">
              Este aumento afecta <span id="modal-platos-titulo-cant">0</span> plato(s)
            </p>
            <p style="font-size:0.82rem;color:var(--gris-texto);margin-bottom:14px;">
              Al confirmar, se va a recalcular el costo de estos platos:
            </p>
          </div>
          <ul id="modal-platos-lista" style="text-align:left;font-size:0.82rem;margin:0 0 22px;padding-left:18px;color:var(--negro);"></ul>
          <p id="modal-platos-texto-info" style="display:none;font-size:0.78rem;color:var(--gris-texto);margin:-14px 0 18px;">
            Esto es solo un aviso — todavía no se aplicó ningún cambio. Revisá la tabla y confirmá cuando quieras.
          </p>
          <div style="display:flex;gap:10px;justify-content:center;">
            <button type="button" id="btn-modal-platos-cancelar" class="btn-secondary" onclick="cerrarModalPlatos()">Cancelar</button>
            <button type="button" id="btn-modal-platos-entendido" class="btn-secondary" style="display:none;" onclick="cerrarModalPlatos()">Entendido</button>
            <button type="button" id="btn-modal-platos-confirmar" class="btn-primary" onclick="confirmarAplicarConPlatos()"><i class="ti ti-check"></i> Sí, aplicar cambios</button>
          </div>
        </div>
      </div>

      <script>
        // Mismos datos que ya calculamos en el servidor (idx, insumo,
        // platos afectados, % de diferencia, si sube o no), pero en JSON
        // para poder armar el cartel tanto apenas se carga la pantalla
        // (con lo que Gemini detectó) como de nuevo, filtrado, justo antes
        // de aplicar (con lo que el usuario efectivamente tildó).
        const ITEMS_FACTURA = <%- JSON.stringify(comparacion.map((item) => {
          const tieneMatch = !!item.insumo_id;
          const diferencia = tieneMatch ? (item.precio_detectado - item.precio_actual) : null;
          const porcentaje = tieneMatch && item.precio_actual > 0
            ? Number(((diferencia / item.precio_actual) * 100).toFixed(1)) : null;
          return {
            idx: item.idx,
            insumo_nombre: item.insumo_nombre,
            platos_afectados: item.platos_afectados || [],
            porcentaje,
            sube: !!item.sube,
          };
        })).replace(/</g, '\\u003c') %>;

        function calcularPlatosAfectados(idxsPermitidos) {
          const platosMap = new Map(); // nombre del plato -> [{insumo, porcentaje}]
          ITEMS_FACTURA.forEach((item) => {
            if (idxsPermitidos && !idxsPermitidos.has(item.idx)) return;
            (item.platos_afectados || []).forEach((nombrePlato) => {
              if (!platosMap.has(nombrePlato)) platosMap.set(nombrePlato, []);
              platosMap.get(nombrePlato).push({ insumo: item.insumo_nombre, porcentaje: item.porcentaje });
            });
          });
          return platosMap;
        }

        function pintarListaPlatos(platosMap) {
          const lista = document.getElementById('modal-platos-lista');
          lista.innerHTML = '';
          platosMap.forEach((insumos, nombrePlato) => {
            const li = document.createElement('li');
            li.style.marginBottom = '5px';
            const strong = document.createElement('strong');
            strong.textContent = nombrePlato;
            li.appendChild(strong);
            const detalle = insumos
              .map((i) => i.insumo + (i.porcentaje != null ? ' (+' + i.porcentaje + '%)' : ''))
              .join(', ');
            li.appendChild(document.createTextNode(' — por ' + detalle));
            lista.appendChild(li);
          });
          document.getElementById('modal-platos-titulo-cant').textContent = platosMap.size;
        }

        // modo 'info' = solo aviso apenas se detecta (botón "Entendido", no manda el form).
        // modo 'confirm' = paso previo a aplicar (botones "Cancelar" / "Sí, aplicar cambios").
        function mostrarModalPlatos(platosMap, modo) {
          pintarListaPlatos(platosMap);
          document.getElementById('btn-modal-platos-entendido').style.display = modo === 'info' ? 'inline-flex' : 'none';
          document.getElementById('btn-modal-platos-cancelar').style.display = modo === 'confirm' ? 'inline-flex' : 'none';
          document.getElementById('btn-modal-platos-confirmar').style.display = modo === 'confirm' ? 'inline-flex' : 'none';
          document.getElementById('modal-platos-texto-info').style.display = modo === 'info' ? 'block' : 'none';
          document.getElementById('modal-platos-afectados').style.display = 'flex';
        }

        function intentarAplicar() {
          const marcados = new Set(
            [...document.querySelectorAll('input[name="aplicar"]:checked')].map((cb) => parseInt(cb.value, 10))
          );
          const platosMap = calcularPlatosAfectados(marcados);
          if (platosMap.size === 0) {
            document.getElementById('form-factura').submit();
            return;
          }
          mostrarModalPlatos(platosMap, 'confirm');
        }

        function cerrarModalPlatos() {
          document.getElementById('modal-platos-afectados').style.display = 'none';
        }

        function confirmarAplicarConPlatos() {
          cerrarModalPlatos();
          document.getElementById('form-factura').submit();
        }

        // Apenas se carga la pantalla (recién detectado por Gemini), si algún
        // insumo detectado se usa en algún plato, mostramos el cartel de una
        // vez, sin esperar a que el usuario apriete "Aplicar cambios
        // tildados". No filtramos por si el precio subió o no: incluso con
        // 0% de diferencia (factura repetida, o una de prueba) sirve saber
        // qué platos usan ese insumo.
        window.addEventListener('DOMContentLoaded', () => {
          const todosLosDetectados = new Set(ITEMS_FACTURA.map((item) => item.idx));
          const platosMap = calcularPlatosAfectados(todosLosDetectados);
          if (platosMap.size > 0) {
            mostrarModalPlatos(platosMap, 'info');
          }
        });
      </script>
    <% } %>
  </main>
  <%- include('partials/mobile-nav', { path: 'costos' }) %>
</div>
</body>
</html>
