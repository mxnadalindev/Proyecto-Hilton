<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Desayuno — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
  <style>
.field{display:flex;flex-direction:column;gap:6px;}
.field label{font-size:0.72rem;font-weight:600;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.04em;}
.field input{border:1px solid var(--gris-borde);border-radius:8px;padding:10px 12px;font-size:0.85rem;outline:none;background:var(--gris-fondo);}
.field input:focus{border-color:var(--azul);background:var(--blanco);}

.desayuno-buscador{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:28px;box-shadow:var(--sombra);margin-bottom:20px;}
.desayuno-buscador-input{font-size:1.6rem;font-weight:700;text-align:center;letter-spacing:0.06em;padding:16px;border-radius:10px;}
/* 5 tarjetas: en pantallas chicas van UNA por fila (no 2) a propósito —
   con 2 columnas, la 5ta tarjeta queda sola debajo de la 3ra y ahí sí o sí
   se repite un color pegado arriba de otro igual (con solo verde/azul
   para el resto, no hay forma de evitarlo en una grilla 2 columnas x 5
   tarjetas). En una sola fila (desktop) o una sola columna (mobile) el
   orden es siempre lineal, así el mismo criterio de colores de abajo
   nunca deja dos tarjetas iguales pegadas, en ninguna de las dos pantallas. */
.desayuno-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px;}
.desayuno-stat{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:12px;padding:16px;text-align:center;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);}
.desayuno-stat p:first-child{font-size:0.62rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px;}
.desayuno-stat p:last-child{font-size:1.4rem;font-weight:700;color:var(--negro);margin:0;}
@media (max-width:700px){.desayuno-stats{grid-template-columns:1fr;}}

/* Colores translúcidos por tarjeta — mismo estilo "vidrio" que ya usamos en
   Inventario AYB (fondo de color con transparencia + borde a juego). */
.desayuno-stat-azul{ background:rgba(0,47,97,0.12); border-color:rgba(0,47,97,0.28); }
.desayuno-stat-rojo{ background:rgba(220,38,38,0.10); border-color:rgba(220,38,38,0.28); }
.desayuno-stat-rojo p{ color:#dc2626; }
.desayuno-stat-verde{ background:rgba(6,147,126,0.12); border-color:rgba(6,147,126,0.3); }

.desayuno-resultado{background:var(--blanco);border:1px solid var(--gris-borde);border-radius:14px;padding:24px;box-shadow:var(--sombra);}
/* Tiñe toda la tarjeta según si la habitación tiene desayuno incluido o
   no (mismos colores que ya usa el cartelito badge-si/badge-no, muy
   translúcidos para no perder la legibilidad de todos los datos de
   adentro). Elegido en un mockup aparte antes de instalarlo acá. */
.desayuno-resultado-si{background:rgba(6,147,126,0.06);border-color:rgba(6,147,126,0.28);}
.desayuno-resultado-no{background:rgba(220,38,38,0.05);border-color:rgba(220,38,38,0.25);}
.desayuno-resultado-header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--gris-borde);}
.desayuno-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;font-size:0.72rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;}
.badge-si{background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;}
.badge-no{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.desayuno-filas{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media (max-width:600px){.desayuno-filas{grid-template-columns:1fr;}}
.desayuno-dato p:first-child{font-size:0.62rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 4px;}
.desayuno-dato p:last-child{font-size:0.9rem;color:var(--negro);margin:0;font-weight:500;}
.desayuno-aviso-tr{margin-top:16px;background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:12px 16px;font-size:0.85rem;font-weight:600;display:flex;align-items:center;gap:8px;}

.dropdown-otras-opciones{position:absolute;right:0;top:calc(100% + 6px);background:var(--blanco);border:1px solid var(--gris-borde);border-radius:10px;box-shadow:var(--sombra-md);padding:6px;min-width:240px;display:none;flex-direction:column;gap:2px;z-index:50;}
.dropdown-otras-opciones.abierto{display:flex;}
.dropdown-otras-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:7px;font-size:0.83rem;color:var(--negro);text-decoration:none;transition:background .15s;border:none;background:none;width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);}
.dropdown-otras-item:hover{background:var(--gris-fondo);}
.dropdown-otras-item i{font-size:16px;color:var(--gris-texto);}
.dropdown-otras-item-nav{ color:#002f61; }
.dropdown-otras-item-nav i{ color:#1d4e89; }
.dropdown-otras-item-nav:hover{ background:rgba(0,47,97,0.08); }
.menu-otras-opciones{position:relative;}

/* Modal de confirmación (mismo patrón que ya se usa en Configuración y en
   Costos para eliminar) — acá se usa DOS VECES seguidas para "Eliminar
   todo lo cargado", a pedido explícito: es una acción destructiva (borra
   todas las habitaciones del reporte actual) y no tiene vuelta atrás. */
.modal-confirmar{position:fixed;inset:0;background:rgba(0,0,0,0);z-index:2000;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity 0.2s ease, background 0.2s ease;}
.modal-confirmar.mostrar{opacity:1;pointer-events:auto;background:rgba(0,0,0,0.45);}
.modal-confirmar-caja{background:var(--blanco);border-radius:16px;width:100%;max-width:380px;padding:26px 28px;box-shadow:0 20px 60px rgba(0,0,0,0.3);text-align:center;transform:scale(0.9);transition:transform 0.2s cubic-bezier(.22,1,.36,1);}
.modal-confirmar.mostrar .modal-confirmar-caja{transform:scale(1);}
.modal-confirmar-icono{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:1.4rem;background:var(--azul-claro);color:var(--azul);}
.modal-confirmar-caja.peligro .modal-confirmar-icono{background:#fef2f2;color:#dc2626;}
.modal-confirmar-msg{font-size:0.88rem;color:var(--negro);font-weight:500;margin:0 0 22px;line-height:1.5;}
.modal-confirmar-botones{display:flex;gap:10px;justify-content:center;}
.modal-confirmar-botones button{font-size:0.78rem;font-weight:600;padding:9px 18px;border-radius:8px;cursor:pointer;font-family:var(--font-sans);}
.modal-confirmar-cancelar{background:none;border:1px solid var(--gris-borde);color:var(--gris-texto);}
.modal-confirmar-cancelar:hover{background:var(--gris-fondo);}
.modal-confirmar-aceptar{background:var(--azul);border:1px solid var(--azul);color:#fff;}
.modal-confirmar-aceptar:hover{background:var(--azul-hover);}
.modal-confirmar-caja.peligro .modal-confirmar-aceptar{background:#dc2626;border-color:#dc2626;}
.modal-confirmar-caja.peligro .modal-confirmar-aceptar:hover{background:#b91c1c;}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'desayuno' }) %>

  <main class="main-content">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">AYB</p>
        <h1 class="seccion-titulo">Desayuno</h1>
      </div>
      <div class="menu-otras-opciones">
        <button type="button" class="btn-secondary" id="btn-otras-opciones-desayuno" onclick="document.getElementById('dropdown-otras-opciones-desayuno').classList.toggle('abierto')">
          <i class="ti ti-dots"></i> Otras opciones
        </button>
        <div class="dropdown-otras-opciones" id="dropdown-otras-opciones-desayuno">
          <button type="button" class="dropdown-otras-item dropdown-otras-item-nav" onclick="showModal('modal-subir-reporte')">
            <i class="ti ti-upload"></i> Subir reporte del día
          </button>
          <% if (fechaReporte) { %>
          <button type="button" class="dropdown-otras-item" style="color:#dc2626;" onclick="document.getElementById('dropdown-otras-opciones-desayuno').classList.remove('abierto'); confirmarEliminarTodo()">
            <i class="ti ti-trash" style="color:#dc2626;"></i> Eliminar todo lo cargado
          </button>
          <% } %>
        </div>
      </div>
    </div>

    <% if (msg === 'importado') { %>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;color:#16a34a;font-weight:600;margin-bottom:20px;">
        <i class="ti ti-circle-check"></i> Reporte importado correctamente.
      </div>
    <% } else if (msg === 'eliminado') { %>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;color:#16a34a;font-weight:600;margin-bottom:20px;">
        <i class="ti ti-circle-check"></i> Se eliminó todo lo que estaba cargado.
      </div>
    <% } else if (msg) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px 18px;color:#dc2626;font-weight:600;margin-bottom:20px;">
        <i class="ti ti-alert-triangle"></i> <%= msg %>
      </div>
    <% } %>

    <% if (!fechaReporte) { %>
      <div style="background:var(--gris-fondo);border:1px dashed var(--gris-borde);border-radius:14px;padding:40px;text-align:center;color:var(--gris-texto);">
        <i class="ti ti-coffee" style="font-size:32px;display:block;margin-bottom:10px;"></i>
        Todavía no se subió ningún reporte de desayuno.<br>
        Usá "Otras opciones → Subir reporte del día" para cargar el primero.
      </div>
    <% } else { %>

      <div class="desayuno-stats">
        <div class="desayuno-stat desayuno-stat-azul"><p>Habitaciones</p><p><%= totalHabitaciones %></p></div>
        <div class="desayuno-stat desayuno-stat-rojo"><p>Sin desayuno incluido</p><p><%= sinDesayuno %></p></div>
        <div class="desayuno-stat desayuno-stat-verde"><p>Con desayuno incluido</p><p><%= totalHabitaciones - sinDesayuno %></p></div>
        <div class="desayuno-stat desayuno-stat-azul"><p>Tripulación</p><p><%= tripulacion %></p></div>
        <div class="desayuno-stat desayuno-stat-verde"><p>Con pedido TR</p><p><%= conTR %></p></div>
      </div>
      <p style="font-size:0.75rem;color:var(--gris-texto);margin:-12px 0 20px;">Reporte del <%= fechaReporte.split('-').reverse().join('-') %></p>

      <div class="desayuno-buscador">
        <div class="field">
          <label>Número de habitación</label>
          <input type="text" id="input-habitacion" class="desayuno-buscador-input" placeholder="Ej: 0234" autocomplete="off" autofocus>
        </div>
      </div>

      <div id="resultados-desayuno"></div>

    <% } %>

  </main>
  <%- include('partials/mobile-nav', { path: 'desayuno' }) %>
</div>

<!-- Modal: subir reporte -->
<div class="modal" id="modal-subir-reporte" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div style="background:var(--blanco);border-radius:14px;padding:28px;max-width:460px;width:100%;box-shadow:var(--sombra-lg);">
    <p class="form-card-title" style="font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--azul);margin-bottom:16px;"><i class="ti ti-upload"></i> Subir reporte del día</p>
    <form method="POST" action="/desayuno/importar" enctype="multipart/form-data">
      <div class="field" style="margin-bottom:16px;">
        <label>Archivo (Excel, CSV o PDF)</label>
        <input type="file" name="archivo" accept=".xlsx,.xls,.csv,.pdf" required style="padding:10px;">
      </div>
      <p style="font-size:0.76rem;color:var(--gris-texto);margin-bottom:20px;line-height:1.5;">
        Si es Excel o CSV, se lee directo (más confiable). Si es PDF, lo lee la IA —
        con reportes muy largos puede tardar un rato. En los dos casos, antes de
        cargarlo a la base te muestro un resumen para que confirmes.
      </p>
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button type="button" onclick="hideModal('modal-subir-reporte')" class="btn-secondary">Cancelar</button>
        <button type="submit" class="btn-primary"><i class="ti ti-upload"></i> Subir y revisar</button>
      </div>
    </form>
  </div>
</div>

<!-- Formulario oculto que efectivamente borra — se manda por JS recién
     después de las dos confirmaciones, nunca por un click directo. -->
<form id="form-eliminar-todo-desayuno" method="POST" action="/desayuno/eliminar-todo" style="display:none;"></form>

<!-- Confirmación 1 de 2 -->
<div class="modal-confirmar" id="modal-confirmar-desayuno-1" onclick="if(event.target===this) cerrarConfirmarDesayuno(1)">
  <div class="modal-confirmar-caja peligro">
    <div class="modal-confirmar-icono"><i class="ti ti-alert-triangle"></i></div>
    <p class="modal-confirmar-msg">¿Eliminar todo lo cargado de Desayuno? Se van a borrar las <%= typeof totalHabitaciones !== 'undefined' ? totalHabitaciones : '' %> habitaciones del reporte actual.</p>
    <div class="modal-confirmar-botones">
      <button type="button" class="modal-confirmar-cancelar" onclick="cerrarConfirmarDesayuno(1)">Cancelar</button>
      <button type="button" class="modal-confirmar-aceptar" onclick="pasarASegundaConfirmacionDesayuno()">Sí, eliminar</button>
    </div>
  </div>
</div>

<!-- Confirmación 2 de 2 -->
<div class="modal-confirmar" id="modal-confirmar-desayuno-2" onclick="if(event.target===this) cerrarConfirmarDesayuno(2)">
  <div class="modal-confirmar-caja peligro">
    <div class="modal-confirmar-icono"><i class="ti ti-alert-triangle"></i></div>
    <p class="modal-confirmar-msg">Esta acción no se puede deshacer. ¿Confirmás de nuevo que querés eliminar todo lo cargado?</p>
    <div class="modal-confirmar-botones">
      <button type="button" class="modal-confirmar-cancelar" onclick="cerrarConfirmarDesayuno(2)">Cancelar</button>
      <button type="button" class="modal-confirmar-aceptar" onclick="eliminarTodoDesayuno()">Sí, eliminar definitivamente</button>
    </div>
  </div>
</div>

<script src="/js/ui-comun.js"></script>
<script>
document.addEventListener('click', (ev) => {
  const dropdown = document.getElementById('dropdown-otras-opciones-desayuno');
  const boton = document.getElementById('btn-otras-opciones-desayuno');
  if (dropdown && dropdown.classList.contains('abierto') && !dropdown.contains(ev.target) && ev.target !== boton && !boton.contains(ev.target)) {
    dropdown.classList.remove('abierto');
  }
});

// "Eliminar todo lo cargado" — pide confirmación DOS VECES seguidas antes
// de mandar el POST que borra, justamente por ser una acción destructiva
// sin vuelta atrás (borra todas las habitaciones del reporte actual).
function confirmarEliminarTodo() {
  document.getElementById('modal-confirmar-desayuno-1').classList.add('mostrar');
}
function cerrarConfirmarDesayuno(n) {
  document.getElementById('modal-confirmar-desayuno-' + n).classList.remove('mostrar');
}
function pasarASegundaConfirmacionDesayuno() {
  cerrarConfirmarDesayuno(1);
  document.getElementById('modal-confirmar-desayuno-2').classList.add('mostrar');
}
function eliminarTodoDesayuno() {
  cerrarConfirmarDesayuno(2);
  document.getElementById('form-eliminar-todo-desayuno').submit();
}

const inputHabitacion = document.getElementById('input-habitacion');
const contResultados = document.getElementById('resultados-desayuno');
let _debounceHab, _pedidoHabEnCurso = 0;

function escaparHtml(s) {
  return (s || '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function tarjetaHabitacion(f) {
  const badgeBkf = f.bkfIncluido
    ? '<span class="desayuno-badge badge-si"><i class="ti ti-check"></i> Desayuno incluido</span>'
    : '<span class="desayuno-badge badge-no"><i class="ti ti-x"></i> Desayuno NO incluido</span>';

  let tripuHtml = '';
  if (f.tripulacionDe) {
    tripuHtml = `<div class="desayuno-dato"><p>Tripulación</p><p>${escaparHtml(f.tripulacionDe)}` +
      (f.tripulacionBkfSegunRegla !== null
        ? ` <span style="font-size:0.72rem;color:var(--gris-texto);">(regla: ${f.tripulacionBkfSegunRegla ? 'bkf incluido' : 'bkf NO incluido'})</span>`
        : '') + `</p></div>`;
  }

  const trHtml = f.tieneTR
    ? `<div class="desayuno-aviso-tr"><i class="ti ti-alert-triangle"></i> Esta habitación tiene pedido especial "TR"</div>`
    : '';

  return `
    <div class="desayuno-resultado ${f.bkfIncluido ? 'desayuno-resultado-si' : 'desayuno-resultado-no'}">
      <div class="desayuno-resultado-header">
        <div>
          <p style="font-size:0.62rem;color:var(--gris-texto);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 4px;">Habitación ${escaparHtml(f.habitacion)}</p>
          <p style="font-size:1.15rem;font-weight:700;margin:0;">${escaparHtml(f.nombre_huesped || '(sin nombre)')}</p>
        </div>
        ${badgeBkf}
      </div>
      <div class="desayuno-filas">
        <div class="desayuno-dato"><p>Nivel de membresía</p><p>${f.membershipLabel ? escaparHtml(f.membershipLabel) : '—'}</p></div>
        <div class="desayuno-dato"><p>Adultos / Niños</p><p>${f.adultos ?? 0} / ${f.ninos ?? 0}</p></div>
        <div class="desayuno-dato"><p>Llegada / Salida</p><p>${escaparHtml(f.fecha_llegada || '—')} → ${escaparHtml(f.fecha_salida || '—')}</p></div>
        <div class="desayuno-dato"><p>Estado</p><p>${escaparHtml(f.estado_reserva || '—')}</p></div>
        <div class="desayuno-dato"><p>Grupo</p><p>${escaparHtml(f.group_name || '—')}</p></div>
        <div class="desayuno-dato"><p>Empresa</p><p>${escaparHtml(f.company_name || '—')}</p></div>
        ${tripuHtml}
        <div class="desayuno-dato"><p>Pedido especial</p><p>${f.special_request ? escaparHtml(f.special_request) : '—'}</p></div>
      </div>
      ${trHtml}
    </div>
  `;
}

function buscarHabitacion() {
  const q = inputHabitacion.value.trim();
  if (!q) { contResultados.innerHTML = ''; return; }
  const idPedido = ++_pedidoHabEnCurso;
  fetch('/desayuno/buscar?habitacion=' + encodeURIComponent(q))
    .then(r => r.json())
    .then(data => {
      if (idPedido !== _pedidoHabEnCurso) return; // respuesta vieja, descartar
      if (!data.resultados || data.resultados.length === 0) {
        contResultados.innerHTML = '<p style="color:var(--gris-texto);font-size:0.85rem;padding:16px 0;">Sin resultados para "' + escaparHtml(q) + '".</p>';
        return;
      }
      contResultados.innerHTML = data.resultados.map(tarjetaHabitacion).join('<div style="height:14px;"></div>');
    })
    .catch(() => { contResultados.innerHTML = '<p style="color:#dc2626;font-size:0.85rem;">Error buscando la habitación.</p>'; });
}

if (inputHabitacion) {
  inputHabitacion.addEventListener('input', () => {
    clearTimeout(_debounceHab);
    _debounceHab = setTimeout(buscarHabitacion, 250);
  });
}
</script>

</body>
</html>
