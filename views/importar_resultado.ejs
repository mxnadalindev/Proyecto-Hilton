<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Importación de insumos — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: 'costos' }) %>

  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Costos</p>
        <h1 class="seccion-titulo">Resultado de la importación</h1>
      </div>
      <a href="/costos<%= (typeof resumen !== 'undefined' && resumen && resumen.esAyb) ? '?depto=ayb' : '' %>" class="btn-secondary"><i class="ti ti-arrow-left"></i> Volver a Costos</a>
    </div>

    <% if (!resumen) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:16px;color:#dc2626;">
        No hay ninguna importación reciente para mostrar. <a href="/costos">Volver a Costos</a>.
      </div>
    <% } else { %>

      <p style="font-size:0.85rem;color:var(--gris-texto);margin-bottom:20px;">
        Categoría: <strong style="color:var(--negro);"><%= resumen.categoria %></strong> ·
        <%= resumen.totalProcesados %> filas procesadas del archivo.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:28px;">
        <div style="background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= resumen.nuevos %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Nuevos</p>
        </div>
        <div style="background:rgba(0,47,97,0.10);border:1px solid rgba(0,47,97,0.26);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= resumen.actualizados %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Precios actualizados</p>
        </div>
        <div style="background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= resumen.sinCambios %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Sin cambios</p>
        </div>
        <div style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= resumen.sinPrecio %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Sin precio</p>
        </div>
        <% if (resumen.negativosRechazados > 0) { %>
        <div style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= resumen.negativosRechazados %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Precio negativo (ignoradas)</p>
        </div>
        <% } %>
        <% if (resumen.menoresIgnorados > 0) { %>
        <div style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:#dc2626;margin:0;"><%= resumen.menoresIgnorados %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:#dc2626;margin:4px 0 0;">Precio menor (se mantuvo el actual)</p>
        </div>
        <% } %>
      </div>

      <% if (resumen.menoresIgnorados > 0) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:12px;font-size:0.8rem;color:#dc2626;display:flex;align-items:center;gap:8px;">
        <i class="ti ti-shield-check"></i>
        <%= resumen.menoresIgnorados %> insumo<%= resumen.menoresIgnorados !== 1 ? 's' : '' %> del archivo tenía<%= resumen.menoresIgnorados !== 1 ? 'n' : '' %> un precio más bajo que el actual — se mantuvo el precio más alto (el costeo de los platos nunca baja solo). Si alguno es una baja real de precio, corregilo a mano en la lista de insumos con la opción "Forzar".
      </div>
      <% } %>

      <% if (resumen.negativosRechazados > 0) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.8rem;color:#dc2626;display:flex;align-items:center;gap:8px;">
        <i class="ti ti-alert-circle"></i>
        <%= resumen.negativosRechazados %> fila<%= resumen.negativosRechazados !== 1 ? 's' : '' %> del archivo tenía<%= resumen.negativosRechazados !== 1 ? 'n' : '' %> precio negativo (probablemente una nota de crédito o bonificación mezclada en el archivo) — no se cargaron ni actualizaron esos insumos.
      </div>
      <% } %>

      <% if (resumen.cambiosDePrecios.length > 0) { %>
      <p style="font-size:0.7rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--azul);margin-bottom:10px;">
        Detalle de precios actualizados (<%= resumen.cambiosDePrecios.length %>)
      </p>
      <div class="tabla-wrap" style="max-height:480px;overflow-y:auto;">
        <table class="tabla" style="width:100%;">
          <thead>
            <tr>
              <th>Código</th>
              <th>Insumo</th>
              <th>Precio anterior</th>
              <th>Precio nuevo</th>
              <th>Diferencia</th>
            </tr>
          </thead>
          <tbody>
            <% resumen.cambiosDePrecios.forEach(c => {
              const diff = c.precio_nuevo - c.precio_anterior;
              const pct = c.precio_anterior > 0 ? ((diff / c.precio_anterior) * 100).toFixed(1) : '—';
            %>
            <tr>
              <td style="font-family:monospace;font-size:0.75rem;color:var(--gris-texto);"><%= c.codigo %></td>
              <td style="font-size:0.82rem;"><%= c.nombre %></td>
              <td style="font-size:0.82rem;">$<%= Number(c.precio_anterior).toLocaleString('es-AR') %></td>
              <td style="font-size:0.82rem;font-weight:600;">$<%= Number(c.precio_nuevo).toLocaleString('es-AR') %></td>
              <td style="font-size:0.8rem;font-weight:600;color:<%= diff > 0 ? '#dc2626' : (diff < 0 ? '#16a34a' : 'var(--gris-texto)') %>;">
                <%= diff > 0 ? '+' : '' %><%= pct %>%
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>

    <% } %>
  </main>
  <%- include('partials/mobile-nav', { path: 'costos' }) %>
</div>
</body>
</html>
