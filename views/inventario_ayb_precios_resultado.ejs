<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Precios actualizados — Inventario AYB — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
  <style>
    .btn-chico-azul,.btn-chico-verde{height:32px;box-sizing:border-box;padding:0 12px;border-radius:8px;font-family:var(--font-sans);font-size:0.62rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;transition:all .2s;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border:none;}
    .btn-chico-azul{background:rgba(0,47,97,0.12);color:#002f61;border:1px solid rgba(0,47,97,0.28);}
    .btn-chico-azul:hover{background:rgba(0,47,97,0.20);}
    .btn-chico-verde{background:rgba(6,147,126,0.14);color:#06937e;border:1px solid rgba(6,147,126,0.32);}
    .btn-chico-verde:hover{background:rgba(6,147,126,0.24);}
  </style>
</head>
<body>
<div class="app-layout">

  <%- include('partials/nav', { path: 'inventario-ayb' }) %>

  <main class="main-content main-content-ancho">

    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label">Alimentos y Bebidas</p>
        <h1 class="seccion-titulo">Precios actualizados</h1>
      </div>
      <a href="/inventario-ayb" class="btn-chico-azul"><i class="ti ti-arrow-left"></i> Volver al inventario</a>
    </div>

    <% if (!resultado) { %>
      <div style="background:rgba(220,38,38,0.10);border:1px solid rgba(220,38,38,0.28);border-radius:10px;padding:16px;color:#dc2626;">
        No hay ninguna actualización reciente para mostrar. <a href="/inventario-ayb">Volver al inventario</a>.
      </div>
    <% } else { %>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:20px;">
        <div style="background:rgba(6,147,126,0.12);border:1px solid rgba(6,147,126,0.3);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= resultado.productosActualizados %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Producto<%= resultado.productosActualizados !== 1 ? 's' : '' %> actualizado<%= resultado.productosActualizados !== 1 ? 's' : '' %></p>
        </div>
        <div style="background:rgba(0,47,97,0.10);border:1px solid rgba(0,47,97,0.26);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-radius:12px;padding:16px;text-align:center;">
          <p style="font-size:1.8rem;font-weight:700;color:var(--negro);margin:0;"><%= resultado.platosRecalculados %></p>
          <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gris-texto);margin:4px 0 0;">Trago<%= resultado.platosRecalculados !== 1 ? 's' : '' %> de Costos recalculado<%= resultado.platosRecalculados !== 1 ? 's' : '' %></p>
        </div>
      </div>

      <% if (resultado.nombres && resultado.nombres.length > 0) { %>
      <details style="margin-bottom:16px;">
        <summary style="cursor:pointer;font-size:0.82rem;color:var(--azul);">Ver los productos actualizados</summary>
        <ul style="font-size:0.8rem;color:var(--gris-texto);margin-top:8px;columns:2;">
          <% resultado.nombres.forEach(n => { %><li><%= n %></li><% }) %>
        </ul>
      </details>
      <% } %>

      <div style="display:flex;gap:10px;margin-top:12px;">
        <a href="/inventario-ayb" class="btn-chico-verde"><i class="ti ti-list"></i> Ver el inventario</a>
        <a href="/costos" class="btn-chico-azul"><i class="ti ti-receipt"></i> Ver Costos</a>
      </div>

    <% } %>
  </main>
</div>
</body>
</html>
