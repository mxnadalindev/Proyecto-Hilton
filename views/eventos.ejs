<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eventos — Hilton</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css"></noscript>
</head>
<body>
<div class="app-layout">
  <%- include('partials/nav', { path: path }) %>
  <main class="main-content">
    <div class="seccion-header">
      <div class="seccion-header-left">
        <p class="seccion-label" data-i18n>Portal interno</p>
        <h1 class="seccion-titulo" data-i18n>Eventos</h1>
        <%- include('partials/eventos_subnav', { seccionEventos: 'lista' }) %>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/eventos/nuevo" class="btn-primary"><i class="ti ti-plus"></i> <span data-i18n>Nuevo evento</span></a>
      </div>
    </div>

    <% if (eventos.length > 0) { %>
    <div class="tabla-wrap">
      <table class="tabla">
        <thead><tr><th data-i18n>Nombre</th><th data-i18n>Fecha</th><th data-i18n>Horario</th><th data-i18n>Miembros de equipo</th><th data-i18n>Costo total</th><th></th></tr></thead>
        <tbody>
          <% eventos.forEach(e => { %>
          <tr>
            <td><a href="/eventos/<%= e.id %>" class="link-tabla"><%= e.nombre %></a></td>
            <td><%= e.fecha %></td>
            <td><%= e.hora_inicio ? e.hora_inicio + (e.hora_fin ? ' — ' + e.hora_fin : '') : '—' %></td>
            <td><span class="badge-num"><i class="ti ti-users"></i> <%= e.cantidad_personal %></span></td>
            <td style="font-weight:500;color:var(--azul);">$<%= parseFloat(e.costo_total).toFixed(2) %></td>
            <td><a href="/eventos/<%= e.id %>" class="btn-sm" data-i18n>Ver detalle</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <i class="ti ti-calendar-off" style="font-size:2.5rem;color:var(--gris-borde);margin-bottom:16px;display:block;"></i>
      <p data-i18n>No hay eventos todavía.</p>
      <a href="/eventos/nuevo" class="btn-primary" style="margin-top:20px;display:inline-flex;"><i class="ti ti-plus"></i> <span data-i18n>Crear el primer evento</span></a>
    </div>
    <% } %>
    <div style="display:flex;justify-content:flex-start;align-items:center;margin-top:24px;padding-top:20px;border-top:1px solid var(--gris-borde);">
      <a href="/inicio" class="btn-secondary"><i class="ti ti-arrow-left"></i> <span data-i18n>Volver al menú principal</span></a>
    </div>
  </main>
  <%- include('partials/mobile-nav', { path: path }) %>
</div>
</body>
</html>

